{"status": 200, "url_final": "https://019ff614-abc2-1aab-7d84-c1c7270bc938.share.connect.posit.cloud/", "html": "\n<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"robots\" content=\"noindex, nofollow\">\n    <title>Posit Connect Cloud</title>\n  <style>\n    @font-face {\n      font-family: 'Open Sans';\n      font-display: fallback;\n      src: url(\"https://connect.posit.cloud/fonts/OpenSans-Regular.woff2\") format('woff2'),\n           url(\"https://connect.posit.cloud/fonts/OpenSans-Regular.woff\") format('woff');\n      font-weight: normal;\n      font-style: normal;\n    }\n    html, body {\n      height: 100%;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background-color: #fff;\n      color: #303030;\n      font-family: \"Open Sans\", sans-serif;\n      font-size: 14px;\n      font-weight: normal;\n      -webkit-font-smoothing: antialiased;\n    }\n    .centered {\n      position: fixed;\n      top: 45%;\n      left: 50%;\n      text-align: center;\n      transform: translate(-50%, -50%);\n    }\n    .message {\n      background-color: #f9f8f8;\n      border-radius: 50px;\n      display: inline-block;\n      font-size: 18px;\n      line-height: 50px;\n      opacity: .95;\n      padding: 20px 50px 20px 40px;\n      white-space: nowrap;\n    }\n    .spinner-container {\n      display: inline-block;\n      height: 35px;\n      margin-right: 10px;\n      position: relative;\n      top: 5px;\n      width: 35px;\n    }\n    .spinner {\n      display: block;\n      width: 100%;\n      height: 100%;\n      position: relative;\n      -webkit-animation: rotate 2s infinite linear;\n      animation: rotate 2s infinite linear;\n    }\n    .dot {\n      width: 40%;\n      height: 40%;\n      border-radius: 50%;\n      position: absolute;\n      -webkit-animation: progressPulse 2s infinite ease-in-out;\n      animation: progressPulse 2s infinite ease-in-out;\n    }\n    .dot.one {\n      top: 0;\n      left: 30%;\n      background-color: #447099;\n    }\n    .dot.two {\n      top: 30%;\n      left: 0;\n      -webkit-animation-delay: -1.5s;\n      animation-delay: -1.5s;\n      background-color: #447099;\n    }\n    .dot.three {\n      bottom: 0;\n      left: 30%;\n      -webkit-animation-delay: -1s;\n      animation-delay: -1s;\n      background-color: #447099;\n    }\n    .dot.four {\n      top: 30%;\n      right: 0;\n      -webkit-animation-delay: -0.5s;\n      animation-delay: -0.5s;\n      background-color: #447099;\n    }\n\n    @-webkit-keyframes rotate {\n      100% {\n        -webkit-transform: rotate(360deg);\n        transform: rotate(360deg); }\n    }\n\n    @keyframes rotate {\n      100% {\n        -webkit-transform: rotate(360deg);\n        transform: rotate(360deg); }\n    }\n\n    @-webkit-keyframes progressPulse {\n      0%, 100% {\n        -webkit-transform: scale(.1);\n        transform: scale(.1);\n        opacity: .1;\n      }\n      50% {\n        -webkit-transform: scale(1);\n        transform: scale(1);\n        opacity: 1;\n      }\n    }\n\n    @keyframes progressPulse {\n      0%, 100% {\n        -webkit-transform: scale(.1);\n        transform: scale(.1);\n        opacity: .1;\n      }\n      50% {\n        -webkit-transform: scale(1);\n        transform: scale(1);\n        opacity: 1;\n      }\n    }\n\n    main {\n      align-items: center;\n      display: flex;\n      height: 100%;\n      justify-content: center;\n    }\n    \n    h1 {\n      color: inherit;\n      font-size: 2.4em;\n      font-weight: 300;\n      margin: .75em 0 .5em 0;\n    }\n\t\n    p {\n      line-height: 1.6em;\n      margin-bottom: 1em;\n    }\n\t\n    .container {\n      align-items: center;\n      display: flex;\n      flex-direction: column;\n      gap: 2rem;\n      justify-content: center;\n      margin: 1rem;\n    }\n\t\n    @media (min-width: 768px) {\n      .container {\n        flex-direction: row;\n      }\n      .error_message {\n        max-width: 450px;\n      }\n    }\n\n  </style>\n</head>\n<body>\n  <main>\n    <div id=\"loading\" class=\"centered\">\n      <div class=\"message\">\n        <div class=\"spinner-container\">\n          <div class=\"spinner\">\n            <div class=\"dot one\"></div>\n            <div class=\"dot two\"></div>\n            <div class=\"dot three\"></div>\n            <div class=\"dot four\"></div>\n          </div>\n        </div>\n        <span>Loading...</span>\n      </div>\n    </div>\n    <script>\n      // Fallback reload in case the server-side reload script is not delivered\n      // (e.g. if the HTTP connection is terminated by a proxy timeout during the build).\n      // The server sends periodic heartbeat chunks that reset this timer, so it only\n      // fires if the connection is truly lost.\n      var __loadingFallbackTimer = setTimeout(function() { window.location.reload(); }, 7000);\n    </script><script>clearTimeout(__loadingFallbackTimer);window.location.reload();</script></body></html>", "erro": "", "ms": 4095}