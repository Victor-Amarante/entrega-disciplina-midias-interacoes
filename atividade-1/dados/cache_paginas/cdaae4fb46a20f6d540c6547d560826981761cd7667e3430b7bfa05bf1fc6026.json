{"status": 200, "url_final": "https://monstergaming.ai/challenges", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>10-Minute Build Challenges \u2014 Monster Gaming AI</title>\n<meta name=\"description\" content=\"Build something cool with AI in 10 minutes. Single-file challenges you can copy-paste and run. Share your results.\">\n<meta property=\"og:title\" content=\"10-Minute Build Challenges \u2014 Monster Gaming AI\">\n<meta property=\"og:description\" content=\"Build a complete AI game feature in 10 minutes. One file. Under $0.05. Worth screenshotting.\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://monstergaming.ai/challenges\">\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0a0a0f; color: #e4e4e7; min-height: 100vh; line-height: 1.6; }\n  .container { max-width: 900px; margin: 0 auto; padding: 60px 24px; }\n  h1 { font-size: 36px; font-weight: 700; margin-bottom: 8px; }\n  .subtitle { color: #a1a1aa; font-size: 17px; margin-bottom: 48px; }\n  .hero-badge { display: inline-block; background: #7c3aed; color: white; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; margin-bottom: 16px; }\n  .challenge-card { background: #18181b; border: 1px solid #27272a; border-radius: 16px; padding: 32px; margin-bottom: 24px; transition: border-color 0.2s; }\n  .challenge-card:hover { border-color: #7c3aed; }\n  .challenge-header { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }\n  .challenge-icon { font-size: 40px; }\n  .challenge-title { font-size: 22px; font-weight: 700; }\n  .challenge-meta { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }\n  .meta-tag { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 500; }\n  .meta-python { background: #1e3a1e; color: #4ade80; }\n  .meta-js { background: #1a2e4b; color: #60a5fa; }\n  .meta-cost { background: #27272a; color: #a1a1aa; }\n  .meta-time { background: #451a03; color: #fb923c; }\n  .challenge-desc { color: #a1a1aa; font-size: 14px; margin-bottom: 20px; }\n  .challenge-actions { display: flex; gap: 12px; flex-wrap: wrap; }\n  .btn { display: inline-block; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; transition: all 0.2s; cursor: pointer; border: none; }\n  .btn-primary { background: #7c3aed; color: white; }\n  .btn-primary:hover { background: #6d28d9; }\n  .btn-outline { background: transparent; border: 1px solid #3f3f46; color: #a1a1aa; }\n  .btn-outline:hover { border-color: #7c3aed; color: #c4b5fd; }\n  .rules-section { margin-top: 48px; padding: 32px; background: #18181b; border: 1px solid #27272a; border-radius: 12px; }\n  .rules-section h2 { font-size: 20px; margin-bottom: 16px; }\n  .rules-list { list-style: none; }\n  .rules-list li { padding: 8px 0; color: #a1a1aa; font-size: 14px; display: flex; align-items: center; gap: 8px; }\n  .rules-list li::before { content: ''; display: inline-block; width: 6px; height: 6px; background: #7c3aed; border-radius: 50%; }\n  .submit-section { text-align: center; margin-top: 48px; padding: 32px; }\n  .submit-section h2 { font-size: 22px; margin-bottom: 12px; }\n  .submit-section p { color: #a1a1aa; margin-bottom: 20px; font-size: 14px; }\n  .coming-soon { opacity: 0.5; pointer-events: none; position: relative; }\n  .coming-soon::after { content: 'COMING SOON'; position: absolute; top: 12px; right: 12px; background: #27272a; color: #71717a; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }\n  .code-block { background: #0f0f14; border: 1px solid #27272a; border-radius: 8px; padding: 16px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #a1a1aa; overflow-x: auto; margin: 16px 0; position: relative; }\n  .copy-btn { position: absolute; top: 8px; right: 8px; background: #27272a; border: none; color: #a1a1aa; padding: 4px 10px; border-radius: 4px; font-size: 11px; cursor: pointer; }\n  .copy-btn:hover { background: #3f3f46; color: white; }\n  footer { text-align: center; color: #52525b; font-size: 13px; margin-top: 60px; padding-top: 24px; border-top: 1px solid #1f1f23; }\n  footer a { color: #71717a; text-decoration: none; }\n  footer a:hover { color: #a1a1aa; }\n  .share-prompt { background: linear-gradient(135deg, #1e1b4b 0%, #18181b 100%); border: 1px solid #4c1d95; border-radius: 12px; padding: 24px; margin-top: 24px; text-align: center; }\n  .share-prompt p { color: #c4b5fd; font-size: 14px; margin-bottom: 12px; }\n  .hashtag { color: #a78bfa; font-weight: 700; font-size: 16px; }\n</style>\n<link rel=\"canonical\" href=\"https://monstergaming.ai/challenges\"/>\n<link rel=\"icon\" href=\"/images/favicon.ico\" sizes=\"any\">\n<meta property=\"og:image\" content=\"https://monstergaming.ai/images/og-default.png\"/>\n<meta property=\"og:image:type\" content=\"image/png\"/>\n<meta property=\"og:image:width\" content=\"1200\"/>\n<meta property=\"og:image:height\" content=\"630\"/>\n<meta property=\"og:image:width\" content=\"1200\"/>\n<meta property=\"og:image:height\" content=\"630\"/>\n<meta name=\"twitter:card\" content=\"summary_large_image\"/>\n<meta name=\"twitter:site\" content=\"@monstergaming\"/>\n<meta name=\"twitter:image\" content=\"https://monstergaming.ai/images/og-default.png\"/>\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://monstergaming.ai/challenges\"/>\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://monstergaming.ai/es/challenges\"/>\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://monstergaming.ai/fr/challenges\"/>\n<link rel=\"alternate\" hreflang=\"ko\" href=\"https://monstergaming.ai/ko/challenges\"/>\n<link rel=\"alternate\" hreflang=\"ja\" href=\"https://monstergaming.ai/ja/challenges\"/>\n<link rel=\"alternate\" hreflang=\"pt\" href=\"https://monstergaming.ai/pt/challenges\"/>\n<link rel=\"alternate\" hreflang=\"sv\" href=\"https://monstergaming.ai/sv/challenges\"/>\n<link rel=\"alternate\" hreflang=\"da\" href=\"https://monstergaming.ai/da/challenges\"/>\n<link rel=\"alternate\" hreflang=\"fi\" href=\"https://monstergaming.ai/fi/challenges\"/>\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://monstergaming.ai/de/challenges\"/>\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://monstergaming.ai/zh/challenges\"/>\n<link rel=\"alternate\" hreflang=\"vi\" href=\"https://monstergaming.ai/vi/challenges\"/>\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://monstergaming.ai/ms/challenges\"/>\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://monstergaming.ai/ar/challenges\"/>\n<link rel=\"alternate\" hreflang=\"it\" href=\"https://monstergaming.ai/it/challenges\"/>\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://monstergaming.ai/ru/challenges\"/>\n<link rel=\"alternate\" hreflang=\"th\" href=\"https://monstergaming.ai/th/challenges\"/>\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://monstergaming.ai/id/challenges\"/>\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://monstergaming.ai/tr/challenges\"/>\n<link rel=\"alternate\" hreflang=\"pl\" href=\"https://monstergaming.ai/pl/challenges\"/>\n<link rel=\"alternate\" hreflang=\"nl\" href=\"https://monstergaming.ai/nl/challenges\"/>\n<link rel=\"alternate\" hreflang=\"hu\" href=\"https://monstergaming.ai/hu/challenges\"/>\n<link rel=\"alternate\" hreflang=\"fr-CA\" href=\"https://monstergaming.ai/fr-ca/challenges\"/>\n<link rel=\"alternate\" hreflang=\"es-CL\" href=\"https://monstergaming.ai/es-cl/challenges\"/>\n<link rel=\"alternate\" hreflang=\"es-AR\" href=\"https://monstergaming.ai/es-ar/challenges\"/>\n<link rel=\"alternate\" hreflang=\"pt-BR\" href=\"https://monstergaming.ai/pt-br/challenges\"/>\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://monstergaming.ai/challenges\"/>\n<meta property=\"og:locale\" content=\"en_US\"/>\n<meta property=\"og:locale:alternate\" content=\"es_ES\"/>\n<meta property=\"og:locale:alternate\" content=\"fr_FR\"/>\n<meta property=\"og:locale:alternate\" content=\"ko_KR\"/>\n<meta property=\"og:locale:alternate\" content=\"ja_JP\"/>\n<meta property=\"og:locale:alternate\" content=\"pt_PT\"/>\n<meta property=\"og:locale:alternate\" content=\"sv_SE\"/>\n<meta property=\"og:locale:alternate\" content=\"da_DK\"/>\n<meta property=\"og:locale:alternate\" content=\"fi_FI\"/>\n<meta property=\"og:locale:alternate\" content=\"de_DE\"/>\n<meta property=\"og:locale:alternate\" content=\"zh_CN\"/>\n<meta property=\"og:locale:alternate\" content=\"vi_VN\"/>\n<meta property=\"og:locale:alternate\" content=\"ms_MY\"/>\n<meta property=\"og:locale:alternate\" content=\"ar_SA\"/>\n<meta property=\"og:locale:alternate\" content=\"it_IT\"/>\n<meta property=\"og:locale:alternate\" content=\"ru_RU\"/>\n<meta property=\"og:locale:alternate\" content=\"th_TH\"/>\n<meta property=\"og:locale:alternate\" content=\"id_ID\"/>\n<meta property=\"og:locale:alternate\" content=\"tr_TR\"/>\n<meta property=\"og:locale:alternate\" content=\"pl_PL\"/>\n<meta property=\"og:locale:alternate\" content=\"nl_NL\"/>\n<meta property=\"og:locale:alternate\" content=\"hu_HU\"/>\n<meta property=\"og:locale:alternate\" content=\"fr_CA\"/>\n<meta property=\"og:locale:alternate\" content=\"es_CL\"/>\n<meta property=\"og:locale:alternate\" content=\"es_AR\"/>\n<meta property=\"og:locale:alternate\" content=\"pt_BR\"/>\n<link rel=\"stylesheet\" href=\"/css/shared.css\">\n<style id=\"mg-wcag\">\n/* WCAG AA contrast: bump text-dim from #6a7a8a (3.5:1) to #8a9aaa (5.1:1) on #020408 */\n:root{--text-dim:#8a9aaa!important}\n[style*=\"color:#6a7a8a\"],[style*=\"color: #6a7a8a\"]{color:#8a9aaa!important}\n/* Focus indicators for all interactive elements */\na:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:2px solid #4d00b8;outline-offset:2px}\n/* Skip navigation link */\n.mg-skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);background:#4d00b8;color:#d0d8e0;padding:8px 16px;border-radius:0 0 4px 4px;font-weight:600;font-size:14px;z-index:10000;text-decoration:none;font-family:'Barlow',system-ui,sans-serif}\n.mg-skip:focus{top:0}\n</style>\n<script defer data-domain=\"monstergaming.ai\" src=\"https://plausible.io/js/script.js\" nonce=\"W4I+iYs3zRv3kmlSSJGx9Q==\"></script>\n</head>\n<body>\n<a href=\"#main\" class=\"mg-skip\">Skip to main content</a>\n<nav style=\"display:flex;align-items:center;justify-content:space-between;padding:1rem 2rem;max-width:1200px;margin:0 auto\">\n<a href=\"/\" style=\"font-family:'Orbitron',sans-serif;font-size:1rem;font-weight:700;letter-spacing:.15em;color:#c8922e;text-decoration:none\">MONSTER<span style=\"color:#9b5cff\">GAMING</span></a>\n<div style=\"display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap\">\n<a href=\"/about\" style=\"font-size:.85rem;color:#8a9aaa;text-decoration:none;font-weight:500\">About</a>\n<a href=\"/team\" style=\"font-size:.85rem;color:#8a9aaa;text-decoration:none;font-weight:500\">Team</a>\n<a href=\"/showcase\" style=\"font-size:.85rem;color:#8a9aaa;text-decoration:none;font-weight:500\">Showcase</a>\n<a href=\"/quickstart\" style=\"font-size:.85rem;color:#8a9aaa;text-decoration:none;font-weight:500\">Docs</a>\n<a href=\"/docs/quickstart\" style=\"font-size:.85rem;color:#8a9aaa;text-decoration:none;font-weight:500\">Quickstart</a>\n<a href=\"/pricing\" style=\"font-size:.85rem;color:#8a9aaa;text-decoration:none;font-weight:500\">Pricing</a>\n<a href=\"/blog\" style=\"font-size:.85rem;color:#8a9aaa;text-decoration:none;font-weight:500\">Blog</a>\n<a href=\"https://portal.monstergaming.ai\" style=\"font-size:.85rem;color:#1ab8cc;text-decoration:none;font-weight:600\">Portal</a>\n<a href=\"/signup\" style=\"font-size:.8rem;color:#d0d8e0;background:#4d00b8;padding:.45rem 1rem;border-radius:4px;text-decoration:none;font-weight:600\">Get Started</a>\n</div></nav>\n\n<div id=\"main\"></div><div class=\"container\">\n  <span class=\"hero-badge\">FREE TO PLAY</span>\n  <h1>10-Minute Build Challenges</h1>\n  <p class=\"subtitle\">Build something cool with AI in 10 minutes. One file. Under $0.05. Worth screenshotting.</p>\n\n  <div class=\"challenge-card\">\n    <div class=\"challenge-header\">\n      <span class=\"challenge-icon\">&#9876;&#65039;</span>\n      <div>\n        <div class=\"challenge-title\">AI Dungeon Master</div>\n      </div>\n    </div>\n    <div class=\"challenge-meta\">\n      <span class=\"meta-tag meta-python\">Python</span>\n      <span class=\"meta-tag meta-time\">10 min</span>\n      <span class=\"meta-tag meta-cost\">~$0.003/turn</span>\n    </div>\n    <p class=\"challenge-desc\">Build a terminal RPG with AI-powered storytelling. The AI creates dramatic narrative, tracks your HP and gold, and responds to any action you take. Fight dragons, loot treasure, die gloriously.</p>\n    <div class=\"code-block\">\n      <button class=\"copy-btn\" onclick=\"navigator.clipboard.writeText('pip install requests &amp;&amp; python ai-dungeon-master.py')\">Copy</button>\n      <code>pip install requests && python ai-dungeon-master.py</code>\n    </div>\n    <div class=\"challenge-actions\">\n      <a class=\"btn btn-primary\" href=\"https://github.com/Monster-Gaming-AI/challenges/blob/main/ai-dungeon-master.py\" target=\"_blank\" rel=\"noopener\">View Source</a>\n      <a class=\"btn btn-outline\" href=\"/snippets\">Get API Key First</a>\n    </div>\n  </div>\n\n  <div class=\"challenge-card coming-soon\">\n    <div class=\"challenge-header\">\n      <span class=\"challenge-icon\">&#128302;</span>\n      <div>\n        <div class=\"challenge-title\">NPC Personality Generator</div>\n      </div>\n    </div>\n    <div class=\"challenge-meta\">\n      <span class=\"meta-tag meta-python\">Python</span>\n      <span class=\"meta-tag meta-time\">8 min</span>\n      <span class=\"meta-tag meta-cost\">~$0.001/NPC</span>\n    </div>\n    <p class=\"challenge-desc\">Generate 20 unique NPCs with backstories, dialogue quirks, and relationship webs. Output a JSON file you can import into any engine. Each NPC remembers the others.</p>\n  </div>\n\n  <div class=\"challenge-card coming-soon\">\n    <div class=\"challenge-header\">\n      <span class=\"challenge-icon\">&#127758;</span>\n      <div>\n        <div class=\"challenge-title\">Procedural Lore Builder</div>\n      </div>\n    </div>\n    <div class=\"challenge-meta\">\n      <span class=\"meta-tag meta-js\">JavaScript</span>\n      <span class=\"meta-tag meta-time\">10 min</span>\n      <span class=\"meta-tag meta-cost\">~$0.01 total</span>\n    </div>\n    <p class=\"challenge-desc\">Generate an entire world's history \u2014 factions, wars, legends, and artifacts. The AI builds internally consistent lore that references its own past events. Export as markdown or JSON.</p>\n  </div>\n\n  <div class=\"challenge-card coming-soon\">\n    <div class=\"challenge-header\">\n      <span class=\"challenge-icon\">&#128172;</span>\n      <div>\n        <div class=\"challenge-title\">Dialogue Tree Weaver</div>\n      </div>\n    </div>\n    <div class=\"challenge-meta\">\n      <span class=\"meta-tag meta-python\">Python</span>\n      <span class=\"meta-tag meta-time\">7 min</span>\n      <span class=\"meta-tag meta-cost\">~$0.005 total</span>\n    </div>\n    <p class=\"challenge-desc\">Feed it a scenario (\"guard at the castle gate, suspicious of strangers\") and it generates a full branching dialogue tree with 4+ paths. Export as Ink, Yarn, or JSON.</p>\n  </div>\n\n  <div class=\"share-prompt\">\n    <p>Finished a challenge? Screenshot your best moment and share it.</p>\n    <span class=\"hashtag\">#MonsterGaming #10MinBuild</span>\n  </div>\n\n  <div class=\"rules-section\">\n    <h2>Challenge Rules</h2>\n    <ul class=\"rules-list\">\n      <li>One file per challenge (no complex setups)</li>\n      <li>Must work in under 50 lines of game logic</li>\n      <li>Must cost less than $0.05 to complete</li>\n      <li>Must produce something worth screenshotting</li>\n      <li>Free API key gets you through every challenge</li>\n    </ul>\n  </div>\n\n  <div style=\"text-align:center; margin-top:32px;\">\n    <p style=\"color:#a1a1aa; font-size:14px; margin-bottom:12px;\">Need an API key to play?</p>\n    <a style=\"display:inline-block; background:#7c3aed; color:white; padding:12px 24px; border-radius:8px; text-decoration:none; font-weight:600; font-size:14px;\" href=\"/onboard\">Get Free Key ($2 credit, no card)</a>\n  </div>\n\n  <div style=\"background:#18181b;border:1px solid #27272a;border-radius:12px;padding:20px;margin-top:32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;\">\n    <div>\n      <p style=\"font-size:14px;font-weight:600;margin-bottom:4px;\">From the blog: Why game devs make the best security engineers</p>\n      <p style=\"color:#a1a1aa;font-size:12px;\">The same skills you use in these challenges power defense simulation and AI security.</p>\n    </div>\n    <a href=\"/blog\" style=\"color:#a78bfa;font-size:13px;text-decoration:none;font-weight:600;white-space:nowrap;\">Read the Trilogy &rarr;</a>\n  </div>\n\n  <div class=\"submit-section\">\n    <h2>Submit Your Own Challenge</h2>\n    <p>Open a PR with your single-file challenge. Community challenges that get merged earn you <strong style=\"color:#4ade80;\">$10 in credits</strong>.</p>\n    <a class=\"btn btn-outline\" href=\"https://github.com/Monster-Gaming-AI/challenges\" target=\"_blank\" rel=\"noopener\">View on GitHub</a>\n  </div>\n\n  <footer>\n    <p><a href=\"/about\">About</a> &middot; <a href=\"/team\">Team</a> &middot; <a href=\"/pricing\">Pricing</a> &middot; <a href=\"/showcase\">Showcase</a> &middot; <a href=\"/blog\">Blog</a> &middot; <a href=\"/tos\"