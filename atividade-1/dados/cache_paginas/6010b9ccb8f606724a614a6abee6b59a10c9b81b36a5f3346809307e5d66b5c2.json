{"status": 200, "url_final": "https://photog.art/", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>photog\u56fe\u50cf\u751f\u6210 \u00b7 orandiffusion</title>\n<meta name=\"description\" content=\"photog\u56fe\u50cf\u751f\u6210 \u2014 \u7531 orandiffusion \u9a71\u52a8\u7684 AI \u56fe\u50cf\u751f\u6210\u3002\u8f93\u5165\u4e00\u53e5\u63cf\u8ff0\uff0c\u5373\u523b\u751f\u6210\u9ad8\u8d28\u611f\u753b\u9762\u3002\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"/static/style.css\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='13' fill='%23100d0b' stroke='%23ff4d3d' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='5' fill='%23ff8a3d'/%3E%3C/svg%3E\">\n</head>\n<body>\n\n<header class=\"masthead\">\n  <div class=\"wrap\">\n    <a class=\"brand\" href=\"/\" style=\"text-decoration:none;color:inherit\">\n      <span class=\"dot\"></span>\n      <h1>photog<em>.</em></h1>\n      <span class=\"zh\">\u56fe\u50cf\u751f\u6210</span>\n    </a>\n    <nav id=\"nav\">\n      <a href=\"#features\">\u7279\u6027</a>\n      <a href=\"#showcase\">\u6837\u7247</a>\n      <span class=\"pill\" id=\"model-pill\">\u6a21\u578b <b>orandiffusion</b></span>\n      <span id=\"account\"></span>\n    </nav>\n  </div>\n</header>\n\n<section class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"glow\"></div>\n    <div class=\"eyebrow\">Analog soul \u00b7 Synthetic light</div>\n    <h2>\u628a\u4e00\u53e5\u8bdd<br>\u51b2\u6d17\u6210<span class=\"it\"> \u4e00\u5e27\u753b\u9762</span>\u3002</h2>\n    <p class=\"lede\"><strong>photog \u56fe\u50cf\u751f\u6210\u6a21\u578b</strong>\uff0c\u7531 <strong>orandiffusion</strong> \u9a71\u52a8\u3002\n      \u8f93\u5165\u4e00\u53e5\u63cf\u8ff0\uff0c\u8ba9\u6697\u623f\u66ff\u4f60\u663e\u5f71\u2014\u2014\u8d28\u611f\u3001\u5149\u7ebf\u3001\u6784\u56fe\uff0c\u4e00\u6b21\u6210\u7247\u3002</p>\n    <div class=\"cta\">\n      <a class=\"btn-primary\" id=\"cta-start\" href=\"#\">\u5f00\u59cb\u521b\u4f5c \u2192</a>\n      <a class=\"btn-ghost\" href=\"#showcase\">\u770b\u770b\u6837\u7247</a>\n    </div>\n  </div>\n</section>\n\n<section class=\"wrap showcase\" id=\"showcase\">\n  <div class=\"lab\">\u6210\u7247\u6837\u7247 \u00b7 contact sheet</div>\n  <div class=\"show-grid\">\n    <figure><img src=\"/static/showcase/cat.jpg\" alt=\"\u6837\u7247\"><figcaption>\u201c\u4e00\u53ea\u732b\u201d</figcaption></figure>\n    <figure><img src=\"/static/showcase/apple.jpg\" alt=\"\u6837\u7247\"><figcaption>\u201c\u4e00\u4e2a\u82f9\u679c\u201d</figcaption></figure>\n    <figure><img src=\"/static/showcase/fruit.jpg\" alt=\"\u6837\u7247\"><figcaption>\u201c\u4e00\u7bee\u65b0\u9c9c\u6c34\u679c\u201d</figcaption></figure>\n    <figure><img src=\"/static/showcase/cat2.jpg\" alt=\"\u6837\u7247\"><figcaption>\u201c\u4e00\u53ea\u732b\u201d</figcaption></figure>\n  </div>\n</section>\n\n<section class=\"wrap features\" id=\"features\">\n  <h3 class=\"sec-head\">\u4e3a\u521b\u4f5c\u800c\u751f\u7684<span class=\"it\"> \u6697\u623f</span>\u3002</h3>\n  <div class=\"grid\">\n    <div class=\"feat\"><div class=\"ic\">\ud83c\udf9e\ufe0f</div><h4>orandiffusion \u6a21\u578b</h4>\n      <p>\u7531 orandiffusion \u9a71\u52a8\uff0c\u7406\u89e3\u4e2d\u6587\u63cf\u8ff0\uff0c\u8f93\u51fa\u7535\u5f71\u611f\u4e0e\u7167\u7247\u7ea7\u8d28\u611f\u7684\u753b\u9762\u3002</p></div>\n    <div class=\"feat\"><div class=\"ic\">\u2699\ufe0f</div><h4>\u591a\u5c3a\u5bf8 \u00b7 \u591a\u98ce\u683c</h4>\n      <p>1:1 / 2:3 / 3:2 \u591a\u79cd\u753b\u5e45\uff0c\u5185\u7f6e\u7535\u5f71\u611f\u3001\u80f6\u7247\u3001\u4eba\u50cf\u3001\u98ce\u5149\u7b49\u98ce\u683c\u4e00\u952e\u53e0\u52a0\u3002</p></div>\n    <div class=\"feat\"><div class=\"ic\">\ud83d\uddbc\ufe0f</div><h4>\u6697\u623f\u753b\u5eca</h4>\n      <p>\u6210\u7247\u81ea\u52a8\u5f52\u6863\u8fdb\u4f60\u7684\u4e13\u5c5e\u753b\u5eca\uff0c\u706f\u7bb1\u5927\u56fe\u6d4f\u89c8\u3001\u952e\u76d8\u7ffb\u7247\u3001\u4e00\u952e\u4e0b\u8f7d\u3002</p></div>\n  </div>\n</section>\n\n<section class=\"wrap\">\n  <div class=\"cta-band\">\n    <div class=\"glow\"></div>\n    <h3>\u73b0\u5728\uff0c\u5c31\u8ba9\u4e00\u53e5\u8bdd<span class=\"it\"> \u663e\u5f71\u6210\u753b\u9762</span>\u3002</h3>\n    <a class=\"btn-primary\" id=\"cta-start2\" href=\"#\">\u5f00\u59cb\u521b\u4f5c \u2192</a>\n  </div>\n</section>\n\n<footer class=\"wrap\">\n  <span>\u00a9 photog\u56fe\u50cf\u751f\u6210 \u00b7 \u6a21\u578b orandiffusion \u00b7 \u6a59\u679c\u89c6\u754c\uff08\u6df1\u5733\uff09\u79d1\u6280\u6709\u9650\u516c\u53f8</span>\n  <span class=\"foot-links\">\n    <a href=\"/static/agreement.html\">\u7528\u6237\u534f\u8bae</a> \u00b7\n    <a href=\"/static/privacy.html\">\u9690\u79c1\u653f\u7b56</a> \u00b7\n    <a href=\"#\" id=\"report-open\">\u4fb5\u6743/\u4e0d\u826f\u4fe1\u606f\u4e3e\u62a5</a> \u00b7\n    <span>\u767b\u5f55\u540e\u4f7f\u7528</span> \u00b7 <span>\u751f\u6210\u5185\u5bb9\u5747\u542b AI \u6807\u8bc6</span> \u00b7\n    <a href=\"https://beian.miit.gov.cn/\" target=\"_blank\" rel=\"noopener\">\u7ca4ICP\u59072024322593\u53f7-2</a>\n  </span>\n</footer>\n\n<!-- login overlay -->\n<div class=\"auth\" id=\"auth\">\n  <div class=\"box\">\n    <span class=\"x\" id=\"auth-x\">\u2715</span>\n    <div class=\"auth-brand\"><span class=\"dot\"></span> photog<em>.</em> <span class=\"zh\">\u56fe\u50cf\u751f\u6210</span></div>\n    <h4>\u767b\u5f55 / \u6ce8\u518c</h4>\n    <p class=\"auth-sub\">\u4f7f\u7528\u751f\u6210\u529f\u80fd\u9700\u5148\u767b\u5f55\u3002\u6211\u4eec\u5c06\u5411\u4f60\u7684\u90ae\u7bb1\u53d1\u9001\u9a8c\u8bc1\u7801\u3002</p>\n    <label class=\"fld\">\u90ae\u7bb1</label>\n    <input id=\"au-email\" class=\"auth-inp\" type=\"email\" autocomplete=\"email\" placeholder=\"your@email.com\">\n    <label class=\"fld\">\u9a8c\u8bc1\u7801</label>\n    <div class=\"code-row\">\n      <input id=\"au-code\" class=\"auth-inp\" inputmode=\"numeric\" maxlength=\"6\" placeholder=\"6 \u4f4d\u9a8c\u8bc1\u7801\">\n      <button id=\"au-send\" class=\"code-btn\">\u83b7\u53d6\u9a8c\u8bc1\u7801</button>\n    </div>\n    <label class=\"agree\"><input type=\"checkbox\" id=\"au-agree\"> \u6211\u5df2\u9605\u8bfb\u5e76\u540c\u610f\n      <a href=\"/static/agreement.html\" target=\"_blank\">\u300a\u7528\u6237\u534f\u8bae\u300b</a>\u4e0e<a href=\"/static/privacy.html\" target=\"_blank\">\u300a\u9690\u79c1\u653f\u7b56\u300b</a></label>\n    <button id=\"au-login\" class=\"auth-go\">\u767b\u5f55 / \u6ce8\u518c</button>\n    <p class=\"auth-note\" id=\"au-note\"></p>\n  </div>\n</div>\n\n<!-- complaint / report overlay -->\n<div class=\"auth\" id=\"report\">\n  <div class=\"box\">\n    <span class=\"x\" id=\"report-x\">\u2715</span>\n    <div class=\"auth-brand\"><span class=\"dot\"></span> \u4e3e\u62a5 / \u6295\u8bc9</div>\n    <h4 style=\"font-size:22px\">\u4fb5\u6743\u00b7\u4e0d\u826f\u4fe1\u606f\u4e3e\u62a5</h4>\n    <p class=\"auth-sub\">\u53d1\u73b0\u8fdd\u6cd5\u6216\u4e0d\u826f\u5185\u5bb9\u3001\u4fb5\u6743\u95ee\u9898\uff0c\u8bf7\u5728\u6b64\u63d0\u4ea4\uff0c\u6211\u4eec\u5c06\u4f9d\u6cd5\u4f9d\u89c4\u53ca\u65f6\u5904\u7406\u3002</p>\n    <label class=\"fld\">\u4e3e\u62a5\u7c7b\u578b</label>\n    <select id=\"rp-cat\" class=\"auth-inp\">\n      <option>\u8fdd\u6cd5\u8fdd\u89c4\u5185\u5bb9</option><option>\u8272\u60c5\u4f4e\u4fd7</option>\n      <option>\u4fb5\u72af\u77e5\u8bc6\u4ea7\u6743 / \u8096\u50cf\u6743</option><option>\u865a\u5047\u4fe1\u606f / \u6df1\u5ea6\u4f2a\u9020</option>\n      <option>AI \u6807\u8bc6\u88ab\u7be1\u6539\u6216\u53bb\u9664</option><option>\u5176\u4ed6</option>\n    </select>\n    <label class=\"fld\">\u6d89\u53ca\u5185\u5bb9\u7f16\u53f7 / \u94fe\u63a5\uff08\u9009\u586b\uff09</label>\n    <input id=\"rp-target\" class=\"auth-inp\" placeholder=\"\u5982 PHOTOG-... \u6216\u56fe\u7247\u94fe\u63a5\">\n    <label class=\"fld\">\u95ee\u9898\u63cf\u8ff0</label>\n    <textarea id=\"rp-content\" class=\"auth-inp\" style=\"min-height:90px;font-family:var(--body)\" placeholder=\"\u8bf7\u7b80\u8981\u63cf\u8ff0\u95ee\u9898\uff08\u81f3\u5c11 5 \u5b57\uff09\"></textarea>\n    <label class=\"fld\">\u8054\u7cfb\u65b9\u5f0f\uff08\u9009\u586b\uff09</label>\n    <input id=\"rp-contact\" class=\"auth-inp\" placeholder=\"\u4fbf\u4e8e\u6211\u4eec\u53cd\u9988\u5904\u7406\u7ed3\u679c\">\n    <button id=\"rp-submit\" class=\"auth-go\">\u63d0\u4ea4\u4e3e\u62a5</button>\n    <p class=\"auth-note\" id=\"rp-note\"></p>\n  </div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n<script src=\"/static/landing.js\"></script>\n</body>\n</html>\n", "erro": "", "ms": 2131}