{"status": 200, "url_final": "https://kandelo.dev/20260819-demo/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <script src=\"/20260819-demo/service-worker-local-4dd17a340ba9fee7.js\"></script>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Kandelo</title>\n  <link rel=\"icon\" type=\"image/png\" href=\"/20260819-demo/assets-local-bc2ed0de99d468ed/favicon-DwvkjUbe.png\">\n  <!-- Fonts are intentionally system-stack only. Cross-origin font hosts\n       (rsms.me, jsdelivr) get blocked by Cross-Origin-Embedder-Policy:\n       require-corp, which we need set for SharedArrayBuffer. If we want\n       Inter/JetBrains Mono we'll need to self-host with @font-face. -->\n  <script>\n    (() => {\n      try {\n        const raw = window.localStorage.getItem(\"kandelo.theme\");\n        const parsed = raw ? JSON.parse(raw) : {};\n        const validStoredPreference = parsed.version === 1 || parsed.version === 2 || parsed.version === 3;\n        const normalizeFamily = (family) => {\n          if (family === \"playground\") return \"wordpress\";\n          if (family === \"balanced\" || family === \"terminal\") return \"kandelo\";\n          return [\"ubuntu\", \"wordpress\", \"kandelo\"].includes(family) ? family : \"ubuntu\";\n        };\n        const family = validStoredPreference ? normalizeFamily(parsed.family) : \"ubuntu\";\n        const preference = validStoredPreference && [\"auto\", \"light\", \"dark\"].includes(parsed.mode)\n          ? parsed.mode\n          : \"auto\";\n        const resolvedMode = preference === \"auto\"\n          ? (window.matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\")\n          : preference;\n        document.documentElement.dataset.kTheme = family;\n        document.documentElement.dataset.kMode = resolvedMode;\n        document.documentElement.dataset.kModePreference = preference;\n        document.documentElement.style.colorScheme = resolvedMode;\n      } catch {\n        // Preference storage can be unavailable in restricted browser contexts.\n      }\n    })();\n  </script>\n  <script type=\"module\" crossorigin src=\"/20260819-demo/assets-local-bc2ed0de99d468ed/main-DyTO1qp7.js\"></script>\n  <link rel=\"modulepreload\" crossorigin href=\"/20260819-demo/assets-local-bc2ed0de99d468ed/modulepreload-polyfill-axk1WA_r.js\">\n  <link rel=\"stylesheet\" crossorigin href=\"/20260819-demo/assets-local-bc2ed0de99d468ed/main-CmNRvPGY.css\">\n</head>\n<body>\n  <div id=\"kandelo-root\"></div>\n</body>\n</html>\n", "erro": "", "ms": 1520}