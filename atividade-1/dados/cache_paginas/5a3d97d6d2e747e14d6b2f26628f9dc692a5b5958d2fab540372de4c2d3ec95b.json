{"status": 200, "url_final": "https://wasmagent.github.io/wasmagent-js/", "html": "<!DOCTYPE html>\n<html lang=\"en-US\" dir=\"ltr\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n    <title>wasmagent</title>\n    <meta name=\"description\" content=\"WasmAgent adds a verifiable evidence layer to agent tool use: protect tool calls, record what happened, audit the result, and turn trusted traces into training data.\">\n    <meta name=\"generator\" content=\"VitePress v1.6.4\">\n    <link rel=\"preload stylesheet\" href=\"/wasmagent-js/assets/style.CjRthxrJ.css\" as=\"style\">\n    <link rel=\"preload stylesheet\" href=\"/wasmagent-js/vp-icons.css\" as=\"style\">\n    \n    <script type=\"module\" src=\"/wasmagent-js/assets/app.Cv-unoiR.js\"></script>\n    <link rel=\"preload\" href=\"/wasmagent-js/assets/inter-roman-latin.Di8DUHzh.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"\">\n    <link rel=\"modulepreload\" href=\"/wasmagent-js/assets/chunks/theme.Z-c1ESNN.js\">\n    <link rel=\"modulepreload\" href=\"/wasmagent-js/assets/chunks/framework.BRgSiRrs.js\">\n    <link rel=\"modulepreload\" href=\"/wasmagent-js/assets/index.md.vfciry0C.lean.js\">\n    <meta name=\"theme-color\" content=\"#646cff\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:title\" content=\"wasmagent\">\n    <meta property=\"og:description\" content=\"WasmAgent adds a verifiable evidence layer to agent tool use: protect tool calls, record what happened, audit the result, and turn trusted traces into training data.\">\n    <script id=\"check-dark-mode\">(()=>{const e=localStorage.getItem(\"vitepress-theme-appearance\")||\"auto\",a=window.matchMedia(\"(prefers-color-scheme: dark)\").matches;(!e||e===\"auto\"?a:e===\"dark\")&&document.documentElement.classList.add(\"dark\")})();</script>\n    <script id=\"check-mac-os\">document.documentElement.classList.toggle(\"mac\",/Mac|iPhone|iPod|iPad