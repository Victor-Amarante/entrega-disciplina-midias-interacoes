class=\"VPLink link\" href=\"/wasmagent-js/zh/\" data-v-118f8245><!--[--><span data-v-118f8245>\u7b80\u4f53\u4e2d\u6587</span><!--]--></a></div><!--]--></div><!--]--><!--]--></div></div></div><div class=\"VPNavBarAppearance appearance\" data-v-fcfb9fb6 data-v-01014eb0><button class=\"VPSwitch VPSwitchAppearance\" type=\"button\" role=\"switch\" title aria-checked=\"false\" data-v-01014eb0 data-v-192ca323 data-v-95aebdad><span class=\"check\" data-v-95aebdad><span class=\"icon\" data-v-95aebdad><!--[--><span class=\"vpi-sun sun\" data-v-192ca323></span><span class=\"vpi-moon moon\" data-v-192ca323></span><!--]--></span></span></button></div><div class=\"VPSocialLinks VPNavBarSocialLinks social-links\" data-v-fcfb9fb6 data-v-8c359000 data-v-3900d2bf><!--[--><a class=\"VPSocialLink no-icon\" href=\"https://github.com/WasmAgent/wasmagent-js\" aria-label=\"github\" target=\"_blank\" rel=\"noopener\" data-v-3900d2bf data-v-e1004224><span class=\"vpi-social-github\"></span></a><!--]--></div><div class=\"VPFlyout VPNavBarExtra extra\" data-v-fcfb9fb6 data-v-57bd7752 data-v-6c4a28a3><button type=\"button\" class=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\" aria-label=\"extra navigation\" data-v-6c4a28a3><span class=\"vpi-more-horizontal icon\" data-v-6c4a28a3></span></button><div class=\"menu\" data-v-6c4a28a3><div class=\"VPMenu\" data-v-6c4a28a3 data-v-7f339390><!----><!--[--><!--[--><div class=\"group translations\" data-v-57bd7752><p class=\"trans-title\" data-v-57bd7752>English</p><!--[--><div class=\"VPMenuLink\" data-v-57bd7752 data-v-118f8245><a class=\"VPLink link\" href=\"/wasmagent-js/zh/\" data-v-118f8245><!--[--><span data-v-118f8245>\u7b80\u4f53\u4e2d\u6587</span><!--]--></a></div><!--]--></div><div class=\"group\" data-v-57bd7752><div class=\"item appearance\" data-v-57bd7752><p class=\"label\" data-v-57bd7752>Appearance</p><div class=\"appearance-action\" data-v-57bd7752><button class=\"VPSwitch VPSwitchAppearance\" type=\"button\" role=\"switch\" title aria-checked=\"false\" data-v-57bd7752 data-v-192ca323 data-v-95aebdad><span class=\"check\" data-v-95aebdad><span class=\"icon\" data-v-95aebdad><!--[--><span class=\"vpi-sun sun\" data-v-192ca323></span><span class=\"vpi-moon moon\" data-v-192ca323></span><!--]--></span></span></button></div></div></div><div class=\"group\" data-v-57bd7752><div class=\"item social-links\" data-v-57bd7752><div class=\"VPSocialLinks social-links-list\" data-v-57bd7752 data-v-3900d2bf><!--[--><a class=\"VPSocialLink no-icon\" href=\"https://github.com/WasmAgent/wasmagent-js\" aria-label=\"github\" target=\"_blank\" rel=\"noopener\" data-v-3900d2bf data-v-e1004224><span class=\"vpi-social-github\"></span></a><!--]--></div></div></div><!--]--><!--]--></div></div></div><!--[--><!--]--><button type=\"button\" class=\"VPNavBarHamburger hamburger\" aria-label=\"mobile navigation\" aria-expanded=\"false\" aria-controls=\"VPNavScreen\" data-v-fcfb9fb6 data-v-c6778f01><span class=\"container\" data-v-c6778f01><span class=\"top\" data-v-c6778f01></span><span class=\"middle\" data-v-c6778f01></span><span class=\"bottom\" data-v-c6778f01></span></span></button></div></div></div></div><div class=\"divider\" data-v-fcfb9fb6><div class=\"divider-line\" data-v-fcfb9fb6></div></div></div><!----></header><!----><!----><div class=\"VPContent is-home\" id=\"VPContent\" data-v-cfcd723a data-v-6d993413><div class=\"VPHome\" data-v-6d993413 data-v-724bc0d9><!--[--><!--]--><div class=\"VPHero VPHomeHero\" data-v-724bc0d9 data-v-e78f954f><div class=\"container\" data-v-e78f954f><div class=\"main\" data-v-e78f954f><!--[--><!--]--><!--[--><h1 class=\"heading\" data-v-e78f954f><span class=\"name clip\" data-v-e78f954f>wasmagent-js</span><span class=\"text\" data-v-e78f954f>Secure portable agent runtime</span></h1><p class=\"tagline\" data-v-e78f954f>WASM isolation \u00b7 Cloudflare-ready \u00b7 rollout ranking \u00b7 training-data export hooks.</p><!--]--><!--[--><!--]--><div class=\"actions\" data-v-e78f954f><!--[--><div class=\"action\" data-v-e78f954f><a class=\"VPButton medium brand\" href=\"/wasmagent-js/guides/getting-started\" data-v-e78f954f data-v-137cc6e8>Get started</a></div><div class=\"action\" data-v-e78f954f><a class=\"VPButton medium alt\" href=\"/wasmagent-js/ecosystem\" data-v-e78f954f data-v-137cc6e8>Ecosystem overview</a></div><div class=\"action\" data-v-e78f954f><a class=\"VPButton medium alt\" href=\"https://github.com/WasmAgent/wasmagent-js\" target=\"_blank\" rel=\"noreferrer\" data-v-e78f954f data-v-137cc6e8>GitHub</a></div><!--]--></div><!--[--><!--]--></div><!----></div></div><!--[--><!--]--><!--[--><!--]--><div class=\"VPFeatures VPHomeFeatures\" data-v-724bc0d9 data-v-479101b6><div class=\"container\" data-v-479101b6><div class=\"items\" data-v-479101b6><!--[--><div class=\"grid-6 item\" data-v-479101b6><a class=\"VPLink link no-icon VPFeature\" href=\"/wasmagent-js/kernels/comparison\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\ud83e\uddf1</div><h2 class=\"title\" data-v-982bdeef>Three-tier code execution</h2><p class=\"details\" data-v-982bdeef>VmKernel (in-process), QuickJS / Pyodide / Wasmtime (true WASM, edge-safe), RemoteSandboxKernel (E2B / CF Sandbox microVMs). Drop-in interchangeable. No other framework ships all three.</p><div class=\"link-text\" data-v-982bdeef><p class=\"link-text-value\" data-v-982bdeef>Decision tree <span class=\"vpi-arrow-right link-text-icon\" data-v-982bdeef></span></p></div></article><!--]--></a></div><div class=\"grid-6 item\" data-v-479101b6><a class=\"VPLink link no-icon VPFeature\" href=\"/wasmagent-js/benchmarks\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\ud83d\udcb8</div><h2 class=\"title\" data-v-982bdeef>Prompt-cache cost control</h2><p class=\"details\" data-v-982bdeef>Auto cache breakpoints, 1-hour TTL, per-TTL usage metering. Verified \u201386% tokens in CI-gated benchmark.</p><div class=\"link-text\" data-v-982bdeef><p class=\"link-text-value\" data-v-982bdeef>See benchmarks <span class=\"vpi-arrow-right link-text-icon\" data-v-982bdeef></span></p></div></article><!--]--></a></div><div class=\"grid-6 item\" data-v-479101b6><div class=\"VPLink no-icon VPFeature\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\ud83c\udde8\ud83c\uddf3</div><h2 class=\"title\" data-v-982bdeef>Chinese models, first-class</h2><p class=\"details\" data-v-982bdeef>Doubao, DeepSeek, Kimi, Qwen, GLM, MiniMax. Each adapter handles thinking modes + cache strategies + reasoning fields correctly. None of the Western frameworks ship these.</p><!----></article><!--]--></div></div><div class=\"grid-6 item\" data-v-479101b6><a class=\"VPLink link no-icon VPFeature\" href=\"/wasmagent-js/guides/devtools\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\u23ea</div><h2 class=\"title\" data-v-982bdeef>Time-travel debugger</h2><p class=\"details\" data-v-982bdeef><code>EventLogReplay</code> + opt-in <code>&lt;DevTools/&gt;</code> React UI. Step replay any agent run, fork from any step. Tiny opt-in package.</p><div class=\"link-text\" data-v-982bdeef><p class=\"link-text-value\" data-v-982bdeef>Open guide <span class=\"vpi-arrow-right link-text-icon\" data-v-982bdeef></span></p></div></article><!--]--></a></div><div class=\"grid-6 item\" data-v-479101b6><a class=\"VPLink link no-icon VPFeature\" href=\"/wasmagent-js/guides/durable-runtime\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\ud83d\udd01</div><h2 class=\"title\" data-v-982bdeef>Durable runtime</h2><p class=\"details\" data-v-982bdeef>Checkpoints, SSE Last-Event-ID resume, stateless human-in-the-loop. Backends - CF KV, Durable Objects, Redis, Upstash.</p><div class=\"link-text\" data-v-982bdeef><p class=\"link-text-value\" data-v-982bdeef>Architecture <span class=\"vpi-arrow-right link-text-icon\" data-v-982bdeef></span></p></div></article><!--]--></a></div><div class=\"grid-6 item\" data-v-479101b6><a class=\"VPLink link no-icon VPFeature\" href=\"/wasmagent-js/data-pipeline\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\ud83d\udd04</div><h2 class=\"title\" data-v-982bdeef>RLAIF data flywheel</h2><p class=\"details\" data-v-982bdeef>RolloutForkRunner + RolloutRanker export real build-verified trajectories as DPO/PPO training records. bscode collects the signal; trace-pipeline trains on it.</p><div class=\"link-text\" data-v-982bdeef><p class=\"link-text-value\" data-v-982bdeef>Pipeline guide <span class=\"vpi-arrow-right link-text-icon\" data-v-982bdeef></span></p></div></article><!--]--></a></div><div class=\"grid-6 item\" data-v-479101b6><a class=\"VPLink link no-icon VPFeature\" href=\"/wasmagent-js/benchmarks\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\ud83e\uddea</div><h2 class=\"title\" data-v-982bdeef>Honest, CI-gated benchmarks</h2><p class=\"details\" data-v-982bdeef>Every percentage in the README is reproduced in CI - drift outside \u00b110 % fails the build. No bit-rot.</p><div class=\"link-text\" data-v-982bdeef><p class=\"link-text-value\" data-v-982bdeef>See the numbers <span class=\"vpi-arrow-right link-text-icon\" data-v-982bdeef></span></p></div></article><!--]--></a></div><div class=\"grid-6 item\" data-v-479101b6><a class=\"VPLink link no-icon VPFeature\" href=\"/wasmagent-js/guides/evals-runner\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\ud83d\udcca</div><h2 class=\"title\" data-v-982bdeef>Pareto-first model evaluation</h2><p class=\"details\" data-v-982bdeef><code>@wasmagent/evals-runner</code> ships six benchmark suites and paired statistics (McNemar / Wilson / bootstrap) \u2014 multi-model comparisons surface trade-off fronts, not single-number ranks.</p><div class=\"link-text\" data-v-982bdeef><p class=\"link-text-value\" data-v-982bdeef>Open guide <span class=\"vpi-arrow-right link-text-icon\" data-v-982bdeef></span></p></div></article><!--]--></a></div><div class=\"grid-6 item\" data-v-479101b6><a class=\"VPLink link no-icon VPFeature\" href=\"/wasmagent-js/guides/mcp-guard\" data-v-479101b6 data-v-982bdeef><!--[--><article class=\"box\" data-v-982bdeef><div class=\"icon\" data-v-982bdeef>\ud83d\udee1</div><h2 class=\"title\" data-v-982bdeef>MCP Guard + Evidence</h2><p class=\"details\" data-v-982bdeef>Wrap any MCP server with policy enforcement. Deny injection/exfiltration attacks before tool execution. Export verifiable AEP evidence bundles after every run.</p><div class=\"link-text\" data-v-982bdeef><p class=\"link-text-value\" data-v-982bdeef>5-min quickstart <span class=\"vpi-arrow-right link-text-icon\" data-v-982bdeef></span></p></div></article><!--]--></a></div><!--]--></div></div></div><!--[--><!--]--><div class=\"vp-doc container\" style=\"\" data-v-724bc0d9 data-v-02754fe9><!--[--><div style=\"position:relative;\" data-v-724bc0d9><div><div style=\"text-align:center;margin-top:3rem;opacity:0.7;\"><small>Apache-2.0 \u00b7 <a href=\"https://github.com/WasmAgent/wasmagent-js/blob/main/README.md#comparison-with-other-agent-frameworks\">vs Vercel AI SDK / Mastra / LangGraph</a> \u00b7 <a href=\"/ecosystem\">Runtime + App + Data Factory ecosystem</a></small></div></div></div><!--]--></div></div></div><footer class=\"VPFooter\" data-v-cfcd723a data-v-862ada30><div class=\"container\" data-v-862ada30><p class=\"message\" data-v-862ada30>Released under the Apache-2.0 License.</p><p class=\"copyright\" data-v-862ada30>\u00a9 wasmagent contributors</p></div></footer><!--[--><!--]--></div></div>\n    <script>window.__VP_HASH_MAP__=JSON.parse(\"{\\\"15-milestones.md\