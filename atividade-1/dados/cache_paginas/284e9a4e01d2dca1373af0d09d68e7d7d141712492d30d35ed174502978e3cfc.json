n</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\"> sandbox-codex</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#0184BC;--shiki-dark:#56B6C2;\">    safe</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\"> codex --dangerously-bypass-approvals-and-sandbox </span><span style=\"--shiki-light:#E45649;--shiki-dark:#E5C07B;\">$argv</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#A626A4;--shiki-dark:#C678DD;\">end</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#A626A4;--shiki-dark:#C678DD;\">function</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\"> sandbox-amp</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#0184BC;--shiki-dark:#56B6C2;\">    safe</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\"> amp --dangerously-allow-all </span><span style=\"--shiki-light:#E45649;--shiki-dark:#E5C07B;\">$argv</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#A626A4;--shiki-dark:#C678DD;\">end</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#A626A4;--shiki-dark:#C678DD;\">function</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\"> sandbox-gemini</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#0184BC;--shiki-dark:#56B6C2;\">    set</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\"> -lx NO_BROWSER true</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#0184BC;--shiki-dark:#56B6C2;\">    safe</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\"> gemini --yolo </span><span style=\"--shiki-light:#E45649;--shiki-dark:#E5C07B;\">$argv</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#A626A4;--shiki-dark:#C678DD;\">end</span></span></code></pre></div></div></div></div></section><section class=\"home-section\" data-v-a44b1ffd><div class=\"home-container\" data-v-a44b1ffd><h2 class=\"section-title\" data-v-a44b1ffd>Generate your own profile with an LLM</h2><p class=\"section-sub\" data-v-a44b1ffd>Use a ready-made prompt that tells Claude, Codex, Gemini, or another model to inspect the real Safehouse profile templates, ask about your home directory and toolchain, and generate a least-privilege `sandbox-exec` profile for your setup.</p><div class=\"cta-card\" data-v-a44b1ffd><p class=\"muted-text\" data-v-a44b1ffd>The guide also tells the LLM to ask about global dotfiles, suggest a durable profile path like <code data-v-a44b1ffd>~/.config/sandbox-exec.profile</code>, offer a wrapper that grants the current working directory, and add shell shortcuts for your preferred agents.</p><a class=\"cta-link\" href=\"/llm-instructions.txt\" data-v-a44b1ffd>Open the copy-paste prompt</a></div></div></section><!--]--><!--]--><!--]--><!--]--><div class=\"vp-doc container\" style=\"\" data-v-66d2e0e2 data-v-d62fa59d><!--[--><div style=\"position:relative;\" data-v-66d2e0e2><div></div></div><!--]--></div></div></div><footer class=\"VPFooter\" data-v-45a6c7b2 data-v-33b813c9><div class=\"container\" data-v-33b813c9><p class=\"message\" data-v-33b813c9>Open source under the Apache 2.0 License.</p><p class=\"copyright\" data-v-33b813c9>Agent Safehouse</p></div></footer><!--[--><!--]--></div></div>\n    <script>window.__VP_HASH_MAP__=JSON.parse(\"{\\\"docs_agent-investigations_aider.md\\\":\\\"DiPTlhY_\\\",\\\"docs_agent-investigations_auggie.md\\\":\\\"bT4yNBRZ\\\",\\\"docs_agent-investigations_claude-code.md\\\":\\\"DMfn9sQo\\\",\\\"docs_agent-investigations_cline.md\\\":\\\"D4IVmw0f\\\",\\\"docs_agent-investigations_codex.md\\\":\\\"lIV-ac02\\\",\\\"docs_agent-investigations_copilot-cli.md\\\":\\\"D1KmBbQc\\\",\\\"docs_agent-investigations_cursor-agent.md\\\":\\\"fvFIxPcl\\\",\\\"docs_agent-investigations_droid.md\\\":\\\"BcPrCVEv\\\",\\\"docs_agent-investigations_gemini-cli.md\\\":\\\"CwA8EnDD\\\",\\\"docs_agent-investigations_goose.md\\\":\\\"CxucApeG\\\",\\\"docs_