ight-font-style:inherit;--shiki-dark:#E06C75;--shiki-dark-font-style:italic;\">$@</span><span style=\"--shiki-light:#50A14F;--shiki-dark:#98C379;\">&quot;</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\">; }</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#4078F2;--shiki-dark:#61AFEF;\">gemini</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\">()   { </span><span style=\"--shiki-light:#E45649;--shiki-dark:#E06C75;\">NO_BROWSER</span><span style=\"--shiki-light:#383A42;--shiki-dark:#56B6C2;\">=</span><span style=\"--shiki-light:#50A14F;--shiki-dark:#98C379;\">true</span><span style=\"--shiki-light:#4078F2;--shiki-dark:#61AFEF;\"> safe</span><span style=\"--shiki-light:#50A14F;--shiki-dark:#98C379;\"> gemini</span><span style=\"--shiki-light:#986801;--shiki-dark:#D19A66;\"> --yolo</span><span style=\"--shiki-light:#50A14F;--shiki-dark:#98C379;\"> &quot;</span><span style=\"--shiki-light:#383A42;--shiki-light-font-style:inherit;--shiki-dark:#E06C75;--shiki-dark-font-style:italic;\">$@</span><span style=\"--shiki-light:#50A14F;--shiki-dark:#98C379;\">&quot;</span><span style=\"--shiki-light:#383A42;--shiki-dark:#ABB2BF;\">; }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#A0A1A7;--shiki-light-font-style:italic;--shiki-dark:#7F848E;--shiki-dark-font-style:italic;\"># Unsandboxed \u2014 bypass the function with `command`</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#A0A1A7;--shiki-light-font-style:italic;--shiki-dark:#7F848E;--shiki-dark-font-style:italic;\"># command claude               \u2014 plain interactive session</span></span></code></pre></div><p><strong><code>fish</code></strong></p><div class=\"language-fish\"><button title=\"Copy Code\" class=\"copy\"></button><span class=\"lang\">fish</span><pre class=\"shiki shiki-themes one-light one-dark-pro\" style=\"--shiki-light:#383A42;--shiki-dark:#abb2bf;--shiki-light-bg:#FAFAFA;--shiki-dark-bg:#282c34;\