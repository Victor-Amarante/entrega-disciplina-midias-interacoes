{"status": 200, "url_final": "https://sandboxd.io/", "html": "<!doctype html><html lang=en dir=ltr class=\"plugin-pages plugin-id-default\" data-has-hydrated=false><head><meta charset=UTF-8><meta name=generator content=\"Docusaurus v3.10.1\"><title data-rh=true>Self-hosted, open-source AI app builder | sandboxd</title><meta data-rh=true name=viewport content=\"width=device-width, initial-scale=1.0\"/><meta data-rh=true property=og:image content=https://sandboxd.io/img/sandboxd-social-card.png /><meta data-rh=true name=twitter:image content=https://sandboxd.io/img/sandboxd-social-card.png /><meta data-rh=true property=og:url content=https://sandboxd.io/ /><meta data-rh=true property=og:locale content=en /><meta data-rh=true name=docusaurus_locale content=en /><meta data-rh=true name=docusaurus_tag content=default /><meta data-rh=true name=docsearch:language content=en /><meta data-rh=true name=docsearch:docusaurus_tag content=default /><meta data-rh=true name=keywords content=\"sandboxd, AI sandbox, self-hosted sandboxes, isolated dev environments, AI coding agents, preview URLs, AI app builder backend, agent infrastructure, Docker sandboxes, open source\"/><meta data-rh=true name=twitter:card content=summary_large_image /><meta data-rh=true property=og:type content=website /><meta data-rh=true property=og:site_name content=sandboxd /><meta data-rh=true name=author content=sandboxd /><meta data-rh=true property=og:title content=\"Self-hosted, open-source AI app builder | sandboxd\"/><meta data-rh=true name=description content=\"Open-source, self-hosted AI app builder \u2014 an agent builds real apps in isolated sandboxes on your own server, each live at a preview URL. One command.\"/><meta data-rh=true property=og:description content=\"Open-source, self-hosted AI app builder \u2014 an agent builds real apps in isolated sandboxes on your own server, each live at a preview URL. One command.\"/><link data-rh=true rel=icon href=/img/favicon.png /><link data-rh=true rel=c