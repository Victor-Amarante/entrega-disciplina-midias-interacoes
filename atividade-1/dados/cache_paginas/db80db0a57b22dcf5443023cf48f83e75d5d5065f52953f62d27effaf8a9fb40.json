{"status": 200, "url_final": "https://gestalt-village.pauloferreira.me/", "html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Gestalt Village</title>\n    <link rel=\"stylesheet\" href=\"styles.css\">\n  </head>\n  <body>\n    <section id=\"load-screen\" class=\"screen intro-screen\">\n      <div class=\"intro-card\">\n        <div class=\"intro-layout\">\n          <div>\n            <p class=\"eyebrow\">Browser-native multi-agent simulation</p>\n            <h1>Gestalt Village</h1>\n            <p class=\"header-copy\">\n              Load the model once, then generate a small local social simulation where\n              agents move, remember, and talk directly in your browser.\n            </p>\n            <div class=\"boot-actions\">\n              <button id=\"load-model-button\" class=\"boot-button\" type=\"button\" data-state=\"idle\">\n                <span id=\"load-model-label\">Boot Model</span>\n              </button>\n              <p class=\"boot-caption\">Loads once, then opens the village workspace.</p>\n            </div>\n            <div id=\"compatibility-note\" class=\"note warning hidden\"></div>\n          </div>\n\n          <div class=\"boot-visual\">\n            <div class=\"signal-card\">\n              <div class=\"signal-header\">\n                <span>Village runtime</span>\n                <strong>Local model boot</strong>\n              </div>\n              <div class=\"signal-grid\">\n                <div class=\"signal-cell\">\n                  <span>Model</span>\n                  <strong id=\"boot-model-name\">Simulation model</strong>\n                </div>\n                <div class=\"signal-cell\">\n                  <span>Mode</span>\n                  <strong id=\"boot-model-device\">WebGPU</strong>\n                </div>\n                <div class=\"signal-cell signal-cell-wide\">\n                  <span>Status</span>\n                  <p id=\"progress-meter\" class=\"boot-meter-copy\">Awaiting model load.</p>\n                </div>\n              </div>\n              <div class=\"boot-map\">\n                <span class=\"boot-room\"></span>\n                <span class=\"boot-room\"></span>\n                <span class=\"boot-room\"></span>\n                <span class=\"boot-room\"></span>\n                <span class=\"boot-path\"></span>\n                <span class=\"boot-path\"></span>\n                <span class=\"boot-agent\"></span>\n                <span class=\"boot-agent\"></span>\n                <span class=\"boot-agent\"></span>\n                <span class=\"boot-agent\"></span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <div id=\"app-screen\" class=\"app-shell hidden\">\n      <header class=\"header\">\n        <div class=\"header-title\">\n          <p class=\"eyebrow\">Browser-native multi-agent simulation</p>\n          <h1>Gestalt Village</h1>\n          <p class=\"header-copy\">\n            Describe a place, then watch a small cast of local agents move, talk,\n            remember, and change their relationships over time.\n          </p>\n        </div>\n        <div class=\"header-meta\">\n          <div class=\"meta-card\">\n            <span>Model</span>\n            <strong id=\"model-chip-name\">Local model</strong>\n            <span id=\"model-chip-detail\">loading\\u2026</span>\n          </div>\n          <div class=\"meta-card live\">\n            <span>Runtime</span>\n            <strong id=\"local-status\">Running locally</strong>\n            <span id=\"network-status\">0 network requests</span>\n          </div>\n          <div class=\"meta-card\" id=\"convo-status-card\">\n            <span>Active scene</span>\n            <strong id=\"convo-status-text\">Waiting for agents to meet</strong>\n          </div>\n          <div class=\"meta-card\">\n            <span>Token Estimate</span>\n            <strong id=\"token-count\">0</strong>\n            <span>browser model telemetry</span>\n          </div>\n        </div>\n      </header>\n\n      <section id=\"prompt-panel\" class=\"prompt-panel\">\n        <div class=\"prompt-panel-header\">\n          <div>\n            <label id=\"scenario-label\" for=\"scenario-input\">Describe the setting and its inhabitants</label>\n            <p id=\"scenario-summary\" class=\"prompt-summary hidden\"></p>\n          </div>\n          <button id=\"toggle-prompt-button\" class=\"prompt-toggle ghost hidden\" type=\"button\">Edit Setup</button>\n        </div>\n        <div id=\"prompt-panel-body\">\n          <div id=\"prompt-editor\" class=\"prompt-row\">\n            <textarea id=\"scenario-input\" rows=\"4\" placeholder=\"A small startup. Maya is the CTO...\"></textarea>\n            <button id=\"generate-button\" class=\"primary-button\">Generate world</button>\n          </div>\n          <div id=\"prompt-runtime-controls\" class=\"control-row\">\n            <div class=\"model-progress\">\n              <div class=\"progress-copy\">\n                <span>Local model cache</span>\n                <strong id=\"model-status\">Ready from cache</strong>\n              </div>\n              <div id=\"model-details\" class=\"model-details\"></div>\n              <div class=\"progress-bar\"><span id=\"progress-bar-fill\"></span></div>\n            </div>\n            <div class=\"simulation-controls\">\n              <button data-speed=\"0\" class=\"control-button\" id=\"pause-button\">Pause</button>\n              <button data-speed=\"1\" class=\"control-button active\" id=\"play-button\">Play</button>\n              <button data-speed=\"2\" class=\"control-button\" id=\"fast-button\">Fast</button>\n              <button class=\"control-button\" id=\"screenshot-button\">Screenshot</button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"workspace\">\n        <section class=\"panel world-panel\">\n          <div class=\"panel-header\">\n            <div>\n              <h2>World view</h2>\n              <p id=\"world-caption\">Generate a scenario to start the village.</p>\n            </div>\n            <div class=\"tick-chip\">Tick <span id=\"tick-count\">0</span></div>\n          </div>\n          <canvas id=\"world-canvas\" width=\"960\" height=\"620\"></canvas>\n          <div class=\"world-legend\">\n            <span><i class=\"legend-dot thought\"></i> click a resident to inspect thought, memory, and trust</span>\n            <span><i class=\"legend-dot speech\"></i> active dialogue appears above each sprite in-world</span>\n          </div>\n        </section>\n\n        <section class=\"panel\">\n          <div class=\"panel-header\">\n            <div>\n              <h2>Agent inspector</h2>\n              <p>Thoughts, memories, and relationships.</p>\n            </div>\n          </div>\n          <div id=\"inspector-empty\" class=\"empty-state\">Select a resident on the map to inspect thoughts, memory, and relationships.</div>\n          <div id=\"inspector-content\" class=\"hidden\">\n            <div class=\"agent-hero\">\n              <div id=\"agent-badge\" class=\"agent-badge\"></div>\n              <div>\n                <h3 id=\"agent-name\"></h3>\n                <p id=\"agent-role\"></p>\n              </div>\n            </div>\n            <div class=\"summary-grid\">\n              <div id=\"agent-status-card\" class=\"summary-card\">\n                <span class=\"status-label\">Status</span>\n                <strong id=\"agent-status\"></strong>\n                <p id=\"agent-status-detail\"></p>\n              </div>\n              <div id=\"agent-focus-card\" class=\"summary-card active\">\n                <span class=\"status-label\">Focus</span>\n                <strong id=\"agent-goal-title\"></strong>\n                <p id=\"agent-goal\"></p>\n              </div>\n              <div id=\"agent-pressure-card\" class=\"summary-card\">\n                <span class=\"status-label\">Pressure</span>\n                <strong id=\"agent-pressure-title\"></strong>\n                <p id=\"agent-secret\"></p>\n              </div>\n            </div>\n            <div class=\"inspector-section\">\n              <h4>Current thought</h4>\n              <p id=\"agent-thought\"></p>\n            </div>\n            <div class=\"inspector-section\">\n              <h4>Persona</h4>\n              <p id=\"agent-personality\"></p>\n            </div>\n            <div id=\"agent-speech-section\" class=\"inspector-section hidden\">\n              <h4>Current speech</h4>\n              <p id=\"agent-speech\" class=\"agent-speech-live\"></p>\n            </div>\n            <div class=\"inspector-section\">\n              <h4>Private office</h4>\n              <label for=\"office-input\">Talk directly to the selected agent</label>\n              <div class=\"office-composer\">\n                <textarea id=\"office-input\" rows=\"3\" placeholder=\"Ask what they are worried about, what they are hiding, or what they need.\"></textarea>\n                <button id=\"office-send-button\" class=\"primary-button office-button\">Talk</button>\n              </div>\n            </div>\n            <div class=\"inspector-section\">\n              <h4>Key relationships</h4>\n              <div id=\"relationship-list\" class=\"stack-list\"></div>\n            </div>\n            <div class=\"inspector-section\">\n              <h4>Recent signals</h4>\n              <div id=\"memory-list\" class=\"stack-list\"></div>\n            </div>\n            <details id=\"agent-debug-panel\" class=\"debug-panel\">\n              <summary>Agent debug</summary>\n              <div id=\"agent-diagnostics\" class=\"debug-list\"></div>\n            </details>\n          </div>\n        </section>\n\n        <section class=\"panel\">\n          <div class=\"panel-header\">\n            <div>\n              <h2>Conversation log</h2>\n              <p>Transcripts first, deeper debugging only when you need it.</p>\n            </div>\n            <div class=\"log-filter-row\">\n              <button id=\"log-latest-button\" class=\"control-button active\" type=\"button\">Latest</button>\n              <button id=\"log-full-button\" class=\"control-button\" type=\"button\">Full history</button>\n            </div>\n          </div>\n          <div class=\"telemetry-grid\">\n            <div class=\"telemetry-card\">\n              <span class=\"status-label\">Model health</span>\n              <strong id=\"telemetry-model-summary\">Loading</strong>\n              <span id=\"telemetry-model-detail\">Waiting for model boot.</span>\n            </div>\n            <div class=\"telemetry-card\">\n              <span class=\"status-label\">Runtime</span>\n              <strong id=\"telemetry-runtime-summary\">Tick 0</strong>\n              <span id=\"telemetry-runtime-detail\">No active scene.</span>\n            </div>\n            <div class=\"telemetry-card\">\n              <span class=\"status-label\">Conversations</span>\n              <strong id=\"telemetry-conversation-summary\">0 total</strong>\n              <span id=\"telemetry-conversation-detail\">last -</span>\n            </div>\n            <div class=\"telemetry-card telemetry-card-wide\">\n              <span class=\"status-label\">Live bubble</span>\n              <strong id=\"telemetry-live-speaker\">No active speech</strong>\n              <p id=\"telemetry-live-text\">The full current speech line appears here.</p>\n            </div>\n            <div id=\"telemetry-active-scene-card\" class=\"telemetry-card telemetry-card-wide hidden\">\n              <span class=\"status-label\">Active scene</span>\n              <strong id=\"telemetry-active-scene-title\">No active conversation</strong>\n              <p id=\"telemetry-active-scene-detail\"></p>\n            </div>\n          </div>\n          <details id=\"telemetry-debug-panel\" class=\"debug-panel\">\n            <summary>Debug stream</summary>\n            <div class=\"telemetry-row\">\n              <span id=\"telemetry-repeat-count\">0 repeats / 0 blocked</span>\n              <span id=\"telemetry-error-count\">0 client errors</span>\n              <span id=\"telemetry-reflection-count\">0 reflections</span>\n              <span id=\"telemetry-conversation-count\">0 conversations</span>\n              <span id=\"telemetry-memory-count\">0 memory writes</span>\n            </div>\n            <div class=\"telemetry-row\">\n              <span id=\"telemetry-reflection-latency\">reflection -</span>\n              <span id=\"telemetry-conversation-latency\">conversation -</span>\n              <span id=\"telemetry-memory-latency\">memory -</span>\n            </div>\n            <div class=\"prompt-trace-block\">\n              <strong>Prompt traces (debug)</strong>\n              <div id=\"prompt-trace-stream\" class=\"telemetry-stream prompt-trace-stream\"></div>\n            </div>\n            <div id=\"telemetry-stream\" class=\"telemetry-stream\"></div>\n          </details>\n          <div id=\"conversation-log\" class=\"conversation-log\"></div>\n        </section>\n      </div>\n    </div>\n\n    <template id=\"log-entry-template\">\n      <article class=\"log-entry\">\n        <div class=\"log-meta\"></div>\n        <div class=\"log-body\"></div>\n      </article>\n    </template>\n\n    <script type=\"module\" src=\"src/app.js\"></script>\n  </body>\n</html>\n", "erro": "", "ms": 1410}