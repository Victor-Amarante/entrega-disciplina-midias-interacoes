{"status": 200, "url_final": "https://pyex.dev/", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" />\n  <meta name=\"color-scheme\" content=\"dark\" />\n  <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%237c74ff'/%3E%3Ctext x='32' y='43' font-family='ui-monospace,monospace' font-size='30' font-weight='bold' fill='white' text-anchor='middle'%3Epy%3C/text%3E%3C/svg%3E\" />\n  <title>pyex \u2014 run agent-written Python as a function call</title>\n  <meta name=\"description\" content=\"The sandbox is a function call. A Python 3 interpreter written in Elixir for code-mode agents: no containers, no cold starts, no RPC between the agent's code and your tools. Capabilities in, verdict + capability trace out.\" />\n  <meta property=\"og:title\" content=\"pyex \u2014 run agent-written Python as a function call\" />\n  <meta property=\"og:description\" content=\"The sandbox is a function call. No containers, no cold starts, no RPC between agent code and your tools.\" />\n  <meta property=\"og:url\" content=\"https://pyex.dev\" />\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:image\" content=\"https://pyex.dev/og.png\" />\n  <meta property=\"og:image:width\" content=\"1200\" />\n  <meta property=\"og:image:height\" content=\"630\" />\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  <meta name=\"twitter:image\" content=\"https://pyex.dev/og.png\" />\n  <style>\n    :root {\n      --bg: #050507; --surface: rgba(255,255,255,.025); --line: rgba(255,255,255,.07); --line2: rgba(255,255,255,.13);\n      --fg: #f4f4f6; --body: #9ba0ab; --faint: #5c6068; --accent: #7c74ff; --accent2: #9a8bff;\n      --grn: #5ce08a; --red: #ff6b64; --yel: #e3b341;\n      --mono: \"SF Mono\", ui-monospace, \"JetBrains Mono\", Menlo, Consolas, monospace;\n      --sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, system-ui, sans-serif;\n    }\n    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0; background: var(--bg); color: var(--fg); font-family: var(--sans);\n      letter-spacing: -.01em; line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden;\n    }\n    ::selection { background: rgba(124,116,255,.35); }\n    a { color: inherit; text-decoration: none; }\n    .wrap { max-width: 1024px; margin: 0 auto; padding: 0 24px; }\n    .narrow { max-width: 760px; }\n\n    .backdrop { position: fixed; inset: 0; z-index: -1; pointer-events: none; }\n    .backdrop .grid {\n      position: absolute; inset: 0;\n      background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);\n      background-size: 72px 72px;\n      mask-image: radial-gradient(ellipse 90% 55% at 50% -10%, black 35%, transparent 78%);\n      -webkit-mask-image: radial-gradient(ellipse 90% 55% at 50% -10%, black 35%, transparent 78%);\n    }\n    .backdrop .glow {\n      position: absolute; left: 50%; top: -340px; width: 1100px; height: 720px; transform: translateX(-50%);\n      background: radial-gradient(ellipse at center, rgba(124,116,255,.16), rgba(124,116,255,.05) 45%, transparent 70%);\n      filter: blur(4px);\n    }\n\n    nav {\n      position: sticky; top: 0; z-index: 40; height: 60px;\n      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);\n      background: rgba(5,5,7,.72); border-bottom: 1px solid var(--line);\n    }\n    nav .inner { display: flex; align-items: center; gap: 12px; height: 100%; }\n    .logo { width: 26px; height: 26px; border-radius: 7px; display: grid; place-items: center;\n      font: 700 12px var(--mono); color: #fff; background: linear-gradient(145deg, #8d84ff, #5a4fd6);\n      box-shadow: 0 0 0 1px rgba(255,255,255,.1), 0 4px 14px -4px rgba(124,116,255,.8); }\n    .brand { font: 600 15px var(--mono); }\n    nav .links { margin-left: auto; display: flex; align-items: center; gap: 2px; }\n    nav .links a { font: 500 13.5px var(--sans); color: var(--body); padding: 8px 12px; border-radius: 8px; transition: .15s; }\n    nav .links a:hover { color: var(--fg); background: rgba(255,255,255,.05); }\n    nav .links a.solid { color: #000; background: #fff; font-weight: 600; margin-left: 8px; padding: 8px 14px; }\n    nav .links a.solid:hover { background: #e6e6ea; }\n\n    header { text-align: center; padding: 88px 0 24px; }\n    .badge {\n      display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 13px 0 9px;\n      border: 1px solid var(--line2); border-radius: 999px; background: rgba(255,255,255,.03);\n      font: 500 12.5px var(--mono); color: var(--body);\n    }\n    .badge .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--grn); box-shadow: 0 0 10px var(--grn); }\n    h1 {\n      margin: 26px auto 14px; max-width: 16ch;\n      font-size: clamp(38px, 6.6vw, 64px); line-height: 1.06; letter-spacing: -.035em; font-weight: 700;\n      background: linear-gradient(180deg, #fff 30%, #b6b9c3);\n      -webkit-background-clip: text; background-clip: text; color: transparent;\n    }\n    h1 em { font-style: normal;\n      background: linear-gradient(90deg, #b1a6ff, #7c74ff 55%, #a08bff);\n      -webkit-background-clip: text; background-clip: text; color: transparent; }\n    .position { font: 500 15px var(--mono); color: var(--accent2); margin: 0 0 18px; }\n    .sub { font-size: 16.5px; color: var(--body); max-width: 60ch; margin: 0 auto; }\n    .sub b { color: var(--fg); font-weight: 600; }\n    .ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 30px 0 0; }\n    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; padding: 0 22px;\n      border-radius: 10px; font: 600 14px var(--sans); cursor: pointer; transition: .15s; border: 1px solid transparent; }\n    .btn.primary { background: #fff; color: #000; box-shadow: 0 0 0 1px rgba(255,255,255,.14), 0 8px 30px -12px rgba(255,255,255,.45); }\n    .btn.primary:hover { background: #e6e6ea; }\n    .btn.ghost { background: rgba(255,255,255,.02); color: var(--fg); border-color: var(--line2); font-family: var(--mono); font-size: 13px; }\n    .btn.ghost:hover { border-color: rgba(124,116,255,.6); background: rgba(124,116,255,.06); }\n\n    pre.block {\n      background: #0a0a0e; border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px;\n      font: 400 12.5px/1.7 var(--mono); color: var(--fg); overflow-x: auto; margin: 24px 0 0; text-align: left;\n      box-shadow: 0 30px 70px -40px rgba(0,0,0,.9);\n    }\n    pre.block .c { color: var(--faint); }\n    pre.block .g { color: var(--grn); }\n    pre.block .p { color: var(--accent2); }\n    pre.block .s { color: var(--yel); }\n    pre.block a { color: var(--accent2); text-decoration: underline; text-underline-offset: 3px; }\n\n    .demo-wrap { position: relative; max-width: 780px; margin: 40px auto 0; }\n    .demo-wrap::before { content: \"\"; position: absolute; inset: -1px; border-radius: 17px; z-index: -1;\n      background: linear-gradient(140deg, rgba(124,116,255,.5), rgba(124,116,255,.06) 30%, rgba(255,255,255,.06) 60%, rgba(92,224,138,.25)); }\n    .demo { background: #0a0a0e; border-radius: 16px; overflow: hidden; text-align: left;\n      box-shadow: 0 40px 90px -40px rgba(0,0,0,.9), 0 0 80px -30px rgba(124,116,255,.25); }\n    .demo .bar { display: flex; align-items: center; gap: 10px; padding: 0 16px; height: 44px;\n      border-bottom: 1px solid var(--line); font: 500 12px var(--mono); color: var(--body); }\n    .demo .bar .dots { display: flex; gap: 6px; }\n    .demo .bar .dots i { width: 10px; height: 10px; border-radius: 999px; background: var(--line2); }\n    .demo .bar .hint { margin-left: auto; color: var(--faint); }\n    .demo textarea { display: block; width: 100%; min-height: 150px; padding: 16px 18px; border: 0; resize: vertical;\n      background: transparent; color: var(--fg); font: 400 13.5px/1.6 var(--mono); outline: none; }\n    .demo pre.out { margin: 0; padding: 13px 18px; border-top: 1px solid var(--line); background: rgba(255,255,255,.02);\n      font: 400 13px/1.5 var(--mono); color: var(--grn); overflow-x: auto; white-space: pre; }\n    .demo pre.out.err { color: var(--red); }\n    .demo pre.out:empty { display: none; }\n    .demo .foot { display: flex; align-items: center; gap: 14px; padding: 10px 10px 10px 18px; border-top: 1px solid var(--line); }\n    .demo .run { height: 40px; padding: 0 20px; border-radius: 9px; border: 1px solid rgba(255,255,255,.14); cursor: pointer;\n      font: 600 13.5px var(--sans); color: #fff; background: linear-gradient(180deg, #9a8bff, #7266f0);\n      box-shadow: 0 6px 20px -8px rgba(124,116,255,.9); transition: .15s; }\n    .demo .run:hover { filter: brightness(1.12); }\n    .demo .run:disabled { opacity: .6; }\n    .demo .meta { font: 500 12px var(--mono); color: var(--faint); }\n\n    section { padding: 88px 0 0; }\n    .kicker { font: 600 12px var(--mono); color: var(--accent2); text-transform: uppercase; letter-spacing: .1em; margin: 0 0 10px; }\n    h2 { font-size: clamp(25px, 3.4vw, 32px); letter-spacing: -.025em; line-height: 1.18; margin: 0 0 12px; font-weight: 700; }\n    .lede { color: var(--body); font-size: 15.5px; max-width: 66ch; margin: 0; }\n    .lede b, .lede strong { color: var(--fg); }\n    .lede code, td code, .card p code { font: 500 12px var(--mono); color: var(--accent2); }\n\n    table { width: 100%; border-collapse: collapse; margin: 26px 0 0; font-size: 14px; }\n    th, td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--line); }\n    th { font: 600 12px var(--mono); color: var(--faint); text-transform: uppercase; letter-spacing: .06em; }\n    td { color: var(--body); }\n    td:first-child { color: var(--fg); font-weight: 500; }\n    td.good { color: var(--grn); font-family: var(--mono); font-size: 13px; }\n    td.num { font-family: var(--mono); font-size: 13px; color: var(--fg); }\n    .table-scroll { overflow-x: auto; }\n\n    blockquote { margin: 26px 0 0; padding: 18px 22px; border-left: 2px solid var(--accent);\n      background: rgba(124,116,255,.05); border-radius: 0 12px 12px 0; color: var(--body); font-size: 15px; }\n    blockquote b { color: var(--fg); }\n    blockquote code { font: 500 12.5px var(--mono); color: var(--accent2); }\n\n    .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; margin-top: 26px; }\n    .card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 18px; transition: border-color .2s, background .2s; }\n    .card:hover { border-color: rgba(124,116,255,.45); background: rgba(124,116,255,.04); }\n    .card h3 { margin: 0 0 6px; font-size: 14.5px; font-weight: 600; }\n    .card p { margin: 0; font-size: 13.5px; color: var(--body); line-height: 1.55; }\n\n    ul.strip { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 9px; }\n    ul.strip li { font-size: 14px; color: var(--body); padding-left: 24px; position: relative; }\n    ul.strip li::before { content: \"\u2713\"; position: absolute; left: 0; color: var(--grn); font: 600 13px var(--mono); }\n    ul.strip b { color: var(--fg); }\n\n    .honest { border: 1px solid var(--line2); border-radius: 14px; padding: 22px 24px; margin-top: 26px; background: rgba(255,255,255,.015); }\n    .honest h3 { margin: 0 0 8px; font: 600 13px var(--mono); color: var(--yel); text-transform: uppercase; letter-spacing: .08em; }\n    .honest p { margin: 0; color: var(--body); font-size: 14.5px; }\n    .honest b { color: var(--fg); }\n\n    .install { text-align: center; margin-top: 96px; padding: 44px 24px; border: 1px solid var(--line); border-radius: 16px;\n      background: radial-gradient(ellipse 70% 120% at 50% 0%, rgba(124,116,255,.09), transparent 65%); }\n    .install h2 { margin-bottom: 6px; }\n    .install .dep { display: inline-block; margin: 16px 0 0; padding: 12px 22px; border: 1px solid var(--line2); border-radius: 10px;\n      background: #0a0a0e; font: 500 14px var(--mono); color: var(--fg); }\n    .install .dep .p { color: var(--accent2); }\n\n    footer { margin-top: 90px; padding: 30px 0 48px; border-top: 1px solid var(--line);\n      display: flex; align-items: center; gap: 8px 20px; flex-wrap: wrap; font: 500 13px var(--mono); color: var(--faint); }\n    footer a { color: var(--body); transition: .15s; }\n    footer a:hover { color: var(--fg); }\n    @media (max-width: 640px) {\n      header { padding-top: 56px; }\n      .ctas .btn { flex: 1 1 100%; }\n      nav .links a:not(.solid) { padding: 8px 8px; }\n      section { padding-top: 64px; }\n    }\n    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\n  </style>\n</head>\n<body>\n  <div class=\"backdrop\"><div class=\"grid\"></div><div class=\"glow\"></div></div>\n\n  <nav><div class=\"wrap inner\">\n    <div class=\"logo\">py</div><span class=\"brand\">pyex</span>\n    <div class=\"links\">\n      <a href=\"#sandbox\">Sandbox</a>\n      <a href=\"/support/\">Conformance</a>\n      <a href=\"https://github.com/ivarvong/pyex\">GitHub</a>\n      <a class=\"solid\" href=\"/play/\">Playground</a>\n    </div>\n  </div></nav>\n\n  <div class=\"wrap\">\n    <header>\n      <span class=\"badge\"><span class=\"dot\"></span>this page runs it live \u2014 Python 3 \u00b7 Elixir \u00b7 WasmGC</span>\n      <h1>Run agent-written Python as a <em>function call</em></h1>\n      <p class=\"position\">The sandbox is a function call.</p>\n      <p class=\"sub\">\n        pyex is a Python&nbsp;3 interpreter written in <b>Elixir</b>, built as an execution substrate for\n        agent loops. Sandboxed code never touches a Python runtime, a process, or your filesystem \u2014\n        it reaches an interpreter that sees only the <b>capabilities you pass in</b>.\n        Tenant boot: <b>microseconds</b>. Container cold start: seconds.\n      </p>\n      <div class=\"ctas\">\n        <a class=\"btn primary\" href=\"/play/\">Open the playground</a>\n        <a class=\"btn ghost\" href=\"https://hex.pm/packages/pyex\">{:pyex, \"~> 0.1\"}</a>\n      </div>\n\n      <pre class=\"block\" style=\"max-width: 780px; margin-left: auto; margin-right: auto;\"><span class=\"c\"># the whole pitch: the model emits Python, your tools are host functions,</span>\n<span class=\"c\"># isolation is deny-by-default \u2014 and it's all one function call.</span>\ntools = %{\n  <span class=\"s\">\"search\"</span> => {:builtin, fn [q] -> MyApp.Search.run(q) end},\n  <span class=\"s\">\"fetch\"</span>  => {:builtin, fn [url] -> MyApp.HTTP.get(url) end}\n}\n\n{:ok, result, ctx} = <span class=\"p\">Pyex.run</span>(code_the_model_wrote,\n  modules: %{<span class=\"s\">\"agent\"</span> => %{<span class=\"s\">\"tools\"</span> => tools}},\n  filesystem: %{<span class=\"s\">\"notes.md\"</span> => scratchpad},\n  limits: [timeout: 5_000, max_memory_bytes: 50_000_000])</pre>\n\n      <div class=\"demo-wrap\"><div class=\"demo\">\n        <div class=\"bar\">\n          <span class=\"dots\"><i></i><i></i><i></i></span>\n          <span>live \u2014 this very interpreter, compiled to WasmGC, in this page's Worker</span>\n          <span class=\"hint\">\u2318\u21b5</span>\n        </div>\n        <textarea id=\"code\" spellcheck=\"false\" aria-label=\"Python code\">a = b = 1                  # chained assignment, like real Python\nfibs = []\nwhile len(fibs) < 10:\n    fibs.append(a)\n    a, b = b, a + b        # tuple swap\n\nprint(f\"fib: {fibs}\")\nprint(f\"golden ratio \u2248 {b / a:.6f}\")</textarea>\n        <pre class=\"out\" id=\"out\"></pre>\n        <div class=\"foot\">\n          <button class=\"run\" id=\"run\">Run</button>\n          <span class=\"meta\" id=\"meta\">fresh sandbox per request \u00b7 deterministic step budget</span>\n        </div>\n      </div></div>\n    </header>\n\n    <section>\n      <p class=\"kicker\">why code mode needs a different shape</p>\n      <h2>Ten tool calls become one program.<br />Now who runs the program?</h2>\n      <p class=\"lede\">\n        Tool-calling agents pay one model round-trip per action. Code mode collapses ten tool calls into\n        one program \u2014 but now you're executing untrusted, model-written code on every step. The industry\n        answer is a VM per step, which reintroduces the latency you were removing and puts an RPC boundary\n        between the agent's code and every tool it calls. pyex's answer: <b>interpret the Python yourself,\n        in-process</b> \u2014 a step costs microseconds, and a tool call is a host function dispatch. No IPC, no\n        marshalling, no path from Python source to an OS process.\n      </p>\n      <div class=\"table-scroll\"><table>\n        <tr><th></th><th>Sandbox service / microVM</th><th>pyex</th></tr>\n        <tr><td>Start a run</td><td>seconds cold, or a warm pool to manage</td><td class=\"good\">~200 \u00b5s, no pool</td></tr>\n        <tr><td>Call a tool</td><td>HTTP/RPC round-trip</td><td class=\"good\">Elixir function dispatch</td></tr>\n        <tr><td>Keep agent state</td><td>serialize + ship</td><td class=\"good\">a value on your heap</td></tr>\n        <tr><td>Per-tenant cost</td><td>a VM</td><td class=\"good\">a struct</td></tr>\n      </table></div>\n    </section>\n\n    <section id=\"sandbox\">\n      <p class=\"kicker\">the trust boundary is a diff you can read</p>\n      <h2>Everything the program can see<br />is an argument.</h2>\n      <blockquote>\n        <code>open()</code> writes to the map you passed in. <code>requests.get</code> hits your allowlist.\n        There is no <code>os.exec</code> because it doesn't exist. And a static analyzer walks the compiled\n        BEAM code on every CI run and <b>fails the build</b> if anything under <code>lib/pyex</code>\n        references <code>File</code>, <code>Port</code>, <code>System.cmd</code>, <code>spawn</code>, or the\n        host environment. The sandbox guarantee is a CI gate, not a code-review promise.\n      </blockquote>\n      <pre class=\"block\"><span class=\"c\"># Deny by default. Every effect is a capability you chose to hand in.</span>\n<span class=\"p\">Pyex.run</span>(source,\n  filesystem: %{<span class=\"s\">\"data.json\"</span> => json},           <span class=\"c\"># open() sees only this</span>\n  network: [%{allowed_url_prefix: <span class=\"s\">\"https://api.example.com/\"</span>}],\n  env: %{<span class=\"s\">\"API_KEY\"</span> => key},                     <span class=\"c\"># injected, never in source</span>\n  limits: [timeout: 5_000, max_memory_bytes: 50_000_000])</pre>\n      <p class=\"lede\" style=\"margin-top: 22px\">\n        And every run returns an unforgeable <b>capability ledger</b> \u2014 an OpenTelemetry span tree of every\n        file, URL, and store the program touched, <b>even when it crashed</b>. Preview effects before they\n        happen: copy-on-write overlays stage <code>open(...).write</code> and <code>store.put</code> for\n        review, then <code>commit/1</code> applies exactly the run you approved \u2014 deterministic under a\n        seed, so there is no time-of-check/time-of-use gap.\n      </p>\n    </section>\n\n    <section>\n      <p class=\"kicker\">the loop itself is sandboxed</p>\n      <h2>Most sandboxes run the tool code.<br />pyex runs the controller.</h2>\n      <pre class=\"block\"><span class=\"c\"># The model wrote this. It runs 10 steps without a single</span>\n<span class=\"c\"># network hop between the code and the tools.</span>\n<span class=\"p\">import</span> json\n<span class=\"p\">from</span> agent <span class=\"p\">import</span> call_model, tools\n\nstate = {<span class=\"s\">\"steps\"</span>: []}\n<span class=\"p\">for</span> _ <span class=\"p\">in</span> range(10):\n    decision = call_model(state)\n    <span class=\"p\">if</span> decision[<span class=\"s\">\"action\"</span>] == <span class=\"s\">\"stop\"</span>:\n        <span class=\"p\">break</span>\n    result = tools[decision[<span class=\"s\">\"tool\"</span>]](*decision[<span class=\"s\">\"args\"</span>])\n    state[<span class=\"s\">\"steps\"</span>].append({<span class=\"s\">\"tool\"</span>: decision[<span class=\"s\">\"tool\"</span>], <span class=\"s\">\"result\"</span>: result})\n<span class=\"p\">print</span>(json.dumps(state))</pre>\n      <p class=\"lede\" style=\"margin-top: 22px\">\n        Generators are continuations, so a step can pause and resume without owning a process.\n        <code>asyncio.gather</code> interleaves like CPython. Retries, planners, eval harnesses \u2014 the loop\n        logic the model emits just runs.\n        See <a href=\"https://github.com/ivarvong/pyex/blob/main/examples/research_agent.py\" style=\"color:var(--accent2)\">examples/research_agent.py</a>\n        for the runnable proof.\n      </p>\n    </section>\n\n    <section id=\"numbers\">\n      <p class=\"kicker\">numbers, reproducibly</p>\n      <h2>The command is the marketing.</h2>\n      <div class=\"table-scroll\"><table>\n        <tr><th>Workload</th><th>p50</th><th>p99</th></tr>\n        <tr><td>FizzBuzz (100 iterations)</td><td class=\"num\">182 \u00b5s</td><td class=\"num\">238 \u00b5s</td></tr>\n        <tr><td>Algorithms suite (~150 LOC: sieve + sort + fib + stats)</td><td class=\"num\">1.67 ms</td><td class=\"num\">2.04 ms</td></tr>\n        <tr><td>FastAPI cold boot</td><td class=\"num\">221 \u00b5s</td><td class=\"num\">302 \u00b5s</td></tr>\n        <tr><td>FastAPI route \u2014 list + Jinja2 render</td><td class=\"num\">108 \u00b5s</td><td class=\"num\">166 \u00b5s</td></tr>\n        <tr><td>FastAPI route \u2014 404</td><td class=\"num\">9 \u00b5s</td><td class=\"num\">19 \u00b5s</td></tr>\n      </table></div>\n      <pre class=\"block\">mix run bench/readme_bench.exs</pre>\n      <p class=\"lede\" style=\"margin-top: 22px\">\n        The honest tradeoff: <b>10\u2013100\u00d7 slower than CPython for pure CPU work \u2014 and it doesn't matter</b>,\n        because agent steps are dominated by tool I/O, JSON shaping, and routing. Compute budgets exclude\n        I/O time: an agent waiting on a slow tool isn't killed for it; an infinite loop is.\n      </p>\n    </section>\n\n    <section>\n      <p class=\"kicker\">multi-tenancy</p>\n      <h2>A tenant is a value.</h2>\n      <p class=\"lede\">\n        A booted app is a struct on your heap. 100,000 tenants is a benchmark file\n        (<code>bench/multitenant_scaling_bench.exs</code>), not a capacity-planning meeting. Storage\n        multitenancy is an object boundary, not a <code>tenant_id</code> filter someone forgets.\n      </p>\n      <pre class=\"block\">{:ok, app}       = <span class=\"p\">Pyex.Lambda.boot</span>(model_generated_fastapi_source)\n{:ok, resp, app} = <span class=\"p\">Pyex.Lambda.handle</span>(app, %{method: <span class=\"s\">\"GET\"</span>, path: <span class=\"s\">\"/hello/world\"</span>})\n<span class=\"c\"># boot once, handle many; state threads through; tenants serialize like any value</span></pre>\n    </section>\n\n    <section>\n      <p class=\"kicker\">trust, itemized</p>\n      <h2>How we know it works.</h2>\n      <ul class=\"strip\">\n        <li><b>Differentially fuzzed against CPython</b> \u2014 outputs <i>and</i> exception types must match.</li>\n        <li><b>Byte-for-byte repr conformance</b> suite, plus fixture programs checked against CPython ground truth.</li>\n        <li><b>5,073 IBM dectest vectors</b> pass for <code>decimal</code>.</li>\n        <li><b>Property tests</b> assert malformed input never crashes the host \u2014 it returns a Python error.</li>\n        <li><b>Dialyzer-clean</b>, with <code>@spec</code> on the public surface; the banned-call tracer fails CI if the sandbox boundary regresses.</li>\n        <li><b>Real workloads as end-to-end tests</b>: a webhook handler, a DCF model, an SSR blog, a research agent.</li>\n      </ul>\n    </section>\n\n    <section>\n      <p class=\"kicker\">defense in depth</p>\n      <h2>Three layers, each named.</h2>\n      <p class=\"lede\">\n        <b>pyex stops the 99% cooperatively</b> \u2014 step, memory, and output budgets with clean Python errors.\n        <b>The BEAM stops the rest unconditionally</b> \u2014 run each guest in a monitored process with a\n        GC-enforced <code>max_heap_size</code> and a wall-clock kill\n        (<a href=\"https://github.com/ivarvong/pyex/blob/main/examples/sandbox_server.exs\" style=\"color:var(--accent2)\">examples/sandbox_server.exs</a>\n        is the copy-paste). <b>A microVM around the whole node stops the adversary.</b>\n        One ops property worth quoting: <b>the guest can't move your 5xx rate</b> \u2014 verdicts\n        (ok / error / timeout / OOM) are body fields; HTTP status describes only your service.\n      </p>\n      <div class=\"honest\">\n        <h3>What it isn't</h3>\n        <p>\n          pyex is a <b>hardened library, not a microVM</b>. Against a sophisticated adversary it composes\n          with stronger isolation rather than replacing it. It runs <b>the Python agents actually write</b> \u2014\n          <code>json</code>, <code>re</code>, <code>asyncio</code>, <code>pydantic</code>, <code>requests</code>,\n          <code>fastapi</code>, partial <code>pandas</code> \u2014 not all of CPython. And it's an interpreter:\n          pure CPU work runs 10\u2013100\u00d7 slower than CPython, which agent workloads don't notice. Naming our own\n          boundary is the point.\n        </p>\n      </div>\n    </section>\n\n    <div class=\"install\">\n      <h2>Your agent writes Python.<br />Run it on your heap.</h2>\n      <span class=\"dep\">{<span class=\"p\">:pyex</span>, \"~> 0.1\"}</span>\n      <div class=\"ctas\">\n        <a class=\"btn primary\" href=\"https://github.com/ivarvong/pyex\">Read the source</a>\n        <a class=\"btn ghost\" href=\"/play/\">Try it in your browser</a>\n      </div>\n    </div>\n\n    <footer>\n      <span>pyex \u2014 Python on the BEAM, on WasmGC</span>\n      <a href=\"/play/\">playground</a>\n      <a href=\"/support/\">conformance</a>\n      <a href=\"https://github.com/ivarvong/pyex\">ivarvong/pyex</a>\n      <a href=\"https://github.com/ivarvong/elixir_wasm\">ivarvong/elixir_wasm</a>\n    </footer>\n  </div>\n\n  <script>\n    const code = document.getElementById(\"code\"), out = document.getElementById(\"out\"),\n          meta = document.getElementById(\"meta\"), btn = document.getElementById(\"run\");\n    const post = () => fetch(\"/api/run\", { method: \"POST\", headers: { \"content-type\": \"text/plain\" }, body: code.value });\n    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n    async function postJSON() {\n      for (let i = 0; ; i++) {\n        try {\n          const res = await post();\n          if (res.status >= 500) throw new Error(\"edge \" + res.status);\n          return await res.json();\n        } catch (err) {\n          if (i >= 2) throw err;\n          await sleep(350 * (i + 1));\n        }\n      }\n    }\n    async function run() {\n      btn.disabled = true; meta.textContent = \"running\u2026\";\n      const t0 = performance.now();\n      try {\n        const j = await postJSON();\n        const wall = Math.round(performance.now() - t0);\n        out.classList.toggle(\"err\", !j.ok);\n        out.textContent = j.ok ? j.stdout.trimEnd() : j.error + (j.hint ? \"\\n(\" + j.hint + \")\" : \"\");\n        meta.textContent = j.ok\n          ? `${wall} ms round-trip \u00b7 ${(j.footprint[\":steps\"] ?? 0).toLocaleString()} steps`\n          : `failed clean in ${wall} ms \u2014 the sandbox holding`;\n      } catch {\n        out.classList.add(\"err\");\n        out.textContent = \"the edge hiccuped \u2014 press Run again\";\n        meta.textContent = \"\";\n      }\n      btn.disabled = false;\n    }\n    btn.addEventListener(\"click\", run);\n    code.addEventListener(\"keydown\", (e) => { if ((e.metaKey || e.ctrlKey) && e.key === \"Enter\") { e.preventDefault(); run(); } });\n  </script>\n</body>\n</html>\n", "erro": "", "ms": 877}