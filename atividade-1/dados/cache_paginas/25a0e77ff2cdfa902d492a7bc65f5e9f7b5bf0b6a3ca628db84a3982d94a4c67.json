0 bg-gray-800 border-t border-gray-700 px-4 py-3\">\n        <div class=\"container mx-auto max-w-4xl flex flex-col sm:flex-row items-center justify-between gap-3 text-sm\">\n            <p class=\"text-gray-300\">We use cookies for analytics to improve this site. <a href=\"https://api.mcpworks.io/v1/legal/privacy\" class=\"text-blue-400 hover:underline\">Privacy policy</a></p>\n            <div class=\"flex gap-2 shrink-0\">\n                <button id=\"consent-decline\" class=\"px-4 py-1.5 rounded border border-gray-600 text-gray-400 hover:text-white hover:border-gray-500 transition-colors\">Decline</button>\n                <button id=\"consent-accept\" class=\"px-4 py-1.5 rounded bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors\">Accept</button>\n            </div>\n        </div>\n    </div>\n    <script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script>\n    (function(){\n        var b=document.getElementById('consent-banner');\n        var c=localStorage.getItem('mcpworks_consent');\n        if(!c){b.style.display='block';}\n        document.getElementById('consent-accept').addEventListener('click',function(){\n            localStorage.setItem('mcpworks_consent','granted');\n            b.style.display='none';\n            var s=document.createElement('script');\n            s.async=true;\n            s.src='https://www.googletagmanager.com/gtag/js?id=G-RPC2YCKP6J';\n            document.head.appendChild(s);\n            window.dataLayer=window.dataLayer||[];\n            function gtag(){dataLayer.push(arguments);}\n            gtag('js',new Date());\n            gtag('config','G-RPC2YCKP6J');\n            window.gtag=gtag;\n        });\n        document.getElementById('consent-decline').addEventListener('click',function(){\n            localStorage.setItem('mcpworks_consent','denied');\n            b.style.display='none';\n        });\n    })();\n    </script>\n    <script>\n    (function(){\n        var btn=document.getElementById('mobile-menu-btn');\n        var menu=document.getElementById('mobile-menu');\n        if(btn&&menu){btn.addEventListener('click',function(){menu.classList.toggle('hidden');});}\n    })();\n    </script>\n</body>\n</html>\n", "erro": "", "ms": 1577}