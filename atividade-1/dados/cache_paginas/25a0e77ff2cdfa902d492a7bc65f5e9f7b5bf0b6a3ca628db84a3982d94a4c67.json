{"status": 200, "url_final": "https://www.mcpworks.io/", "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Open-Source AI Agent Runtime | MCPWorks</title>\n    <meta name=\"description\" content=\"MCPWorks is an open-source AI agent runtime built on MCP. Build persistent agents with scheduling, webhooks, encrypted state, and communication channels. Self-host free under BSL 1.1 or use MCPWorks Cloud. Secure nsjail sandbox, BYOAI, Python and TypeScript.\">\n\n    <!-- Open Graph -->\n    <meta property=\"og:title\" content=\"Open-Source AI Agent Runtime | MCPWorks\">\n    <meta property=\"og:description\" content=\"MCPWorks is an open-source AI agent runtime built on MCP. Build persistent agents with scheduling, webhooks, encrypted state, and communication channels. Self-host free under BSL 1.1 or use MCPWorks Cloud. Secure nsjail sandbox, BYOAI, Python and TypeScript.\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:url\" content=\"https://www.mcpworks.io/\">\n    <meta property=\"og:site_name\" content=\"MCPWorks\">\n    <meta property=\"og:image\" content=\"https://www.mcpworks.io/assets/images/og-default.png\">\n    <meta property=\"og:image:width\" content=\"1200\">\n    <meta property=\"og:image:height\" content=\"630\">\n\n    <!-- Twitter Card -->\n    <meta name=\"twitter:card\" content=\"summary_large_image\">\n    <meta name=\"twitter:title\" content=\"Open-Source AI Agent Runtime | MCPWorks\">\n    <meta name=\"twitter:description\" content=\"MCPWorks is an open-source AI agent runtime built on MCP. Build persistent agents with scheduling, webhooks, encrypted state, and communication channels. Self-host free under BSL 1.1 or use MCPWorks Cloud. Secure nsjail sandbox, BYOAI, Python and TypeScript.\">\n    <meta name=\"twitter:image\" content=\"https://www.mcpworks.io/assets/images/og-default.png\">\n\n    <!-- Canonical -->\n    <link rel=\"canonical\" href=\"https://www.mcpworks.io/\">\n\n    <!-- Robots -->\n    <meta name=\"robots\" content=\"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1\">\n\n    <!-- Preload / Prefetch -->\n    <link rel=\"preload\" href=\"/assets/css/styles.css\" as=\"style\">\n    <link rel=\"dns-prefetch\" href=\"https://api.mcpworks.io\">\n    <link rel=\"dns-prefetch\" href=\"https://modelcontextprotocol.io\">\n\n    <!-- Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap\" rel=\"stylesheet\">\n\n    <link rel=\"stylesheet\" href=\"/assets/css/styles.css\">\n\n    <!-- GA4 \u2014 loads only after PIPEDA cookie consent -->\n    <script>\n    (function(){\n        if(localStorage.getItem('mcpworks_consent')==='granted'){\n            var s=document.createElement('script');\n            s.async=true;\n            s.src='https://www.googletagmanager.com/gtag/js?id=G-RPC2YCKP6J';\n            document.head.appendChild(s);\n            window.dataLayer=window.dataLayer||[];\n            function gtag(){dataLayer.push(arguments);}\n            gtag('js',new Date());\n            gtag('config','G-RPC2YCKP6J');\n            window.gtag=gtag;\n        }\n    })();\n    </script>\n\n    \n    <script type=\"application/ld+json\">\n    {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"Organization\",\n        \"@id\": \"https://www.mcpworks.io/#organization\",\n        \"name\": \"MCPWorks\",\n        \"legalName\": \"MCPWorks Technologies Inc.\",\n        \"url\": \"https://www.mcpworks.io\",\n        \"description\": \"MCPWorks is an open-source AI agent runtime built on the Model Context Protocol (MCP). Build persistent, autonomous agents with scheduling, webhooks, encrypted state, and communication channels. Self-host free under BSL 1.1 or run on MCPWorks Cloud. Secure nsjail sandbox, BYOAI with 14+ LLM providers, Python and TypeScript. 70-98% fewer context tokens than standard MCP tool loading.\",\n        \"foundingDate\": \"2025\",\n        \"sameAs\": [\n            \"https://bsky.app/profile/mcpworks.io\",\n            \"https://github.com/MCPWorks-Technologies-Inc/mcpworks-api\",\n            \"https://www.linkedin.com/company/mcpworks\"\n        ],\n        \"knowsAbout\": [\n            {\n                \"@type\": \"Thing\",\n                \"name\": \"Model Context Protocol\",\n                \"sameAs\": \"https://www.wikidata.org/wiki/Q130901288\"\n            },\n            {\n                \"@type\": \"Thing\",\n                \"name\": \"AI Agent\",\n                \"sameAs\": \"https://www.wikidata.org/wiki/Q564872\"\n            },\n            {\n                \"@type\": \"Thing\",\n                \"name\": \"Software agent\",\n                \"sameAs\": \"https://www.wikidata.org/wiki/Q2297769\"\n            },\n            \"AI Agent Runtime\",\n            \"Open Source AI Infrastructure\",\n            \"Code Sandbox Execution\",\n            \"Self-Hosted AI Agents\",\n            \"Token Efficiency\"\n        ],\n        \"founder\": {\n            \"@type\": \"Person\",\n            \"name\": \"Simon Carr\",\n            \"sameAs\": [\n                \"https://www.linkedin.com/in/simoncarr/\",\n                \"https://github.com/simoncarr\"\n            ]\n        },\n        \"contactPoint\": {\n            \"@type\": \"ContactPoint\",\n            \"email\": \"hello@mcpworks.io\",\n            \"contactType\": \"sales\"\n        }\n    }\n    </script>\n    <script type=\"application/ld+json\">\n    {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"WebSite\",\n        \"@id\": \"https://www.mcpworks.io/#website\",\n        \"name\": \"MCPWorks\",\n        \"url\": \"https://www.mcpworks.io\",\n        \"publisher\": {\n            \"@id\": \"https://www.mcpworks.io/#organization\"\n        }\n    }\n    </script>\n    <script type=\"application/ld+json\">\n    {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"MCPWorks\",\n        \"@id\": \"https://www.mcpworks.io/#software\",\n        \"applicationCategory\": \"DeveloperApplication\",\n        \"applicationSubCategory\": \"AI Agent Runtime\",\n        \"operatingSystem\": \"Linux\",\n        \"description\": \"Open-source AI agent runtime for building and running persistent, autonomous agents with MCP (Model Context Protocol). Self-host free under BSL 1.1 or use MCPWorks Cloud. Secure nsjail sandbox, BYOAI with 14+ LLM providers, Python and TypeScript.\",\n        \"url\": \"https://www.mcpworks.io\",\n        \"offers\": [\n            {\n                \"@type\": \"Offer\",\n                \"name\": \"Community (Self-Hosted)\",\n                \"price\": \"0\",\n                \"priceCurrency\": \"USD\",\n                \"url\": \"https://github.com/MCPWorks-Technologies-Inc/mcpworks-api\",\n                \"description\": \"Full platform, self-hosted under BSL 1.1 (converts to Apache 2.0 after 4 years). Unlimited agents and executions on your own infrastructure.\"\n            },\n            {\n                \"@type\": \"Offer\",\n                \"name\": \"Cloud Pro\",\n                \"price\": \"179\",\n                \"priceCurrency\": \"USD\",\n                \"url\": \"https://www.mcpworks.io/pricing/\",\n                \"description\": \"Managed hosting on MCPWorks infrastructure. 5 agents, 250,000 executions/month, priority support. 14-day free trial.\"\n            },\n            {\n                \"@type\": \"Offer\",\n                \"name\": \"Cloud Enterprise\",\n                \"url\": \"https://www.mcpworks.io/pricing/\",\n                \"description\": \"20+ agents, 1,000,000 executions/month, SSO, audit logs, 99.9% SLA, Slack Connect support.\"\n            }\n        ]\n    }\n    </script>\n    <script type=\"application/ld+json\">\n    {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"FAQPage\",\n        \"mainEntity\": [\n            {\n                \"@type\": \"Question\",\n                \"name\": \"What is MCPWorks?\",\n                \"acceptedAnswer\": {\n                    \"@type\": \"Answer\",\n                    \"text\": \"MCPWorks is an open-source AI agent runtime built on the Model Context Protocol (MCP). The full platform \u2014 agent runtime, nsjail code sandbox, scheduling, webhooks, encrypted state, and communication channels \u2014 is released under BSL 1.1 (converts to Apache 2.0 after 4 years). Self-host for free with no limits, or use MCPWorks Cloud for managed hosting.\"\n                }\n            },\n            {\n                \"@type\": \"Question\",\n                \"name\": \"How is MCPWorks different from LangChain or CrewAI?\",\n                \"acceptedAnswer\": {\n                    \"@type\": \"Answer\",\n                    \"text\": \"MCPWorks is infrastructure, not a framework. LangChain and CrewAI provide SDKs \u2014 you still need to host, schedule, persist state, and manage secrets yourself. MCPWorks provides the runtime: your AI builds the agent through MCP tools, and MCPWorks handles the container, cron, webhooks, encrypted state, and communication channels.\"\n                }\n            },\n            {\n                \"@type\": \"Question\",\n                \"name\": \"Can MCPWorks agents run without an LLM?\",\n                \"acceptedAnswer\": {\n                    \"@type\": \"Answer\",\n                    \"text\": \"Yes. Automation mode runs functions on cron schedules and responds to webhooks with zero token cost. Autonomous mode adds an LLM brain for reasoning. BYOAI \u2014 connect your own API key from 14+ providers. MCPWorks never hosts or proxies AI.\"\n                }\n            }\n        ]\n    }\n    </script>\n    <script type=\"application/ld+json\">\n    {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"SoftwareSourceCode\",\n        \"name\": \"MCPWorks\",\n        \"codeRepository\": \"https://github.com/MCPWorks-Technologies-Inc/mcpworks-api\",\n        \"programmingLanguage\": [\"Python\", \"TypeScript\"],\n        \"license\": \"https://mariadb.com/bsl11/\",\n        \"runtimePlatform\": \"Docker\",\n        \"targetProduct\": {\n            \"@id\": \"https://www.mcpworks.io/#software\"\n        }\n    }\n    </script>\n    \n\n    \n</head>\n<body class=\"bg-gray-900 text-white min-h-screen flex flex-col font-body\">\n    <!-- Header -->\n    <header class=\"border-b border-gray-800 py-4\">\n        <div class=\"container mx-auto px-4 flex items-center justify-between\">\n            <a href=\"/\" class=\"flex items-baseline gap-2\">\n                <span class=\"text-2xl font-bold text-blue-500 font-display\">MCPWorks</span>\n                <span class=\"text-gray-500 text-sm hidden sm:inline\">Open Source</span>\n            </a>\n            <nav class=\"hidden md:flex items-center gap-5\">\n                <a href=\"/agents/\" class=\"text-gray-400 hover:text-white text-sm\">Agents</a>\n                <a href=\"/pricing/\" class=\"text-gray-400 hover:text-white text-sm\">Pricing</a>\n                <a href=\"/docs/\" class=\"text-gray-400 hover:text-white text-sm\">Docs</a>\n                <a href=\"/blog/\" class=\"text-gray-400 hover:text-white text-sm\">Blog</a>\n                <a href=\"https://github.com/MCPWorks-Technologies-Inc/mcpworks-api\" class=\"bg-white text-gray-900 text-sm font-medium px-4 py-2 rounded flex items-center gap-1.5 hover:bg-gray-100 transition-colors\" rel=\"noopener\">\n                    <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 .3a12 12 0 00-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016.02 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.44.38.82 1.12.82 2.26l-.01 3.35c0 .31.21.69.83.57A12 12 0 0012 .3z\"/></svg>\n                    Star on GitHub\n                </a>\n            </nav>\n            <button id=\"mobile-menu-btn\" class=\"md:hidden text-gray-400 hover:text-white p-1\" aria-label=\"Toggle menu\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"/></svg>\n            </button>\n        </div>\n        <div id=\"mobile-menu\" class=\"hidden md:hidden border-t border-gray-800 mt-4 pt-4 px-4\">\n            <nav class=\"flex flex-col gap-3 container mx-auto\">\n                <a href=\"/agents/\" class=\"text-gray-400 hover:text-white text-sm py-1\">Agents</a>\n                <a href=\"/pricing/\" class=\"text-gray-400 hover:text-white text-sm py-1\">Pricing</a>\n                <a href=\"/docs/\" class=\"text-gray-400 hover:text-white text-sm py-1\">Docs</a>\n                <a href=\"/blog/\" class=\"text-gray-400 hover:text-white text-sm py-1\">Blog</a>\n                <a href=\"/consulting/\" class=\"text-gray-400 hover:text-white text-sm py-1\">Consulting</a>\n                <a href=\"https://github.com/MCPWorks-Technologies-Inc/mcpworks-api\" class=\"text-gray-400 hover:text-white text-sm py-1 flex items-center gap-1.5\" rel=\"noopener\">\n                    <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 .3a12 12 0 00-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016.02 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.44.38.82 1.12.82 2.26l-.01 3.35c0 .31.21.69.83.57A12 12 0 0012 .3z\"/></svg>\n                    GitHub\n                </a>\n            </nav>\n        </div>\n    </header>\n\n    <!-- Main -->\n    <main class=\"flex-1\">\n        \n<!-- Hero -->\n<section class=\"py-20 md:py-28 bg-gray-900\">\n    <div class=\"container mx-auto px-4 max-w-6xl\">\n        <div class=\"grid md:grid-cols-2 gap-12 items-center\">\n            <div class=\"fade-in\">\n                <h1 class=\"text-4xl md:text-5xl font-bold leading-tight mb-6 font-display\">\n                    Describe it. Your AI builds it.<br>\n                    <span class=\"text-blue-500\">It runs forever.</span>\n                </h1>\n                <p class=\"text-xl text-gray-400 mb-4\">\n                    MCPWorks is an open-source AI agent runtime. Tell your AI assistant what to automate. It builds a persistent agent &mdash; with scheduling, webhooks, encrypted state, and communication channels &mdash; that runs 24/7 using 70-98% fewer tokens than standard MCP.\n                </p>\n                <p class=\"text-gray-500 mb-10\">\n                    Self-host free forever under <a href=\"https://mariadb.com/bsl11/\" class=\"text-blue-400/70 hover:underline\">BSL 1.1</a>. Or join the Cloud waitlist. Same software either way.\n                </p>\n                <div class=\"flex flex-col sm:flex-row gap-4\">\n                    <a href=\"https://github.com/MCPWorks-Technologies-Inc/mcpworks-api\" class=\"bg-white text-gray-900 font-medium px-8 py-3 rounded text-lg text-center flex items-center justify-center gap-2 hover:bg-gray-100 transition-colors\" rel=\"noopener\">\n                        <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 .3a12 12 0 00-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016.02 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.44.38.82 1.12.82 2.26l-.01 3.35c0 .31.21.69.83.57A12 12 0 0012 .3z\"/></svg>\n                        View on GitHub\n                    </a>\n                    <a href=\"/agents/\" class=\"border border-gray-600 hover:border-gray-400 text-gray-300 hover:text-white font-medium px-8 py-3 rounded text-lg text-center transition-colors\">\n                        See What Agents Can Do\n                    </a>\n                </div>\n            </div>\n            <div class=\"fade-in-delay\">\n                <div class=\"bg-gray-950 rounded-lg border border-gray-700 overflow-hidden shadow-2xl\">\n                    <div class=\"flex items-center gap-2 px-4 py-3 bg-gray-900 border-b border-gray-700\">\n                        <div class=\"w-3 h-3 rounded-full bg-red-500/80\"></div>\n                        <div class=\"w-3 h-3 rounded-full bg-yellow-500/80\"></div>\n                        <div class=\"w-3 h-3 rounded-full bg-green-500/80\"></div>\n                        <span class=\"text-gray-500 text-xs ml-2 font-mono\">claude-code</span>\n                    </div>\n                    <pre class=\"p-5 text-sm font-mono overflow-x-auto leading-relaxed\"><code><span class=\"text-gray-500\">$</span> <span class=\"text-blue-400\">claude</span> \"build me an ETH price agent\"\n\n<span class=\"text-green-400\">&#10003;</span> Created agent <span class=\"text-yellow-300\">ethwatch</span>\n<span class=\"text-green-400\">&#10003;</span> Created function <span class=\"text-yellow-300\">check-price</span>\n  <span class=\"text-gray-500\">&rarr; Python, monitors ETH price feed</span>\n<span class=\"text-green-400\">&#10003;</span> Scheduled every <span class=\"text-blue-400\">5 minutes</span>\n<span class=\"text-green-400\">&#10003;</span> Connected to <span class=\"text-blue-400\">#alerts</span> on Discord\n<span class=\"text-green-400\">&#10003;</span> AI engine: <span class=\"text-yellow-300\">Kimi K2.5</span> (your key)\n\n<span class=\"text-green-400\">&#10003;</span> Agent running. First check in 5m.\n\n<span class=\"text-gray-500\">3 hours later, on your phone:</span>\n<span class=\"text-blue-400\">ethwatch:</span> ETH dropped 6.8% in the last\nhour. Correlated with SEC filing on\nstaking regulations. Want me to dig\ndeeper?</code></pre>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- Works With -->\n<section class=\"py-10 border-y border-gray-800 bg-gray-900\">\n    <div class=\"container mx-auto px-4 max-w-6xl\">\n        <p class=\"text-gray-500 text-sm text-center mb-6\">Works with any client that supports the <a href=\"https://modelcontextprotocol.io/\" class=\"text-blue-400/70 hover:underline\">Model Context Protocol</a> (MCP) &mdash; the open standard adopted by <a href=\"https://developers.googleblog.com/en/gemini-now-supports-the-model-context-protocol/\" class=\"text-blue-400/70 hover:underline\">Google</a>, <a href=\"https://devblogs.microsoft.com/semantic-kernel/building-a-model-context-protocol-server-with-semantic-kernel/\" class=\"text-blue-400/70 hover:underline\">Microsoft</a>, and governed by the <a href=\"https://www.linuxfoundation.org/press/linux-foundation-announces-open-standard-for-ai-connectivity-through-model-context-protocol\" class=\"text-blue-400/70 hover:underline\">Linux Foundation</a></p>\n        <div class=\"flex flex-wrap justify-center items-center gap-8 md:gap-16\">\n            <span class=\"text-gray-400 font-semibold text-lg font-display\">Claude Code</span>\n            <span class=\"text-gray-400 font-semibold text-lg font-display\">GitHub Copilot</span>\n            <span class=\"text-gray-400 font-semibold text-lg font-display\">Cursor</span>\n            <span class=\"text-gray-400 font-semibold text-lg font-display\">Any MCP Client</span>\n        </div>\n    </div>\n</section>\n\n<!-- What Can Your Agents Do -->\n<section class=\"py-16 bg-gray-950\">\n    <div class=\"container mx-auto px-4 max-w-5xl\">\n        <h2 class=\"text-2xl font-bold text-center mb-4 font-display\">What can you build with MCPWorks?</h2>\n        <p class=\"text-gray-400 text-center max-w-3xl mx-auto mb-12\">\n            MCPWorks agents are persistent, autonomous processes that run 24/7. Each agent has its own container, schedule, encrypted state, and communication channels. Describe the automation to your AI &mdash; it builds the agent for you.\n        </p>\n        <div class=\"grid md:grid-cols-3 gap-6\">\n            <div class=\"bg-gray-800 rounded-lg p-6 border border-gray-700\">\n                <p class=\"text-green-400 text-xs font-semibold mb-3 uppercase tracking-wider\">Automation &middot; Cron &middot; Discord</p>\n                <h3 class=\"font-semibold text-lg mb-2\">Competitor Price Monitor</h3>\n                <p class=\"text-gray-400 text-sm mb-3\">\n                    Track competitor pricing every hour. Get a Discord alert when anything changes. No AI needed &mdash; pure automation, $0 tokens.\n                </p>\n                <p class=\"text-gray-600 text-xs italic\">\"Build me an agent that monitors competitor pricing and alerts me on Discord.\"</p>\n            </div>\n            <div class=\"bg-gray-800 rounded-lg p-6 border border-purple-900/50\">\n                <p class=\"text-purple-400 text-xs font-semibold mb-3 uppercase tracking-wider\">Autonomous &middot; Webhook &middot; Discord</p>\n                <h3 class=\"font-semibold text-lg mb-2\">GitHub Issue Triage</h3>\n                <p class=\"text-gray-400 text-sm mb-3\">\n                    When a new issue lands, the agent reads it, labels it by severity, drafts a response, and posts a summary to Discord. Uses your own OpenAI key.\n                </p>\n                <p class=\"text-gray-600 text-xs italic\">\"Build an agent that triages GitHub issues and labels them automatically.\"</p>\n            </div>\n            <div class=\"bg-gray-800 rounded-lg p-6 border border-gray-700\">\n                <p class=\"text-green-400 text-xs font-semibold mb-3 uppercase tracking-wider\">Automation &middot; Cron &middot; Email</p>\n                <h3 class=\"font-semibold text-lg mb-2\">Daily Revenue Report</h3>\n                <p class=\"text-gray-400 text-sm mb-3\">\n                    Pull yesterday's Stripe revenue, format a clean summary, email it to your team at 7am. Runs every morning. No AI needed.\n                </p>\n                <p class=\"text-gray-600 text-xs italic\">\"Build me an agent that emails daily Stripe revenue summaries at 7am.\"</p>\n            </div>\n        </div>\n        <p class=\"text-center mt-8\">\n            <a href=\"/agents/\" class=\"text-blue-400 hover:text-blue-300 text-sm font-medium\">\n                See everything agents can do &rarr;\n            </a>\n        </p>\n    </div>\n</section>\n\n<!-- How It Works -->\n<section class=\"py-16 bg-gray-900\">\n    <div class=\"container mx-auto px-4 max-w-4xl\">\n        <h2 class=\"text-2xl font-bold text-center mb-4 font-display\">How do you build an AI agent with MCP?</h2>\n        <p class=\"text-gray-400 text-center max-w-3xl mx-auto mb-12\">\n            Building an AI agent with MCPWorks takes three steps: clone the repo, describe what you want, and your agent runs autonomously. Your AI assistant handles the code &mdash; you describe the outcome.\n        </p>\n        <div class=\"grid md:grid-cols-3 gap-8\">\n            <div class=\"text-center\">\n                <div class=\"text-3xl font-bold text-blue-500 mb-3\">1</div>\n                <h3 class=\"font-semibold mb-2\">Clone or connect</h3>\n                <p class=\"text-gray-400 text-sm\">\n                    Self-host with <code class=\"bg-gray-800 px-1.5 py-0.5 rounded text-blue-400 text-xs\">docker compose up</code> or connect to MCPWorks Cloud. Add the MCP server to your AI assistant's config &mdash; one JSON block.\n                </p>\n            </div>\n            <div class=\"text-center\">\n                <div class=\"text-3xl font-bold text-blue-500 mb-3\">2</div>\n                <h3 class=\"font-semibold mb-2\">Describe what you want</h3>\n                <p class=\"text-gray-400 text-sm\">\n                    Tell your AI assistant what to automate in plain language. It creates the agent, writes the functions in Python or TypeScript, sets the schedule, and connects your channels.\n                </p>\n            </div>\n            <div class=\"text-center\">\n                <div class=\"text-3xl font-bold text-blue-500 mb-3\">3</div>\n                <h3 class=\"font-semibold mb-2\">Your agent runs 24/7</h3>\n                <p class=\"text-gray-400 text-sm\">\n                    The agent runs on a schedule, responds to webhooks, and messages you on Discord, Slack, or email. Update it anytime by talking to your AI.\n                </p>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- Why MCPWorks Agents Cost Less -->\n<section class=\"py-16 bg-gray-950\">\n    <div class=\"container mx-auto px-4 max-w-4xl\">\n        <h2 class=\"text-2xl font-bold text-center mb-4 font-display\">Why do MCPWorks agents cost less to run?</h2>\n        <p class=\"text-gray-400 text-center max-w-3xl mx-auto mb-10\">\n            Standard MCP tool calls load schemas into context, burning tokens on boilerplate the model already understands. MCPWorks agents write code in a secure sandbox instead &mdash; data stays in the sandbox, never enters context. Same capabilities, 70-98% fewer tokens.\n        </p>\n        <div class=\"grid md:grid-cols-3 gap-6 text-center mb-8\">\n            <div class=\"bg-gray-800 rounded-lg p-6 border border-gray-700\">\n                <p class=\"text-3xl font-bold text-red-400 mb-2\">40,000+</p>\n                <p class=\"text-gray-400 text-sm\">tokens per tool call with standard MCP</p>\n            </div>\n            <div class=\"bg-gray-800 rounded-lg p-6 border border-green-900/50\">\n                <p class=\"text-3xl font-bold text-green-400 mb-2\">70-98%</p>\n                <p class=\"text-gray-400 text-sm\">reduction with MCPWorks code-mode</p>\n            </div>\n            <div class=\"bg-gray-800 rounded-lg p-6 border border-gray-700\">\n                <p class=\"text-3xl font-bold text-blue-400 mb-2\">$0</p>\n                <p class=\"text-gray-400 text-sm\">to self-host. Your hardware, your savings.</p>\n            </div>\n        </div>\n        <div class=\"text-center\">\n            <p class=\"text-gray-500 text-sm\">Free to self-host. Cloud from $179/mo. <a href=\"/pricing/\" class=\"text-blue-400 hover:text-blue-300\">See pricing &rarr;</a></p>\n        </div>\n    </div>\n</section>\n\n<!-- FAQ -->\n<section class=\"py-16 bg-gray-900\">\n    <div class=\"container mx-auto px-4 max-w-3xl\">\n        <h2 class=\"text-2xl font-bold text-center mb-10 font-display\">Frequently Asked Questions</h2>\n        <div class=\"space-y-6\">\n            <details class=\"group bg-gray-800 rounded-lg border border-gray-700 open:border-gray-600\" open>\n                <summary class=\"flex items-center justify-between cursor-pointer p-5 font-semibold\">\n                    What is MCPWorks?\n                    <span class=\"text-gray-500 group-open:rotate-45 transition-transform text-xl\">+</span>\n                </summary>\n                <div class=\"px-5 pb-5 text-gray-400 text-sm\">\n                    <p>MCPWorks is an open-source AI agent runtime built on the Model Context Protocol (MCP). The full platform &mdash; agent runtime, nsjail code sandbox, scheduling, webhooks, encrypted state, and communication channels &mdash; is released under BSL 1.1 (converts to Apache 2.0 after 4 years). Self-host for free with no limits, or use MCPWorks Cloud for managed hosting.</p>\n                </div>\n            </details>\n            <details class=\"group bg-gray-800 rounded-lg border border-gray-700 open:border-gray-600\">\n                <summary class=\"flex items-center justify-between cursor-pointer p-5 font-semibold\">\n                    How is MCPWorks different from LangChain or CrewAI?\n                    <span class=\"text-gray-500 group-open:rotate-45 transition-transform text-xl\">+</span>\n                </summary>\n                <div class=\"px-5 pb-5 text-gray-400 text-sm\">\n                    <p>MCPWorks is infrastructure, not a framework. LangChain and CrewAI provide SDKs &mdash; you still need to host, schedule, persist state, and manage secrets yourself. MCPWorks provides the runtime: your AI builds the agent through MCP tools, and MCPWorks handles the container, cron, webhooks, encrypted state, and communication channels.</p>\n                </div>\n            </details>\n            <details class=\"group bg-gray-800 rounded-lg border border-gray-700 open:border-gray-600\">\n                <summary class=\"flex items-center justify-between cursor-pointer p-5 font-semibold\">\n                    Can agents run without an LLM?\n                    <span class=\"text-gray-500 group-open:rotate-45 transition-transform text-xl\">+</span>\n                </summary>\n                <div class=\"px-5 pb-5 text-gray-400 text-sm\">\n                    <p>Yes. Automation mode runs functions on cron schedules and responds to webhooks with zero token cost. Autonomous mode adds an LLM brain for reasoning. BYOAI &mdash; connect your own API key from 14+ providers. MCPWorks never hosts or proxies AI.</p>\n                </div>\n            </details>\n        </div>\n    </div>\n</section>\n\n<!-- Final CTA -->\n<section id=\"waitlist\" class=\"py-20 bg-gray-950\">\n    <div class=\"container mx-auto px-4 max-w-4xl text-center\">\n        <h2 class=\"text-3xl font-bold mb-4 font-display\">Your first agent is one conversation away.</h2>\n        <p class=\"text-gray-400 mb-8 max-w-lg mx-auto\">\n            Clone the repo and self-host in 5 minutes. Or join the Cloud waitlist for first access when managed hosting launches.\n        </p>\n        <div class=\"flex flex-col sm:flex-row gap-4 justify-center\">\n            <a href=\"https://github.com/MCPWorks-Technologies-Inc/mcpworks-api\" class=\"bg-white text-gray-900 font-medium px-8 py-3 rounded text-lg flex items-center justify-center gap-2 hover:bg-gray-100 transition-colors\" rel=\"noopener\">\n                <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 .3a12 12 0 00-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016.02 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.44.38.82 1.12.82 2.26l-.01 3.35c0 .31.21.69.83.57A12 12 0 0012 .3z\"/></svg>\n                Clone the Repo\n            </a>\n            <a href=\"/agents/\" class=\"border border-gray-600 hover:border-gray-400 text-gray-300 hover:text-white font-medium px-8 py-3 rounded text-lg transition-colors text-center\">\n                Explore Agents\n            </a>\n        </div>\n        <div class=\"mt-10 pt-8 border-t border-gray-800 max-w-lg mx-auto\">\n            <p class=\"text-gray-500 text-sm mb-3\">Get Cloud launch updates and token efficiency research:</p>\n            <form action=\"https://buttondown.com/api/emails/embed-subscribe/mcpworks\"\n                  method=\"post\" referrerpolicy=\"unsafe-url\"\n                  class=\"embeddable-buttondown-form flex flex-col sm:flex-row gap-2 justify-center\">\n                <input type=\"email\" name=\"email\" id=\"bd-email-cta\" placeholder=\"you@example.com\" required\n                       class=\"bg-gray-800 border border-gray-700 rounded px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-colors text-sm\">\n                <button type=\"submit\"\n                        class=\"bg-gray-700 hover:bg-gray-600 text-white font-medium px-5 py-2.5 rounded transition-colors whitespace-nowrap text-sm\">\n                    Subscribe\n                </button>\n            </form>\n        </div>\n        <p class=\"text-gray-600 text-xs mt-8\">Last updated: <time datetime=\"2026-04-09\">April 9, 2026</time></p>\n    </div>\n</section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"border-t border-gray-800 bg-gray-950 pt-12 pb-8 mt-16\">\n        <div class=\"container mx-auto px-4 max-w-6xl\">\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-8 mb-10\">\n                <div class=\"col-span-2 md:col-span-1\">\n                    <p class=\"text-lg font-bold text-blue-500 font-display mb-2\">MCPWorks</p>\n                    <p class=\"text-gray-500 text-sm\">Open-source AI agent runtime</p>\n                </div>\n                <div>\n                    <p class=\"text-sm font-semibold text-gray-300 mb-3\">Product</p>\n                    <ul class=\"space-y-2 text-sm\">\n                        <li><a href=\"/agents/\" class=\"text-gray-500 hover:text-gray-300\">Agents</a></li>\n                        <li><a href=\"/pricing/\" class=\"text-gray-500 hover:text-gray-300\">Pricing</a></li>\n                        <li><a href=\"/consulting/\" class=\"text-gray-500 hover:tex