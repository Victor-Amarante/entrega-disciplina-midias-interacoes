{"status": 200, "url_final": "https://qurt.ai/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Qurt \u2014 Your AI coworker, powered by every model</title>\n    <meta name=\"description\" content=\"Qurt \u2014 Your AI coworker powered by every model. Researches the web, writes drafts, runs commands, reads your files. No subscription. No lock-in.\" />\n    <meta name=\"author\" content=\"Yelaman Abdullin\" />\n    <meta name=\"keywords\" content=\"AI assistant, AI coworker, desktop AI, ChatGPT alternative, Claude, GPT, open source AI, multi-model AI, agent mode\" />\n    <link rel=\"canonical\" href=\"https://qurt.ai/\" />\n    <meta name=\"theme-color\" content=\"#121212\" />\n    <meta name=\"color-scheme\" content=\"dark\" />\n    <meta name=\"robots\" content=\"index, follow\" />\n    <meta name=\"format-detection\" content=\"telephone=no, email=no\" />\n    <meta name=\"referrer\" content=\"strict-origin-when-cross-origin\" />\n    <!-- Open Graph -->\n    <meta property=\"og:title\" content=\"Qurt \u2014 Your AI coworker, powered by every model\" />\n    <meta property=\"og:description\" content=\"Researches the web, writes drafts, runs commands, reads your files. No subscription. No lock-in. Just your API keys and the best AI available.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://qurt.ai/\" />\n    <meta property=\"og:image\" content=\"https://qurt.ai/assets/icon.png\" />\n    <meta property=\"og:image:width\" content=\"512\" />\n    <meta property=\"og:image:height\" content=\"512\" />\n    <meta property=\"og:image:alt\" content=\"Qurt \u2014 Your AI coworker, powered by every model\" />\n    <meta property=\"og:site_name\" content=\"Qurt\" />\n    <meta property=\"og:locale\" content=\"en_US\" />\n    <!-- Twitter Card -->\n    <meta name=\"twitter:card\" content=\"summary\" />\n    <meta name=\"twitter:title\" content=\"Qurt \u2014 Your AI coworker, powered by every model\" />\n    <meta name=\"twitter:description\" content=\"Researches the web, writes drafts, runs commands, reads your files. No subscription. No lock-in. Just your API keys and the best AI available.\" />\n    <meta name=\"twitter:image\" content=\"https://qurt.ai/assets/icon.png\" />\n    <meta name=\"twitter:image:alt\" content=\"Qurt \u2014 Your AI coworker, powered by every model\" />\n    <link rel=\"icon\" type=\"image/png\" href=\"assets/icon.png\" />\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"Qurt\",\n      \"description\": \"AI coworker powered by every model. Researches the web, writes drafts, runs commands, reads your files. No subscription. No lock-in.\",\n      \"url\": \"https://qurt.ai/\",\n      \"applicationCategory\": \"DesktopApplication\",\n      \"operatingSystem\": \"Windows, macOS\",\n      \"offers\": { \"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\" },\n      \"author\": { \"@type\": \"Person\", \"name\": \"Yelaman Abdullin\", \"url\": \"https://github.com/eabdullin\" }\n    }\n    </script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\" />\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n    <style>\n      /* Page load animations */\n      body {\n        opacity: 0;\n        animation: fadeIn 1.6s ease-out forwards;\n      }\n      @keyframes fadeIn {\n        from { opacity: 0; }\n        to { opacity: 1; }\n      }\n      .hero {\n        opacity: 0;\n        animation: slideUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;\n        animation-delay: 0.1s;\n      }\n      .nav {\n        animation: slideDown 0.6s ease-out forwards;\n      }\n      @keyframes slideUp {\n        from { opacity: 0; transform: translateY(20px); }\n        to { opacity: 1; transform: translateY(0); }\n      }\n      @keyframes slideDown {\n        from { opacity: 0; transform: translateY(-20px); }\n        to { opacity: 1; transform: translateY(0); }\n      }\n      @keyframes float {\n        0% { transform: translateY(0px); }\n        50% { transform: translateY(-12px); }\n        100% { transform: translateY(0px); }\n      }\n      .screenshot-frame {\n        animation: float 6s ease-in-out infinite;\n      }\n    </style>\n  </head>\n  <body>\n    <!-- Header -->\n    <header class=\"header\">\n      <nav class=\"nav\">\n        <a href=\"#\" class=\"logo\">\n          <img src=\"assets/logo.horiz.png\" alt=\"Qurt\" />\n        </a>\n        <div class=\"nav-actions\">\n          <a href=\"https://github.com/eabdullin/qurt/releases/latest\" class=\"btn btn-primary btn-small\" data-dl-nav data-dl-label-windows=\"Download for Windows\" data-dl-label-macos=\"Download for macOS\">\n            <svg class=\"btn-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"/></svg>\n            <span class=\"btn-text\">Download</span>\n          </a>\n          <a href=\"https://github.com/eabdullin/qurt\" class=\"btn btn-outline btn-small\" target=\"_blank\" rel=\"noopener\">\n            <svg class=\"btn-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\"/></svg>\n            View GitHub\n          </a>\n        </div>\n      </nav>\n    </header>\n\n    <main>\n      <!-- Hero -->\n      <section class=\"hero\">\n        <div class=\"hero-badge\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n          Open source\n        </div>\n        <h1 class=\"hero-title\">\n          Your AI coworker <br />\n          <span class=\"hero-title-accent\">powered by every model.</span>\n        </h1>\n        <p class=\"hero-subtitle\">\n          Researches the web, writes drafts, runs terminal commands, reads your files.\n          No subscription. No lock-in. Just your API keys and the best AI available.\n        </p>\n        <div class=\"hero-actions\">\n          <a href=\"https://github.com/eabdullin/qurt/releases/latest\" class=\"btn btn-primary btn-large\" data-dl=\"windows\">\n            <svg class=\"btn-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 5.548l7.066-0.964 0.003 6.818-7.062 0.04L3 5.548zm7.063 6.632l0.006 6.826-7.063-0.972V12.14l7.057 0.04zm0.857-7.72L21 3v8.373l-10.08 0.08V4.46zm10.083 7.96L21 20.996l-10.08-1.424-0.014-7.114L21.003 12.42z\"/></svg>\n            Download for Windows\n          </a>\n          <a href=\"https://github.com/eabdullin/qurt/releases/latest\" class=\"btn btn-outline btn-large\" data-dl=\"macos\">\n            <svg class=\"btn-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.71 19.5c-0.83 1.24-1.71 2.45-3.05 2.47-1.34 0.03-1.77-0.79-3.29-0.79-1.53 0-2 0.77-3.27 0.82-1.31 0.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c0.87-1.52 2.43-2.48 4.12-2.51 1.28-0.02 2.5 0.87 3.29 0.87 0.78 0 2.26-1.07 3.8-0.91 0.65 0.03 2.47 0.26 3.64 1.98-0.09 0.06-2.17 1.28-2.15 3.81 0.03 3.02 2.65 4.03 2.68 4.04-0.03 0.07-0.42 1.44-1.38 2.83M13 3.5c0.73-0.83 1.94-1.46 2.94-1.5 0.13 1.17-0.34 2.35-1.04 3.19-0.69 0.84-1.83 1.5-2.95 1.42-0.15-1.15 0.41-2.35 1.05-3.11z\"/></svg>\n            Download for macOS\n          </a>\n        </div>\n        <p class=\"hero-platforms\">Available for Windows &amp; macOS</p>\n\n        <!-- App screenshot placeholder -->\n        <div class=\"hero-screenshot\">\n          <div class=\"screenshot-frame\">\n            <div class=\"screenshot-titlebar\">\n              <span class=\"screenshot-dot\"></span>\n              <span class=\"screenshot-dot\"></span>\n              <span class=\"screenshot-dot\"></span>\n            </div>\n            <div class=\"screenshot-body\">\n              <img src=\"assets/screenshots/hero-app.png\"/>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Provider strip -->\n      <section class=\"providers\">\n        <p class=\"providers-label\">Works with the models you already use</p>\n        <div class=\"providers-strip\">\n          <div class=\"provider-item\">\n            <img src=\"assets/openai.svg\" alt=\"OpenAI\" />\n          </div>\n          <div class=\"provider-item\">\n            <img src=\"assets/anthropic.svg\" alt=\"Anthropic\" />\n          </div>\n          <div class=\"provider-item\">\n            <img src=\"assets/google.svg\" alt=\"Google\" />\n          </div>\n          <div class=\"provider-item\">\n            <img src=\"assets/xai.svg\" alt=\"xAI\" />\n          </div>\n        </div>\n      </section>\n\n      <!-- Features -->\n      <section id=\"features\" class=\"features\">\n        <div class=\"section-header\">\n          <span class=\"section-label\">Features</span>\n          <h2 class=\"section-title\">Built for provider freedom</h2>\n          <p class=\"section-subtitle\">\n            Use the best model for each task. Switch providers without switching apps. Keep full control over your API keys and data.\n          </p>\n        </div>\n\n        <div class=\"feature-grid\">\n          <article class=\"feature-card feature-card-highlight\">\n            <div class=\"feature-icon\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4\"/></svg>\n            </div>\n            <h3>Bring your own keys</h3>\n            <p>Connect your API keys directly. No middleman subscription, no vendor lock-in. You pay providers at cost and switch any time.</p>\n          </article>\n          <article class=\"feature-card\">\n            <div class=\"feature-icon feature-icon-purple\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"/><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"/></svg>\n            </div>\n            <h3>Desktop-native</h3>\n            <p>A real app on your machine \u2014 not a browser tab. Fast, private, always available.</p>\n          </article>\n          <article class=\"feature-card\">\n            <div class=\"feature-icon feature-icon-green\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            </div>\n            <h3>Private by default</h3>\n            <p>Chats, keys, and files stay on your machine. Nothing is stored on our servers. Ever.</p>\n          </article>\n          <article class=\"feature-card\">\n            <div class=\"feature-icon feature-icon-orange\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48\"/></svg>\n            </div>\n            <h3>Attach anything</h3>\n            <p>Drop files and images into your chats. Get analysis, summaries, and answers grounded in your content.</p>\n          </article>\n        </div>\n      </section>\n\n      <!-- Model selector showcase -->\n      <section class=\"showcase\">\n        <div class=\"showcase-split\">\n          <div class=\"showcase-text\">\n            <span class=\"section-label\">Multi-provider</span>\n            <h2 class=\"showcase-title\">One app, every model</h2>\n            <p class=\"showcase-desc\">\n              GPT-5.2, Claude Opus 4.6, Gemini 3.1 Pro, Grok 4 \u2014 <span class=\"showcase-more\">and many more to come</span> \u2014 all accessible from a single model selector.\n              Tune reasoning effort per task. Compare outputs across providers.\n            </p>\n            <ul class=\"showcase-list\">\n              <li>\n                <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n                Switch models without switching apps\n              </li>\n              <li>\n                <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n                Adjust reasoning effort per message\n              </li>\n              <li>\n                <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n                New models added regularly\n              </li>\n            </ul>\n          </div>\n          <div class=\"showcase-visual\">\n            <div class=\"screenshot-frame screenshot-frame-small\">\n              <div class=\"screenshot-titlebar\">\n                <span class=\"screenshot-dot\"></span>\n                <span class=\"screenshot-dot\"></span>\n                <span class=\"screenshot-dot\"></span>\n              </div>\n              <div class=\"screenshot-body\">\n                <img src=\"assets/screenshots/model-selector.png\"/>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Agent mode -->\n      <section id=\"agent\" class=\"agent-section\">\n        <div class=\"showcase-split showcase-split-reverse\">\n          <div class=\"showcase-text\">\n            <span class=\"section-label section-label-orange\">Agent mode</span>\n            <h2 class=\"showcase-title\">Beyond chat</h2>\n            <p class=\"showcase-desc\">\n              Agent mode gives AI hands: browse the web, run terminal commands, and edit files \u2014 all within a controlled environment. Review every action before it runs.\n            </p>\n            <div class=\"agent-tools\">\n              <div class=\"agent-tool\">\n                <div class=\"agent-tool-icon\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"/><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/></svg>\n                </div>\n                <div>\n                  <strong>Web search</strong>\n                  <span>Real-time search across providers</span>\n                </div>\n              </div>\n              <div class=\"agent-tool\">\n                <div class=\"agent-tool-icon\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"4 17 10 11 4 5\"/><line x1=\"12\" y1=\"19\" x2=\"20\" y2=\"19\"/></svg>\n                </div>\n                <div>\n                  <strong>Terminal</strong>\n                  <span>Workspace-restricted commands</span>\n                </div>\n              </div>\n              <div class=\"agent-tool\">\n                <div class=\"agent-tool-icon\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"/><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"/></svg>\n                </div>\n                <div>\n                  <strong>Browser</strong>\n                  <span>Controlled web automation</span>\n                </div>\n              </div>\n              <div class=\"agent-tool\">\n                <div class=\"agent-tool-icon\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"/><polyline points=\"14 2 14 8 20 8\"/></svg>\n                </div>\n                <div>\n                  <strong>File editing</strong>\n                  <span>Patch files with checkpoint revert</span>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"showcase-visual\">\n            <div class=\"screenshot-frame screenshot-frame-small\">\n              <div class=\"screenshot-titlebar\">\n                <span class=\"screenshot-dot\"></span>\n                <span class=\"screenshot-dot\"></span>\n                <span class=\"screenshot-dot\"></span>\n              </div>\n              <div class=\"screenshot-body\">\n                <img src=\"assets/screenshots/agent-mode.png\"/>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- How it works -->\n      <section class=\"steps\">\n        <div class=\"section-header\">\n          <span class=\"section-label\">Get started</span>\n          <h2 class=\"section-title\">Up and running in 30 seconds</h2>\n        </div>\n        <div class=\"steps-grid\">\n          <div class=\"step\">\n            <div class=\"step-number\">1</div>\n            <h3>Download Qurt</h3>\n            <p>Grab the installer for your platform. No account needed.</p>\n          </div>\n          <div class=\"step-arrow\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg>\n          </div>\n          <div class=\"step\">\n            <div class=\"step-number\">2</div>\n            <h3>Add an API key</h3>\n            <p>Paste a key from any supported provider. Takes seconds.</p>\n          </div>\n          <div class=\"step-arrow\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg>\n          </div>\n          <div class=\"step\">\n            <div class=\"step-number\">3</div>\n            <h3>Start chatting</h3>\n            <p>Pick a model, attach files, and get to work.</p>\n          </div>\n        </div>\n      </section>\n\n      <!-- Open source -->\n      <section class=\"opensource\">\n        <div class=\"opensource-card\">\n          <div class=\"opensource-content\">\n            <svg class=\"opensource-icon\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\"/></svg>\n            <h2>Open source, transparent, yours</h2>\n            <p>\n              Qurt is open source. We're actively working on improvements \u2014 read the code, file issues, contribute features.\n              No proprietary lock-in \u2014 the app belongs to its users.\n            </p>\n            <a href=\"https://github.com/eabdullin/qurt\" class=\"btn btn-outline\" target=\"_blank\" rel=\"noopener\">\n              <svg class=\"btn-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\"/></svg>\n              View on GitHub\n            </a>\n          </div>\n        </div>\n      </section>\n\n      <!-- Final CTA -->\n      <section class=\"cta\">\n        <h2 class=\"cta-title\">Ready to try Qurt?</h2>\n        <p class=\"cta-subtitle\">Free, open source, and yours to keep.</p>\n        <div class=\"cta-buttons\">\n          <a href=\"https://github.com/eabdullin/qurt/releases/latest\" class=\"btn btn-primary btn-large\" data-dl=\"windows\">\n            <svg class=\"btn-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 5.548l7.066-0.964 0.003 6.818-7.062 0.04L3 5.548zm7.063 6.632l0.006 6.826-7.063-0.972V12.14l7.057 0.04zm0.857-7.72L21 3v8.373l-10.08 0.08V4.46zm10.083 7.96L21 20.996l-10.08-1.424-0.014-7.114L21.003 12.42z\"/></svg>\n            Download for Windows\n          </a>\n          <a href=\"https://github.com/eabdullin/qurt/releases/latest\" class=\"btn btn-outline btn-large\" data-dl=\"macos\">\n            <svg class=\"btn-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.71 19.5c-0.83 1.24-1.71 2.45-3.05 2.47-1.34 0.03-1.77-0.79-3.29-0.79-1.53 0-2 0.77-3.27 0.82-1.31 0.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c0.87-1.52 2.43-2.48 4.12-2.51 1.28-0.02 2.5 0.87 3.29 0.87 0.78 0 2.26-1.07 3.8-0.91 0.65 0.03 2.47 0.26 3.64 1.98-0.09 0.06-2.17 1.28-2.15 3.81 0.03 3.02 2.65 4.03 2.68 4.04-0.03 0.07-0.42 1.44-1.38 2.83M13 3.5c0.73-0.83 1.94-1.46 2.94-1.5 0.13 1.17-0.34 2.35-1.04 3.19-0.69 0.84-1.83 1.5-2.95 1.42-0.15-1.15 0.41-2.35 1.05-3.11z\"/></svg>\n            Download for macOS\n          </a>\n        </div>\n      </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n      <div class=\"footer-inner\">\n        <div class=\"footer-brand\">\n          <img src=\"assets/logo.horiz.png\" alt=\"Qurt\" class=\"footer-logo\" />\n          <p class=\"footer-tagline\">Your AI coworker, powered by every model.</p>\n        </div>\n        <div class=\"footer-links\">\n          <div class=\"footer-col\">\n            <h4>Product</h4>\n            <a href=\"https://github.com/eabdullin/qurt/releases/latest\" data-dl-footer>Download</a>\n            <a href=\"#features\">Features</a>\n            <a href=\"#agent\">Agent mode</a>\n          </div>\n          <div class=\"footer-col\">\n            <h4>Resources</h4>\n            <a href=\"https://github.com/eabdullin/qurt\" target=\"_blank\" rel=\"noopener\">GitHub</a>\n            <a href=\"https://github.com/eabdullin/qurt/releases\" target=\"_blank\" rel=\"noopener\">Releases</a>\n            <a href=\"https://github.com/eabdullin/qurt/blob/main/README.md\" target=\"_blank\" rel=\"noopener\">Documentation</a>\n          </div>\n        </div>\n      </div>\n      <div class=\"footer-bottom\">\n        <p>Built by <a href=\"https://github.com/eabdullin\" target=\"_blank\" rel=\"noopener\">Yelaman Abdullin</a> &middot; Open source &middot; Electron &middot; React &middot; TypeScript</p>\n      </div>\n    </footer>\n    <script>\n      (function() {\n        var RELEASES_API = 'https://api.github.com/repos/eabdullin/qurt/releases/latest';\n        var FALLBACK_URL = 'https://github.com/eabdullin/qurt/releases/latest';\n\n        function detectPlatform() {\n          var ua = navigator.userAgent || '';\n          var platform = navigator.platform || '';\n          if (/Win/i.test(ua) || /Win/i.test(platform)) return 'windows';\n          if (/Mac/i.test(ua) || /Mac/i.test(platform) || /iPhone|iPad|iPod/.test(ua)) return 'macos';\n          return null;\n        }\n\n        function findAssetUrl(assets, ext) {\n          if (!assets || !assets.length) return null;\n          var lower = ext.toLowerCase();\n          for (var i = 0; i < assets.length; i++) {\n            var name = (assets[i].name || '').toLowerCase();\n            if (name.endsWith(lower)) return assets[i].browser_download_url;\n          }\n          return null;\n        }\n\n        function applyDownloadLinks(data) {\n          var assets = data && data.assets;\n          var winUrl = findAssetUrl(assets, '.exe') || FALLBACK_URL;\n          var macUrl = findAssetUrl(assets, '.dmg') || findAssetUrl(assets, '.zip') || FALLBACK_URL;\n          var platform = detectPlatform();\n\n          document.querySelectorAll('[data-dl], [data-dl-nav], [data-dl-footer]').forEach(function(btn) {\n            var url;\n            if (btn.hasAttribute('data-dl-nav') || btn.hasAttribute('data-dl-footer')) {\n              url = platform === 'windows' ? winUrl : platform === 'macos' ? macUrl : FALLBACK_URL;\n            } else {\n              url = btn.getAttribute('data-dl') === 'windows' ? winUrl : macUrl;\n            }\n            btn.href = url;\n\n            if (btn.hasAttribute('data-dl-nav')) {\n              if (platform === 'windows' && btn.dataset.dlLabelWindows) {\n                var text = btn.querySelector('.btn-text');\n                if (text) text.textContent = btn.dataset.dlLabelWindows;\n              } else if (platform === 'macos' && btn.dataset.dlLabelMacos) {\n                var text = btn.querySelector('.btn-text');\n                if (text) text.textContent = btn.dataset.dlLabelMacos;\n              }\n              return;\n            }\n            if (platform && btn.hasAttribute('data-dl') && btn.getAttribute('data-dl') !== platform) {\n              btn.classList.add('platform-hidden');\n            }\n          });\n        }\n\n        fetch(RELEASES_API)\n          .then(function(r) { return r.ok ? r.json() : null; })\n          .then(applyDownloadLinks)\n          .catch(function() { applyDownloadLinks(null); });\n      })();\n    </script>\n  </body>\n</html>\n", "erro": "", "ms": 922}