{"status": 200, "url_final": "https://axiom-llc.github.io/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Axiom LLC \u2014 AI &amp; Automation Systems</title>\n    <meta name=\"description\" content=\"Axiom LLC \u2014 AI &amp; Automation Systems\">\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"favicon.svg\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@300;400;500&family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,600;12..96,800&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* \u2500\u2500 Reset \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n        /* \u2500\u2500 Tokens (Cyan Palette Color-Aligned with Logo &amp; Stack) \u2500\u2500 */\n        :root {\n            --bg:          #080a0f;\n            --surface:     #0e1118;\n            --surface-2:   #151922;\n            --border:      #1e2530;\n            --border-hi:   #2b3545;\n            --text:        #b4b9c4;\n            --text-dim:    #64748b;\n            --text-mute:   #475569;\n            --text-hi:     #f8fafc;\n            --accent:      #38bdf8;\n            --accent-dim:  rgba(56, 189, 248, 0.06);\n            --accent-glow: rgba(56, 189, 248, 0.15);\n            --mono: \"Azeret Mono\", \"Fira Code\", monospace;\n            --sans: \"Bricolage Grotesque\", system-ui, sans-serif;\n            --ease: cubic-bezier(0.16, 1, 0.3, 1);\n        }\n\n        html { scroll-behavior: smooth; }\n\n        body {\n            background: var(--bg);\n            color: var(--text);\n            font-family: var(--sans);\n            font-size: 16px;\n            line-height: 1.65;\n            -webkit-font-smoothing: antialiased;\n            text-rendering: optimizeLegibility;\n            overflow-x: hidden;\n        }\n\n        /* \u2500\u2500 Grid background \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        body::after {\n            content: \"\";\n            position: fixed;\n            inset: 0;\n            background-image:\n                linear-gradient(var(--text-mute) 1px, transparent 1px),\n                linear-gradient(90deg, var(--text-mute) 1px, transparent 1px);\n            background-size: 60px 60px;\n            opacity: 0.15;\n            pointer-events: none;\n            z-index: 0;\n            mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 0%, transparent 70%);\n        }\n\n        /* \u2500\u2500 Noise overlay \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        body::before {\n            content: \"\";\n            position: fixed;\n            inset: 0;\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E\");\n            background-size: 200px 200px;\n            pointer-events: none;\n            z-index: 999;\n            opacity: 0.4;\n        }\n\n        /* \u2500\u2500 Top accent rule \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .top-rule {\n            position: relative;\n            height: 1px;\n            background: linear-gradient(90deg, transparent 0%, var(--accent) 30%, var(--accent) 70%, transparent 100%);\n            box-shadow: 0 0 40px 0 var(--accent-glow), 0 0 80px 0 rgba(56, 189, 248, 0.07);\n        }\n\n        /* \u2500\u2500 Layout \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .container {\n            max-width: 900px;\n            margin: 0 auto;\n            padding: 0 1.75rem 2.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        /* \u2500\u2500 Header \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .wordmark {\n            padding: 4rem 0 3.2rem;\n            border-bottom: 1px solid var(--border);\n            opacity: 0;\n            transform: translateY(12px);\n            animation: fadeUp 0.8s var(--ease) 0.05s forwards;\n        }\n\n        .wordmark-lockup {\n            display: flex;\n            align-items: flex-end;\n            line-height: 1;\n        }\n\n        .wordmark-axiom {\n            font-family: var(--sans);\n            font-size: clamp(3rem, 9vw, 5.2rem);\n            font-weight: 800;\n            color: var(--text-hi);\n            letter-spacing: 0.09em;\n            text-transform: uppercase;\n            line-height: 1;\n        }\n\n        .wordmark-llc {\n            font-family: var(--mono);\n            font-size: clamp(0.55rem, 1.2vw, 0.72rem);\n            font-weight: 400;\n            color: var(--text-dim);\n            letter-spacing: 0.22em;\n            text-transform: uppercase;\n            padding-left: 0.18em;\n            padding-bottom: 0.18em;\n        }\n\n        .wordmark-rule {\n            display: block;\n            width: 36px;\n            height: 1px;\n            background: linear-gradient(90deg, var(--accent), transparent);\n            margin: 1.5rem 0 0.9rem;\n        }\n\n        .wordmark-sub {\n            display: block;\n            font-family: var(--mono);\n            font-size: 0.68rem;\n            color: var(--accent);\n            letter-spacing: 0.28em;\n            text-transform: uppercase;\n        }\n\n        /* \u2500\u2500 Sections \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .section {\n            padding: 3.2rem 0;\n            border-bottom: 1px solid var(--border);\n            opacity: 0;\n            transform: translateY(10px);\n        }\n\n        .section.visible {\n            animation: fadeUp 0.65s var(--ease) forwards;\n        }\n\n        @keyframes fadeUp {\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        /* \u2500\u2500 Section headings \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        h2 {\n            font-family: var(--mono);\n            font-size: 9.5px;\n            font-weight: 400;\n            letter-spacing: 0.22em;\n            text-transform: uppercase;\n            color: var(--text-dim);\n            margin-bottom: 1.8rem;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        h2::before {\n            content: \"\";\n            display: block;\n            width: 20px;\n            height: 1px;\n            background: var(--accent);\n            box-shadow: 0 0 8px var(--accent-glow);\n            flex-shrink: 0;\n        }\n\n        /* \u2500\u2500 Overview text \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .section > p {\n            font-size: 1.04rem;\n            color: var(--text);\n            max-width: 720px;\n            margin-bottom: 0.9rem;\n            line-height: 1.7;\n        }\n\n        .section > p:last-of-type { margin-bottom: 0; }\n\n        .section > p strong {\n            color: var(--text-hi);\n            font-weight: 600;\n        }\n\n        .inline-link {\n            color: inherit;\n            text-decoration: none;\n            border-bottom: 1px solid rgba(56, 189, 248, 0.35);\n            transition: color 0.18s, border-color 0.18s;\n        }\n\n        .inline-link:hover {\n            color: var(--accent);\n            border-bottom-color: var(--accent);\n        }\n\n        .inline-link strong { font-weight: 600; }\n\n        /* \u2500\u2500 Services grid \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 1px;\n            background: var(--border);\n            border: 1px solid var(--border);\n            border-radius: 3px;\n            overflow: hidden;\n        }\n\n        .project {\n            background: var(--surface);\n            padding: 1.8rem 1.8rem 2rem;\n            position: relative;\n            transition: background 0.22s;\n            overflow: hidden;\n        }\n\n        .project::after {\n            content: \"\";\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 2px;\n            height: 0;\n            background: var(--accent);\n            transition: height 0.3s var(--ease);\n        }\n\n        .project:hover::after { height: 100%; }\n        .project:hover        { background: var(--surface-2); }\n\n        .project-num {\n            font-family: var(--mono);\n            font-size: 9px;\n            color: var(--text-mute);\n            letter-spacing: 0.12em;\n            margin-bottom: 0.9rem;\n        }\n\n        h3 {\n            font-family: var(--sans);\n            font-size: 0.82rem;\n            font-weight: 600;\n            color: var(--text-hi);\n            letter-spacing: 0.06em;\n            text-transform: uppercase;\n            margin-bottom: 0.6rem;\n        }\n\n        .project p {\n            font-size: 0.87rem;\n            color: var(--text-dim);\n            line-height: 1.65;\n            max-width: none;\n            margin-bottom: 0;\n        }\n\n        /* \u2500\u2500 Stack tags \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .stack-list {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 7px;\n        }\n\n        .tag {\n            font-family: var(--mono);\n            font-size: 10px;\n            letter-spacing: 0.08em;\n            color: var(--text-dim);\n            background: var(--surface);\n            border: 1px solid var(--border);\n            padding: 5px 12px;\n            border-radius: 2px;\n            transition: color 0.18s, border-color 0.18s, background 0.18s;\n            cursor: default;\n        }\n\n        .tag:hover {\n            color: var(--accent);\n            border-color: rgba(56, 189, 248, 0.2);\n            background: var(--accent-dim);\n        }\n\n        /* \u2500\u2500 Contact \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .contact-rows {\n            display: flex;\n            flex-direction: column;\n            gap: 11px;\n            margin-bottom: 1.8rem;\n        }\n\n        .contact-row {\n            display: flex;\n            align-items: baseline;\n            gap: 16px;\n        }\n\n        .contact-label {\n            font-family: var(--mono);\n            font-size: 9px;\n            letter-spacing: 0.18em;\n            text-transform: uppercase;\n            color: var(--text-dim);\n            min-width: 50px;\n        }\n\n        .contact-value {\n            font-family: var(--mono);\n            font-size: 0.8rem;\n            color: var(--text);\n            text-decoration: none;\n            border-bottom: 1px solid transparent;\n            padding-bottom: 1px;\n            transition: color 0.18s, border-color 0.18s;\n        }\n\n        .contact-value:hover {\n            color: var(--accent);\n            border-bottom-color: rgba(56, 189, 248, 0.4);\n        }\n\n        /* \u2500\u2500 Buttons \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .contact-links {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 10px;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 7px;\n            padding: 10px 22px;\n            font-family: var(--mono);\n            font-size: 11px;\n            letter-spacing: 0.08em;\n            border-radius: 2px;\n            text-decoration: none;\n            border: none;\n            transition: all 0.18s var(--ease);\n        }\n\n        .btn-primary {\n            background: var(--accent);\n            color: #000;\n            font-weight: 500;\n        }\n\n        .btn-primary:hover {\n            background: #7dd3fc;\n            box-shadow: 0 0 28px var(--accent-glow), 0 4px 16px rgba(56, 189, 248, 0.2);\n            transform: translateY(-1px);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--text-dim);\n            border: 1px solid var(--border-hi);\n        }\n\n        .btn-secondary:hover {\n            color: var(--text-hi);\n            border-color: var(--text-dim);\n            transform: translateY(-1px);\n        }\n\n        /* \u2500\u2500 Footer \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        footer {\n            padding: 2rem 0;\n            font-family: var(--mono);\n            font-size: 10px;\n            color: var(--text-dim);\n            letter-spacing: 0.1em;\n        }\n\n        /* \u2500\u2500 Focus \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        .visually-hidden {\n            position: absolute; width: 1px; height: 1px;\n            padding: 0; margin: -1px; overflow: hidden;\n            clip: rect(0,0,0,0); white-space: nowrap; border: 0;\n        }\n\n        :focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }\n\n        /* \u2500\u2500 Responsive \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n        @media (max-width: 600px) {\n            .grid { grid-template-columns: 1fr; }\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"top-rule\"></div>\n\n<div class=\"container\">\n\n    <header>\n        <h1 class=\"visually-hidden\">Axiom LLC \u2014 AI &amp; Automation Systems</h1>\n        <div class=\"wordmark\">\n\n            <div class=\"wordmark-lockup\">\n                <span class=\"wordmark-axiom\">Axiom</span>\n                <span class=\"wordmark-llc\">LLC</span>\n            </div>\n\n            <span class=\"wordmark-rule\" aria-hidden=\"true\"></span>\n            <span class=\"wordmark-sub\">AI &amp; Automation Systems</span>\n\n        </div>\n    </header>\n\n    <section class=\"section\" data-observe>\n        <h2>Overview</h2>\n        <p>\n            Axiom LLC engineers plan-deterministic operating system layers designed to enforce execution safety and context discipline over probabilistic language models.\n        </p>\n        <p>\n            By compiling natural language intents into schema-validated, declarative execution contracts, our architectures ensure that identical inputs yield strictly reproducible, bounded, and auditable tool sequences. All system components are packaged inside a single unified repository to minimize transactional overhead.\n        </p>\n    </section>\n\n    <section class=\"section\" data-observe>\n        <h2>Services</h2>\n        <div class=\"grid\" role=\"list\">\n            <div class=\"project\" role=\"listitem\">\n                <div class=\"project-num\">01</div>\n                <h3>Plan-Deterministic Engines</h3>\n                <p>Imposing operating system discipline over language models. Our functional run loops run over compiled, schema-validated plans, ensuring reliable, step-bounded executions.</p>\n            </div>\n            <div class=\"project\" role=\"listitem\">\n                <div class=\"project-num\">02</div>\n                <h3>Safety &amp; Execution Policies</h3>\n                <p>Pre-execution contract auditing. Evaluating tool calls against strict, nested policy constraints\u2014enforcing step caps, blocked commands, and process-isolated blast-radius limits before run initiation.</p>\n            </div>\n            <div class=\"project\" role=\"listitem\">\n                <div class=\"project-num\">03</div>\n                <h3>In-Process Context Grounding</h3>\n                <p>Context grounding pipelines. Embedding advanced semantic chunkers, vector search interfaces, and generative retrieval systems directly into the execution path to enforce absolute grounding discipline.</p>\n            </div>\n            <div class=\"project\" role=\"listitem\">\n                <div class=\"project-num\">04</div>\n                <h3>Applied Blueprints</h3>\n                <p>Fully containerized deployment surfaces. Building and hosting transaction dashboards, secure API servers, and serverless voice interfaces on hardened Unix-aligned cloud architectures.</p>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"section\" data-observe>\n\t\t<h2>Stack</h2>\n\t\t<div class=\"stack-list\" role=\"list\">\n\t\t\t<span class=\"tag\" role=\"listitem\">Python</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Bash</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Gemini API</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Pydantic</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Deterministic Agent Runtimes</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Multi-agent Systems</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">RAG / Vector Search</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">SQLite</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">ChromaDB</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">PostgreSQL / pgvector</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Flask</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Docker</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">GCP Cloud Run</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">REST APIs</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Twilio</span>\n\t\t\t<span class=\"tag\" role=\"listitem\">Ollama</span>\n\t\t</div>\n\t</section>\n\n    <section class=\"section\" data-observe>\n        <h2>Architecture</h2>\n        <img src=\"architecture/system-stack.svg\" alt=\"Axiom LLC system architecture\" style=\"width:100%;border-radius:3px;\">\n    </section>\n\n    <section class=\"section contact\" data-observe>\n        <h2>Contact</h2>\n        <div class=\"contact-rows\">\n            <div class=\"contact-row\">\n                <span class=\"contact-label\">email</span>\n                <a href=\"mailto:axiom.co@proton.me\" class=\"contact-value\">axiom.co@proton.me</a>\n            </div>\n            <div class=\"contact-row\">\n                <span class=\"contact-label\">phone</span>\n                <a href=\"tel:+16468834329\" class=\"contact-value\">646-883-4329</a>\n            </div>\n            <div class=\"contact-row\">\n                <span class=\"contact-label\">github</span>\n                <a href=\"https://github.com/axiom-llc\" target=\"_blank\" rel=\"noopener\" class=\"contact-value\">github.com/axiom-llc</a>\n            </div>\n        </div>\n        <nav class=\"contact-links\" aria-label=\"Contact and portfolio links\">\n            <a href=\"mailto:axiom.co@proton.me\" class=\"btn btn-primary\">Start a Project</a>\n            <a href=\"https://github.com/axiom-llc\" target=\"_blank\" rel=\"noopener\" class=\"btn btn-secondary\">View Work &rarr;</a>\n        </nav>\n    </section>\n\n    <footer>\n        <span>&copy; 2026 Axiom LLC</span>\n    </footer>\n\n</div>\n\n<script>\n    (function () {\n        'use strict';\n\n        var sections = document.querySelectorAll('[data-observe]');\n        var observer = new IntersectionObserver(function (entries) {\n            entries.forEach(function (entry) {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, { threshold: 0.06, rootMargin: '0px 0px -30px 0px' });\n\n        sections.forEach(function (el) { observer.observe(el); });\n    })();\n</script>\n\n</body>\n</html>\n", "erro": "", "ms": 425}