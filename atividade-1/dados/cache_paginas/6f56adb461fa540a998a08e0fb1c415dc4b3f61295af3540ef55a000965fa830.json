{"status": 200, "url_final": "https://island.digiscalability.com/", "html": "<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    <!-- Fonts matching the mood: bold display and hand-drawn dialogue.\r\n         Preconnect first: this is the only third-party request on the critical\r\n         path, and without the handshake head-start it delays first paint of\r\n         the loading screen on cold mobile connections. -->\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n    <!-- Non-blocking load: preload-as-style flips to a stylesheet onload, so a\r\n         slow fonts CDN can no longer delay first paint of the loading screen\r\n         (both fonts already use display=swap \u2014 fallbacks render instantly). -->\r\n    <link\r\n      rel=\"preload\"\r\n      as=\"style\"\r\n      href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Patrick+Hand&display=swap\"\r\n      onload=\"this.onload=null;this.rel='stylesheet'\"\r\n    />\r\n    <noscript>\r\n      <link\r\n        href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Patrick+Hand&display=swap\"\r\n        rel=\"stylesheet\"\r\n      />\r\n    </noscript>\r\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\r\n    <!-- iOS ignores SVG apple-touch-icons; needs a real PNG for home-screen. -->\r\n    <link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\" />\r\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\" />\r\n    <link rel=\"canonical\" href=\"https://island.digiscalability.com/\" />\r\n    <!-- viewport-fit=cover: paint under notches (we inset the HUD via\r\n         env(safe-area-*)). maximum-scale/user-scalable=no: a game canvas\r\n         must not pinch-zoom or double-tap-zoom on touch. -->\r\n    <meta\r\n      name=\"viewport\"\r\n      content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\"\r\n    />\r\n    <meta name=\"theme-color\" content=\"#0b1220\" />\r\n    <meta name=\"mobile-web-app-capable\" content=\"yes\" />\r\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\r\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\r\n    <title>DigiScalability Life Island \u2014 a living 3D portfolio</title>\r\n    <meta\r\n      name=\"description\"\r\n      content=\"Explore a hand-built 3D island from DigiScalability, a Melbourne-based venture studio building AI-powered products. Walk the planet, meet the townsfolk, drive the boats and cars, and discover the work.\"\r\n    />\r\n    <meta name=\"author\" content=\"DigiScalability\" />\r\n\r\n    <!-- Open Graph / LinkedIn / WhatsApp / Slack link previews -->\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:site_name\" content=\"DigiScalability\" />\r\n    <meta property=\"og:url\" content=\"https://island.digiscalability.com/\" />\r\n    <meta property=\"og:title\" content=\"DigiScalability Life Island \u2014 a living 3D portfolio\" />\r\n    <meta\r\n      property=\"og:description\"\r\n      content=\"A hand-built 3D island you can actually explore: walk the planet, meet the townsfolk, race the boats and cars, and discover the work of a Melbourne venture studio.\"\r\n    />\r\n    <meta property=\"og:image\" content=\"https://island.digiscalability.com/og-cover-v2.jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"630\" />\r\n    <meta\r\n      property=\"og:image:alt\"\r\n      content=\"DigiScalability Life Island \u2014 an explorable low-poly 3D portfolio planet with a village, ocean and mountains.\"\r\n    />\r\n\r\n    <!-- X / Twitter -->\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:title\" content=\"DigiScalability Life Island \u2014 a living 3D portfolio\" />\r\n    <meta\r\n      name=\"twitter:description\"\r\n      content=\"A hand-built 3D island you can actually explore \u2014 walk the planet, meet the townsfolk, and discover the work.\"\r\n    />\r\n    <meta name=\"twitter:image\" content=\"https://island.digiscalability.com/og-cover-v2.jpg\" />\r\n    <meta\r\n      name=\"twitter:image:alt\"\r\n      content=\"DigiScalability Life Island \u2014 an explorable 3D portfolio planet.\"\r\n    />\r\n\r\n    <!-- Structured data: help search + AI crawlers understand this is Abbas's\r\n         portfolio under DigiScalability. Verify the name / social links are how\r\n         you want them presented publicly. -->\r\n    <script type=\"application/ld+json\">\r\n      {\r\n        \"@context\": \"https://schema.org\",\r\n        \"@graph\": [\r\n          {\r\n            \"@type\": \"WebSite\",\r\n            \"@id\": \"https://island.digiscalability.com/#website\",\r\n            \"name\": \"DigiScalability Life Island\",\r\n            \"url\": \"https://island.digiscalability.com/\",\r\n            \"description\": \"A hand-built, explorable 3D portfolio from DigiScalability, a Melbourne-based venture studio building AI-powered products.\",\r\n            \"author\": { \"@id\": \"https://island.digiscalability.com/#person\" }\r\n          },\r\n          {\r\n            \"@type\": \"Person\",\r\n            \"@id\": \"https://island.digiscalability.com/#person\",\r\n            \"name\": \"Abbas Ali\",\r\n            \"jobTitle\": \"Founder\",\r\n            \"worksFor\": {\r\n              \"@type\": \"Organization\",\r\n              \"name\": \"DigiScalability\",\r\n              \"url\": \"https://digiscalability.com\"\r\n            },\r\n            \"url\": \"https://island.digiscalability.com/\",\r\n            \"sameAs\": [\r\n              \"https://digiscalability.com\",\r\n              \"https://www.linkedin.com/in/digiscalability\",\r\n              \"https://github.com/digiscalability\"\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    </script>\r\n    <style>\n      :root {\n        --bg-gradient-start: #667eea;\n        --bg-gradient-end: #764ba2;\n        --text-light: #ffffff;\n        --text-dark: #0b1220;\n        --overlay-bg: rgba(0, 0, 0, 0.7);\n        --card-bg: rgba(255, 255, 255, 0.95);\n        --card-shadow: 0 12px 30px rgba(20, 24, 44, 0.2);\n        --primary: #5b6cff;\n        --primary-hover: #4350d8;\n        --radius: 18px;\n        --font-display: 'Bebas Neue', sans-serif;\n        --font-body: 'Patrick Hand', cursive;\n      }\n\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      body {\n        overflow: hidden;\n        font-family: var(--font-body);\n        background: linear-gradient(\n          135deg,\n          var(--bg-gradient-start) 0%,\n          var(--bg-gradient-end) 100%\n        );\n      }\n\n      /* No pull-to-refresh / rubber-banding: a downward camera drag must\n         never reload the game (duplicated in style.css; this copy applies\n         before the stylesheet module loads). */\n      html,\n      body {\n        overscroll-behavior: none;\n      }\n\n      #game-canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh; /* mobile: exclude the address bar (fallback above) */\n        position: fixed;\n        top: 0;\n        left: 0;\n        z-index: 500; /* Between UI overlay (1000) and background (0) */\n        /* Canvas drags are game input, never browser scroll/zoom gestures */\n        touch-action: none;\n      }\n\n      /* Loading Screen */\n      #loading-screen {\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        /* Same backdrop as SimpleUI's loader (#0a121c) \u2014 the old purple\n           gradient snapping to dark navy mid-load read as a page restart. */\n        background: #0a121c;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        align-items: center;\n        z-index: 1000;\n        color: var(--text-light);\n        transition: opacity 0.5s ease-out;\n      }\n\n      #loading-screen.hidden {\n        opacity: 0;\n        pointer-events: none;\n      }\n\n      #loading-screen h2 {\n        font-family: var(--font-display);\n        font-size: 48px;\n        letter-spacing: 2px;\n        margin-bottom: 20px;\n      }\n\n      .loading-spinner {\n        width: 60px;\n        height: 60px;\n        border: 6px solid rgba(255, 255, 255, 0.3);\n        border-top-color: var(--text-light);\n        border-radius: 50%;\n        animation: spin 1s linear infinite;\n      }\n\n      @keyframes spin {\n        to {\n          transform: rotate(360deg);\n        }\n      }\n\n      /* This inline block is all the CSS that exists until the JS bundle (and\n         style.css with it) arrives, so the OS reduced-motion preference must\n         be honoured HERE for the boot window. Slowed, not stopped: the\n         spinner is the only liveness signal while the bundle downloads. */\n      @media (prefers-reduced-motion: reduce) {\n        .loading-spinner {\n          animation-duration: 3s;\n        }\n      }\n\n      /* Welcome Modal */\n      #welcome-modal {\n        position: fixed;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%);\n        background: var(--card-bg);\n        padding: 40px;\n        border-radius: var(--radius);\n        box-shadow: var(--card-shadow);\n        z-index: 900;\n        max-width: 500px;\n        width: 90%;\n        text-align: center;\n        transition: opacity 0.3s ease-out;\n      }\n\n      #welcome-modal.hidden {\n        opacity: 0;\n        pointer-events: none;\n      }\n\n      #welcome-modal h1 {\n        font-family: var(--font-display);\n        font-size: 36px;\n        color: var(--text-dark);\n        margin-bottom: 20px;\n      }\n\n      #welcome-modal p {\n        font-size: 18px;\n        color: var(--text-dark);\n        margin-bottom: 30px;\n        line-height: 1.6;\n      }\n\n      #start-button {\n        font-family: var(--font-display);\n        font-size: 24px;\n        padding: 15px 40px;\n        background: var(--primary);\n        color: var(--text-light);\n        border: none;\n        border-radius: var(--radius);\n        cursor: pointer;\n        transition: background 0.2s ease;\n        box-shadow: 0 4px 12px rgba(91, 108, 255, 0.3);\n      }\n\n      #start-button:hover {\n        background: var(--primary-hover);\n        transform: translateY(-2px);\n        box-shadow: 0 6px 16px rgba(91, 108, 255, 0.4);\n      }\n\n      /* HUD Overlay */\n      #hud-overlay {\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 100vw;\n        height: 100vh;\n        z-index: 100;\n        pointer-events: none;\n      }\n\n      #hud-overlay > * {\n        pointer-events: auto;\n      }\n\n      /* Controls Guide */\n      #controls-guide {\n        position: fixed;\n        bottom: 20px;\n        left: 20px;\n        background: var(--overlay-bg);\n        color: var(--text-light);\n        padding: 20px;\n        border-radius: var(--radius);\n        font-size: 16px;\n      }\n\n      #controls-guide h3 {\n        font-family: var(--font-display);\n        font-size: 24px;\n        margin-bottom: 10px;\n      }\n\n      #controls-guide ul {\n        list-style: none;\n      }\n\n      #controls-guide li {\n        margin: 5px 0;\n      }\n\n      #controls-guide kbd {\n        display: inline-block;\n        padding: 3px 8px;\n        background: rgba(255, 255, 255, 0.2);\n        border-radius: 4px;\n        font-family: monospace;\n        font-weight: bold;\n      }\n\n      /* Quest Tracker */\n      #quest-tracker {\n        position: fixed;\n        top: 20px;\n        right: 20px;\n        background: var(--overlay-bg);\n        color: var(--text-light);\n        padding: 20px;\n        border-radius: var(--radius);\n        min-width: 250px;\n      }\n\n      #quest-tracker h3 {\n        font-family: var(--font-display);\n        font-size: 24px;\n        margin-bottom: 10px;\n      }\n\n      #quest-tracker p {\n        font-size: 16px;\n        margin: 5px 0;\n      }\n\n      /* FPS Counter */\n      #fps-counter {\n        position: fixed;\n        top: 20px;\n        left: 20px;\n        background: var(--overlay-bg);\n        color: var(--text-light);\n        padding: 10px 15px;\n        border-radius: var(--radius);\n        font-family: monospace;\n        font-size: 14px;\n      }\n    </style>\r\n    <script type=\"module\" crossorigin src=\"/assets/main-Chh6NqNc.js\"></script>\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/three-PPx_lrH1.js\">\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/main-gHfasgVr.css\">\n  </head>\r\n  <body>\r\n    <canvas id=\"game-canvas\"></canvas>\r\n\r\n    <!-- Loading Screen: the wait is the first impression \u2014 pitch while it\r\n         loads, and narrate progress so a slow phone never reads as a hang. -->\r\n    <div id=\"loading-screen\">\r\n      <h2>DIGISCALABILITY LIFE ISLAND</h2>\r\n      <p style=\"margin: 6px 0 2px; font-size: 14px; opacity: 0.85\">\r\n        Abbas Ali's hand-built 3D portfolio \u2014 a living island run by AI agents.\r\n      </p>\r\n      <div class=\"loading-spinner\"></div>\r\n      <p id=\"load-phase\" style=\"margin-top: 10px; font-size: 12.5px; opacity: 0.6\">\r\n        Preparing the crossing\u2026\r\n      </p>\r\n    </div>\r\n\r\n    <!--\r\n      (Removed: the old static #welcome-modal and #hud-overlay placeholders \u2014\r\n      dead markup the app replaced at runtime, one still name-dropping a template\r\n      it was scaffolded from. Real no-JS/crawler content lives in the <noscript>\r\n      + JSON-LD + boot-fallback below.)\r\n    -->\r\n\r\n    <!--\r\n      Fallback surface. Shown when WebGL is unavailable (locked-down laptops,\r\n      old devices, blocked GPUs) or the app fails to boot. It is not just an\r\n      error message \u2014 it carries the actual portfolio, so a visitor who can\r\n      never see the 3D island still reaches the content and the contact links.\r\n      Also emitted in <noscript> so crawlers and no-JS visitors get real HTML.\r\n    -->\r\n    <div id=\"boot-fallback\" hidden>\r\n      <div class=\"bf-card\">\r\n        <h1>Abbas Ali \u2014 DigiScalability</h1>\r\n        <p class=\"bf-lead\">\r\n          Melbourne-based full-stack engineer and solo founder building AI-powered products\r\n          (TypeScript \u00b7 Next.js \u00b7 Three.js \u00b7 Firebase \u00b7 Python \u00b7 LLM/agent engineering). This\r\n          portfolio is normally an explorable 3D island \u2014\r\n          <span id=\"bf-reason\">but it can't run in this browser.</span>\r\n        </p>\r\n        <h2 style=\"font-size: 15px; margin: 14px 0 6px\">Selected work</h2>\r\n        <ul class=\"bf-links\" style=\"text-align: left\">\r\n          <li>\r\n            <strong>This island</strong> \u2014 a multiplayer Three.js world where every townsperson is a\r\n            live AI agent: an LLM planner assigns their daily jobs, and an autonomous analyst emails\r\n            a nightly report and files GitHub issues about its own world.\r\n          </li>\r\n          <li>\r\n            <strong>RankPilot</strong> \u2014 a live AI-SEO / LLM-visibility platform, solo-built:\r\n            <a href=\"https://rankpilot-h3jpc.web.app\">rankpilot</a>\r\n          </li>\r\n          <li>\r\n            <strong>ChocoMate</strong> \u2014 direct-to-consumer chocolate brand:\r\n            <a href=\"https://chocomate.au\">chocomate.au</a>\r\n          </li>\r\n        </ul>\r\n        <ul class=\"bf-links\">\r\n          <li><a href=\"https://digiscalability.com\">\ud83c\udf10 digiscalability.com</a></li>\r\n          <li><a href=\"https://linkedin.com/in/digiscalability\">\ud83d\udd17 LinkedIn</a></li>\r\n          <li><a href=\"https://github.com/digiscalability\">\ud83d\udcbb GitHub</a></li>\r\n          <li><a href=\"mailto:admin@digiscalability.com\">\u2709\ufe0f admin@digiscalability.com</a></li>\r\n        </ul>\r\n        <button id=\"bf-retry\" type=\"button\">Try again</button>\r\n        <p class=\"bf-foot\">\r\n          The 3D island needs WebGL \u2014 it works in an up-to-date Chrome, Edge, Firefox or Safari with\r\n          hardware acceleration enabled. <a href=\"/privacy.html\">Privacy</a>\r\n        </p>\r\n      </div>\r\n    </div>\r\n    <style>\n      #boot-fallback {\n        position: fixed;\n        inset: 0;\n        z-index: 4000;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 24px;\n        background: linear-gradient(160deg, #0b1220 0%, #16233a 100%);\n        overflow: auto;\n      }\n      #boot-fallback[hidden] {\n        display: none;\n      }\n      .bf-card {\n        max-width: 520px;\n        width: 100%;\n        color: #e6edf7;\n        font-family:\n          system-ui,\n          -apple-system,\n          'Segoe UI',\n          sans-serif;\n        text-align: center;\n      }\n      .bf-card h1 {\n        font-family: 'Bebas Neue', system-ui, sans-serif;\n        letter-spacing: 1px;\n        font-size: 42px;\n        margin: 0 0 10px;\n      }\n      .bf-lead {\n        color: #b8c6d9;\n        line-height: 1.6;\n        margin: 0 0 22px;\n      }\n      .bf-links {\n        list-style: none;\n        padding: 0;\n        margin: 0 0 24px;\n        display: flex;\n        flex-wrap: wrap;\n        gap: 10px;\n        justify-content: center;\n      }\n      .bf-links a {\n        display: inline-block;\n        padding: 9px 15px;\n        border-radius: 10px;\n        background: rgba(255, 255, 255, 0.09);\n        border: 1px solid rgba(255, 255, 255, 0.14);\n        color: #dce7f5;\n        text-decoration: none;\n        font-size: 14px;\n      }\n      .bf-links a:hover {\n        background: rgba(255, 255, 255, 0.16);\n      }\n      #bf-retry {\n        padding: 10px 22px;\n        border-radius: 10px;\n        border: none;\n        background: linear-gradient(135deg, #4caf50, #3d8b40);\n        color: #fff;\n        font-size: 15px;\n        font-weight: 700;\n        cursor: pointer;\n      }\n      .bf-foot {\n        margin: 22px 0 0;\n        font-size: 12px;\n        color: #7d8ea6;\n        line-height: 1.6;\n      }\n      .bf-foot a {\n        color: #7fb2ff;\n      }\n    </style>\r\n\r\n    <noscript>\r\n      <div\r\n        style=\"\r\n          position: fixed;\r\n          inset: 0;\r\n          z-index: 5000;\r\n          background: #0b1220;\r\n          color: #e6edf7;\r\n          display: flex;\r\n          align-items: center;\r\n          justify-content: center;\r\n          padding: 24px;\r\n          font-family: system-ui, sans-serif;\r\n          text-align: center;\r\n        \"\r\n      >\r\n        <div style=\"max-width: 520px\">\r\n          <h1 style=\"font-size: 34px; margin: 0 0 12px\">DigiScalability</h1>\r\n          <p style=\"color: #b8c6d9; line-height: 1.6\">\r\n            A Melbourne-based venture studio building AI-powered products. This 3D portfolio needs\r\n            JavaScript \u2014 meanwhile you can reach us at\r\n            <a style=\"color: #7fb2ff\" href=\"https://digiscalability.com\">digiscalability.com</a> or\r\n            <a style=\"color: #7fb2ff\" href=\"mailto:admin@digiscalability.com\"\r\n              >admin@digiscalability.com</a\r\n            >.\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </noscript>\r\n\r\n    <!--\r\n      Boot guard. Runs BEFORE the deferred module so it can catch a failed\r\n      module load too. Three triggers: no WebGL, an uncaught error before the\r\n      app signals boot, or a watchdog timeout. After a successful boot it stands\r\n      down \u2014 a late error shouldn't blank a playable game.\r\n    -->\r\n    <script>\r\n      (function () {\r\n        var shown = false;\r\n        // __lifeIslandReady means the render loop actually started \u2014 not merely\r\n        // that the module evaluated (that's __lifeIslandBooted, a double-boot\r\n        // latch set before construction, which a crashed init would still set).\r\n        function booted() {\r\n          return !!window.__lifeIslandReady;\r\n        }\r\n        // Vercel Analytics queue stub: events pushed before the injected script\r\n        // loads are drained by it later. Lets this inline watchdog report boot\r\n        // failures/errors that used to be completely invisible to analytics.\r\n        window.va =\r\n          window.va ||\r\n          function () {\r\n            (window.vaq = window.vaq || []).push(arguments);\r\n          };\r\n        var errBudget = 2; // throttle: at most 2 client_error events per session\r\n        function vaEvent(name, data) {\r\n          try {\r\n            window.va('event', { name: name, data: data || {} });\r\n          } catch (e) {\r\n            /* analytics must never break the page */\r\n          }\r\n        }\r\n        function showFallback(reason) {\r\n          if (shown || booted()) return;\r\n          shown = true;\r\n          vaEvent('boot_fallback', { reason: String(reason || '').slice(0, 120) });\r\n          var el = document.getElementById('boot-fallback');\r\n          if (!el) return;\r\n          if (reason) {\r\n            var r = document.getElementById('bf-reason');\r\n            if (r) r.textContent = reason;\r\n          }\r\n          el.hidden = false;\r\n          var ls = document.getElementById('loading-screen');\r\n          if (ls) ls.style.display = 'none';\r\n        }\r\n        function hasWebGL() {\r\n          try {\r\n            var c = document.createElement('canvas');\r\n            return !!(\r\n              window.WebGLRenderingContext &&\r\n              (c.getContext('webgl2') ||\r\n                c.getContext('webgl') ||\r\n                c.getContext('experimental-webgl'))\r\n            );\r\n          } catch (e) {\r\n            return false;\r\n          }\r\n        }\r\n        var retry = document.getElementById('bf-retry');\r\n        if (retry)\r\n          retry.addEventListener('click', function () {\r\n            location.reload();\r\n          });\r\n\r\n        if (!hasWebGL()) {\r\n          showFallback(\"but this browser doesn't support WebGL, which the island needs.\");\r\n          return;\r\n        }\r\n        // A GPU can also drop the context mid-session on flaky drivers.\r\n        var canvas = document.getElementById('game-canvas');\r\n        if (canvas) {\r\n          canvas.addEventListener('webglcontextlost', function (e) {\r\n            e.preventDefault();\r\n            showFallback('but the graphics context was lost. Reloading usually fixes it.');\r\n          });\r\n        }\r\n        window.addEventListener('error', function (e) {\r\n          if (errBudget > 0) {\r\n            errBudget--;\r\n            vaEvent('client_error', {\r\n              msg: String((e && e.message) || 'unknown').slice(0, 140),\r\n              booted: booted() ? 1 : 0,\r\n            });\r\n          }\r\n          if (!booted()) showFallback('but something went wrong loading it.');\r\n          else if (window.console) {\r\n            // Log the stack too \u2014 a bare message (\"cannot read 'dispose' of\r\n            // undefined\") is unactionable when it fires during async init.\r\n            console.error(\r\n              '[island] runtime error',\r\n              e && e.message,\r\n              (e && e.error && e.error.stack) || '(no stack)',\r\n            );\r\n          }\r\n        });\r\n        window.addEventListener('unhandledrejection', function (e) {\r\n          if (errBudget > 0) {\r\n            errBudget--;\r\n            var reason = e && e.reason;\r\n            vaEvent('client_error', {\r\n              msg: String((reason && reason.message) || reason || 'rejection').slice(0, 140),\r\n              booted: booted() ? 1 : 0,\r\n            });\r\n          }\r\n          if (!booted()) showFallback('but something went wrong loading it.');\r\n        });\r\n        // Watchdog: a silent stall (slow CDN, blocked asset) is otherwise an\r\n        // endless spinner with no explanation.\r\n        // Generous: a mid-range phone is several times slower than a desktop\r\n        // through the world-generation pass, and a false \"timed out\" that\r\n        // hides a working game is far worse than a long spinner.\r\n        setTimeout(function () {\r\n          showFallback('but it timed out while loading.');\r\n        }, 60000);\r\n      })();\r\n    </script>\r\n\r\r\n  </body>\r\n</html>\r\n", "erro": "", "ms": 1227}