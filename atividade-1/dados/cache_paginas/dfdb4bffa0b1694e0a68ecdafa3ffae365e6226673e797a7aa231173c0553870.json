{"status": 200, "url_final": "https://sidmohan0.github.io/rumorwoods/", "html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Rumorwoods \u2014 Generative Agents in the Browser</title>\n    <script type=\"module\" crossorigin src=\"./assets/index-CYua0yoj.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"./assets/index-B07FuuvG.css\">\n  </head>\n  <body>\n    <div id=\"app\">\n      <header id=\"topbar\">\n        <div id=\"title\">\n          <b>Rumorwoods</b>\n          <span class=\"subtitle\">Generative Agents: Interactive Simulacra of Human Behavior \u2014 fully in-browser</span>\n          <a id=\"commit-link\" target=\"_blank\" rel=\"noopener\"></a>\n          <a id=\"variant-link\"></a>\n        </div>\n        <div id=\"clock\">\u2014</div>\n        <div id=\"tick-status\"></div>\n        <div id=\"controls\">\n          <button id=\"btn-start\" disabled>Start</button>\n          <button id=\"btn-pause\" disabled>Pause</button>\n          <button id=\"btn-save\" disabled>Save</button>\n          <button id=\"btn-settings\">Settings</button>\n        </div>\n        <div id=\"llm-status\">model not loaded</div>\n      </header>\n      <main id=\"layout\">\n        <div id=\"map-container\">\n          <canvas id=\"map\"></canvas>\n        </div>\n        <aside id=\"sidebar\">\n          <div id=\"inspector\"></div>\n          <div id=\"log-panel\">\n            <div class=\"panel-title\">Town log</div>\n            <div id=\"log\"></div>\n          </div>\n        </aside>\n      </main>\n      <div id=\"loading-overlay\">\n        <div id=\"loading-card\">\n          <button id=\"btn-close-settings\" title=\"Close settings\" aria-label=\"Close settings\">&times;</button>\n          <h2>Rumorwoods</h2>\n          <p>\n            A faithful, fully in-browser reimplementation of\n            <i>Generative Agents: Interactive Simulacra of Human Behavior</i>\n            (Park et&nbsp;al., 2023). Twenty-five agents live out their days in\n            Smallville \u2014 remembering, reflecting, planning, and spreading the\n            word about Isabella's Valentine's Day party.\n          </p>\n          <div id=\"settings-columns\">\n            <section>\n              <div class=\"panel-title\">Model backend</div>\n              <div id=\"backend-choice\">\n                <label>\n                  <input type=\"radio\" name=\"backend\" value=\"webllm\" checked />\n                  WebLLM (WebGPU, in-browser)\n                </label>\n                <select id=\"webllm-model\"></select>\n                <label>\n                  <input type=\"radio\" name=\"backend\" value=\"local\" />\n                  Local LLM server (llama.cpp, Ollama, LM Studio, vLLM\u2026)\n                </label>\n                <div id=\"local-config\">\n                  <div id=\"server-presets\">\n                    <button type=\"button\" class=\"preset\" data-url=\"http://localhost:8080\">llama.cpp :8080</button>\n                    <button type=\"button\" class=\"preset\" data-url=\"http://localhost:11434\">Ollama :11434</button>\n                    <button type=\"button\" class=\"preset\" data-url=\"http://localhost:1234\">LM Studio :1234</button>\n                    <button type=\"button\" class=\"preset\" data-url=\"http://localhost:8000\">vLLM :8000</button>\n                  </div>\n                  <div id=\"server-url-row\">\n                    <input id=\"local-url\" type=\"text\" value=\"http://localhost:8080\" placeholder=\"Base URL (e.g. http://localhost:8080)\" />\n                    <button type=\"button\" id=\"btn-check\">Check</button>\n                  </div>\n                  <div id=\"server-status\"></div>\n                  <select id=\"local-model-select\" hidden></select>\n                  <input id=\"local-model\" type=\"text\" placeholder=\"Model name (leave empty for server default)\" />\n                </div>\n              </div>\n            </section>\n            <section>\n              <div class=\"panel-title\">Saved sessions</div>\n              <div id=\"session-list\"><span class=\"hint\">No saved sessions yet. Use Save in the top bar while a sim is running.</span></div>\n            </section>\n            <section id=\"characters-section\">\n              <div class=\"panel-title\">Characters</div>\n              <div id=\"character-editor\"></div>\n            </section>\n          </div>\n          <button id=\"btn-load\">Load model &amp; begin</button>\n          <div id=\"load-progress\"></div>\n        </div>\n      </div>\n    </div>\n  </body>\n</html>\n", "erro": "", "ms": 617}