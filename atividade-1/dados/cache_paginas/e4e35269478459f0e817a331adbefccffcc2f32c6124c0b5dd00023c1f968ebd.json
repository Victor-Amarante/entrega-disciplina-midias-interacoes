{"status": 200, "url_final": "https://game.jswindell.dev/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Alcatraz Icarus</title>\n    <style>\n        :root {\n            --bg: #12100d;\n            --panel: #1b1712;\n            --panel-strong: #251f17;\n            --text: #e6dabd;\n            --muted: #c4b899;\n            --line: #7a7158;\n            --green: #8aff80;\n            --gold: #f4c95d;\n            --red: #ff5d4d;\n            --blue: #7bc7ff;\n            --shadow: rgba(0, 0, 0, 0.35);\n        }\n\n        * {\n            box-sizing: border-box;\n        }\n\n        body {\n            min-height: 100vh;\n            margin: 0;\n            padding: 24px;\n            color: var(--text);\n            font-family: \"IBM Plex Mono\", \"Fira Code\", \"Courier New\", monospace;\n            background:\n                radial-gradient(circle at 18% 12%, rgba(244, 201, 93, 0.14), transparent 28%),\n                linear-gradient(135deg, #12100d 0%, #171d1b 48%, #0e1115 100%);\n        }\n\n        .page-header {\n            max-width: 980px;\n            margin: 0 auto 18px;\n            display: flex;\n            align-items: baseline;\n            justify-content: space-between;\n            gap: 16px;\n            flex-wrap: wrap;\n        }\n\n        h1 {\n            margin: 0;\n            color: var(--gold);\n            font-size: clamp(26px, 4vw, 44px);\n            letter-spacing: 0.08em;\n            text-transform: uppercase;\n        }\n\n        .repo-link {\n            color: var(--green);\n            font-size: 13px;\n            letter-spacing: 0.12em;\n            text-transform: uppercase;\n            text-decoration: none;\n            padding: 6px 10px;\n            border: 1px solid var(--line);\n            transition: border-color 120ms ease, color 120ms ease, transform 120ms ease;\n        }\n\n        .repo-link:hover {\n            color: var(--gold);\n            border-color: var(--gold);\n            transform: translateY(-1px);\n        }\n\n        .page-section {\n            max-width: 980px;\n            margin: 0 auto 18px;\n            width: 100%;\n        }\n\n        .grader-note {\n            margin: 0 0 12px;\n            color: var(--muted);\n            line-height: 1.5;\n        }\n\n        .loading-line {\n            color: var(--gold);\n        }\n\n        .shell {\n            display: grid;\n            grid-template-columns: minmax(0, 1fr) minmax(420px, 620px);\n            gap: 22px;\n            align-items: start;\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n\n        .shell aside {\n            position: sticky;\n            top: 16px;\n            display: grid;\n            gap: 14px;\n        }\n\n        .panel {\n            border: 1px solid var(--line);\n            background: linear-gradient(180deg, rgba(37, 31, 23, 0.96), rgba(20, 18, 14, 0.96));\n            box-shadow: 0 20px 60px var(--shadow);\n        }\n\n        details.panel {\n            margin-bottom: 14px;\n            overflow: hidden;\n            width: 100%;\n        }\n\n        summary {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 16px;\n            padding: 16px 18px;\n            color: var(--gold);\n            cursor: pointer;\n            font-weight: 700;\n            letter-spacing: 0.06em;\n            list-style: none;\n            text-transform: uppercase;\n        }\n\n        summary::-webkit-details-marker {\n            display: none;\n        }\n\n        summary::after {\n            content: \"+\";\n            color: var(--green);\n            font-size: 22px;\n        }\n\n        details[open] summary::after {\n            content: \"-\";\n        }\n\n        .essay {\n            max-height: 62vh;\n            overflow-y: auto;\n            line-height: 1.65;\n        }\n\n        .essay::-webkit-scrollbar,\n        #game-terminal::-webkit-scrollbar {\n            width: 8px;\n        }\n\n        .essay::-webkit-scrollbar-track,\n        #game-terminal::-webkit-scrollbar-track {\n            background: transparent;\n        }\n\n        .essay::-webkit-scrollbar-thumb,\n        #game-terminal::-webkit-scrollbar-thumb {\n            background: var(--line);\n            border-radius: 4px;\n        }\n\n        .essay h2,\n        .essay h3 {\n            margin: 0 0 12px;\n            color: var(--gold);\n        }\n\n        .essay p {\n            margin: 0 0 16px;\n        }\n\n        .essay strong {\n            color: var(--blue);\n        }\n\n        #game-terminal {\n            min-height: 360px;\n            max-height: 50vh;\n            padding: 18px 20px;\n            overflow-y: auto;\n            line-height: 1.6;\n            font-size: 16px;\n        }\n\n        #game-terminal p {\n            margin: 0 0 8px;\n            white-space: pre-wrap;\n        }\n\n        #game-terminal .term-section {\n            margin: 16px 0 8px;\n            color: var(--muted);\n            font-size: 13px;\n            letter-spacing: 0.22em;\n            text-transform: uppercase;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        #game-terminal .term-section::before,\n        #game-terminal .term-section::after {\n            content: \"\";\n            flex: 1;\n            height: 1px;\n            background: linear-gradient(90deg, transparent, var(--line), transparent);\n            opacity: 0.7;\n        }\n\n        #game-terminal .term-line {\n            display: flex;\n            gap: 12px;\n            align-items: baseline;\n            margin: 0 0 6px;\n        }\n\n        #game-terminal .term-tag {\n            color: var(--muted);\n            font-size: 13px;\n            letter-spacing: 0.18em;\n            text-transform: uppercase;\n            min-width: 80px;\n        }\n\n        #game-terminal .term-value {\n            color: var(--text);\n            font-size: 16px;\n        }\n\n        #game-terminal .term-value.room { color: var(--gold); font-weight: 600; letter-spacing: 0.04em; }\n        #game-terminal .term-value.item { color: var(--blue); }\n\n        #game-terminal .inv-chips {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 6px;\n        }\n\n        #game-terminal .inv-chip {\n            padding: 3px 10px;\n            border: 1px solid rgba(123, 199, 255, 0.35);\n            color: var(--blue);\n            font-size: 14px;\n            background: rgba(123, 199, 255, 0.06);\n        }\n\n        #game-terminal .inv-empty {\n            color: var(--line);\n            font-style: italic;\n            font-size: 14px;\n        }\n\n        #game-terminal .prompt {\n            color: var(--green);\n            margin-top: 12px;\n            font-size: 16px;\n        }\n\n        #game-terminal .prompt::before {\n            content: \"\u276f \";\n            color: var(--gold);\n            margin-right: 2px;\n        }\n\n        #game-terminal .banner {\n            color: var(--gold);\n            letter-spacing: 0.14em;\n            text-transform: uppercase;\n            border: 1px dashed rgba(244, 201, 93, 0.35);\n            padding: 10px 12px;\n            margin: 12px 0;\n            text-align: center;\n            font-weight: 700;\n            font-size: 15px;\n        }\n\n        #game-terminal .meta {\n            color: var(--muted);\n            font-size: 14px;\n            letter-spacing: 0.08em;\n        }\n\n        .error {\n            color: var(--red);\n        }\n\n        .command {\n            color: var(--green);\n        }\n\n        .controls {\n            display: grid;\n            gap: 10px;\n            margin-top: 12px;\n        }\n\n        #character-select {\n            display: grid;\n            gap: 10px;\n            margin-top: 14px;\n        }\n\n        .character-button {\n            display: grid;\n            gap: 4px;\n            padding: 14px 16px;\n            text-align: left;\n            line-height: 1.4;\n        }\n\n        .character-button .name {\n            color: var(--gold);\n            font-weight: 700;\n            letter-spacing: 0.08em;\n            text-transform: uppercase;\n            font-size: 14px;\n        }\n\n        .character-button .role {\n            color: var(--muted);\n            font-size: 13px;\n        }\n\n        .character-button:hover .name {\n            color: var(--gold);\n        }\n\n        input:focus,\n        button:focus {\n            outline: none;\n            border-color: var(--gold);\n            color: var(--gold);\n        }\n\n        input,\n        button {\n            font: inherit;\n        }\n\n        input {\n            width: 100%;\n            padding: 12px;\n            border: 1px solid var(--line);\n            color: var(--green);\n            background: #090907;\n        }\n\n        input::placeholder {\n            color: #8aa885;\n            opacity: 1;\n        }\n\n        button {\n            padding: 11px 14px;\n            border: 1px solid var(--line);\n            color: var(--text);\n            background: var(--panel-strong);\n            cursor: pointer;\n            transition: transform 120ms ease, border-color 120ms ease, color 120ms ease;\n        }\n\n        button:hover {\n            transform: translateY(-1px);\n            border-color: var(--gold);\n            color: var(--gold);\n        }\n\n        #exit-buttons {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 8px;\n        }\n\n        #map-panel {\n            padding: 14px;\n        }\n\n        .panel-title {\n            margin: 0 0 10px;\n            color: var(--muted);\n            font-size: 13px;\n            letter-spacing: 0.12em;\n            text-transform: uppercase;\n        }\n\n        #map {\n            width: 100%;\n            aspect-ratio: 1 / 1;\n            min-height: 560px;\n            border: 1px solid var(--line);\n            background:\n                linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n                #0d0f0d;\n            background-size: 40px 40px;\n        }\n\n        .map-legend {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));\n            gap: 6px 12px;\n            margin-top: 12px;\n            font-size: 12px;\n            color: var(--muted);\n            letter-spacing: 0.06em;\n            text-transform: uppercase;\n        }\n\n        .map-legend span {\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        .map-legend i {\n            width: 14px;\n            height: 14px;\n            border: 1px solid var(--muted);\n            display: inline-block;\n        }\n\n        .legend-current { background: rgba(244, 201, 93, 0.88); border-color: var(--gold); }\n        .legend-warden  { background: rgba(255, 93, 77, 0.84);  border-color: var(--red); }\n        .legend-item    { background: rgba(123, 199, 255, 0.55); border-color: var(--blue); }\n        .legend-visited { background: rgba(138, 255, 128, 0.30); border-color: var(--green); }\n\n        #briefing-panel {\n            margin-top: 14px;\n            padding: 14px 16px;\n        }\n\n        .briefing-divider {\n            height: 1px;\n            background: var(--line);\n            margin: 12px 0;\n            opacity: 0.6;\n        }\n\n        #context {\n            min-height: 42px;\n            color: var(--text);\n            line-height: 1.45;\n        }\n\n        .parts-counter {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            gap: 16px;\n        }\n\n        .parts-counter-label {\n            color: var(--muted);\n            font-size: 16px;\n            letter-spacing: 0.12em;\n            text-transform: uppercase;\n        }\n\n        .parts-counter-value {\n            color: var(--gold);\n            font-size: 40px;\n            font-weight: 700;\n            line-height: 1;\n            text-align: right;\n            font-variant-numeric: tabular-nums;\n            min-width: 2ch;\n        }\n\n        .inventory {\n            color: var(--blue);\n        }\n\n        button:disabled {\n            color: var(--line);\n            background: rgba(27, 23, 18, 0.7);\n            border-color: rgba(122, 113, 88, 0.5);\n            cursor: default;\n            opacity: 0.55;\n            transform: none;\n        }\n\n        button:disabled:hover {\n            color: var(--line);\n            border-color: rgba(122, 113, 88, 0.5);\n            transform: none;\n        }\n\n    </style>\n</head>\n<body>\n    <header class=\"page-header\">\n        <h1>Alcatraz Icarus</h1>\n        <a class=\"repo-link\"\n           href=\"https://github.com/John-Swindell/rag-dungeon-crawler\"\n           target=\"_blank\"\n           rel=\"noopener noreferrer\">\n            View Repository\n        </a>\n    </header>\n\n    <section class=\"page-section\">\n        <details class=\"panel\">\n            <summary>Professional Self-Assessment</summary>\n            <div class=\"essay\">\n                <h2>Professional Self-Assessment</h2>\n                <p><strong>John Swindell | CS 499 Capstone</strong></p>\n\n                <p>When I first began my Computer Science program at SNHU, I operated under the misconception that the pinnacle of development was being a full-stack software engineer writing in languages like Haskell. However, exposure to a wide variety of programming disciplines radically shifted my perspective. I quickly realized my true passion lay in backend infrastructure, data pipelines, and Python. My coursework, combined with professional experience in financial machine learning, has driven my ambition to specialize in Platform Engineering and MLOps. This ePortfolio reflects that evolution, demonstrating my transition from writing isolated scripts to architecting scalable, cloud-native, AI-driven platforms.</p>\n\n                <h3>Software Engineering, Databases, and Security</h3>\n                <p>The core of my capstone revolves around the total architectural overhaul of an early-degree Python scripting project. I completely decoupled the original monolithic application, containerizing the game logic with Docker and exposing it as a RESTful microservice using FastAPI. To showcase modern deployment practices, I utilized Terraform as an Infrastructure as Code (IaC) tool to programmatically provision serverless environments via Google Cloud Platform's Cloud Run.</p>\n\n                <p>Furthermore, I modernized the application's persistence layer by integrating MongoDB Atlas. This went beyond basic NoSQL document storage; I implemented Atlas Vector Search to construct a Retrieval-Augmented Generation (RAG) pipeline. By injecting semantic context into the Gemini API, I enabled dynamic, on-the-fly narrative generation.</p>\n\n                <p>Security is a foundational element of any platform engineering role, and I approached this architecture with a strict security mindset. I implemented Cross-Origin Resource Sharing (CORS) middleware to protect the API and utilized GCP Secret Manager to securely inject API keys at runtime, ensuring no credentials were ever committed to version control. This philosophy extends to my work outside the classroom. Professionally, I build secure ETL data pipelines for crypto assets. Personally, I manage a bare-metal home lab running a distributed cluster of local open-weight LLMs via Llama RPC, heavily utilizing Docker to sandbox AI agents and mitigate the risk of unauthorized system commands.</p>\n\n                <h3>Data Structures and Algorithms</h3>\n                <p>To push my technical boundaries, I replaced my capstone's static map dictionary with a dynamic procedural generation engine. I implemented a Binary Space Partitioning (BSP) algorithm to construct the dungeon rooms server-side. I then translated this layout into a Graph data structure to facilitate intelligent pathfinding.</p>\n\n                <p>By implementing the A* (A-Star) algorithm without diagonal movement, I engineered an NPC capable of actively hunting the player. Because my professional work heavily involves 2D NumPy matrices and Pandas DataFrames, conceptualizing spatial traversal through an adjacency list was a deliberate challenge. This implementation solidified my grasp of space and time complexity, proving my ability to select the most efficient data structures for demanding computational tasks.</p>\n\n                <h3>Collaboration and Professional Communication</h3>\n                <p>Clear communication is essential when bridging the gap between software development and infrastructure operations. During Milestone 1, I conducted a formal Code Review video, analyzing legacy code, identifying bottlenecks, and successfully communicating a highly technical refactoring plan to stakeholders.</p>\n\n                <p>I apply this same communication strategy to safeguard intellectual property. When I wanted to showcase the complex crypto data pipelines I built for my employer, I navigated strict IP constraints by drafting detailed architectural diagrams and blog posts instead of sharing proprietary code. This allowed me to effectively communicate my system design expertise without compromising operational security.</p>\n\n                <h3>Conclusion</h3>\n                <p>The artifacts within this ePortfolio are not isolated assignments; they represent a cohesive, production-grade system. By synthesizing complex algorithmic logic (BSP/A*), robust database management (MongoDB/Vector Search), and automated cloud infrastructure (Terraform/Docker), I have demonstrated the comprehensive skill set required of a modern Platform Engineer. As I look toward the future, I am actively expanding my distributed hardware cluster and studying for the Certified Kubernetes Administrator (CKA) exam, ensuring my technical capabilities continue to scale alongside the rapidly evolving MLOps landscape.</p>\n            </div>\n        </details>\n    </section>\n\n    <main class=\"shell\">\n        <section>\n            <div id=\"game-terminal\" class=\"panel\">\n                <p class=\"meta\">Initializing connection to Alcatraz...</p>\n                <p class=\"meta\">Select your character:</p>\n            </div>\n\n            <section id=\"briefing-panel\" class=\"panel\">\n                <p class=\"panel-title\">Narrative</p>\n                <div id=\"context\">The island is quiet.</div>\n                <div class=\"briefing-divider\"></div>\n                <div class=\"parts-counter\" aria-live=\"polite\">\n                    <span class=\"parts-counter-label\">Parts Remaining</span>\n                    <span id=\"parts-remaining\" class=\"parts-counter-value\">8</span>\n                </div>\n            </section>\n\n            <div id=\"character-select\">\n                <button class=\"character-button\" onclick=\"startNewGame('Weasel')\">\n                    <span class=\"name\">Weasel</span>\n                    <span class=\"role\">Albert Arlington \u2014 built the plane</span>\n                </button>\n                <button class=\"character-button\" onclick=\"startNewGame('Sal')\">\n                    <span class=\"name\">Sal</span>\n                    <span class=\"role\">Salvatore DeLuca \u2014 the mob boss</span>\n                </button>\n                <button class=\"character-button\" onclick=\"startNewGame('Billy')\">\n                    <span class=\"name\">Billy</span>\n                    <span class=\"role\">Billy Handsome \u2014 the enforcer</span>\n                </button>\n                <button class=\"character-button\" onclick=\"startNewGame('Finn')\">\n                    <span class=\"name\">Finn</span>\n                    <span class=\"role\">Finn O'Leary \u2014 the con man</span>\n                </button>\n            </div>\n\n            <div id=\"input-area\" class=\"controls\" style=\"display: none;\">\n                <div id=\"exit-buttons\"></div>\n                <button id=\"pickup-button\" onclick=\"fetchPickup()\" disabled>Pick Up Item</button>\n            </div>\n        </section>\n\n        <aside>\n            <section id=\"map-panel\" class=\"panel\">\n                <p class=\"panel-title\">BSP Map</p>\n                <svg id=\"map\" viewBox=\"0 0 800 800\" role=\"img\" aria-label=\"Generated Alcatraz map\"></svg>\n                <div class=\"map-legend\">\n                    <span><i class=\"legend-current\"></i> You</span>\n                    <span><i class=\"legend-warden\"></i> Warden</span>\n                    <span><i class=\"legend-item\"></i> Item</span>\n                    <span><i class=\"legend-visited\"></i> Visited</span>\n                </div>\n            </section>\n\n        </aside>\n    </main>\n\n        <script>\n        const API_BASE_URL = window.API_BASE_URL || (\n            window.location.protocol.startsWith(\"http\") && window.location.hostname !== \"localhost\" && window.location.hostname !== \"127.0.0.1\"\n                ? \"https://api.jswindell.dev/game\"\n                : \"http://localhost:8080/game\"\n        );\n\n        let currentSessionId = null;\n        let currentState = null;\n        let loadingTimer = null;\n\n        const terminal = document.getElementById(\"game-terminal\");\n        const characterSelect = document.getElementById(\"character-select\");\n        const inputArea = document.getElementById(\"input-area\");\n        const exitButtons = document.getElementById(\"exit-buttons\");\n        const pickupButton = document.getElementById(\"pickup-button\");\n        const map = document.getElementById(\"map\");\n        const context = document.getElementById(\"context\");\n        const partsRemaining = document.getElementById(\"parts-remaining\");\n        const TOTAL_PARTS = 8;\n\n        function printToTerminal(text, className = \"\") {\n            const p = document.createElement(\"p\");\n            p.innerText = text;\n            if (className) p.className = className;\n            terminal.appendChild(p);\n            terminal.scrollTop = terminal.scrollHeight;\n        }\n\n        function printSection(label) {\n            const p = document.createElement(\"p\");\n            p.className = \"term-section\";\n            p.innerText = label;\n            terminal.appendChild(p);\n            terminal.scrollTop = terminal.scrollHeight;\n        }\n\n        function printKeyed(tag, value, valueClass = \"\") {\n            const row = document.createElement(\"p\");\n            row.className = \"term-line\";\n            const t = document.createElement(\"span\");\n            t.className = \"term-tag\";\n            t.innerText = tag;\n            const v = document.createElement(\"span\");\n            v.className = \"term-value\" + (valueClass ? \" \" + valueClass : \"\");\n            v.innerText = value;\n            row.appendChild(t);\n            row.appendChild(v);\n            terminal.appendChild(row);\n            terminal.scrollTop = terminal.scrollHeight;\n        }\n\n        function printInventory(items) {\n            const row = document.createElement(\"p\");\n            row.className = \"term-line\";\n            const t = document.createElement(\"span\");\n            t.className = \"term-tag\";\n            t.innerText = \"carried\";\n            row.appendChild(t);\n            if (!items || items.length === 0) {\n                const empty = document.createElement(\"span\");\n                empty.className = \"inv-empty\";\n                empty.innerText = \"\u2014 empty \u2014\";\n                row.appendChild(empty);\n            } else {\n                const chips = document.createElement(\"span\");\n                chips.className = \"inv-chips\";\n                items.forEach((item) => {\n                    const chip = document.createElement(\"span\");\n                    chip.className = \"inv-chip\";\n                    chip.innerText = item;\n                    chips.appendChild(chip);\n                });\n                row.appendChild(chips);\n            }\n            terminal.appendChild(row);\n            terminal.scrollTop = terminal.scrollHeight;\n        }\n\n        function printBanner(text) {\n            const p = document.createElement(\"p\");\n            p.className = \"banner\";\n            p.innerText = text;\n            terminal.appendChild(p);\n            terminal.scrollTop = terminal.scrollHeight;\n        }\n\n        function printPrompt(text) {\n            const p = document.createElement(\"p\");\n            p.className = \"prompt\";\n            p.innerText = text;\n            terminal.appendChild(p);\n            terminal.scrollTop = terminal.scrollHeight;\n        }\n\n        function showLoading(label) {\n            stopLoading();\n            const p = document.createElement(\"p\");\n            p.id = \"loading-line\";\n            p.className = \"loading-line\";\n            p.innerText = `${label}.`;\n            terminal.appendChild(p);\n            terminal.scrollTop = terminal.scrollHeight;\n            let dots = 1;\n            loadingTimer = setInterval(() => {\n                dots = (dots % 3) + 1;\n                p.innerText = `${label}${\".\".repeat(dots)}`;\n            }, 400);\n        }\n\n        function stopLoading() {\n            if (loadingTimer) {\n                clearInterval(loadingTimer);\n                loadingTimer = null;\n            }\n            const existing = document.getElementById(\"loading-line\");\n            if (existing) existing.remove();\n        }\n\n        async function startNewGame(character) {\n            characterSelect.style.display = \"none\";\n            showLoading(\"Generating map\");\n            try {\n                const response = await fetch(`${API_BASE_URL}/new`, {\n                    method: \"POST\",\n                    headers: { \"Content-Type\": \"application/json\" },\n                    body: JSON.stringify({ character })\n                });\n                const data = await readApiResponse(response);\n                stopLoading();\n                currentSessionId = data.session_id;\n\n                printToTerminal(`Connection established. Session ID: ${currentSessionId}`, \"meta\");\n                printBanner(\"Escape from Alcatraz\");\n                handleApiResponse(data, false);\n                inputArea.style.display = \"grid\";\n            } catch (error) {\n                stopLoading();\n                printToTerminal(`Error: ${error.message}`, \"error\");\n                characterSelect.style.display = \"grid\";\n            }\n        }\n\n        async function fetchMove(direction) {\n            if (!currentSessionId) return;\n            printPrompt(`go ${direction}`);\n            try {\n                const response = await fetch(`${API_BASE_URL}/${currentSessionId}/move`, {\n                    method: \"POST\",\n                    headers: { \"Content-Type\": \"application/json\" },\n                    body: JSON.stringify({ direction })\n                });\n                handleApiResponse(await readApiResponse(response));\n            } catch (error) {\n                printToTerminal(`Network error: ${error.message}`, \"error\");\n            }\n        }\n\n        async function fetchPickup() {\n            if (!currentSessionId || !currentState || !currentState.room_item) return;\n            printPrompt(\"pickup\");\n            try {\n                const response = await fetch(`${API_BASE_URL}/${currentSessionId}/pickup`, { method: \"POST\" });\n                handleApiResponse(await readApiResponse(response));\n            } catch (error) {\n                printToTerminal(`Network error: ${error.message}`, \"error\");\n            }\n        }\n\n        async function readApiResponse(response) {\n            const data = await response.json();\n            if (!response.ok) {\n                throw new Error(data.detail || \"The API rejected the request.\");\n            }\n            return data;\n        }\n\n        function handleApiResponse(data, echoMessage = true) {\n            currentState = data;\n            if (echoMessage && data.message) printToTerminal(data.message);\n\n            if (data.status === \"playing\") {\n                describeCurrentState();\n            } else {\n                printBanner(`Game Over \u2014 ${data.status}`);\n                inputArea.style.display = \"none\";\n            }\n\n            renderExitButtons(data);\n            renderMap(data);\n            renderPartsRemaining(data);\n            updatePickupButton(data);\n            context.innerText = data.narrative_context || \"The island gives you nothing for free.\";\n        }\n\n        function describeCurrentState() {\n            if (!currentState) return;\n            printSection(\"Location\");\n            printKeyed(\"room\", currentState.current_room, \"room\");\n            if (currentState.room_item) {\n                printKeyed(\"item\", currentState.room_item, \"item\");\n            } else {\n                printKeyed(\"item\", \"nothing of use\");\n            }\n            printSection(\"Inventory\");\n            printInventory(currentState.inventory);\n            if (currentState.available_directions && currentState.available_directions.length) {\n                printSection(\"Exits\");\n                printKeyed(\"paths\", currentState.available_directions.join(\" \u00b7 \"));\n            }\n        }\n\n        function renderExitButtons(state) {\n            exitButtons.innerHTML = \"\";\n            const currentRoom = state.map_rooms.find((r) => r.name === state.current_room);\n            state.available_directions.forEach((direction) => {\n                const target = currentRoom && currentRoom.connections\n                    ? currentRoom.connections[direction]\n                    : null;\n                const label = target ? `Go to ${target}` : `Go ${direction}`;\n                const button = document.createElement(\"button\");\n                button.innerText = label;\n                button.onclick = () => fetchMove(direction);\n                exitButtons.appendChild(button);\n            });\n        }\n\n        function renderPartsRemaining(state) {\n            const remaining = Math.max(TOTAL_PARTS - state.inventory.length, 0);\n            partsRemaining.innerText = String(remaining);\n        }\n\n        function updatePickupButton(state) {\n            const canPickup = state.status === \"playing\" && Boolean(state.room_item);\n            pickupButton.disabled = !canPickup;\n            pickupButton.innerText = canPickup ? `Pick Up ${state.room_item}` : \"Pick Up Item\";\n        }\n\n        function renderMap(data) {\n            map.innerHTML = \"\";\n            map.setAttribute(\"viewBox\", `0 0 ${data.map_size[0]} ${data.map_size[1]}`);\n\n            const roomByName = Object.fromEntries(data.map_rooms.map((room) => [room.name, room]));\n            const drawnEdges = new Set();\n\n            data.map_rooms.forEach((room) => {\n                Object.values(room.connections).forEach((targetName) => {\n                    const edgeKey = [room.name, targetName].sort().join(\"::\");\n                    if (drawnEdges.has(edgeKey) || !roomByName[targetName]) return;\n                    drawnEdges.add(edgeKey);\n                    const sourceCenter = center(room);\n                    const targetCenter = center(roomByName[targetName]);\n                    map.appendChild(svgLine(sourceCenter.x, sourceCenter.y, targetCenter.x, targetCenter.y, \"#5f5644\", 4));\n                });\n            });\n\n            data.map_rooms.forEach((room) => {\n                const isCurrent = room.name === data.current_room;\n                const isWarden = room.name === data.warden_room;\n                const hasItem = Boolean(room.item);\n                const visited = data.visited_rooms.includes(room.name);\n                const fill = isCurrent ? \"rgba(244,201,93,0.88)\" : isWarden ? \"rgba(255,93,77,0.84)\" : hasItem ? \"rgba(123,199,255,0.55)\" : visited ? \"rgba(138,255,128,0.30)\" : \"rgba(216,202,168,0.20)\";\n                const stroke = isCurrent ? \"#f4c95d\" : isWarden ? \"#ff5d4d\" : \"#93896f\";\n\n                map.appendChild(svgRect(room.position[0], room.position[1], room.size[0], room.size[1], fill, stroke));\n\n                const label = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n                const roomCenter = center(room);\n                label.setAttribute(\"x\", roomCenter.x);\n                label.setAttribute(\"y\", roomCenter.y);\n                label.setAttribute(\"text-anchor\", \"middle\");\n                label.setAttribute(\"dominant-baseline\", \"middle\");\n                label.setAttribute(\"font-size\", \"18\");\n                label.setAttribute(\"font-weight\", \"600\");\n                label.setAttribute(\"fill\", \"#f5ecd1\");\n                label.textContent = shortName(room.name);\n                map.appendChild(label);\n            });\n        }\n\n        function center(room) {\n            return {\n                x: room.position[0] + room.size[0] / 2,\n                y: room.position[1] + room.size[1] / 2\n            };\n        }\n\n        function svgLine(x1, y1, x2, y2, stroke, width) {\n            const line = document.createElementNS(\"http://www.w3.org/2000/svg\", \"line\");\n            line.setAttribute(\"x1\", x1);\n            line.setAttribute(\"y1\", y1);\n            line.setAttribute(\"x2\", x2);\n            line.setAttribute(\"y2\", y2);\n            line.setAttribute(\"stroke\", stroke);\n            line.setAttribute(\"stroke-width\", width);\n            line.setAttribute(\"stroke-linecap\", \"round\");\n            return line;\n        }\n\n        function svgRect(x, y, width, height, fill, stroke) {\n            const rect = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n            rect.setAttribute(\"x\", x);\n            rect.setAttribute(\"y\", y);\n            rect.setAttribute(\"width\", width);\n            rect.setAttribute(\"height\", height);\n            rect.setAttribute(\"rx\", 8);\n            rect.setAttribute(\"fill\", fill);\n            rect.setAttribute(\"stroke\", stroke);\n            rect.setAttribute(\"stroke-width\", 3);\n            return rect;\n        }\n\n        function shortName(name) {\n            return name\n                .replace(\"Wardens Office\", \"Warden\")\n                .replace(\"Michigan Avenue\", \"Michigan\")\n                .replace(\"Recreation Yard\", \"Yard\")\n                .replace(\"Gondola Station\", \"Gondola\")\n                .replace(\"Spiral Staircase\", \"Stairs\")\n                .replace(\"Citadel Tunnels\", \"Tunnels\");\n        }\n\n    </script>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a35191c0fe061a8e',t:'MTc4ODQwNTEwOQ=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe')