{"status": 200, "url_final": "https://panicspreadsheet.itch.io/red-dust-colony-demo", "html": "<!DOCTYPE HTML><html lang=\"en\"><head><meta charset=\"UTF-8\"/><meta content=\"#1E2837\" name=\"theme-color\"/><meta content=\"https://img.itch.zone/aW1nLzI4ODYxNTkwLnBuZw==/original/kY3CRZ.png\" property=\"og:image\"/><link href=\"https://img.itch.zone/aW1nLzI4ODYxNTkwLnBuZw==/32x32%23/BS50py.png\" type=\"image/png\" rel=\"icon\"/><meta content=\"itch.io\" property=\"og:site_name\"/><meta content=\"4503599627724030\" property=\"twitter:account_id\"/><meta content=\"Colony Sim set on Mars with deep systems to manage.\" property=\"og:description\"/><meta content=\"Colony Sim set on Mars with deep systems to manage.\" name=\"description\"/><meta content=\"width=device-width, initial-scale=1\" name=\"viewport\"/><meta content=\"games/4608959\" name=\"itch:path\"/><link href=\"https://panicspreadsheet.itch.io/red-dust-colony-demo/devlog.rss\" type=\"application/rss+xml\" rel=\"alternate\" title=\"Red Dust Colony Demo Devlog\"/><meta content=\"@itchio\" name=\"twitter:site\"/><meta content=\"Red Dust Colony Demo by PanicSpreadsheet\" name=\"twitter:title\"/><meta content=\"Colony Sim set on Mars with deep systems to manage. Available for Windows, macOS\" name=\"twitter:description\"/><meta content=\"summary_large_image\" name=\"twitter:card\"/><meta content=\"https://img.itch.zone/aW1nLzI4ODYxNTkwLnBuZw==/508x254%23mb/Y1plDr.png\" property=\"twitter:image\"/><meta content=\"https://panicspreadsheet.itch.io/red-dust-colony-demo\" name=\"twitter:url\"/><script type=\"application/ld+json\">{\"@type\":\"BreadcrumbList\",\"@context\":\"http:\\/\\/schema.org\",\"itemListElement\":[{\"@type\":\"ListItem\",\"item\":{\"name\":\"Games\",\"@id\":\"https:\\/\\/itch.io\\/games\"},\"position\":1},{\"@type\":\"ListItem\",\"item\":{\"name\":\"Simulation\",\"@id\":\"https:\\/\\/itch.io\\/games\\/genre-simulation\"},\"position\":2},{\"@type\":\"ListItem\",\"item\":{\"name\":\"Free\",\"@id\":\"h