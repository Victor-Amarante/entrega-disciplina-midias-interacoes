pacing:var(--tracking-wide);text-transform:uppercase;white-space:nowrap;border-radius:20px;font-weight:700;position:absolute;top:-12px;left:50%;transform:translate(-50%)}body.dark .pricing-badge{color:#0f172a}.pricing-title{font-size:var(--text-xl);margin-bottom:var(--space-3)}.pricing-amount{font-size:var(--text-3xl);color:var(--color-accent);margin-bottom:var(--space-1);font-weight:800}.pricing-duration{font-size:var(--text-sm);color:var(--color-text-tertiary);margin-bottom:var(--space-4)}.pricing-desc{font-size:var(--text-sm);color:var(--color-text-secondary);margin-bottom:var(--space-6);flex-grow:1}.pricing-features{margin-bottom:var(--space-8);list-style:none}.pricing-features li{font-size:var(--text-sm);color:var(--color-text-secondary);padding:var(--space-2) 0;padding-left:var(--space-6);position:relative}.pricing-features li:before{content:\"\u2713\";color:var(--color-accent);font-weight:700;position:absolute;left:0}.pricing-cta{text-align:center;justify-content:center;width:100%;margin-top:auto}.contact-section-layout{max-width:640px}.contact-section-title{font-size:var(--text-4xl)}.contact-section-subtitle{font-size:var(--text-lg);color:var(--color-text-secondary);margin-bottom:var(--space-10)}.about-layout{gap:var(--space-12);grid-template-columns:1fr 1fr;align-items:start;display:grid}.about-content p{font-size:var(--text-lg);color:var(--color-text-secondary);line-height:var(--leading-relaxed);margin-bottom:var(--space-6)}.about-photo-img{border:1px solid var(--color-border);border-radius:12px;width:100%;max-width:400px}.about-photo-caption{font-size:var(--text-xs);color:var(--color-text-tertiary);margin-top:var(--space-3);max-width:400px;font-style:italic}.about-actions{gap:var(--space-4);margin-top:var(--space-6);flex-wrap:wrap;display:flex}@media (width<=768px){.about-layout{gap:var(--space-8);grid-template-columns:1fr}.about-photo{order:-1}}\n</style></head><body class=\"dark\"><!-- Skip-to-content link for keyboard and screen-reader accessibility --><a href=\"#main-content\" class=\"skip-link\">Skip to main content</a><!-- Header --><header class=\"site-header\"><nav class=\"container nav-bar\"><a href=\"/\" class=\"logo-text\"><img src=\"/images/logo-text-custom.webp\" alt=\"TurinTech Solutions \u2014 AI and Technical Operations Consulting\" class=\"header-logo header-logo--dark\" width=\"250\" height=\"45\"><img src=\"/images/logo-text-light.webp\" alt=\"TurinTech Solutions \u2014 AI and Technical Operations Consulting\" class=\"header-logo header-logo--light\" width=\"250\" height=\"45\"></a><button class=\"theme-toggle\" id=\"theme-toggle\" aria-label=\"Toggle theme\" title=\"Toggle light/dark mode\"><svg class=\"sun-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"5\"></circle><path d=\"M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42\"></path></svg><svg class=\"moon-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"></path></svg></button><button class=\"mobile-menu-btn\" id=\"mobile-menu-btn\" aria-label=\"Toggle menu\"><span></span><span></span><span></span></button><div class=\"nav-right\" id=\"nav-right\"><div class=\"nav-links\"><a href=\"/\" class=\"nav-link\">Home</a><a href=\"/#pricing\" class=\"nav-link\">Services</a><a href=\"/#about\" class=\"nav-link\">About</a><a href=\"/#contact-form-section\" class=\"btn btn-primary nav-cta\">Get in Touch</a></div></div></nav></header><main id=\"main-content\"><section class=\"hero\"><div class=\"container\"><div class=\"hero-content\"><picture><source srcset=\"/images/logo.webp\" type=\"image/webp\"><img src=\"/images/logo-optimized.png\" alt=\"TurinTech Solutions\" class=\"hero-logo\" width=\"600\" height=\"400\" fetchpriority=\"high\"></picture><span class=\"section-label hero-label\">Local IT Systems and AI Consulting - Orange County, CA</span><h1 class=\"hero-title\">Your Business Runs on Technology.<br><span class=\"text-accent\">Let's Make It Actually Work.</span></h1><p class=\"hero-subtitle\">I help small businesses in Anaheim and Orange County with their IT. I clean things up, lock down data, and set up AI tools that don't leak client information. One system at a time.</p><p class=\"hero-subtitle hero-subtitle--secondary\">No jargon, no retainers you don't need. I tell you what's broken and how to fix it. It starts with a flat $500 systems audit.</p><div class=\"hero-actions\"><a href=\"#pricing\" class=\"btn btn-primary\">Book a $500 Systems Audit</a><a href=\"#free-download\" class=\"btn btn-secondary\">Free AI Risk Checklist</a></div></div></div></section><section class=\"section section-alt\"><div class=\"container\"><span class=\"section-label\">The Problem</span><h2 class=\"section-title\">Small Business Tech Is a Mess. Here's What I Keep Finding.</h2><div class=\"problem-content\"><p>You run a business, not an IT department. Your employees are using ChatGPT with client data. Your file server is held together with duct tape. Your IT guy is the accountant's nephew. Nobody really knows what is on your network.</p><p>This is not your fault. But it is your problem.</p></div><div class=\"grid-3 problem-grid\"><article class=\"card\"><div class=\"card-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg></div><h3 class=\"card-title\">Employees Use AI With Customer Data</h3><p class=\"card-text\">Your team uses ChatGPT and other AI tools with your customer data, financial records, and business plans. Every prompt helps train someone else's product. You probably do not know who is using what.</p></article><article class=\"card\"><div class=\"card-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></div><h3 class=\"card-title\">No Dedicated IT Support</h3><p class=\"card-text\">When something breaks, you call someone who takes days to show up. Or you try to fix it yourself. Your systems are whatever worked at the time. No documentation. No backup plan.</p></article><article class=\"card\"><div class=\"card-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg></div><h3 class=\"card-title\">Disconnected Systems</h3><p class=\"card-text\">Your CRM does not talk to your email. Your files are scattered across OneDrive, Google Drive, and a dusty NAS. Your team wastes hours every week moving data between tools that should just work together.</p></article></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"diff-grid\"><div class=\"diff-content\"><span class=\"section-label\">How I Fix It</span><h2 class=\"section-title\">I Audit What You Have. Then We Fix It.</h2><p class=\"section-subtitle\">I work alone. You talk to me, not an account manager or a junior developer. I look at your setup, tell you what is wrong, and fix it.</p><ul class=\"diff-list\"><li class=\"diff-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"diff-check\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg><div><strong>Systems Audit ($500)</strong><span>I spend 2 hours going through your IT setup. Network, cloud services, devices, AI usage. You get a recorded walkthrough and a one page action plan with the most important fixes.</span></div></li><li class=\"diff-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"diff-check\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg><div><strong>Quick Fix ($750)</strong><span>The audit found three problems. I fix them. No full sprint needed if the issues are small.</span></div></li><li class=\"diff-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"diff-check\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg><div><strong>Cleanup Sprint</strong><span>I fix everything the audit found. Security holes, broken configurations, tools that do not talk to each other. Fixed price. You know the cost before I start.</span></div></li><li class=\"diff-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"diff-check\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg><div><strong>Managed Ops Retainer</strong><span>I keep an eye on things after the cleanup. Monthly checkups, priority support, security updates. You can cancel anytime.</span></div></li></ul></div><div class=\"diff-visual\" aria-hidden=\"true\"><div class=\"diff-graphic\"><div class=\"diff-row diff-row--bad\"><span class=\"diff-label diff-label--bad\">Messy Tech</span><span class=\"diff-arrow diff-arrow--bad\">&rarr;</span><span class=\"diff-label diff-label--bad\">Frustration and Risk</span></div><div class=\"diff-row-divider\"></div><div class=\"diff-row diff-row--good\"><span class=\"diff-label diff-label--good\">Clean Systems</span><span class=\"diff-arrow diff-arrow--good\">&rarr;</span><span class=\"diff-label diff-label--good\">Peace of Mind</span></div></div></div></div></div></section><section class=\"section section-alt\" id=\"free-download\"><div class=\"container\"><div class=\"cta-block\"><span class=\"section-label\">Free Resource</span><h2 class=\"cta-title\">5 Shadow AI Red Flags for Small Business Owners</h2><p class=\"cta-text\">Are your employees using AI with your client data? Here is a checklist to find out. It takes about five minutes.</p><div class=\"free-download-link\"><a href=\"/downloads/shadow-ai-red-flags.html\" class=\"btn btn-primary\">Read the Free Checklist</a></div><p class=\"free-download-note\">One page. Three minutes to read.</p></div></div></section><section class=\"section\" id=\"pricing\"><div class=\"container\"><span class=\"section-label\">Pricing</span><h2 class=\"section-title\">What I Charge</h2><p class=\"section-subtitle\">Everything starts with an audit. Then you decide what else makes sense.</p><div class=\"pricing-grid\"><!-- Offer 1 --><article class=\"card pricing-card pricing-card--featured\"><div class=\"pricing-badge\">Start Here</div><h3 class=\"pricing-title\">IT Systems Audit</h3><div class=\"pricing-amount\">$500</div><p class=\"pricing-duration\">flat fee</p><p class=\"pricing-desc\">Two hours. Remote. I go through your setup and find three things that need to change.</p><ul class=\"pricing-features\"><li>Remote session, no onsite visit</li><li>Recorded walkthrough of your systems</li><li>One page action plan with the important fixes</li><li>30 minute follow up call</li></ul><a href=\"#contact-form-section\" class=\"btn btn-primary pricing-cta\">Book Your Audit</a></article><!-- Offer 2 --><article class=\"card pricing-card\"><h3 class=\"pricing-title\">Quick Fix</h3><div class=\"pricing-amount\">$750</div><p class=\"pricing-duration\">flat fee</p><p class=\"pricing-desc\">The audit found a few things that need fixing. I fix them. Simple as that.</p><ul class=\"pricing-features\"><li>Fix the top issues from the audit</li><li>Security holes patched</li><li>Basic documentation</li><li>Can bundle with the audit</li></ul><a href=\"#contact-form-section\" class=\"btn btn-secondary pricing-cta\">Get a Quote</a></article><!-- Offer 3 --><article class=\"card pricing-card\"><h3 class=\"pricing-title\">Cleanup Sprint</h3><div class=\"pricing-amount\">$1,500 to $3,000</div><p class=\"pricing-duration\">fixed price</p><p class=\"pricing-desc\">A full cleanup. I close security gaps, connect your systems, and write down how everything works.</p><ul class=\"pricing-features\"><li>Security fixes completed</li><li>SaaS cleanup and consolidation</li><li>Data pipeline fixes (CRM, email, files)</li><li>Written documentation of your setup</li></ul><a href=\"#contact-form-section\" class=\"btn btn-secondary pricing-cta\">Get a Quote</a></article><!-- Offer 4 --><article class=\"card pricing-card\"><h3 class=\"pricing-title\">Managed IT Ops Retainer</h3><div class=\"pricing-amount\">$1,000 to $2,500</div><p class=\"pricing-duration\">per month</p><p class=\"pricing-desc\">After we clean things up, I keep them that way. Monthly support, monitoring, and upkeep.</p><ul class=\"pricing-features\"><li>Weekly system health checks</li><li>Priority support (4 hour response)</li><li>Security monitoring and updates</li><li>Quarterly review and roadmap</li></ul><a href=\"#contact-form-section\" class=\"btn btn-secondary pricing-cta\">Start a Conversation</a></article></div></div></section><section class=\"section\"><div class=\"container\"><div class=\"cta-block\"><span class=\"section-label\">Get Started</span><h2 class=\"cta-title\">Not Sure What You Need?</h2><p class=\"cta-text\">Book a free 15 minute call. I will listen to your situation and tell you if I can help. If I cannot, I will tell you that.</p><a href=\"#contact-form-section\" class=\"btn btn-primary\">Book a Free Call</a></div></div></section><section class=\"section section-alt\" id=\"contact-form-section\"><div class=\"container\"><div class=\"contact-section-layout\"><span class=\"section-label\">Contact</span><h2 class=\"section-title contact-section-title\">Contact</h2><p class=\"contact-section-subtitle\">Tell me what is happening with your systems. I will tell you what to do next. No pressure.</p><form class=\"contact-form\" id=\"contact-form\" action=\"https://formsubmit.co/josh@turintechsolutions.com\" method=\"POST\" data-astro-cid-vekgkm42><!-- Honeypot: hidden field that bots fill, humans don't --><input type=\"text\" name=\"_honey\" style=\"display:none\" tabindex=\"-1\" autocomplete=\"off\" data-astro-cid-vekgkm42><!-- Redirect back to home with success anchor --><input type=\"hidden\" name=\"_next\" value=\"https://turintechsolutions.com/#contact\" data-astro-cid-vekgkm42><input type=\"hidden\" name=\"_subject\" value=\"New Contact Form Submission from turintechsolutions.com\" data-astro-cid-vekgkm42><input type=\"hidden\" name=\"_captcha\" value=\"true\" data-astro-cid-vekgkm42><div class=\"form-field\" data-astro-cid-vekgkm42><label for=\"name\" class=\"form-label\" data-astro-cid-vekgkm42>Name</label><input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" required autocomplete=\"name\" placeholder=\"Your full name\" data-astro-cid-vekgkm42></div><div class=\"form-field\" data-astro-cid-vekgkm42><label for=\"email\" class=\"form-label\" data-astro-cid-vekgkm42>Email</label><input type=\"email\" id=\"email\" name=\"email\" class=\"form-input\" required autocomplete=\"email\" placeholder=\"you@company.com\" data-astro-cid-vekgkm42></div><div class=\"form-field\" data-astro-cid-vekgkm42><label for=\"message\" class=\"form-label\" data-astro-cid-vekgkm42>Message</label><textarea id=\"message\" name=\"message\" class=\"form-input form-textarea\" required placeholder=\"Tell us about your project...\" rows=\"5\" maxlength=\"2000\" data-astro-cid-vekgkm42