{"status": 200, "url_final": "https://agentport.sh/", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n<title>AgentPort</title>\n<link rel=\"icon\" type=\"image/png\" href=\"./agentport-website-favicon.png\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n:root {\n  --bg:         #0a0a0a;\n  --fg:         #e6e6e6;\n  --dim:        #6e6e6e;\n  --faint:      #2a2a2a;\n  --accent:     #4ade80;\n  --mono:       'JetBrains Mono', SFMono-Regular, Menlo, Consolas, monospace;\n}\n\nhtml, body { background: var(--bg); color: var(--fg); }\n\nbody {\n  font-family: var(--mono);\n  font-size: 13px;\n  line-height: 1.6;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  padding: 48px 32px 96px;\n  min-height: 100vh;\n}\n\na { color: inherit; text-decoration: none; }\n\n.wrap {\n  max-width: 1080px;\n  margin: 0 auto;\n}\n\n/* \u2500\u2500\u2500 header \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.hdr {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 80px;\n  padding-left: 42px;\n  font-size: 12px;\n}\n.hdr-brand {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  color: var(--fg);\n  font-size: 14px;\n  font-weight: 500;\n}\n.hdr-brand img { height: 20px; width: auto; display: block; }\n\n.hdr-right {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n.hdr-gh {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--dim);\n  transition: color 120ms;\n}\n.hdr-gh:hover { color: var(--fg); }\n.hdr-gh svg { width: 16px; height: 16px; display: block; }\n\n.hdr-cta {\n  display: inline-flex;\n  align-items: center;\n  height: 32px;\n  padding: 0 14px;\n  background: var(--fg);\n  color: var(--bg);\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: 0.01em;\n  transition: opacity 120ms, transform 120ms;\n}\n.hdr-cta:hover { opacity: 0.88; transform: translateY(-1px); }\n\n/* \u2500\u2500\u2500 hero \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.hero {\n  margin-bottom: 56px;\n  padding-left: 42px;\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);\n  gap: 56px;\n  align-items: center;\n}\n.hero-copy { min-width: 0; }\n.hero-visual {\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.hero-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n  color: var(--dim);\n  text-transform: uppercase;\n  letter-spacing: 0.14em;\n  margin-bottom: 28px;\n}\n.hero-label::before {\n  content: '';\n  width: 6px;\n  height: 6px;\n  background: var(--accent);\n  border-radius: 50%;\n  box-shadow: 0 0 12px var(--accent);\n}\n.hero-title {\n  font-family: var(--mono);\n  font-weight: 600;\n  font-size: clamp(30px, 4.2vw, 50px);\n  line-height: 1.18;\n  letter-spacing: -0.02em;\n  color: var(--fg);\n  margin-bottom: 0;\n  max-width: none;\n}\n.hero-title .accent {\n  color: var(--accent);\n}\n.hero-title .dim {\n  color: var(--dim);\n  font-weight: 400;\n}\n.hero-sub {\n  font-size: 14px;\n  color: var(--dim);\n  max-width: 56ch;\n  line-height: 1.7;\n  margin-bottom: 36px;\n}\n.hero-sub b {\n  color: var(--fg);\n  font-weight: 500;\n}\n.hero-meta {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  font-size: 11px;\n  color: var(--dim);\n}\n.hero-meta .dot {\n  width: 3px;\n  height: 3px;\n  background: var(--dim);\n  border-radius: 50%;\n}\n\n@media (max-width: 960px) {\n  .hero { grid-template-columns: 1fr; gap: 48px; }\n}\n@media (max-width: 720px) {\n  .hdr { padding-left: 0; }\n  .hero { padding-left: 0; margin-bottom: 72px; gap: 36px; }\n  .hero-title { font-size: 32px; max-width: none; }\n  .hero-sub { font-size: 13px; }\n}\n\n/* \u2500\u2500\u2500 flow diagram (ported from index mobile, dark) \u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.diagram {\n  margin: 0 0 96px 42px;\n  display: flex;\n  justify-content: flex-start;\n}\n.flow-diagram {\n  position: relative;\n  display: grid;\n  grid-template-columns: 52px minmax(16px, 0.75fr) minmax(0, 150px) minmax(16px, 0.75fr) 52px;\n  align-items: center;\n  gap: 0;\n  width: 100%;\n  max-width: 480px;\n  min-height: 320px;\n}\n.flow-svg {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 1;\n}\n.flow-col {\n  position: relative;\n  z-index: 2;\n  min-width: 0;\n}\n.flow-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n}\n.agent-node,\n.proto-chip,\n.int-node {\n  background: var(--bg);\n  border: 1px solid var(--faint);\n}\n.agent-node {\n  height: 44px;\n  aspect-ratio: 1;\n  padding: 9px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: border-color 160ms;\n}\n.agent-node:hover { border-color: rgba(255,255,255,0.22); }\n.agent-node .agent-logo {\n  width: 24px;\n  height: 24px;\n  object-fit: contain;\n  display: block;\n}\n.agent-node .mono-avatar {\n  width: 24px;\n  height: 24px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 21px;\n  flex-shrink: 0;\n}\n\n.flow-hub {\n  position: relative;\n  background: var(--bg);\n  border: 1px solid rgba(74,222,128,0.32);\n  padding: 16px 14px 18px;\n  box-shadow: 0 0 0 1px rgba(74,222,128,0.04), inset 0 0 50px rgba(74,222,128,0.04);\n}\n.flow-hub-brand {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  margin-bottom: 14px;\n}\n.flow-hub-brand span {\n  font-family: var(--mono);\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--fg);\n  letter-spacing: -0.01em;\n}\n.flow-hub-protos {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.proto-chip {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 7px 8px;\n  font-family: var(--mono);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.1em;\n  color: var(--fg);\n  background: rgba(255,255,255,0.02);\n  border-color: var(--faint);\n}\n.proto-icon {\n  width: 12px;\n  height: 12px;\n  flex-shrink: 0;\n  color: var(--dim);\n}\n.proto-icon svg { display: block; width: 100%; height: 100%; }\n\n.flow-hub-tools {\n  margin-top: 12px;\n  padding-top: 12px;\n  border-top: 1px dashed var(--faint);\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.flow-hub-tool {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 26px;\n  align-items: center;\n  gap: 10px;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--fg);\n  min-width: 0;\n}\n.flow-hub-tool .tool-left {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n}\n.flow-hub-tool .tool-logo {\n  width: 12px;\n  height: 12px;\n  object-fit: contain;\n  flex-shrink: 0;\n  display: block;\n}\n.flow-hub-tool .tool-logo.invert { filter: invert(1) brightness(1.1); }\n.flow-hub-tool .tool-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.flow-hub-tool .tool-tag {\n  position: relative;\n  justify-self: end;\n  width: 22px;\n  height: 22px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid;\n}\n.flow-hub-tool .tool-tag.approve {\n  background: rgba(74,222,128,0.10);\n  color: var(--accent);\n  border-color: rgba(74,222,128,0.4);\n}\n.flow-hub-tool .tool-tag.pending {\n  background: rgba(251,191,36,0.10);\n  color: #fbbf24;\n  border-color: rgba(251,191,36,0.4);\n}\n.flow-hub-tool .tool-tag.deny {\n  background: rgba(248,113,113,0.10);\n  color: #f87171;\n  border-color: rgba(248,113,113,0.4);\n}\n.flow-hub-tool .tool-tag::before,\n.flow-hub-tool .tool-tag::after {\n  content: \"\";\n  display: block;\n}\n.flow-hub-tool .tool-tag.approve::before {\n  width: 8px;\n  height: 4px;\n  border-left: 1.4px solid currentColor;\n  border-bottom: 1.4px solid currentColor;\n  transform: rotate(-45deg) translate(1px, -1px);\n}\n.flow-hub-tool .tool-tag.pending::before {\n  width: 10px;\n  height: 10px;\n  border: 1.4px solid currentColor;\n  border-radius: 50%;\n}\n.flow-hub-tool .tool-tag.pending::after {\n  position: absolute;\n  width: 4px;\n  height: 4px;\n  border-left: 1.4px solid currentColor;\n  border-bottom: 1.4px solid currentColor;\n  transform: translate(2px, -1px);\n}\n.flow-hub-tool .tool-tag.deny::before {\n  width: 10px;\n  height: 10px;\n  background:\n    linear-gradient(45deg, transparent 46%, currentColor 46%, currentColor 54%, transparent 54%),\n    linear-gradient(-45deg, transparent 46%, currentColor 46%, currentColor 54%, transparent 54%);\n}\n\n.flow-ints-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 44px);\n  justify-content: end;\n  gap: 7px;\n}\n.int-node {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  aspect-ratio: 1;\n  padding: 9px;\n  transition: border-color 160ms;\n}\n.int-node:hover { border-color: rgba(255,255,255,0.22); }\n.int-node img {\n  width: 22px;\n  height: 22px;\n  object-fit: contain;\n  display: block;\n}\n.int-node img.invert { filter: invert(1) brightness(1.1); }\n\n.flow-line {\n  stroke: rgba(74,222,128,0.28);\n  stroke-width: 1.2;\n  fill: none;\n}\n\n@media (max-width: 720px) {\n  .diagram { margin: 0 0 64px; }\n  .flow-diagram { max-width: 100%; min-height: 320px; }\n}\n\n/* \u2500\u2500\u2500 steps \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.steps {\n  margin-left: 42px;\n  margin-bottom: 80px;\n  border-top: 1px solid var(--faint);\n}\n.step {\n  display: grid;\n  grid-template-columns: 72px 1fr;\n  gap: 28px;\n  padding: 32px 0;\n  align-items: start;\n  position: relative;\n}\n.step-logos {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-top: 4px;\n}\n.step-logos .logo {\n  width: 36px;\n  height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid var(--faint);\n  background: rgba(255,255,255,0.015);\n  transition: border-color 160ms, background 160ms, transform 180ms;\n}\n.step-logos .logo:hover {\n  border-color: rgba(255,255,255,0.18);\n  background: rgba(255,255,255,0.04);\n  transform: translateY(-1px);\n}\n.step-logos .logo img {\n  width: 20px;\n  height: 20px;\n  object-fit: contain;\n}\n.step-num {\n  font-size: 11px;\n  color: var(--dim);\n  letter-spacing: 0.14em;\n  font-weight: 400;\n  padding-top: 6px;\n  user-select: none;\n}\n.step-body {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.step-title {\n  font-size: 22px;\n  font-weight: 600;\n  color: var(--fg);\n  letter-spacing: -0.01em;\n  line-height: 1.2;\n}\n.step-desc {\n  font-size: 13px;\n  color: var(--dim);\n  line-height: 1.65;\n  max-width: 76ch;\n}\n.step-desc b { color: var(--fg); font-weight: 500; }\n\n/* \u2500\u2500\u2500 cta boxes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cta-boxes {\n  margin-top: 72px;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n}\n.cta-box {\n  display: block;\n  padding: 28px;\n  border: 1px solid var(--faint);\n  background: rgba(255,255,255,0.015);\n  text-decoration: none;\n  transition: border-color 160ms, background 160ms, transform 180ms;\n}\n.cta-box:hover {\n  border-color: rgba(255,255,255,0.18);\n  background: rgba(255,255,255,0.04);\n  transform: translateY(-2px);\n}\n.cta-box-title {\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--fg);\n  letter-spacing: -0.01em;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.cta-box-badge {\n  font-size: 10px;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--accent);\n  border: 1px solid rgba(74,222,128,0.4);\n  border-radius: 999px;\n  padding: 2px 8px;\n}\n.cta-box-desc {\n  font-size: 13px;\n  color: var(--dim);\n  line-height: 1.6;\n  margin: 10px 0 18px;\n}\n.cta-box-link {\n  font-size: 12px;\n  color: var(--accent);\n  font-weight: 500;\n}\n@media (max-width: 720px) {\n  .cta-boxes { grid-template-columns: 1fr; }\n}\n\n/* \u2500\u2500\u2500 footer \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.foot {\n  margin-top: 96px;\n  padding-top: 28px;\n  border-top: 1px solid var(--faint);\n  font-size: 12px;\n  color: var(--dim);\n  display: flex;\n  align-items: center;\n  gap: 24px;\n  flex-wrap: wrap;\n}\n.foot-brand { color: var(--fg); font-weight: 600; }\n.foot-links {\n  display: flex;\n  gap: 20px;\n}\n.foot-links a {\n  color: var(--dim);\n  text-decoration: none;\n  transition: color 160ms;\n}\n.foot-links a:hover { color: var(--fg); }\n.foot-copy { margin-left: auto; }\n\n@media (max-width: 720px) {\n  body { padding: 32px 20px 64px; font-size: 12px; }\n  .steps { margin-left: 0; }\n  .step { grid-template-columns: 48px 1fr; gap: 18px; padding: 24px 0; }\n  .step-title { font-size: 18px; }\n  .step-desc { font-size: 12px; }\n  .step-logos { gap: 10px; }\n  .step-logos .logo { width: 30px; height: 30px; }\n  .step-logos .logo img { width: 17px; height: 17px; }\n}\n</style>\n<script>\n  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(\".\");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement(\"script\")).type=\"text/javascript\",p.async=!0,p.src=s.api_host.replace(\".i.posthog.com\",\"-assets.i.posthog.com\")+\"/static/array.js\",(r=t.getElementsByTagName(\"script\")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a=\"posthog\",u.people=u.people||[],u.toString=function(t){var e=\"posthog\";return\"posthog\"!==a&&(e+=\".\"+a),t||(e+=\" (stub)\"),e},u.people.toString=function(){return u.toString(1)+\".people (stub)\"},o=\"init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep\".split(\" \"),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);\n  posthog.init('phc_o9LvxygZagFKt6J9UcJmzf4Ldrj2cFZx8mKMoAtuuUpb', {\n    api_host: 'https://us.i.posthog.com',\n    defaults: '2026-01-30'\n  });\n</script>\n</head>\n<body>\n\n<div class=\"wrap\">\n\n  <header class=\"hdr\">\n    <a class=\"hdr-brand\" href=\"./index.html\">\n      <img src=\"./logos/agentport-dark-mode.png\" alt=\"\" />\n      <span>AgentPort</span>\n    </a>\n    <div class=\"hdr-right\">\n      <a class=\"hdr-gh\" href=\"https://github.com/yakkomajuri/agentport\" target=\"_blank\" rel=\"noopener\" aria-label=\"GitHub\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path d=\"M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.82 1.18 3.08 0 4.42-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z\"/>\n        </svg>\n        <span>GitHub</span>\n      </a>\n      <a class=\"hdr-cta\" href=\"https://app.agentport.sh\">Try Free</a>\n    </div>\n  </header>\n\n  <section class=\"hero\">\n    <div class=\"hero-copy\">\n      <h1 class=\"hero-title\">\n        connect your agents<br/>\n        to everything\n      </h1>\n    </div>\n    <div class=\"hero-visual\">\n      <div class=\"flow-diagram\" id=\"flowDiagram\">\n      <svg class=\"flow-svg\" id=\"flowSvg\" xmlns=\"http://www.w3.org/2000/svg\"></svg>\n\n      <!-- agents -->\n      <div class=\"flow-col flow-col-agents\">\n        <div class=\"flow-stack\">\n          <div class=\"agent-node\"><img class=\"agent-logo\" src=\"./logos/claude.svg\" alt=\"Claude Code\"></div>\n          <div class=\"agent-node\"><img class=\"agent-logo\" src=\"./logos/codex.png\" alt=\"Codex\"></div>\n          <div class=\"agent-node\"><img class=\"agent-logo\" src=\"./logos/cursor-app.png\" alt=\"Cursor\"></div>\n          <div class=\"agent-node\"><img class=\"agent-logo\" src=\"./logos/openclaw.png\" alt=\"OpenClaw\"></div>\n          <div class=\"agent-node\"><div class=\"mono-avatar\" style=\"color:#b48c14;\">\u2624</div></div>\n        </div>\n      </div>\n\n      <div class=\"flow-col\" aria-hidden=\"true\"></div>\n\n      <!-- hub -->\n      <div class=\"flow-col flow-hub-col\">\n        <div class=\"flow-hub\">\n          <div class=\"flow-hub-brand\"><span>AgentPort</span></div>\n          <div class=\"flow-hub-protos\">\n            <div class=\"proto-chip\">\n              <span class=\"proto-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"5 8 9 12 5 16\"/><line x1=\"12\" y1=\"16\" x2=\"18\" y2=\"16\"/></svg></span>\n              CLI\n            </div>\n            <div class=\"proto-chip\">\n              <span class=\"proto-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 2v5M15 2v5\"/><path d=\"M6 7h12v5a6 6 0 0 1-12 0V7z\"/><path d=\"M12 18v4\"/></svg></span>\n              MCP\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"flow-col\" aria-hidden=\"true\"></div>\n\n      <!-- integrations -->\n      <div class=\"flow-col flow-col-ints\">\n        <div class=\"flow-ints-grid\">\n          <div class=\"int-node\"><img src=\"./logos/stripe.svg\" alt=\"Stripe\"></div>\n          <div class=\"int-node\"><img src=\"./logos/slack.svg\" alt=\"Slack\"></div>\n          <div class=\"int-node\"><img class=\"invert\" src=\"./logos/github.svg\" alt=\"GitHub\"></div>\n          <div class=\"int-node\"><img class=\"invert\" src=\"./logos/notion.svg\" alt=\"Notion\"></div>\n          <div class=\"int-node\"><img class=\"invert\" src=\"./logos/linear.svg\" alt=\"Linear\"></div>\n        </div>\n      </div>\n    </div>\n    </div>\n  </section>\n\n  <div class=\"steps\">\n    <div class=\"step\">\n      <div class=\"step-num\">01</div>\n      <div class=\"step-body\">\n        <div class=\"step-title\">Plug in all your agents</div>\n        <div class=\"step-desc\">\n          We offer both an MCP and a CLI.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"step\">\n      <div class=\"step-num\">02</div>\n      <div class=\"step-body\">\n        <div class=\"step-title\">Connect to any platform</div>\n        <div class=\"step-desc\">\n          Linear, Slack, GitHub, Notion, Stripe, and dozens of other connectors offered out of the box. Plus connect any MCP or API.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"step\">\n      <div class=\"step-num\">03</div>\n      <div class=\"step-body\">\n        <div class=\"step-title\">Set granular access policies</div>\n        <div class=\"step-desc\">\n          Define what tools an agent can use, and which it needs your approval for. With advanced rule-based filtering for the extra cautious.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"step\">\n      <div class=\"step-num\">04</div>\n      <div class=\"step-body\">\n        <div class=\"step-title\">Run and audit</div>\n        <div class=\"step-desc\">\n          Complete audit logs of every tool call and approval chain.\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"cta-boxes\">\n    <a class=\"cta-box\" href=\"https://github.com/yakkomajuri/agentport\" target=\"_blank\" rel=\"noopener\">\n      <div class=\"cta-box-title\">Self-host</div>\n      <div class=\"cta-box-desc\">Open source. Run on your own infra.</div>\n      <span class=\"cta-box-link\">View on GitHub \u2192</span>\n    </a>\n    <a class=\"cta-box\" href=\"https://app.agentport.sh\">\n      <div class=\"cta-box-title\">Cloud <span class=\"cta-box-badge\">beta</span></div>\n      <div class=\"cta-box-desc\">Get up and running fast with a managed service.</div>\n      <span class=\"cta-box-link\">Try Cloud \u2192</span>\n    </a>\n  </div>\n\n  <footer class=\"foot\">\n    <span class=\"foot-brand\">AgentPort</span>\n    <nav class=\"foot-links\">\n      <a href=\"https://github.com/yakkomajuri/agentport\" target=\"_blank\" rel=\"noopener\">GitHub</a>\n      <a href=\"https://app.agentport.sh\">Cloud</a>\n    </nav>\n    <span class=\"foot-copy\">\u00a9 2026 AgentPort</span>\n  </footer>\n\n</div>\n\n<script>\n(function () {\n  const diagram = document.getElementById('flowDiagram');\n  const svg = document.getElementById('flowSvg');\n  if (!diagram || !svg) return;\n  const SVG_NS = 'http://www.w3.org/2000/svg';\n\n  function draw() {\n    const rect = diagram.getBoundingClientRect();\n    svg.setAttribute('viewBox', `0 0 ${rect.width} ${rect.height}`);\n    svg.setAttribute('width', rect.width);\n    svg.setAttribute('height', rect.height);\n    while (svg.firstChild) svg.removeChild(svg.firstChild);\n\n    const toLocal = (el, side) => {\n      const r = el.getBoundingClientRect();\n      return {\n        x: (side === 'right' ? r.right : r.left) - rect.left,\n        y: r.top + r.height / 2 - rect.top,\n      };\n    };\n    const GAP = 6;\n    const makePath = (a, b) => {\n      const ax = a.x + GAP, bx = b.x - GAP;\n      const dx = Math.max(30, (bx - ax) * 0.55);\n      return `M ${ax} ${a.y} C ${ax + dx} ${a.y}, ${bx - dx} ${b.y}, ${bx} ${b.y}`;\n    };\n    const addPath = (d) => {\n      const p = document.createElementNS(SVG_NS, 'path');\n      p.setAttribute('d', d);\n      p.setAttribute('class', 'flow-line');\n      svg.appendChild(p);\n    };\n\n    const hub = diagram.querySelector('.flow-hub');\n    const hubRect = hub.getBoundingClientRect();\n    const hubLeftX = hubRect.left - rect.left;\n    const hubTopY = hubRect.top - rect.top;\n    const hubH = hubRect.height;\n\n    const agents = Array.from(diagram.querySelectorAll('.agent-node'));\n    agents.forEach((agent, i) => {\n      const a = toLocal(agent, 'right');\n      const t = (i + 0.5) / agents.length;\n      const b = { x: hubLeftX, y: hubTopY + hubH * (0.18 + 0.64 * t) };\n      addPath(makePath(a, b));\n    });\n\n    const hubRight = {\n      x: hubRect.right - rect.left,\n      y: hubRect.top + hubRect.height / 2 - rect.top,\n    };\n    diagram.querySelectorAll('.int-node').forEach(intg => {\n      const b = toLocal(intg, 'left');\n      addPath(makePath(hubRight, b));\n    });\n  }\n\n  const redraw = () => requestAnimationFrame(draw);\n  window.addEventListener('load', redraw);\n  window.addEventListener('resize', redraw);\n  diagram.querySelectorAll('img').forEach(img => {\n    if (!img.complete) img.addEventListener('load', redraw, { once: true });\n  });\n  redraw();\n})();\n</script>\n\n</body>\n</html>\n", "erro": "", "ms": 527}