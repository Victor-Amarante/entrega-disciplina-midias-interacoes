{"status": 200, "url_final": "https://agent-bundle.com/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>agent-bundle \u2014 Define agent skills in YAML. Generate a production-ready agent service.</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n\n  :root {\n    --bg: #09090b;\n    --bg-elevated: #111114;\n    --bg-card: rgba(255,255,255,0.03);\n    --border: rgba(255,255,255,0.06);\n    --border-hover: rgba(255,255,255,0.12);\n    --text: #fafafa;\n    --text-secondary: #a1a1aa;\n    --text-muted: #52525b;\n    --violet: #8b5cf6;\n    --violet-soft: rgba(139,92,246,0.12);\n    --teal: #2dd4bf;\n    --teal-soft: rgba(45,212,191,0.10);\n    --font-sans: 'Outfit', sans-serif;\n    --font-mono: 'Fira Code', monospace;\n  }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    background: var(--bg);\n    color: var(--text);\n    font-family: var(--font-sans);\n    font-size: 16px;\n    line-height: 1.6;\n    overflow-x: hidden;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  /* ---- Gradient mesh background ---- */\n  .mesh-bg {\n    position: fixed; inset: 0; z-index: 0; pointer-events: none;\n    overflow: hidden;\n  }\n  .mesh-bg::before {\n    content: '';\n    position: absolute;\n    width: 800px; height: 800px;\n    top: -200px; right: -200px;\n    background: radial-gradient(circle, rgba(139,92,246,0.08) 0%, transparent 70%);\n    animation: drift1 20s ease-in-out infinite alternate;\n  }\n  .mesh-bg::after {\n    content: '';\n    position: absolute;\n    width: 600px; height: 600px;\n    bottom: -100px; left: -100px;\n    background: radial-gradient(circle, rgba(45,212,191,0.06) 0%, transparent 70%);\n    animation: drift2 25s ease-in-out infinite alternate;\n  }\n  @keyframes drift1 {\n    from { transform: translate(0, 0); }\n    to { transform: translate(-80px, 60px); }\n  }\n  @keyframes drift2 {\n    from { transform: translate(0, 0); }\n    to { transform: translate(60px, -40px); }\n  }\n\n  /* ---- Noise overlay ---- */\n  .noise {\n    position: fixed; inset: 0; z-index: 1; pointer-events: none;\n    opacity: 0.025;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n    background-repeat: repeat;\n    background-size: 256px 256px;\n  }\n\n  /* ---- Navbar ---- */\n  nav {\n    position: fixed; top: 0; left: 0; right: 0; z-index: 100;\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 16px 40px;\n    background: rgba(9,9,11,0.75);\n    backdrop-filter: blur(24px) saturate(1.2);\n    border-bottom: 1px solid var(--border);\n  }\n  .nav-brand {\n    font-weight: 700; font-size: 17px;\n    color: var(--text); text-decoration: none;\n    letter-spacing: -0.3px;\n  }\n  .nav-brand .dot { color: var(--violet); }\n  .nav-right { display: flex; align-items: center; gap: 28px; }\n  .nav-right a {\n    color: var(--text-secondary); text-decoration: none;\n    font-size: 14px; font-weight: 400;\n    transition: color 0.2s;\n  }\n  .nav-right a:hover { color: var(--text); }\n  .gh-btn {\n    display: inline-flex; align-items: center; gap: 6px;\n    padding: 7px 14px; border-radius: 8px;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid var(--border);\n    color: var(--text-secondary); font-size: 13px;\n    text-decoration: none; font-family: var(--font-sans);\n    transition: all 0.2s;\n  }\n  .gh-btn:hover {\n    background: rgba(255,255,255,0.09);\n    border-color: var(--border-hover);\n    color: var(--text);\n  }\n  .gh-btn svg { width: 15px; height: 15px; fill: currentColor; }\n\n  /* ---- Hero ---- */\n  .hero {\n    position: relative; z-index: 2;\n    display: flex; flex-direction: column; align-items: center;\n    padding: 160px 40px 100px;\n    text-align: center;\n  }\n  .hero-pill {\n    display: inline-flex; align-items: center; gap: 10px;\n    padding: 5px 14px 5px 6px; border-radius: 100px;\n    background: var(--violet-soft);\n    border: 1px solid rgba(139,92,246,0.2);\n    font-size: 13px; font-weight: 500;\n    color: var(--violet);\n    margin-bottom: 36px;\n    opacity: 0; animation: fadeIn 0.6s ease 0.1s forwards;\n  }\n  .hero-pill .pill-dot {\n    width: 20px; height: 20px; border-radius: 50%;\n    background: var(--violet);\n    display: flex; align-items: center; justify-content: center;\n    font-size: 10px; color: white;\n  }\n\n  .hero h1 {\n    font-weight: 800; font-size: clamp(42px, 5.5vw, 68px);\n    line-height: 1.08; letter-spacing: -2.5px;\n    max-width: 780px;\n    background: linear-gradient(180deg, #fafafa 40%, #71717a 100%);\n    -webkit-background-clip: text; -webkit-text-fill-color: transparent;\n    background-clip: text;\n    opacity: 0; animation: fadeIn 0.6s ease 0.2s forwards;\n  }\n  .hero .sub {\n    margin-top: 24px;\n    font-size: 18px; font-weight: 300;\n    color: var(--text-secondary);\n    max-width: 480px; line-height: 1.6;\n    opacity: 0; animation: fadeIn 0.6s ease 0.3s forwards;\n  }\n\n  /* ---- Install bar (inline copy) ---- */\n  .install-bar {\n    display: inline-flex; align-items: center; gap: 0;\n    margin-top: 32px;\n    border-radius: 10px;\n    border: 1px solid var(--border);\n    background: var(--bg-elevated);\n    overflow: hidden;\n    opacity: 0; animation: fadeIn 0.6s ease 0.35s forwards;\n    cursor: pointer;\n    transition: border-color 0.25s;\n  }\n  .install-bar:hover {\n    border-color: var(--border-hover);\n  }\n  .install-bar code {\n    padding: 10px 18px;\n    font-family: var(--font-mono);\n    font-size: 13.5px;\n    color: var(--text-secondary);\n    user-select: all;\n  }\n  .install-bar code .dollar { color: var(--teal); margin-right: 8px; }\n  .install-bar .install-copy {\n    padding: 10px 16px;\n    border: none; border-left: 1px solid var(--border);\n    background: rgba(255,255,255,0.03);\n    color: var(--text-muted);\n    font-family: var(--font-sans);\n    font-size: 12px;\n    cursor: pointer;\n    transition: all 0.2s;\n  }\n  .install-bar .install-copy:hover {\n    background: rgba(255,255,255,0.06);\n    color: var(--text-secondary);\n  }\n\n  .hero-actions {\n    display: flex; gap: 12px; margin-top: 28px;\n    opacity: 0; animation: fadeIn 0.6s ease 0.4s forwards;\n  }\n  .btn-glow {\n    display: inline-flex; align-items: center; gap: 8px;\n    padding: 12px 28px; border-radius: 10px;\n    background: var(--violet);\n    color: white; font-weight: 600; font-size: 14px;\n    text-decoration: none; border: none;\n    font-family: var(--font-sans);\n    transition: all 0.25s;\n    box-shadow: 0 0 24px var(--violet-soft), inset 0 1px 0 rgba(255,255,255,0.15);\n  }\n  .btn-glow:hover {\n    filter: brightness(1.15);\n    box-shadow: 0 0 40px rgba(139,92,246,0.25), inset 0 1px 0 rgba(255,255,255,0.15);\n    transform: translateY(-1px);\n  }\n  .btn-ghost {\n    display: inline-flex; align-items: center; gap: 8px;\n    padding: 12px 28px; border-radius: 10px;\n    background: transparent;\n    border: 1px solid var(--border);\n    color: var(--text-secondary); font-weight: 500; font-size: 14px;\n    text-decoration: none;\n    font-family: var(--font-sans);\n    transition: all 0.25s;\n  }\n  .btn-ghost:hover {\n    border-color: var(--border-hover);\n    color: var(--text);\n    background: rgba(255,255,255,0.03);\n  }\n\n  /* ---- Terminal with animated border ---- */\n  .terminal-container {\n    margin-top: 64px; width: 100%; max-width: 680px;\n    opacity: 0; animation: fadeIn 0.6s ease 0.5s forwards;\n  }\n  .term-border {\n    position: relative;\n    border-radius: 17px;\n    padding: 1px;\n    background: var(--border);\n    overflow: hidden;\n  }\n  .term-border::before {\n    content: '';\n    position: absolute;\n    inset: -50%;\n    background: conic-gradient(\n      from 0deg,\n      transparent 0%,\n      var(--violet) 8%,\n      var(--teal) 16%,\n      transparent 24%,\n      transparent 100%\n    );\n    animation: borderSpin 6s linear infinite;\n  }\n  @keyframes borderSpin {\n    to { transform: rotate(360deg); }\n  }\n  .term {\n    position: relative;\n    border-radius: 16px;\n    background: var(--bg-elevated);\n    overflow: hidden;\n    box-shadow: 0 24px 80px rgba(0,0,0,0.6);\n  }\n  .term-chrome {\n    display: flex; align-items: center; gap: 7px;\n    padding: 15px 18px;\n    border-bottom: 1px solid var(--border);\n  }\n  .term-circle { width: 10px; height: 10px; border-radius: 50%; }\n  .term-circle.r { background: #f87171; }\n  .term-circle.y { background: #fbbf24; }\n  .term-circle.g { background: #4ade80; }\n  .term-chrome .term-title {\n    flex: 1; text-align: center;\n    font-size: 12px; color: var(--text-muted);\n    font-family: var(--font-mono);\n    margin-right: 36px;\n  }\n  .term-content {\n    padding: 22px 24px;\n    font-family: var(--font-mono);\n    font-size: 13.5px;\n    line-height: 1.9;\n    height: 360px;\n    overflow: hidden;\n  }\n  .term-content .line {\n    opacity: 0;\n    transition: opacity 0.15s ease;\n    white-space: nowrap;\n  }\n  .term-content .line.show { opacity: 1; }\n  .term-content .pr { color: var(--teal); }\n  .term-content .cm { color: var(--text); }\n  .term-content .dim { color: var(--text-muted); }\n  .term-content .ok { color: #4ade80; }\n  .term-content .warn { color: #fbbf24; }\n  .term-content .cursor-block {\n    display: inline-block;\n    width: 8px; height: 16px;\n    background: var(--teal);\n    animation: cursorBlink 1.2s step-end infinite;\n    vertical-align: text-bottom;\n  }\n\n  @keyframes cursorBlink { 50% { opacity: 0; } }\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(16px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  /* ---- Section wrapper ---- */\n  .section-wrap {\n    position: relative; z-index: 2;\n    max-width: 1080px; margin: 0 auto;\n    padding: 100px 40px;\n  }\n  .section-eyebrow {\n    font-size: 13px; font-weight: 600;\n    text-transform: uppercase; letter-spacing: 2px;\n    color: var(--violet);\n    margin-bottom: 12px;\n  }\n  .section-heading {\n    font-weight: 700; font-size: clamp(26px, 3vw, 36px);\n    letter-spacing: -0.8px;\n    margin-bottom: 56px;\n    color: var(--text);\n  }\n\n  /* ---- Features ---- */\n  .feat-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1px;\n    background: var(--border);\n    border-radius: 16px;\n    overflow: hidden;\n    border: 1px solid var(--border);\n  }\n  .feat-cell {\n    padding: 36px 32px;\n    background: var(--bg);\n    transition: background 0.3s ease;\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  .feat-cell.visible {\n    opacity: 1;\n    transform: translateY(0);\n    transition: background 0.3s ease, opacity 0.5s ease, transform 0.5s ease;\n  }\n  .feat-cell:hover {\n    background: var(--bg-elevated);\n  }\n  .feat-cell .feat-icon {\n    width: 36px; height: 36px; border-radius: 8px;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 18px; margin-bottom: 20px;\n  }\n  .feat-cell:nth-child(odd) .feat-icon {\n    background: var(--violet-soft);\n  }\n  .feat-cell:nth-child(even) .feat-icon {\n    background: var(--teal-soft);\n  }\n  .feat-cell h3 {\n    font-weight: 600; font-size: 15px;\n    margin-bottom: 8px; letter-spacing: -0.2px;\n  }\n  .feat-cell p {\n    font-size: 13.5px; color: var(--text-secondary);\n    line-height: 1.65; font-weight: 300;\n  }\n\n  /* ---- Quick Start ---- */\n  .qs-wrap { max-width: 620px; }\n  .qs-step { margin-bottom: 32px; }\n  .qs-step-head {\n    display: flex; align-items: center; gap: 12px;\n    margin-bottom: 10px;\n  }\n  .qs-num {\n    font-family: var(--font-mono);\n    font-size: 12px; font-weight: 600;\n    color: var(--violet);\n    width: 26px; height: 26px; border-radius: 6px;\n    display: flex; align-items: center; justify-content: center;\n    background: var(--violet-soft);\n  }\n  .qs-label { font-weight: 600; font-size: 14px; }\n  .qs-code {\n    position: relative;\n    border-radius: 12px;\n    background: var(--bg-elevated);\n    border: 1px solid var(--border);\n    overflow-x: auto;\n  }\n  .qs-code pre {\n    margin: 0;\n    padding: 18px 22px;\n    font-family: var(--font-mono);\n    font-size: 13px; line-height: 1.9;\n    white-space: pre;\n  }\n  .qs-code .cp {\n    position: absolute; top: 10px; right: 10px;\n    padding: 3px 10px; border-radius: 5px;\n    background: rgba(255,255,255,0.04);\n    border: 1px solid var(--border);\n    color: var(--text-muted); font-size: 11px;\n    cursor: pointer; font-family: var(--font-sans);\n    transition: all 0.2s;\n  }\n  .qs-code .cp:hover {\n    color: var(--text-secondary);\n    background: rgba(255,255,255,0.07);\n  }\n  .qs-code .k { color: var(--violet); }\n  .qs-code .s { color: var(--teal); }\n  .qs-code .c { color: var(--text-muted); }\n  .qs-code .p { color: var(--teal); }\n\n  /* ---- Star CTA ---- */\n  .star-cta {\n    position: relative; z-index: 2;\n    text-align: center;\n    padding: 100px 40px;\n  }\n  .star-cta-inner {\n    max-width: 560px;\n    margin: 0 auto;\n  }\n  .star-cta h2 {\n    font-weight: 700;\n    font-size: clamp(26px, 3vw, 38px);\n    letter-spacing: -1px;\n    margin-bottom: 16px;\n    background: linear-gradient(135deg, var(--violet), var(--teal));\n    -webkit-background-clip: text; -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .star-cta p {\n    font-size: 16px; font-weight: 300;\n    color: var(--text-secondary);\n    margin-bottom: 36px;\n    line-height: 1.6;\n  }\n  .star-btn {\n    display: inline-flex; align-items: center; gap: 10px;\n    padding: 16px 36px; border-radius: 12px;\n    font-family: var(--font-sans);\n    font-weight: 600; font-size: 16px;\n    text-decoration: none; border: none; cursor: pointer;\n    color: white;\n    background: linear-gradient(135deg, var(--violet), #6d28d9);\n    box-shadow:\n      0 0 40px rgba(139,92,246,0.2),\n      inset 0 1px 0 rgba(255,255,255,0.15);\n    transition: all 0.3s;\n  }\n  .star-btn:hover {\n    transform: translateY(-2px);\n    box-shadow:\n      0 0 60px rgba(139,92,246,0.35),\n      inset 0 1px 0 rgba(255,255,255,0.15);\n  }\n  .star-btn svg {\n    width: 20px; height: 20px; fill: currentColor;\n    transition: transform 0.3s;\n  }\n  .star-btn:hover svg {\n    transform: scale(1.15) rotate(-8deg);\n  }\n\n  /* ---- Divider ---- */\n  .divider {\n    height: 1px; border: none;\n    background: linear-gradient(90deg, transparent, var(--border), transparent);\n    margin: 0 40px;\n    position: relative; z-index: 2;\n  }\n\n  /* ---- Footer ---- */\n  footer {\n    position: relative; z-index: 2;\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 28px 40px;\n    font-size: 13px; color: var(--text-muted);\n    font-weight: 300;\n  }\n  footer a {\n    color: var(--text-muted); text-decoration: none;\n    transition: color 0.2s;\n  }\n  footer a:hover { color: var(--text-secondary); }\n  .ft-links { display: flex; gap: 20px; }\n\n  /* ---- Scroll animations ---- */\n  .anim-in {\n    opacity: 0; transform: translateY(24px);\n    transition: opacity 0.65s ease, transform 0.65s ease;\n  }\n  .anim-in.show {\n    opacity: 1; transform: translateY(0);\n  }\n\n  /* ---- Responsive ---- */\n  @media (max-width: 768px) {\n    nav { padding: 14px 20px; }\n    .hero { padding: 130px 24px 60px; }\n    .section-wrap { padding: 80px 24px; }\n    .feat-grid { grid-template-columns: 1fr; }\n    .star-cta { padding: 80px 24px; }\n    footer { padding: 24px 20px; flex-direction: column; gap: 12px; }\n  }\n  @media (max-width: 480px) {\n    .hero-actions { flex-direction: column; width: 100%; }\n    .btn-glow, .btn-ghost { justify-content: center; }\n    .nav-right a:not(.gh-btn) { display: none; }\n    .install-bar { width: 100%; }\n    .install-bar code { flex: 1; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"mesh-bg\"></div>\n<div class=\"noise\"></div>\n\n<!-- Navbar -->\n<nav>\n  <a href=\"#\" class=\"nav-brand\">agent<span class=\"dot\">\u00b7</span>bundle</a>\n  <div class=\"nav-right\">\n    <a href=\"#features\">Features</a>\n    <a href=\"#quickstart\">Quick Start</a>\n    <a href=\"https://www.npmjs.com/package/agent-bundle\">npm</a>\n    <a href=\"https://github.com/yujiachen-y/agent-bundle\" class=\"gh-btn\">\n      <svg viewBox=\"0 0 16 16\"><path d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z\"/></svg>\n      Star <span id=\"starCount\"></span>\n    </a>\n  </div>\n</nav>\n\n<!-- Hero -->\n<div class=\"hero\">\n  <h1>Define skills in YAML. Generate a production-ready agent service.</h1>\n  <p class=\"sub\">One YAML config. Prisma-style typed codegen.<br>Import the generated package into your own service.</p>\n\n  <!-- Install bar -->\n  <div class=\"install-bar\" id=\"installBar\" title=\"Click to copy\">\n    <code><span class=\"dollar\">$</span>npm install agent-bundle</code>\n    <button class=\"install-copy\" id=\"installCopy\">Copy</button>\n  </div>\n\n  <div class=\"hero-actions\">\n    <a href=\"#quickstart\" class=\"btn-glow\">Get Started</a>\n    <a href=\"https://github.com/yujiachen-y/agent-bundle\" class=\"btn-ghost\">\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z\"/></svg>\n      View on GitHub\n    </a>\n  </div>\n\n  <!-- Terminal with animated gradient border -->\n  <div class=\"terminal-container\">\n    <div class=\"term-border\">\n      <div class=\"term\">\n        <div class=\"term-chrome\">\n          <div class=\"term-circle r\"></div>\n          <div class=\"term-circle y\"></div>\n          <div class=\"term-circle g\"></div>\n          <span class=\"term-title\">~/personalized-recommend</span>\n        </div>\n        <div class=\"term-content\" id=\"terminal\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<hr class=\"divider\">\n\n<!-- Features -->\n<div class=\"section-wrap\" id=\"features\">\n  <div class=\"section-eyebrow anim-in\">Features</div>\n  <div class=\"section-heading anim-in\">Everything you need to ship agents.</div>\n  <div class=\"feat-grid\">\n    <div class=\"feat-cell\">\n      <div class=\"feat-icon\">\u26a1</div>\n      <h3>Type-safe codegen</h3>\n      <p>Prisma-style generate. Your YAML config becomes a typed TypeScript package you can import like any dependency.</p>\n    </div>\n    <div class=\"feat-cell\">\n      <div class=\"feat-icon\">\ud83d\udd13</div>\n      <h3>No vendor lock-in</h3>\n      <p>Anthropic, OpenAI, Gemini, OpenRouter \u2014 or run locally with Ollama, no API key needed. One line of YAML to swap.</p>\n    </div>\n    <div class=\"feat-cell\">\n      <div class=\"feat-icon\">\ud83e\udde9</div>\n      <h3>Plugin marketplace</h3>\n      <p>Pull skills and commands from a plugin marketplace. Local skills, local commands, and marketplace plugins \u2014 all merged into one typed bundle.</p>\n    </div>\n    <div class=\"feat-cell\">\n      <div class=\"feat-icon\">\ud83d\udc41</div>\n      <h3>Live sandbox view</h3>\n      <p>WebUI shows the agent's file tree, file preview, LLM transcript, and metrics dashboard as it runs. No more black boxes.</p>\n    </div>\n    <div class=\"feat-cell\">\n      <div class=\"feat-icon\">\ud83d\udcca</div>\n      <h3>Observability built in</h3>\n      <p>Token usage, tool call latency, error rates \u2014 visible in the dev UI and exportable via OpenTelemetry for production.</p>\n    </div>\n    <div class=\"feat-cell\">\n      <div class=\"feat-icon\">\ud83d\udee1</div>\n      <h3>Token-scoped MCP</h3>\n      <p>Connect to internal services via MCP servers. Even under prompt injection, the agent cannot exceed what the MCP server permits.</p>\n    </div>\n  </div>\n</div>\n\n<hr class=\"divider\">\n\n<!-- Quick Start -->\n<div class=\"section-wrap anim-in\" id=\"quickstart\">\n  <div class=\"qs-wrap\">\n    <div class=\"section-eyebrow\">Quick Start</div>\n    <div class=\"section-heading\">Three steps to your first agent.</div>\n\n    <div class=\"qs-step\">\n      <div class=\"qs-step-head\">\n        <div class=\"qs-num\">1</div>\n        <div class=\"qs-label\">Install</div>\n      </div>\n      <div class=\"qs-code\">\n        <button class=\"cp\" onclick=\"copyBlock(this)\">Copy</button>\n<pre><span class=\"p\">$</span> npm install agent-bundle</pre>\n      </div>\n    </div>\n\n    <div class=\"qs-step\">\n      <div class=\"qs-step-head\">\n        <div class=\"qs-num\">2</div>\n        <div class=\"qs-label\">Define your agent</div>\n      </div>\n      <div class=\"qs-code\">\n        <button class=\"cp\" onclick=\"copyBlock(this)\">Copy</button>\n<pre><span class=\"c\"># agent-bundle.yaml</span>\n<span class=\"k\">name</span>: personalized-recommend\n\n<span class=\"k\">model</span>:\n  <span class=\"k\">provider</span>: openrouter\n  <span class=\"k\">model</span>: <span class=\"s\">qwen/qwen3.5-397b-a17b</span>\n\n<span class=\"k\">sandbox</span>:\n  <span class=\"k\">provider</span>: e2b\n\n<span class=\"k\">skills</span>:\n  - <span class=\"k\">path</span>: <span class=\"s\">./skills/update-memory</span>\n  - <span class=\"k\">path</span>: <span class=\"s\">./skills/recommend</span></pre>\n      </div>\n    </div>\n\n    <div class=\"qs-step\">\n      <div class=\"qs-step-head\">\n        <div class=\"qs-num\">3</div>\n        <div class=\"qs-label\">Generate and import</div>\n      </div>\n      <div class=\"qs-code\">\n        <button class=\"cp\" onclick=\"copyBlock(this)\">Copy</button>\n<pre><span class=\"p\">$</span> npx agent-bundle generate  <span class=\"c\"># typed package \u2192 node_modules/</span>\n\n<span class=\"c\"># then in your code:</span>\n<span class=\"k\">import</span> { PersonalizedRecommend }\n  <span class=\"k\">from</span> <span class=\"s\">\"@agent-bundle/personalized-recommend\"</span>;</pre>\n      </div>\n    </div>\n  </div>\n</div>\n\n<hr class=\"divider\">\n\n<!-- Star CTA -->\n<div class=\"star-cta anim-in\">\n  <div class=\"star-cta-inner\">\n    <h2>Ship your first agent today.</h2>\n    <p>agent-bundle is open source and free forever. Star the repo to follow updates and help others discover it.</p>\n    <a href=\"https://github.com/yujiachen-y/agent-bundle\" class=\"star-btn\">\n      <svg viewBox=\"0 0 16 16\"><path d=\"M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z\"/></svg>\n      Star on GitHub\n    </a>\n  </div>\n</div>\n\n<!-- Footer -->\n<footer>\n  <span>MIT License \u00b7 agent-bundle</span>\n  <div class=\"ft-links\">\n    <a href=\"https://www.npmjs.com/package/agent-bundle\">npm</a>\n    <a href=\"https://github.com/yujiachen-y/agent-bundle\">GitHub</a>\n    <a href=\"https://github.com/yujiachen-y/agent-bundle/blob/main/docs/configuration.md\">Docs</a>\n  </div>\n</footer>\n\n<script>\n// ---- Typewriter terminal animation ----\nconst termEl = document.getElementById('terminal');\n\nconst sequence = [\n  { type: 'cmd', prompt: '$ ', text: 'cat agent-bundle.yaml', delay: 0 },\n  { type: 'out', cls: 'warn', text: 'name: personalized-recommend', delay: 600 },\n  { type: 'out', cls: 'dim', text: 'model:', delay: 800 },\n  { type: 'out', cls: 'dim', text: '  provider: openrouter', delay: 950 },\n  { type: 'out', cls: 'dim', text: 'sandbox:', delay: 1100 },\n  { type: 'out', cls: 'dim', text: '  provider: e2b', delay: 1250 },\n  { type: 'out', cls: 'dim', text: 'skills:', delay: 1400 },\n  { type: 'out', cls: 'dim', text: '  - path: ./skills/update-memory', delay: 1550 },\n  { type: 'out', cls: 'dim', text: '  - path: ./skills/recommend', delay: 1700 },\n  { type: 'blank', delay: 2200 },\n  { type: 'cmd', prompt: '$ ', text: 'npx agent-bundle generate', delay: 2600 },\n  { type: 'out', cls: 'dim', text: 'Generating bundle \"personalized-recommend\" ...', delay: 3300 },\n  { type: 'blank', delay: 3600 },\n  { type: 'out', cls: 'warn', text: '  node_modules/@agent-bundle/personalized-recommend/', delay: 3900 },\n  { type: 'out', cls: 'warn', text: '    index.ts      \u2190 typed agent factory', delay: 4200 },\n  { type: 'out', cls: 'warn', text: '    types.ts      \u2190 type definitions', delay: 4500 },\n  { type: 'out', cls: 'warn', text: '    bundle.json   \u2190 resolved config', delay: 4800 },\n  { type: 'out', cls: 'warn', text: '    package.json  \u2190 scoped package', delay: 5100 },\n  { type: 'blank', delay: 5400 },\n  { type: 'out', cls: 'ok', text: '\u2713 Generate completed \u2014 import and use in your service', delay: 5700 },\n];\n\nfunction typeText(container, text, charDelay) {\n  return new Promise(resolve => {\n    let i = 0;\n    // Add cursor\n    const cursor = document.createElement('span');\n    cursor.className = 'cursor-block';\n    container.appendChild(cursor);\n    function tick() {\n      if (i < text.length) {\n        cursor.before(document.createTextNode(text[i]));\n        i++;\n        setTimeout(tick, charDelay);\n      } else {\n        resolve();\n      }\n    }\n    tick();\n  });\n}\n\nfunction removeCursor() {\n  const c = termEl.querySelector('.cursor-block');\n  if (c) c.remove();\n}\n\nasync function playTerminal() {\n  termEl.innerHTML = '';\n\n  for (const item of sequence) {\n    await new Promise(r => setTimeout(r, item === sequence[0] ? 400 : 300));\n\n    if (item.type === 'blank') {\n      const div = document.createElement('div');\n      div.className = 'line show';\n      div.innerHTML = '&nbsp;';\n      termEl.appendChild(div);\n      continue;\n    }\n\n    if (item.type === 'cmd') {\n      removeCursor();\n      const div = document.createElement('div');\n      div.className = 'line show';\n      const promptSpan = document.createElement('span');\n      promptSpan.className = 'pr';\n      promptSpan.textContent = item.prompt;\n      div.appendChild(promptSpan);\n      const cmdSpan = document.createElement('span');\n      cmdSpan.className = 'cm';\n      div.appendChild(cmdSpan);\n      termEl.appendChild(div);\n      await typeText(cmdSpan, item.text, 32);\n      // Brief pause after typing command\n      await new Promise(r => setTimeout(r, 350));\n    }\n\n    if (item.type === 'out') {\n      removeCursor();\n      const div = document.createElement('div');\n      div.className = 'line';\n      div.innerHTML = `<span class=\"${item.cls}\">${item.text}</span>`;\n      termEl.appendChild(div);\n      requestAnimationFrame(() => div.classList.add('show'));\n    }\n\n    termEl.scrollTop = termEl.scrollHeight;\n  }\n}\n\nplayTerminal();\n\n// ---- Feature cards staggered reveal ----\nconst featObserver = new IntersectionObserver((entries) => {\n  entries.forEach(entry => {\n    if (entry.isIntersecting) {\n      const cells = entry.target.querySelectorAll('.feat-cell');\n      cells.forEach((cell, i) => {\n        setTimeout(() => cell.classList.add('visible'), i * 100);\n      });\n      featObserver.unobserve(entry.target);\n    }\n  });\n}, { threshold: 0.15 });\ndocument.querySelectorAll('.feat-grid').forEach(el => featObserver.observe(el));\n\n// ---- Scroll reveal for other sections ----\nconst io = new IntersectionObserver((entries) => {\n  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('show'); });\n}, { threshold: 0.12 });\ndocument.querySelectorAll('.anim-in').forEach(el => io.observe(el));\n\n// ---- Install bar copy ----\nconst installBar = document.getElementById('installBar');\nconst installCopy = document.getElementById('installCopy');\nfunction copyInstall() {\n  navigator.clipboard.writeText('npm install agent-bundle').then(() => {\n    installCopy.textContent = 'Copied!';\n    setTimeout(() => installCopy.textContent = 'Copy', 2000);\n  });\n}\ninstallBar.addEventListener('click', copyInstall);\n\n// ---- Fetch GitHub star count ----\nfetch('https://api.github.com/repos/yujiachen-y/agent-bundle')\n  .then(r => r.json())\n  .then(data => {\n    const count = data.stargazers_count;\n    if (typeof count === 'number') {\n      const el = document.getElementById('starCount');\n      if (el) el.textContent = count >= 1000 ? (count / 1000).toFixed(1) + 'k' : String(count);\n    }\n  })\n  .catch(() => {});\n\n// ---- Code block copy ----\nfunction copyBlock(btn) {\n  const pre = btn.parentElement.querySelector('pre');\n  const text = pre.textContent.trim();\n  navigator.clipboard.writeText(text).then(() => {\n    btn.textContent = 'Copied!';\n    setTimeout(() => btn.textContent = 'Copy', 1800);\n  });\n}\n</script>\n\n</body>\n</html>\n", "erro": "", "ms": 755}