303C10.1303 18.1406 10.1686 10.173 10.1303 9.34808H13.0527V10.593C13.441 9.9939 14.1359 9.14172 15.6865 9.14172C17.6093 9.14172 19.051 10.3984 19.051 13.099V18.1406Z\" fill=\"currentColor\"/>\n</g>\n</g>\n<defs>\n<clipPath id=\"clip0_2001_2298\">\n<rect width=\"24\" height=\"24\" fill=\"currentColor\"/>\n</clipPath>\n<clipPath id=\"clip1_2001_2298\">\n<rect width=\"24\" height=\"24\" fill=\"currentColor\"/>\n</clipPath>\n</defs>\n</svg></div></a></div><div class=\"text-small\">\u00a9 Sevorix\u2122 2026, All Rights Reserved</div></div></div></div></div><div class=\"big_text\"><h1 class=\"footer_text\">Sevorix</h1></div></div></section></div><script src=\"https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=69a6a7ae7ec6768c1bfc26dc\" type=\"text/javascript\" integrity=\"sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/69a6a7ae7ec6768c1bfc26dc/js/webflow.schunk.36b8fb49256177c8.js\" type=\"text/javascript\" integrity=\"sha384-4abIlA5/v7XaW1HMXKBgnUuhnjBYJ/Z9C1OSg4OhmVw9O3QeHJ/qJqFBERCDPv7G\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/69a6a7ae7ec6768c1bfc26dc/js/webflow.schunk.efa42a9f719c97e2.js\" type=\"text/javascript\" integrity=\"sha384-fMw7LyCPNIFQJkmkm9wLHNYYMZ6/n+UyARD6b4swFNFU7rZ7fRzypXJsXAkl0CH2\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/69a6a7ae7ec6768c1bfc26dc/js/webflow.7d9ee8c3.6a2364ce0d43ef96.js\" type=\"text/javascript\" integrity=\"sha384-O2/UrNddGqDzs1StANBoOLt4igueFVUnU9tIhRfTbldiluEAw/7EVo+5gkXEH+Sg\" crossorigin=\"anonymous\"></script><!-- Lenis script and styles -->\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1.3.4/dist/lenis.css\">\n<script src=\"https://unpkg.com/lenis@1.3.4/dist/lenis.min.js\"></script>\n\n<!-- Lenis setup -->\n<script>\n  const lenis = new Lenis({\n    smooth: true,\n    lerp: 0.1,\n    wheelMultiplier: 1,\n    infinite: false,\n  });\n\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n\n  requestAnimationFrame(raf);\n</script></body></html>", "erro": "", "ms": 1002}