{"status": 200, "url_final": "https://timepointai.com/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Timepoint AI \u2014 Decision simulation for teams.</title>\n  <meta name=\"description\" content=\"Timepoint is a console for rehearsing meetings, campaigns, and go-to-market decisions. Name the people and the decision; leave with labeled paths, a storyboard, cockpit, and report.\">\n  <meta name=\"keywords\" content=\"decision simulation, meeting rehearsal, campaign simulation, go-to-market simulation, scenario planning, labeled simulation\">\n  <link rel=\"canonical\" href=\"https://timepointai.com\">\n\n  <!-- Open Graph -->\n  <meta property=\"og:title\" content=\"Timepoint AI \u2014 Decision simulation for teams.\">\n  <meta property=\"og:description\" content=\"Walk into the room having already sat in it. Rehearse meetings, campaigns, and go-to-market decisions in the Timepoint console.\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:url\" content=\"https://timepointai.com\">\n  <meta property=\"og:image\" content=\"https://timepointai.com/og-image.png\">\n  <meta property=\"og:image:width\" content=\"1200\">\n  <meta property=\"og:image:height\" content=\"630\">\n  <meta property=\"og:site_name\" content=\"Timepoint AI\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:site\" content=\"@timepointai\">\n  <meta name=\"twitter:title\" content=\"Timepoint AI \u2014 Decision simulation for teams.\">\n  <meta name=\"twitter:description\" content=\"Walk into the room having already sat in it. Rehearse meetings, campaigns, and go-to-market decisions in the Timepoint console.\">\n  <meta name=\"twitter:image\" content=\"https://timepointai.com/og-image.png\">\n  <meta name=\"twitter:image:alt\" content=\"Timepoint AI \u2014 Decision simulation for teams.\">\n\n  <!-- AI Agent Discovery -->\n  <link rel=\"alternate\" type=\"application/json\" href=\"https://timepointai.com/.well-known/ai-plugin.json\">\n\n  <!-- Fonts -->\n  <link rel=\"stylesheet\" href=\"/fonts/fonts.css\">\n\n  <!-- Styles -->\n  <link rel=\"stylesheet\" href=\"/styles.css\">\n  <link rel=\"stylesheet\" href=\"/marketing.css?v=hero-temporal-graph\">\n\n  <!-- Favicon -->\n  <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n\n  <!-- JSON-LD Structured Data -->\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"SoftwareApplication\",\n    \"name\": \"Timepoint AI\",\n    \"description\": \"Timepoint is a console for rehearsing meetings, campaigns, and go-to-market decisions. Name the people and the decision; leave with labeled paths, a storyboard, cockpit, and report.\",\n    \"applicationCategory\": \"BusinessApplication\",\n    \"operatingSystem\": \"Web\",\n    \"url\": \"https://timepointai.com\",\n    \"screenshot\": \"https://timepointai.com/og-image.png\",\n    \"offers\": {\n      \"@type\": \"Offer\",\n      \"availability\": \"https://schema.org/LimitedAvailability\",\n      \"priceCurrency\": \"USD\",\n      \"description\": \"Limited access \u2014 by request. Request access to join.\"\n    },\n    \"creator\": {\n      \"@type\": \"Organization\",\n      \"name\": \"Timepoint AI\",\n      \"url\": \"https://timepointai.com\"\n    },\n    \"featureList\": [\n      \"Meeting rehearsal\",\n      \"Campaign variant testing\",\n      \"Go-to-market scenario testing\",\n      \"Labeled storyboard, cockpit, and report output\",\n      \"Revocable share links\"\n    ]\n  }\n  </script>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Organization\",\n    \"name\": \"Timepoint AI\",\n    \"url\": \"https://timepointai.com\",\n    \"logo\": \"https://timepointai.com/logo-full-alpha.svg\",\n    \"sameAs\": [\n      \"https://x.com/timepointai\",\n      \"https://github.com/timepointai\"\n    ]\n  }\n  </script>\n<script>\n    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(\".\");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement(\"script\")).type=\"text/javascript\",p.crossOrigin=\"anonymous\",p.async=!0,p.src=s.api_host+\"/static/array.js\",(r=t.getElementsByTagName(\"script\")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a=\"posthog\",u.people=u.people||[],u.toString=function(t){var e=\"posthog\";return\"posthog\"!==a&&(e+=\".\"+a),t||(e+=\" (stub)\"),e},u.people.toString=function(){return u.toString(1)+\".people (stub)\"},o=\"init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onFeatureFlags onSessionId\".split(\" \"),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);\n    posthog.init('phc_WWMUGb20gLrNr8ghIxL6dx5gvwvnj0YGRv0mKRVYWkO',{api_host:'https://us.i.posthog.com',person_profiles:'identified_only'});\n  </script>\n</head>\n<body>\n\n<!-- ALPHA BANNER -->\n<div class=\"alpha-banner\" id=\"alpha-banner\">\n  <span class=\"alpha-badge\">ALPHA</span>\n  <span class=\"alpha-text\">Timepoint is in alpha</span>\n  <button class=\"alpha-close\" onclick=\"this.parentElement.remove();localStorage.setItem('ab-d','1')\">&times;</button>\n</div>\n<script>if(localStorage.getItem('ab-d'))document.getElementById('alpha-banner')?.remove()</script>\n\n<!-- NAV -->\n<nav class=\"site-nav\">\n  <div class=\"nav-inner\">\n    <a href=\"/\" class=\"nav-logo\" aria-label=\"Timepoint AI\">\n      <img src=\"/logo-full-alpha-light.svg\" height=\"30\" alt=\"Timepoint AI\">\n    </a>\n    <button class=\"nav-hamburger\" aria-label=\"Menu\">\n      <span></span><span></span><span></span>\n    </button>\n    <div class=\"nav-links\">\n      <a href=\"/#result\">Product</a>\n      <a href=\"/#console-jobs\">Use cases</a>\n      <a href=\"/#examples\">Examples</a>\n      <a href=\"/evidence\">Evidence</a>\n      <a href=\"/#request-access\" class=\"nav-cta\">Request</a>\n    </div>\n  </div>\n</nav>\n\n<!-- HERO -->\n<div class=\"hero mkt-hero\">\n  <div class=\"mkt-hero-inner\">\n    <div class=\"mkt-hero-copy\">\n      <div class=\"mkt-hero-eyebrow\">Decision simulation for teams</div>\n      <h1 class=\"hero-headline\">Walk into the room<br><span class=\"hero-accent\">having already sat in it.</span></h1>\n      <p class=\"mkt-hero-sub\">\n        Timepoint is a console for rehearsing meetings, campaigns, and go-to-market decisions. Name the people and the decision; leave with labeled paths, a storyboard, cockpit, and report.\n      </p>\n      <p class=\"mkt-hero-example\">Example: Which format survives the greenlight room?</p>\n      <div class=\"mkt-hero-ctas\">\n        <a href=\"/blog/harbourline-studios-an-independent-factual-content-producer-with-2026-08-16\" class=\"cta-primary\">See a sample result &rarr;</a>\n        <a href=\"#request-access\" class=\"mkt-text-cta\">Request a scoped run &rarr;</a>\n      </div>\n    </div>\n    <div class=\"mkt-hero-visual\">\n      <figure class=\"mkt-hero-graph\">\n        <img src=\"/hero-temporal-branch.svg?v=2\" width=\"720\" height=\"500\" alt=\"One decision branching into three labeled simulations over time, with the simulation's leading path highlighted and alternative paths still visible.\">\n        <figcaption class=\"mkt-hero-figure-note\">AI-generated simulation by Timepoint AI. The scenario, actors and outcomes are invented to demonstrate the method &mdash; not reporting, not a transcript, not a prediction service.</figcaption>\n      </figure>\n    </div>\n  </div>\n</div>\n\n<!-- THE RESULT -->\n<section class=\"reveal tpl tpl-result\" id=\"result\">\n  <div class=\"section-label\">The product</div>\n  <h2 class=\"section-title\">A simulation console for the decisions people argue over</h2>\n  <p class=\"section-body\">Name the room and the decision. Read the ordered paths, the people moving them, and the written reasoning in a labeled result.</p>\n\n  <div class=\"mkt-result-stage\">\n    <div class=\"mkt-result-artifact\">\n      <div class=\"mkt-result-artifact-head\">\n        <div>\n          <span class=\"mkt-result-eyebrow\">Harbourline Studios &middot; fictional demonstration</span>\n          <h3>Which format survives the greenlight room?</h3>\n        </div>\n        <span class=\"mkt-result-stamp\">Labeled simulation</span>\n      </div>\n      <div class=\"mkt-result-grid\">\n        <div>\n          <div class=\"mkt-result-column-label\">Ranked paths</div>\n          <ol class=\"mkt-result-branches\">\n            <li><span>01</span><p>Format B proceeds to production with the Distribution Head&rsquo;s backing and budget oversight in place.</p></li>\n            <li><span>02</span><p>Format B is greenlit, but budget caps or milestone gates constrain creative execution.</p></li>\n            <li><span>03</span><p>The selection is reversed in review when the Finance Director escalates the budget objection.</p></li>\n          </ol>\n        </div>\n        <div class=\"mkt-result-notes\">\n          <div>\n            <div class=\"mkt-result-column-label\">People moving the room</div>\n            <p>The Distribution Head controls the production slot. The Finance Director controls the budget gate. The Commissioning Lead opens the choice, while the Channel Partner can force reconsideration.</p>\n          </div>\n          <div>\n            <div class=\"mkt-result-column-label\">Reasoning</div>\n            <p>The leading path requires the Finance Director&rsquo;s explicit budget sign-off before production contracts. Slot authority alone does not clear the execution gate.</p>\n          </div>\n          <div class=\"mkt-result-caveat\">\n            <strong>How to read the order</strong>\n            <p>Ranked by the simulation, uncalibrated. This is an internal ranking, not a probability.</p>\n          </div>\n        </div>\n      </div>\n      <p class=\"mkt-result-disclosure\">AI-generated simulation by Timepoint AI. The scenario, actors and outcomes are invented to demonstrate the method &mdash; not reporting, not a transcript, not a prediction service.</p>\n      <a href=\"/blog/harbourline-studios-an-independent-factual-content-producer-with-2026-08-16\" class=\"tpl-link\">Open the complete sample &rarr;</a>\n    </div>\n\n    <aside class=\"mkt-typical-note\">\n      <div class=\"mkt-result-column-label\">Typical unlabeled output</div>\n      <p>Format B is the strongest concept. The team will support it, budget risk is manageable, and production should proceed.</p>\n    </aside>\n  </div>\n</section>\n\n<!-- CONSOLE JOBS -->\n<section class=\"reveal tpl band-alt\" id=\"console-jobs\">\n  <div class=\"section-label\">After access</div>\n  <h2 class=\"section-title\">Name the room. Repeat the job.</h2>\n  <p class=\"section-body\">Public-record assembly is how a demonstration starts. The Timepoint console is where you run your meeting, your campaign variants, or your first segment.</p>\n  <div class=\"mkt-jobs-grid\">\n    <div class=\"mkt-job-group\">\n      <div class=\"mkt-job-kicker\">This week</div>\n      <h3>Meetings &middot; Campaign &middot; Go to market</h3>\n      <p>Rehearse the next sitting. Test messages on a panel. Push an offer through its first segment.</p>\n    </div>\n    <div class=\"mkt-job-group\">\n      <div class=\"mkt-job-kicker\">The desk</div>\n      <h3>Today &middot; Tomorrow &middot; Yesterday</h3>\n      <p>Today is the desk. Tomorrow runs what-ifs. Yesterday waits for you to record what the world did.</p>\n    </div>\n    <div class=\"mkt-job-group\">\n      <div class=\"mkt-job-kicker\">The reading</div>\n      <h3>Storyboard &middot; Cockpit &middot; Report &middot; Share</h3>\n      <p>Walk the scenes, inspect the trace, take the memo, or send a revocable reading without asking the recipient to create an account.</p>\n    </div>\n  </div>\n</section>\n\n<!-- DIFFERENTIATION -->\n<section class=\"reveal tpl\" id=\"different\">\n  <div class=\"section-label\">The difference</div>\n  <h2 class=\"section-title\">The room stays visible in the answer</h2>\n  <div class=\"mkt-difference-grid\">\n    <div class=\"mkt-difference\">\n      <h3>Named people under pressure</h3>\n      <p>Rehearse a meeting, test campaign variants, or push a go-to-market motion. The people, blockers, and decision stay named.</p>\n    </div>\n    <div class=\"mkt-difference\">\n      <h3>Branches with written reasoning</h3>\n      <p>Stress-test the decision tree. Read why a path holds and where runs disagree instead of receiving a single score.</p>\n    </div>\n    <div class=\"mkt-difference\">\n      <h3>Simulation labeled in the output</h3>\n      <p>The caveat travels with the result. You can quote the branch without laundering the simulation as fact.</p>\n    </div>\n  </div>\n</section>\n\n<!-- EXAMPLES -->\n<section class=\"reveal tpl band-alt\" id=\"examples\">\n  <div class=\"section-label\">What teams run</div>\n  <h2 class=\"section-title\">See it in practice</h2>\n  <p class=\"section-body\">The product stays the same; the room and the decision change.</p>\n  <div class=\"use-cases\">\n    <div class=\"use-case\">\n      <div class=\"use-case-title\">Meetings</div>\n      <div class=\"use-case-body\">Rehearse the meeting on the other side of the decision.</div>\n      <a href=\"/blog/the-other-sides-tuesday-meeting\" class=\"mkt-example-link\">The other side&rsquo;s Tuesday meeting &rarr;</a>\n    </div>\n    <div class=\"use-case\">\n      <div class=\"use-case-title\">Campaign</div>\n      <div class=\"use-case-body\">Test messages against the audience that can stall them.</div>\n      <a href=\"/blog/after-the-trend-report\" class=\"mkt-example-link\">After the trend report &rarr;</a>\n    </div>\n    <div class=\"use-case\">\n      <div class=\"use-case-title\">Go to market</div>\n      <div class=\"use-case-body\">Run the first segment forward and see who moves when you arrive.</div>\n      <a href=\"/blog/which-city-next\" class=\"mkt-example-link\">Which city next &rarr;</a>\n    </div>\n    <div class=\"use-case\">\n      <div class=\"use-case-title\">Programming decisions</div>\n      <div class=\"use-case-body\">Put competing bets into the same greenlight room.</div>\n      <a href=\"/blog/which-format-survives\" class=\"mkt-example-link\">Which format survives &rarr;</a>\n    </div>\n    <div class=\"use-case\">\n      <div class=\"use-case-title\">Program expansion</div>\n      <div class=\"use-case-body\">Follow the stakeholders, calendars, and pipeline behind growth.</div>\n      <a href=\"/blog/where-the-program-grows\" class=\"mkt-example-link\">Where the program grows &rarr;</a>\n    </div>\n    <div class=\"use-case\">\n      <div class=\"use-case-title\">Diligence</div>\n      <div class=\"use-case-body\">Read your own plan from the adversarial side.</div>\n      <a href=\"/blog/what-would-have-to-be-true\" class=\"mkt-example-link\">What would have to be true &rarr;</a>\n    </div>\n  </div>\n</section>\n\n<!-- METHOD -->\n<section class=\"reveal tpl\" id=\"how-it-works\">\n  <div class=\"section-label\">How it works</div>\n  <h2 class=\"section-title\">Name. Review. Read. Observe.</h2>\n  <div class=\"mkt-steps\">\n    <div class=\"mkt-step\">\n      <div class=\"mkt-step-num\">01</div>\n      <div class=\"mkt-step-title\">Name the job</div>\n      <div class=\"mkt-step-body\">Choose Meetings, Campaign, Go to market, or Pro. Name the room and the decision it must inform.</div>\n    </div>\n    <div class=\"mkt-step\">\n      <div class=\"mkt-step-num\">02</div>\n      <div class=\"mkt-step-title\">Review the price</div>\n      <div class=\"mkt-step-body\">Planning is free. Planned runs return a quote to confirm; quick runs show their price before they start.</div>\n    </div>\n    <div class=\"mkt-step\">\n      <div class=\"mkt-step-num\">03</div>\n      <div class=\"mkt-step-title\">Take the reading</div>\n      <div class=\"mkt-step-body\">Open the storyboard, cockpit, or report. Send a revocable share link when someone else needs the result.</div>\n    </div>\n    <div class=\"mkt-step\">\n      <div class=\"mkt-step-num\">04</div>\n      <div class=\"mkt-step-title\">Record what happened</div>\n      <div class=\"mkt-step-body\">Yesterday waits for your observation. The product does not invent an outcome to look finished.</div>\n    </div>\n  </div>\n  <p class=\"mkt-method-note\">Files are optional and later. Collision rule applies. <a href=\"/quiet-engagements\" class=\"tpl-link\">How a quiet engagement runs &rarr;</a></p>\n</section>\n\n<!-- TRUST -->\n<section class=\"reveal tpl band-alt\" id=\"evidence\">\n  <div class=\"section-label\">Trust</div>\n  <h2 class=\"section-title\">What we can show, and what we will not claim</h2>\n  <div class=\"mkt-trust-grid\">\n    <div>\n      <h3>What we can show</h3>\n      <p>A published demonstration. A blind replay of a decision you made before you tell us how it turned out. The branch order, reasoning, and disagreement between runs.</p>\n    </div>\n    <div>\n      <h3>What we will not claim</h3>\n      <p>No accuracy percentage. No real client named without written consent. The ranking caveat stays beside the sample.</p>\n    </div>\n  </div>\n  <p class=\"tpl-link-row\"><a href=\"/evidence\" class=\"tpl-link\">Read the evidence standard &rarr;</a></p>\n</section>\n\n<!-- SCOPED RUN -->\n<section class=\"mkt-subscribe-section reveal\" id=\"request-access\">\n  <div class=\"mkt-subscribe-inner\">\n    <div class=\"section-label\">Access</div>\n    <h2 class=\"section-title\">Request a scoped run</h2>\n    <p class=\"mkt-subscribe-desc\">Founder-delivered. One live question at a time. Scope and price are set in one conversation. After access, repeat the work in the Timepoint console.</p>\n    <form class=\"mkt-request-form\" id=\"request-access-form\" novalidate>\n      <div class=\"mkt-request-row\">\n        <input type=\"text\" placeholder=\"Your name\" class=\"mkt-subscribe-input\" id=\"request-name\" autocomplete=\"name\" aria-label=\"Your name\">\n        <input type=\"email\" placeholder=\"you@firm.com\" required class=\"mkt-subscribe-input\" id=\"request-email\" autocomplete=\"email\" aria-label=\"Email address\">\n      </div>\n      <textarea placeholder=\"What decision do you want to run?\" class=\"mkt-request-textarea\" id=\"request-usecase\" rows=\"3\" aria-label=\"What decision do you want to run\"></textarea>\n      <!-- Honeypot: off-screen, unfocusable, hidden from assistive tech. Only bots fill this. -->\n      <input type=\"text\" id=\"request-hp\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\" style=\"position:absolute;left:-9999px;width:1px;height:1px;opacity:0;\">\n      <button type=\"submit\" class=\"mkt-subscribe-btn\" id=\"request-btn\">Request a scoped run</button>\n    </form>\n    <div class=\"mkt-subscribe-msg\" id=\"request-msg\" role=\"status\" aria-live=\"polite\" style=\"display:none;\"></div>\n    <p class=\"mkt-subscribe-privacy\">We&rsquo;ll never share your address. See our <a href=\"/privacy\">Privacy Policy</a>.</p>\n  </div>\n</section>\n\n<!-- FOOTER -->\n<footer>\n  <div class=\"footer-grid footer-grid-compact\">\n    <div class=\"footer-about\">\n      Timepoint simulates named decision rooms and returns labeled, ranked paths with the reasoning written out. Alpha.\n    </div>\n  </div>\n  <div class=\"footer-bottom\">\n    <img src=\"/logo-glyph.svg\" alt=\"\" width=\"20\" height=\"20\" style=\"opacity:0.2; margin-bottom:8px;\">\n    <span class=\"footer-copy\">&copy; 2026 Timepoint AI &middot; timepointai.com</span>\n  </div>\n\n  <div class=\"footer-links\">\n    <a href=\"/blog/harbourline-studios-an-independent-factual-content-producer-with-2026-08-16\">Sample</a>\n    <a href=\"/whitepaper\">Whitepaper</a>\n    <a href=\"/blog\">Journal</a>\n    <a href=\"/evidence\">Evidence</a>\n    <a href=\"/telemetry\">Telemetry</a>\n    <a href=\"/clockchain\">Clockchain</a>\n    <a href=\"/quiet-engagements\">Quiet Engagements</a>\n    <a href=\"/contact\">Contact</a>\n    <a href=\"/privacy\">Privacy</a>\n    <a href=\"/terms\">Terms</a>\n  </div>\n  <p class=\"footer-ledger\">Simulations are labeled as simulations. We don't publish accuracy claims.</p>\n</footer>\n\n<!-- Timepoint Detail Modal -->\n\n<!-- Scripts -->\n<script src=\"/main.js\"></script>\n<script>\n// Scoped-run form \u2014 captures name/email/use-case to /api/request-access.\n// Server stores the request, emails the user a confirmation, and notifies the team.\n(function() {\n  var form = document.getElementById('request-access-form');\n  if (!form) return;\n  var nameEl = document.getElementById('request-name');\n  var emailEl = document.getElementById('request-email');\n  var useEl = document.getElementById('request-usecase');\n  var btn = document.getElementById('request-btn');\n  var msg = document.getElementById('request-msg');\n  var BTN_LABEL = 'Request a scoped run';\n  var EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  function showMsg(text, kind) {\n    msg.textContent = text;\n    msg.className = 'mkt-subscribe-msg mkt-subscribe-msg-' + kind;\n    msg.style.display = 'block';\n  }\n\n  form.addEventListener('submit', function(e) {\n    e.preventDefault();\n    var email = (emailEl.value || '').trim();\n    if (!EMAIL_RE.test(email)) {\n      showMsg('Please enter a valid email address.', 'error');\n      emailEl.focus();\n      return;\n    }\n    btn.disabled = true;\n    btn.textContent = 'Sending...';\n    msg.style.display = 'none';\n\n    fetch('/api/request-access', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        name: (nameEl.value || '').trim(),\n        email: email,\n        use_case: (useEl.value || '').trim(),\n        website: (document.getElementById('request-hp') || {}).value || ''\n      })\n    }).then(function(res) {\n      return res.json().catch(function() { return {}; }).then(function(data) {\n        return { ok: res.ok, status: res.status, data: data };\n      });\n    }).then(function(r) {\n      if (r.ok && r.data && r.data.success) {\n        form.style.display = 'none';\n        showMsg(\"Thanks \u2014 we'll be in touch about the decision.\", 'success');\n        return;\n      }\n      btn.disabled = false;\n      btn.textContent = BTN_LABEL;\n      if (r.status === 429) {\n        showMsg('Too many requests \u2014 please try again in a moment.', 'error');\n      } else {\n        showMsg((r.data && r.data.message) || 'Something went wrong. Please try again.', 'error');\n      }\n    }).catch(function() {\n      btn.disabled = false;\n      btn.textContent = BTN_LABEL;\n      showMsg('Could not reach our servers. Please try again.', 'error');\n    });\n  });\n})();\n</script>\n\n</body>\n</html>\n", "erro": "", "ms": 1122}