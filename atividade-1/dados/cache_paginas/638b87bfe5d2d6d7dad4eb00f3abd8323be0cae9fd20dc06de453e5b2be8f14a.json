-faint);\n  text-wrap: pretty;\n}\n.hire-alt a {\n  color: var(--muted);\n  text-decoration: underline;\n  text-underline-offset: 2px;\n}\n.hire-alt a:hover {\n  color: var(--fg);\n}\n@media (max-width: 560px) {\n  .field-row {\n    grid-template-columns: 1fr;\n    gap: 0;\n  }\n}\n</style>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Organization\",\n    \"@id\": \"https://flynnhq.com/#organization\",\n    \"name\": \"Flynn\",\n    \"url\": \"https://flynnhq.com/\",\n    \"parentOrganization\": { \"@id\": \"https://ionalpha.io/#organization\" },\n    \"sameAs\": [\n      \"https://ionalpha.io/\",\n      \"https://github.com/ionalpha\"\n    ]\n  }\n  </script>\n<!-- ssg:headmeta -->\n  <meta property=\"og:site_name\" content=\"Flynn\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:title\" content=\"Flynn\">\n  <meta property=\"og:description\" content=\"A secure, self-improving agent operating system in a single Go binary. Bring your own model, point it at a goal, and grant it real authority, because every action is sandboxed, governed, and sealed into a verifiable, tamper-evident record.\">\n  <meta property=\"og:url\" content=\"https://flynnhq.com/\">\n  <meta property=\"og:locale\" content=\"en\">\n  <meta name=\"twitter:card\" content=\"summary\">\n  <meta name=\"twitter:title\" content=\"Flynn\">\n  <meta name=\"twitter:description\" content=\"A secure, self-improving agent operating system in a single Go binary. Bring your own model, point it at a goal, and grant it real authority, because every action is sandboxed, governed, and sealed into a verifiable, tamper-evident record.\">\n  <link rel=\"alternate\" type=\"application/rss+xml\" title=\"Flynn\" href=\"https://flynnhq.com/feed.xml\">\n  <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"description\":\"A secure, self-improving agent operating system in a single Go binary.\",\"name\":\"Flynn\",\"url\":\"https://flynnhq.com/\"}</script>\n  <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Flynn\",\"url\":\"https://flynnhq.com/\"}</script>\n<link data-ion-preconnect rel=\"preconnect\" href=\"https://subscribe.flynnhq.com\" crossorigin>\n</head>\n<body>\n  <main>\n    \n\n<header class=\"topbar\">\n  <a class=\"topbar-link\" href=\"/posts/flynn-the-reference-implementation/\">Why you shouldn't trust your agent &rarr;</a>\n  <div class=\"topbar-right\">\n    <a class=\"topbar-cta\" href=\"/hire/\">Hire us</a>\n    <a class=\"gh-link\" href=\"https://github.com/ionalpha/flynn\" aria-label=\"Flynn on GitHub\">\n      <svg class=\"gh-icon\" viewBox=\"0 0 16 16\" width=\"18\" height=\"18\" aria-hidden=\"true\" fill=\"currentColor\">\n        <path d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z\"></path>\n      </svg>\n      <span>GitHub</span>\n    </a>\n  </div>\n</header>\n\n<section class=\"hero\">\n  <div class=\"hero-inner\">\n    <h1 class=\"wordmark\">Flynn</h1>\n\n    <p class=\"tagline\">\n      A secure, self-improving agent operating system in a single Go binary.\n    </p>\n\n    <p class=\"lede\">\n      Bring your own model, point it at a goal, and grant it real authority. Every\n      action is sandboxed, governed, and sealed into a verifiable, tamper-evident\n      record. It runs standalone from a laptop to a $5 VPS, works with any model\n      provider, and stores all of its state locally, so you own it.\n    </p>\n\n    \n<p class=\"signup-lead\">\n  \n  Get in early on the community around it: founders, engineers, and\n  researchers handing agents real authority.\n  \n</p>\n\n\n<form class=\"signup\" id=\"signup\" data-ion-form=\"subscribe\" method=\"post\" novalidate>\n  <div class=\"signup-row\">\n    <input\n      class=\"signup-email\"\n      type=\"email\"\n      name=\"email\"\n      data-ion-field=\"email\"\n      inputmode=\"email\"\n      autocomplete=\"email\"\n      placeholder=\"you@example.com\"\n      aria-label=\"Email address\"\n      required\n    >\n    <button class=\"btn btn-primary\" type=\"submit\">Get in early</button>\n  </div>\n\n  <input type=\"hidden\" name=\"source\" value=\"flynnhq-home\">\n\n  <label class=\"consent\">\n    <input type=\"checkbox\" name=\"consent\" value=\"on\" id=\"consent\" data-ion-field=\"consent\" required>\n    <span id=\"consent-text\">I agree to receive email updates and accept the <a href=\"/privacy/\" data-ion-privacy-link>privacy policy</a>.</span>\n  </label>\n\n  <p class=\"signup-status is-ok\" data-ion-status=\"success\" role=\"status\" hidden>You're on the list. Talk soon.</p>\n  <p class=\"signup-status is-ok\" data-ion-status=\"pending\" role=\"status\" hidden>Almost there. Check your inbox to confirm.</p>\n  <p class=\"signup-status is-err\" data-ion-error role=\"alert\"></p>\n</form>\n\n\n    <ul class=\"features\" aria-label=\"What Flynn does\">\n      <li class=\"feature\">\n        <h3>Run any model, even local</h3>\n        <p>Provider-agnostic across hosted and open-weight models, with hardware-fit checks and one-command fetch-and-run. No lock-in.</p>\n      </li>\n      <li class=\"feature\">\n        <h3>One binary, zero runtime</h3>\n        <p>No Python, no Node, no node_modules. <code>curl | sh</code> and it runs, from a laptop to a $5 VPS.</p>\n      </li>\n      <li class=\"feature\">\n        <h3>Hard cost ceilings</h3>\n        <p>Per-run token and dollar budgets it cannot exceed. Runaway spend is structurally impossible.</p>\n      </li>\n      <li class=\"feature\">\n        <h3>Real authority, audited</h3>\n        <p>Every action is capability-scoped, sandboxed, and sealed into a tamper-evident record you can verify.</p>\n      </li>\n      <li class=\"feature\">\n        <h3>Learns as it works</h3>\n        <p>Captures skills and memory from real work, and reinforces what actually succeeds.</p>\n      </li>\n      <li class=\"feature\">\n        <h3>Plans and orchestrates</h3>\n        <p>Turns a goal into a plan and fans it out into concurrent, governed runs. It does not just chat.</p>\n      </li>\n    </ul>\n\n    <p class=\"footnote\">\n      Open source \u00b7 Apache-2.0 licensed \u00b7 Open standard: <a href=\"https://provetrail.org\">Provetrail</a> \u00b7 Embedded into <a href=\"https://ionalpha.io\">Ion Alpha</a> \u00b7 <a href=\"/hire/\">Hire us</a>\n    </p>\n  </div>\n</section>\n\n\n  </main>\n  <script src=\"/assets/js/main.d020b9ef.js\" defer></script>\n<script defer src=\"/assets/js/a.7e472ba5.js\" data-site-key=\"pk_422da30ad6f6a4423d21ad850edd7c1f\" data-api=\"https://analytics.flynnhq.com/api/analytics/collect\"></script>\n<script defer src=\"/assets/js/forms.c40a5e88.js\" data-api=\"https://subscribe.flynnhq.com\"></script>\n</body>\n</html>\n", "erro": "", "ms": 850}