{"status": 200, "url_final": "https://meodai.github.io/ray-color/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n  <title>Ray Color</title>\n  <meta name=\"description\" content=\"Generative color palettes from a raytraced scene \u2014 edit the conditions, not the colors. Place lights, drag a circle across a sphere, harvest the palette.\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:url\" content=\"https://meodai.github.io/ray-color/\">\n  <meta property=\"og:title\" content=\"Ray Color\">\n  <meta property=\"og:description\" content=\"Generative color palettes from a raytraced scene \u2014 edit the conditions, not the colors.\">\n  <meta property=\"og:image\" content=\"https://meodai.github.io/ray-color/og-image.png\">\n  <meta property=\"og:image:width\" content=\"2400\">\n  <meta property=\"og:image:height\" content=\"1260\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"Ray Color\">\n  <meta name=\"twitter:description\" content=\"Generative color palettes from a raytraced scene \u2014 edit the conditions, not the colors.\">\n  <meta name=\"twitter:image\" content=\"https://meodai.github.io/ray-color/og-image.png\">\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/ray-color/vite.svg\">\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/Iosevka/6.0.0/iosevka/iosevka.min.css\">\n  <script type=\"module\" crossorigin src=\"/ray-color/assets/index-C43J36Ud.js\"></script>\n  <link rel=\"stylesheet\" crossorigin href=\"/ray-color/assets/index-CV_JFHMf.css\">\n</head>\n\n<body>\n  <main class=\"l-wrap\">\n    <div class=\"l-main\" id=\"app\">\n\n      <header class=\"l-app__header\">\n        <div class=\"menu\">\n          <div class=\"seg\" role=\"group\" aria-label=\"Sampling mode\">\n            <button class=\"button button--icon seg__btn\" data-mode=\"points\" title=\"Points\">\n              <svg class=\"button__icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"4.5\" cy=\"5.2\" r=\"1.7\" fill=\"currentColor\"/><circle cx=\"11.4\" cy=\"4\" r=\"1.7\" fill=\"currentColor\"/><circle cx=\"8.6\" cy=\"11.6\" r=\"1.7\" fill=\"currentColor\"/></svg>\n              <span>Points</span>\n            </button>\n            <button class=\"button button--icon seg__btn\" data-mode=\"line\" title=\"Line\">\n              <svg class=\"button__icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.2 12.3 Q 7 4.5 12.8 5.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><circle cx=\"3.2\" cy=\"12.3\" r=\"1.7\" fill=\"currentColor\"/><circle cx=\"12.8\" cy=\"5.8\" r=\"1.7\" fill=\"currentColor\"/></svg>\n              <span>Line</span>\n            </button>\n            <button class=\"button button--icon seg__btn seg__btn--active\" data-mode=\"circle\" title=\"Circle\">\n              <svg class=\"button__icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><circle cx=\"12.4\" cy=\"5.6\" r=\"1.7\" fill=\"currentColor\"/></svg>\n              <span>Circle</span>\n            </button>\n          </div>\n          <div class=\"button button--label button--count\" id=\"shapeCountWrap\" hidden>\n            <label for=\"shapeCount\">Points</label>\n            <span class=\"numberslider\" style=\"--relval: 0.167\">\n              <button class=\"numberslider__button\" type=\"button\" id=\"shapeCountMinus\">-</button>\n              <input class=\"numberslider__input\" type=\"number\" id=\"shapeCount\" min=\"2\" max=\"32\" value=\"7\">\n              <button class=\"numberslider__button\" type=\"button\" id=\"shapeCountPlus\">+</button>\n            </span>\n          </div>\n          <div class=\"seg\" id=\"spacingSeg\" role=\"group\" aria-label=\"Point spacing\" hidden>\n            <button class=\"button button--icon seg__btn seg__btn--active\" data-spacing=\"linear\" title=\"Linear spacing\">\n              <svg class=\"button__icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2 8H14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\"/><circle cx=\"2.5\" cy=\"8\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"8\" cy=\"8\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"13.5\" cy=\"8\" r=\"1.4\" fill=\"currentColor\"/></svg>\n              <span>Linear</span>\n            </button>\n            <button class=\"button button--icon seg__btn\" data-spacing=\"smoothstep\" title=\"Smoothstep spacing\">\n              <svg class=\"button__icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2 8H14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\"/><circle cx=\"2.5\" cy=\"8\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"4.6\" cy=\"8\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"11.4\" cy=\"8\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"13.5\" cy=\"8\" r=\"1.4\" fill=\"currentColor\"/></svg>\n              <span>Smooth</span>\n            </button>\n          </div>\n          <span class=\"menu__spacer\"></span>\n          <span class=\"menu__brand\">Ray Color</span>\n        </div>\n      </header>\n\n      <div class=\"l-stage\">\n      <div class=\"l-body\">\n        <ray-color-view id=\"view\" controls mode=\"circle\" count=\"7\"></ray-color-view>\n      </div>\n\n      <button class=\"button button--icon drawer-toggle\" id=\"drawerToggleBtn\" title=\"Open the palette drawer\" aria-controls=\"colorOverlay\">\n        <svg class=\"button__icon\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M12 4V14M8 10L12 14L16 10\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          <path d=\"M5 19H19\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path>\n        </svg>\n        <span>Colors</span>\n      </button>\n      <div class=\"l-overlay l-overlay--left\" id=\"colorOverlay\" aria-label=\"Sampled colors\">\n        <div class=\"l-overlay__body\">\n          <div class=\"palette\" id=\"palette\"></div>\n          <div class=\"lib-snippet\">\n            <pre class=\"code\" title=\"Click to copy\"><code id=\"libSnippetCode\"></code></pre>\n          </div>\n        </div>\n        <div class=\"l-overlay__footer\">\n          <div class=\"menu menu--end menu--export\">\n            <button class=\"button button--icon\" id=\"tokenBeamBtn\" title=\"Token Beam \u2014 click to copy the pairing token\">\n              <svg class=\"button__icon\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <circle cx=\"6\" cy=\"12\" r=\"2.5\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.5\"></circle>\n                <path d=\"M8.5 12H15.5\" stroke=\"currentColor\" stroke-width=\"1.5\"></path>\n                <circle cx=\"18\" cy=\"12\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.5\"></circle>\n              </svg>\n              <span></span>\n            </button>\n            <button class=\"button button--icon\" id=\"copyPaletteBtn\" title=\"Copy palette\">\n              <svg class=\"button__icon\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <rect x=\"5\" y=\"7\" width=\"12\" height=\"12\" rx=\"1.8\" stroke=\"currentColor\" stroke-width=\"1.5\"></rect>\n                <rect x=\"8\" y=\"4\" width=\"12\" height=\"12\" rx=\"1.8\" stroke=\"currentColor\" stroke-width=\"1.5\" fill=\"var(--bg)\"></rect>\n              </svg>\n              <span>Copy</span>\n            </button>\n            <button class=\"button button--end button--icon\" id=\"downloadPaletteBtnPNG\" title=\"Download render + palette PNG\">\n              <svg class=\"button__icon\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M7 3H14L19 8V21H7V3Z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n                <path d=\"M14 3V8H19\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n              </svg>\n              <span>PNG</span>\n            </button>\n          </div>\n        </div>\n      </div>\n      <div class=\"menu menu--overlay\" id=\"paletteHeader\">\n        <h2 class=\"button button--title\"><span id=\"paletteName\"></span></h2>\n        <button class=\"button button--icon button--close button--end\" id=\"closeColorsBtn\" title=\"Close the palette drawer\">\n          <svg class=\"button__icon\" stroke-width=\"1.5\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M18 6L6 18M6 6L18 18\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n          <span>Close</span>\n        </button>\n      </div>\n\n      <button class=\"button button--icon button--end drawer-toggle drawer-toggle--right\" id=\"controlsToggleBtn\" title=\"Scene &amp; light controls\" aria-controls=\"controlOverlay\">\n        <svg class=\"button__icon\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M4 7H20M4 12H20M4 17H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path>\n          <circle cx=\"9\" cy=\"7\" r=\"2\" fill=\"var(--bg)\" stroke=\"currentColor\" stroke-width=\"1.5\"></circle>\n          <circle cx=\"15\" cy=\"12\" r=\"2\" fill=\"var(--bg)\" stroke=\"currentColor\" stroke-width=\"1.5\"></circle>\n          <circle cx=\"7\" cy=\"17\" r=\"2\" fill=\"var(--bg)\" stroke=\"currentColor\" stroke-width=\"1.5\"></circle>\n        </svg>\n        <span>Scene</span>\n      </button>\n      <div class=\"l-overlay l-overlay--right\" id=\"controlOverlay\" aria-label=\"Scene and light controls\">\n        <div class=\"control-rail\" id=\"controlRail\">\n          <button class=\"control-rail__light\" data-rail-light=\"0\" title=\"Light 1\"></button>\n          <button class=\"control-rail__light\" data-rail-light=\"1\" title=\"Light 2\"></button>\n          <button class=\"control-rail__light\" data-rail-light=\"2\" title=\"Light 3\"></button>\n          <button class=\"control-rail__play\" id=\"playBtn\" title=\"Orbit the lights around the sphere\" aria-pressed=\"false\">&#9654;</button>\n        </div>\n        <div class=\"l-overlay__body l-overlay__body--controls\">\n          <section class=\"drawer-section\" id=\"inspector\" hidden>\n            <div class=\"popover__title\" id=\"inspTitle\">Light 1</div>\n            <div class=\"field field--orbit\">\n              <span class=\"field__row\"><label id=\"orbitLabel\">Direction</label><output id=\"orbitOut\"></output></span>\n              <div id=\"orbit\" title=\"Drag to spin the light around the sphere\" aria-labelledby=\"orbitLabel\">\n                <svg viewBox=\"0 0 100 100\" aria-hidden=\"true\">\n                  <path id=\"arc-pb\" class=\"back\"></path>\n                  <path id=\"arc-mb\" class=\"back\"></path>\n                  <path id=\"arc-pf\" class=\"front\"></path>\n                  <path id=\"arc-mf\" class=\"front\"></path>\n                </svg>\n                <div id=\"orbit-dot\"></div>\n              </div>\n            </div>\n            <div class=\"field\">\n              <span class=\"field__row\"><label for=\"inspType\">Type</label></span>\n              <select id=\"inspType\" class=\"light-type\">\n                <button>\n                  <selectedcontent></selectedcontent>\n                </button>\n                <option value=\"point\">\n                  <svg class=\"lt-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"2\" fill=\"currentColor\"/><path d=\"M8 1.5v3M8 11.5v3M1.5 8h3M11.5 8h3M3.4 3.4l2.1 2.1M10.5 10.5l2.1 2.1M12.6 3.4l-2.1 2.1M5.5 10.5l-2.1 2.1\" stroke=\"currentColor\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n                  <span class=\"lt-name\">Point light</span>\n                </option>\n                <option value=\"area\">\n                  <svg class=\"lt-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"8\" r=\"3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M10.5 4.5l2.3-1.4M11.3 8h3.2M10.5 11.5l2.3 1.4\" stroke=\"currentColor\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n                  <span class=\"lt-name\">Area light</span>\n                </option>\n                <option value=\"directional\">\n                  <svg class=\"lt-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2 4h7M2 8h7M2 12h7\" stroke=\"currentColor\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M9.5 2.4L14 4l-4.5 1.6zM9.5 6.4L14 8l-4.5 1.6zM9.5 10.4L14 12l-4.5 1.6z\" fill=\"currentColor\"/></svg>\n                  <span class=\"lt-name\">Directional</span>\n                </option>\n                <option value=\"spot\">\n                  <svg class=\"lt-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2.5 8L12 3.8M2.5 8L12 12.2\" stroke=\"currentColor\" stroke-width=\"1.4\" fill=\"none\" stroke-linecap=\"round\"/><ellipse cx=\"12.2\" cy=\"8\" rx=\"1.7\" ry=\"4.3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/></svg>\n                  <span class=\"lt-name\">Spot light</span>\n                </option>\n              </select>\n            </div>\n            <div class=\"field field--color\">\n              <span class=\"field__row\"><label for=\"inspColor\">Color</label></span>\n              <input type=\"color\" id=\"inspColor\">\n            </div>\n            <div class=\"field\">\n              <span class=\"field__row\"><label for=\"inspIntensity\">Intensity</label><output id=\"inspIntensityOut\"></output></span>\n              <input type=\"range\" id=\"inspIntensity\" min=\"0\" max=\"1.25\" step=\"0.05\">\n            </div>\n            <div class=\"field\" id=\"inspDistRow\">\n              <span class=\"field__row\"><label for=\"inspDist\">Distance</label><output id=\"inspDistOut\"></output></span>\n              <input type=\"range\" id=\"inspDist\" min=\"0.1\" max=\"12\" step=\"0.05\">\n            </div>\n            <div class=\"field\" id=\"inspSizeRow\" hidden>\n              <span class=\"field__row\"><label for=\"inspSize\">Size</label><output id=\"inspSizeOut\"></output></span>\n              <input type=\"range\" id=\"inspSize\" min=\"0\" max=\"0.5\" value=\"0.15\" step=\"0.01\">\n              <p class=\"field__help\">Emitter radius: bigger softens shadows into wider penumbras.</p>\n            </div>\n            <div class=\"field\" id=\"inspAngleRow\" hidden>\n              <span class=\"field__row\"><label for=\"inspAngle\">Cone angle&deg;</label><output id=\"inspAngleOut\"></output></span>\n              <input type=\"range\" id=\"inspAngle\" min=\"10\" max=\"60\" step=\"1\">\n            </div>\n          </section>\n          <p class=\"drawer-hint\" id=\"lightHint\">Click a light on the canvas &mdash; or press 1 2 3 &mdash; to edit it.</p>\n          <section class=\"drawer-section\">\n    <div class=\"popover__title\">Scene</div>\n    <div class=\"field\">\n      <span class=\"field__row\"><label for=\"scnPreset\">Preset</label></span>\n      <select id=\"scnPreset\">\n        <option value=\"\" selected>None</option>\n      </select>\n      <p class=\"field__help\">Complete lighting setups &mdash; a starting point, everything stays editable.</p>\n    </div>\n    <div class=\"field field--color\">\n      <span class=\"field__row\"><label for=\"scnSphereColor\">Sphere color</label></span>\n      <input type=\"color\" id=\"scnSphereColor\" value=\"#ffffff\">\n    </div>\n    <div class=\"field field--color\">\n      <span class=\"field__row\"><label for=\"scnWallColor\">Wall color</label></span>\n      <input type=\"color\" id=\"scnWallColor\" value=\"#999999\">\n    </div>\n    <div class=\"field\">\n      <span class=\"field__row\"><label for=\"scnReflect\">Reflectivity</label><output id=\"scnReflectOut\"></output></span>\n      <input type=\"range\" id=\"scnReflect\" min=\"0\" max=\"1\" value=\"0\" step=\"0.05\">\n      <p class=\"field__help\">Mirror-like walls: the room reflects the sphere. One bounce.</p>\n    </div>\n    <div class=\"field\">\n      <span class=\"field__row\"><label for=\"scnRadius\">Sphere size</label><output id=\"scnRadiusOut\"></output></span>\n      <input type=\"range\" id=\"scnRadius\" min=\"0.1\" max=\"1.5\" value=\"1.2\" step=\"0.1\">\n    </div>\n    <div class=\"field\">\n      <span class=\"field__row\"><label for=\"scnFov\">FOV</label><output id=\"scnFovOut\"></output></span>\n      <input type=\"range\" id=\"scnFov\" min=\"10\" max=\"120\" value=\"30\" step=\"1\">\n    </div>\n    <div class=\"field\">\n      <span class=\"field__row\"><label for=\"scnCamera\">Camera dolly</label><output id=\"scnCameraOut\"></output></span>\n      <input type=\"range\" id=\"scnCamera\" min=\"-10\" max=\"-2\" value=\"-9.3\" step=\"0.1\">\n      <p class=\"field__help\">How far the camera sits from the sphere.</p>\n    </div>\n    <div class=\"field\">\n      <span class=\"field__row\"><label for=\"scnIndirect\">Indirect light</label><output id=\"scnIndirectOut\"></output></span>\n      <input type=\"range\" id=\"scnIndirect\" min=\"0\" max=\"1\" value=\"0.3\" step=\"0.05\">\n    </div>\n    <div class=\"field\">\n      <span class=\"field__row\"><label for=\"scnQuality\">Area samples</label><output id=\"scnQualityOut\"></output></span>\n      <input type=\"range\" id=\"scnQuality\" min=\"1\" max=\"48\" value=\"6\" step=\"1\">\n      <p class=\"field__help\">Shadow rays per area light: more give smoother soft shadows, but render slower.</p>\n    </div>\n          </section>\n        </div>\n      </div>\n      </div>\n\n    </div>\n  </main>\n\n  <footer class=\"footer\">\n    <p class=\"hints hints--keys\">click sphere = sample &nbsp;\u00b7&nbsp; line / circle = drag to draw &nbsp;\u00b7&nbsp; drag points, handles &amp; lights &nbsp;\u00b7&nbsp; globe = aim &nbsp;\u00b7&nbsp; backspace = delete &nbsp;\u00b7&nbsp; light + scroll = distance &nbsp;\u00b7&nbsp; 1 2 3 = lights &nbsp;\u00b7&nbsp; esc = close</p>\n    <p class=\"hints hints--touch\">tap sphere = sample &nbsp;\u00b7&nbsp; drag points, handles &amp; lights &nbsp;\u00b7&nbsp; camera &amp; distance live in the settings drawer</p>\n    <p class=\"hints footer__links\"><a href=\"https://github.com/meodai/ray-color\">GitHub</a> &nbsp;\u00b7&nbsp; <a href=\"https://www.npmjs.com/package/ray-color\">npm</a> &nbsp;\u00b7&nbsp; <a href=\"https://www.elastiq.ch/\" hreflang=\"en\" class=\"ellogo\" target=\"_blank\" rel=\"noopener noreferrer\"\n      aria-label=\"elastiq\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 352 185\">\n        <g fill=\"none\" fill-rule=\"evenodd\" transform=\"translate(0 6)\">\n          <path fill=\"currentColor\" fill-rule=\"nonzero\"\n            d=\"M179.54 71.84a9 9 0 00-1.91.21 7.74 7.74 0 00-1.83.64 4 4 0 00-1.4 1.15 2.81 2.81 0 001.49 4.38 29.19 29.19 0 007 1.45 17.65 17.65 0 018.93 3.36 9.22 9.22 0 013.4 7.7c0 4.993-1.743 8.907-5.23 11.74s-8.323 4.25-14.51 4.25a21.41 21.41 0 01-8-1.36 17.6 17.6 0 01-5.53-3.4 14.1 14.1 0 01-3.28-4.51 12.64 12.64 0 01-1.19-4.68l10.55-2.55a7.32 7.32 0 002.38 4.81c1.42 1.333 3.577 2 6.47 2a13.24 13.24 0 005.19-.94 3.34 3.34 0 002.21-3.32 3.24 3.24 0 00-1.7-2.85c-1.133-.707-3.233-1.203-6.3-1.49a17.19 17.19 0 01-9.74-3.49 9.73 9.73 0 01-3.62-7.91 13.4 13.4 0 011.49-6.38 14 14 0 014-4.68 17.87 17.87 0 015.74-2.85 23.84 23.84 0 016.85-1 20.07 20.07 0 017.4 1.19 15 15 0 014.85 3 11.8 11.8 0 012.76 3.87 15.47 15.47 0 011.15 3.87l-10.45 2.72a5.27 5.27 0 00-2.13-3.62 8.3