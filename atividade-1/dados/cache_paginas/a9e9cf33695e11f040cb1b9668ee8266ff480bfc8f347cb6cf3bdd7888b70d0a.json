{"status": 200, "url_final": "https://siddhantkhare.com/writing/agent-observability-gap", "html": "<!doctype html>\n<html lang=\"en\" data-theme=\"paper\">\n\t<head>\n\t\t<meta charset=\"utf-8\" />\n\t\t<meta name=\"google-site-verification\" content=\"J86PwWpXrEEmxbSCDNQ6SJlopEI1N5kA3cdwde9SKag\" />\n\t\t<meta name=\"google-adsense-account\" content=\"ca-pub-2866074695584144\" />\n\t\t<!-- Google tag (gtag.js) -->\n\t\t<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ENJ10Y6KQE\"></script>\n\t\t<script>\n\t\t\twindow.dataLayer = window.dataLayer || [];\n\t\t\tfunction gtag(){dataLayer.push(arguments);}\n\t\t\tgtag('js', new Date());\n\t\t\tgtag('config', 'G-ENJ10Y6KQE');\n\t\t</script>\n\t\t<link rel=\"icon\" href=\"../favicon.ico\" sizes=\"32x32\" />\n\t\t<link rel=\"icon\" href=\"../favicon-192.png\" type=\"image/png\" sizes=\"192x192\" />\n\t\t<link rel=\"icon\" href=\"../favicon-512.png\" type=\"image/png\" sizes=\"512x512\" />\n\t\t<link rel=\"apple-touch-icon\" href=\"../apple-touch-icon.png\" />\n\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n\t\t<meta name=\"theme-color\" content=\"#ffffff\" />\n\t\t<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n\t\t<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n\t\t<link\n\t\t\thref=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\"\n\t\t\trel=\"stylesheet\"\n\t\t/>\n\t\t<link rel=\"preload\" href=\"../Siddhant_headshot.webp\" as=\"image\" type=\"image/webp\" />\n\t\t<script>\n\t\t\t(function() {\n\t\t\t\tconst stored = localStorage.getItem('theme');\n\t\t\t\tif (stored === 'paper' || stored === 'neural') {\n\t\t\t\t\tdocument.documentElement.setAttribute('data-theme', stored);\n\t\t\t\t} else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {\n\t\t\t\t\tdocument.documentElement.setAttribute('data-theme', 'neural');\n\t\t\t\t} else {\n\t\t\t\t\tdocument.documentElement.setAttribute('data-theme', 'paper');\n\t\t\t\t}\n\t\t\t})();\n\t\t</script>\n\t\t<!--1k78aqt--><!----><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"The agent observability gap\",\"description\":\"We have better observability for a Node.js microservice than for an agent that just rewrote half a codebase. Here is what is missing.\",\"datePublished\":\"2026-03-14\",\"dateModified\":\"2026-03-14\",\"url\":\"https://siddhantkhare.com/writing/agent-observability-gap\",\"image\":\"/api/og?title=The+agent+observability+gap&description=We+have+better+observability+for+a+Node.js+microservice+than+for+an+agent+that+just+rewrote+half+a+codebase.+Here+is+what+is+missing.&tags=ai%2Cobservability%2Cagents%2Cinfrastructure&date=2026-03-14&readingTime=6\",\"keywords\":\"ai, observability, agents, infrastructure\",\"inLanguage\":\"en-US\",\"timeRequired\":\"PT6M\",\"author\":{\"@type\":\"Person\",\"name\":\"Siddhant Khare\",\"url\":\"https://siddhantkhare.com\"},\"publisher\":{\"@type\":\"Person\",\"name\":\"Siddhant Khare\",\"url\":\"https://siddhantkhare.com\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://siddhantkhare.com/writing/agent-observability-gap\"}}</script><!----><!----><!--ojxrft--><meta name=\"description\" content=\"We have better observability for a Node.js microservice than for an agent that just rewrote half a codebase. Here is what is missing.\"/> <link rel=\"canonical\" href=\"https://siddhantkhare.com/writing/agent-observability-gap\"/> <meta property=\"og:type\" content=\"article\"/> <meta property=\"og:title\" content=\"The agent observability gap \u00b7 Siddhant Khare\"/> <meta property=\"og:description\" content=\"We have better observability for a Node.js microservice than for an agent that just rewrote half a codebase. Here is what is missing.\"/> <meta property=\"og:image\" content=\"https://siddhantkhare.com/api/og?title=The+agent+observability+