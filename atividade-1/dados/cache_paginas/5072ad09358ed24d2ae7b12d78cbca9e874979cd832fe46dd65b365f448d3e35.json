{"status": 200, "url_final": "https://bigfootsbc.ca/", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Bigfoot's British Columbia</title>\n  <meta name=\"description\" content=\"A sasquatch-guided 3D tour of British Columbia \u2014 roam 30 historic towns, six mountain ranges, and one very large province. Free, in your browser.\" />\n  <link rel=\"canonical\" href=\"https://bigfootsbc.ca/\" />\n\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:site_name\" content=\"Bigfoot's British Columbia\" />\n  <meta property=\"og:title\" content=\"Bigfoot's British Columbia\" />\n  <meta property=\"og:description\" content=\"A sasquatch-guided 3D tour of 30 historic towns, six mountain ranges, and one very large province. Free, in your browser.\" />\n  <meta property=\"og:url\" content=\"https://bigfootsbc.ca/\" />\n  <meta property=\"og:image\" content=\"https://bigfootsbc.ca/og.jpg\" />\n  <meta property=\"og:image:width\" content=\"1200\" />\n  <meta property=\"og:image:height\" content=\"630\" />\n\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  <meta name=\"twitter:title\" content=\"Bigfoot's British Columbia\" />\n  <meta name=\"twitter:description\" content=\"A sasquatch-guided 3D tour of 30 historic towns, six mountain ranges, and one very large province. Free, in your browser.\" />\n  <meta name=\"twitter:image\" content=\"https://bigfootsbc.ca/og.jpg\" />\n\n  <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>\ud83e\uddb6</text></svg>\" />\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Zilla+Slab:ital,wght@0,400;0,500;0,600;1,400&display=swap\" rel=\"stylesheet\" />\n  <script type=\"module\" crossorigin src=\"/assets/index-CjTFdSKv.js\"></script>\n  <link rel=\"modulepreload\" crossorigin href=\"/assets/three-CF1t8ezi.js\">\n  <link rel=\"stylesheet\" crossorigin href=\"/assets/index-ByQrZ_OC.css\">\n  <script>try{var M={\"full\":\"bc-heightmap.a2e9a853.bin\",\"quarter\":\"bc-heightmap-q.94572209.bin\"};var mob=new URLSearchParams(location.search).has('mobile')||(matchMedia('(pointer: coarse)').matches&&Math.min(screen.width,screen.height)<900);window.__hmVariant=mob?'quarter':'full';window.__hmFetch=fetch('/data/'+M[window.__hmVariant]);}catch(e){}</script>\n</head>\n<body>\n  <div id=\"app\"></div>\n\n  <div id=\"ui\">\n    <!-- intro splash -->\n    <div id=\"intro\">\n      <div class=\"intro-inner\">\n        <div class=\"intro-sunburst\"></div>\n        <p class=\"intro-kicker\">Parks &amp; Legends of the Pacific Northwest presents</p>\n        <h1 class=\"intro-title\"><span>Bigfoot's</span><br/>British Columbia</h1>\n        <p class=\"intro-sub\">A sasquatch-guided tour of 30 historic towns, six mountain ranges,<br/>and one very large province</p>\n        <div id=\"loading-bar\"><div id=\"loading-fill\"></div></div>\n        <p id=\"loading-text\">Surveying the province\u2026</p>\n        <button id=\"begin-btn\" disabled>Begin the Journey</button>\n        <div class=\"intro-controls desktop-controls\">\n          <span><b>WASD</b> roam</span><span><b>Shift</b> sprint</span><span><b>Space</b> leap</span>\n          <span><b>Drag</b> look</span><span><b>Scroll</b> zoom</span><span><b>R</b> roar</span>\n          <span><b>M</b> map</span><span><b>J</b> journal</span>\n        </div>\n        <div class=\"intro-controls mobile-controls\">\n          <span><b>Left side</b> move</span><span><b>Right side</b> look</span>\n          <span><b>Pinch</b> zoom</span><span><b>Push farther</b> sprint</span>\n        </div>\n        <p class=\"intro-maker\">An Overseed AI experiment \u00b7 <a href=\"https://overseed.ai\" target=\"_blank\" rel=\"noopener\">overseed.ai</a></p>\n      </div>\n    </div>\n\n    <!-- top-left title badge -->\n    <div id=\"badge\" class=\"hud hidden\">\n      <div class=\"badge-title\">Bigfoot's BC</div>\n      <div class=\"badge-sub\">est. 1871</div>\n    </div>\n\n    <!-- health -->\n    <div id=\"health-panel\" class=\"hud hidden\">\n      <div id=\"health-label\">Vitality</div>\n      <div id=\"health-track\"><div id=\"health-fill\"></div></div>\n    </div>\n\n    <!-- desktop combat action: appears only while a grizzly is charging -->\n    <button id=\"roar-prompt\" class=\"hidden\" aria-label=\"Roar to scare away the attacking grizzly\">\n      <span>Roar back</span><kbd>R</kbd>\n    </button>\n\n    <!-- damage vignette -->\n    <div id=\"hurt\"></div>\n\n<!-- camera shutter flash -->\n    <div id=\"shutter-flash\" aria-hidden=\"true\"></div>\n\n    <!-- photo-mode viewfinder: the band is exactly the postcard's photo strip -->\n    <div id=\"viewfinder\" class=\"hidden\">\n      <div id=\"vf-band\">\n        <span class=\"vf-corner vf-tl\" aria-hidden=\"true\"></span>\n        <span class=\"vf-corner vf-tr\" aria-hidden=\"true\"></span>\n        <span class=\"vf-corner vf-bl\" aria-hidden=\"true\"></span>\n        <span class=\"vf-corner vf-br\" aria-hidden=\"true\"></span>\n        <div id=\"vf-bar\">\n          <p id=\"vf-hint\">Line up the shot</p>\n          <button id=\"vf-snap\"><span aria-hidden=\"true\">\ud83d\udcf8</span> Take photo</button>\n          <button id=\"vf-cancel\" aria-label=\"Cancel photo\">\u2715</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- tourist camera flash (only when a shot catches you) -->\n    <div id=\"photo-flash\"></div>\n\n    <!-- graphics context lost (GPU reset / low memory) -->\n    <div id=\"ctx-lost\" class=\"hidden\">\n      <div id=\"ctx-lost-card\">\n        <p class=\"death-kicker\">Even legends drop a frame</p>\n        <h2>Graphics Paused</h2>\n        <p id=\"ctx-lost-text\">The graphics driver bowed out \u2014 usually low memory. Waiting for it to come back\u2026 or reload now.</p>\n        <button id=\"ctx-reload-btn\" onclick=\"location.reload()\">Reload</button>\n      </div>\n    </div>\n\n    <!-- death overlay -->\n    <div id=\"death\" class=\"hidden\">\n      <div id=\"death-card\">\n        <p class=\"death-kicker\">The legend meets its match</p>\n        <h2>MAULED</h2>\n        <p id=\"death-text\">A grizzly got the better of you. Even legends need a moment.</p>\n        <button id=\"respawn-btn\">Rise Again</button>\n      </div>\n    </div>\n\n    <!-- top-centre heading compass -->\n    <div id=\"compass\" class=\"hud hidden\" aria-label=\"Compass heading\">\n      <canvas id=\"compass-canvas\" width=\"380\" height=\"40\"></canvas>\n    </div>\n\n    <!-- top-right time control -->\n    <div id=\"time-panel\" class=\"hud hidden\">\n      <svg id=\"time-dial\" viewBox=\"0 0 100 54\" aria-hidden=\"true\">\n        <path d=\"M 8 50 A 42 42 0 0 1 92 50\" fill=\"none\" stroke=\"var(--line)\" stroke-width=\"2.5\" stroke-dasharray=\"1 5\" stroke-linecap=\"round\"/>\n        <circle id=\"dial-sun\" cx=\"50\" cy=\"8\" r=\"6\" fill=\"#f5b83d\"/>\n        <circle id=\"dial-moon\" cx=\"50\" cy=\"8\" r=\"4.5\" fill=\"#dfe6f2\" opacity=\"0\"/>\n      </svg>\n      <div id=\"clock\">10:30</div>\n      <input id=\"time-slider\" type=\"range\" min=\"0\" max=\"24\" step=\"0.05\" value=\"10.5\" aria-label=\"Time of day\" />\n      <div id=\"time-buttons\">\n        <button data-speed=\"0\" title=\"Pause time\">\u23f8</button>\n        <button data-speed=\"1\" class=\"active\" title=\"Gentle \u2014 a day lasts 24 min\">1\u00d7</button>\n        <button data-speed=\"5\" title=\"A day lasts ~5 min\">5\u00d7</button>\n        <button data-speed=\"20\" title=\"Sunset chaser \u2014 72 s days\">20\u00d7</button>\n      </div>\n    </div>\n\n    <!-- bottom-left minimap -->\n    <div id=\"map-panel\" class=\"hud hidden\" title=\"Open the map\" aria-label=\"Open the map\" role=\"button\">\n      <canvas id=\"minimap\" width=\"240\" height=\"174\"></canvas>\n      <span class=\"mobile-map-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><path d=\"M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z\"/><path d=\"M9 3v15M15 6v15\"/></svg></span>\n      <div class=\"map-label\">British Columbia \u00b7 click to expand</div>\n    </div>\n\n    <!-- full-screen map modal -->\n    <div id=\"bigmap\" class=\"hidden\">\n      <div id=\"bigmap-card\">\n        <div id=\"bigmap-head\">\n          <h3>British Columbia</h3>\n          <span id=\"bigmap-hint\">Choose anywhere to travel there \u00b7 select a discovered town to reread its story</span>\n          <button id=\"bigmap-north\">\ud83e\udded Face North</button>\n          <button id=\"bigmap-close\">\u2715</button>\n        </div>\n        <canvas id=\"bigmap-canvas\" width=\"1044\" height=\"756\"></canvas>\n      </div>\n    </div>\n\n    <!-- bottom-right: counter + hint + buttons -->\n    <div id=\"tracker\" class=\"hud hidden\">\n      <div id=\"counter\"><b id=\"count-n\">0</b> / <span id=\"count-total\">30</span> towns discovered</div>\n      <div id=\"counter-sub\">\n        <span class=\"sub-stat\">\u26fa <b id=\"wp-n\">0</b>/<span id=\"wp-total\">39</span> waypoints</span>\n        <span class=\"sub-stat hidden\" id=\"gem-stat\">\u2726 <b id=\"gem-n\">0</b>/<span id=\"gem-total\">0</span> gems</span>\n      </div>\n      <div id=\"tracker-buttons\">\n        <button id=\"photo-btn\" aria-label=\"Take a photo\"><span class=\"button-icon\" aria-hidden=\"true\">\ud83d\udcf7</span><span class=\"button-label\">Photo</span> <kbd>P</kbd></button>\n        <button id=\"journal-btn\" aria-label=\"Explorer's journal\"><span class=\"button-icon\" aria-hidden=\"true\">\u2726</span><span class=\"button-label\">Journal</span> <kbd>J</kbd></button>\n        <button id=\"help-btn\" aria-label=\"How to play\"><span class=\"button-icon\" aria-hidden=\"true\">?</span><span class=\"button-label\">Help</span> <kbd>H</kbd></button>\n        <button id=\"about-btn\" aria-label=\"About Bigfoot's British Columbia\"><span class=\"button-icon\" aria-hidden=\"true\">i</span><span class=\"button-label\">About</span></button>\n        <button id=\"mute-btn\" aria-label=\"Turn sound off\"><span class=\"button-icon\" aria-hidden=\"true\">\u266a</span><span class=\"button-label\">Sound: on</span></button>\n        <button id=\"settings-btn\" aria-label=\"Open settings\"><span class=\"button-icon\" aria-hidden=\"true\">\u2261</span><span class=\"button-label\">Menu</span> <kbd>Esc</kbd></button>\n        <button id=\"share-btn\" aria-label=\"Share Bigfoot's British Columbia\"><span class=\"button-icon\" aria-hidden=\"true\">\u2197</span><span class=\"button-label\">Share the expedition</span></button>\n      </div>\n    </div>\n\n    <!-- touch controls (coarse-pointer devices only) -->\n    <div id=\"touch-ui\" class=\"hidden\">\n      <div id=\"joy-base\"><div id=\"joy-knob\"></div></div>\n      <div id=\"touch-buttons\">\n        <button id=\"btn-jump\" aria-label=\"Leap\"><span class=\"action-glyph\" aria-hidden=\"true\">\u2191</span><span>Leap</span></button>\n        <button id=\"btn-roar\" aria-label=\"Roar\"><span class=\"action-glyph\" aria-hidden=\"true\">\u25d6</span><span>Roar</span></button>\n        <button id=\"btn-photo\" aria-label=\"Take a photo\"><span class=\"action-glyph\" aria-hidden=\"true\">\u25c9</span><span>Photo</span></button>\n      </div>\n    </div>\n\n    <div id=\"touch-coach\" class=\"hidden\">\n      <span class=\"coach-zone\">\n        <i class=\"coach-ring\" aria-hidden=\"true\"></i>\n        <span><b>Left side \u00b7 Move</b><small>Push farther to sprint</small></span>\n      </span>\n      <span class=\"coach-divider\" aria-hidden=\"true\"></span>\n      <span class=\"coach-zone\">\n        <i class=\"coach-swipe\" aria-hidden=\"true\">\u2194</i>\n        <span><b>Right side \u00b7 Look</b><small>Drag to turn the camera</small></span>\n      </span>\n    </div>\n\n    <!-- toasts -->\n    <div id=\"toasts\"></div>\n\n    <!-- pause / settings menu -->\n    <div id=\"settings-wrap\" class=\"hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"settings-title\">\n      <div id=\"settings-menu\">\n        <button id=\"settings-close\" type=\"button\" aria-label=\"Close settings\">\u2715</button>\n        <p class=\"settings-kicker\">Expedition camp</p>\n        <h2 id=\"settings-title\">Journey Settings</h2>\n\n        <section class=\"settings-section\" aria-labelledby=\"audio-settings-title\">\n          <h3 id=\"audio-settings-title\">Audio</h3>\n          <label class=\"settings-slider\" for=\"volume-master\">\n            <span>Master <output id=\"volume-master-value\" for=\"volume-master\">100%</output></span>\n            <input id=\"volume-master\" name=\"master-volume\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"100\" />\n          </label>\n          <label class=\"settings-slider\" for=\"volume-ambience\">\n            <span>Ambience <output id=\"volume-ambience-value\" for=\"volume-ambience\">100%</output></span>\n            <input id=\"volume-ambience\" name=\"ambience-volume\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"100\" />\n          </label>\n          <label class=\"settings-slider\" for=\"volume-effects\">\n            <span>Effects <output id=\"volume-effects-value\" for=\"volume-effects\">100%</output></span>\n            <input id=\"volume-effects\" name=\"effects-volume\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"100\" />\n          </label>\n        </section>\n\n        <section class=\"settings-section\" aria-labelledby=\"graphics-settings-title\">\n          <h3 id=\"graphics-settings-title\">Graphics</h3>\n          <label class=\"settings-select\" for=\"graphics-preset\">\n            <span>Render quality</span>\n            <select id=\"graphics-preset\" name=\"graphics-preset\">\n              <option value=\"performance\">Performance</option>\n              <option value=\"balanced\">Balanced</option>\n              <option value=\"high\">High detail</option>\n            </select>\n          </label>\n          <p id=\"graphics-note\">Full resolution for the clearest landscape.</p>\n          <label class=\"settings-toggle\" for=\"graphics-shadows\">\n            <span><b>Sun shadows</b><small id=\"graphics-shadows-note\">Disable these for a cooler GPU.</small></span>\n            <input id=\"graphics-shadows\" name=\"graphics-shadows\" type=\"checkbox\" checked />\n          </label>\n          <p class=\"settings-cap\">Frame rate is capped at 60 FPS.</p>\n        </section>\n\n        <div class=\"settings-actions\">\n          <button id=\"settings-resume\" type=\"button\">Resume Journey</button>\n          <button id=\"settings-quit\" type=\"button\">Quit to Title</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- discovery card -->\n    <div id=\"card-wrap\" class=\"hidden\">\n      <div id=\"card\">\n        <button id=\"card-close\" aria-label=\"Close\">\u2715</button>\n        <div id=\"card-photo\">\n          <div id=\"card-stamp\">Discovered!</div>\n          <button id=\"ph-prev\" class=\"ph-nav\" aria-label=\"Previous photo\">\u2039</button>\n          <button id=\"ph-next\" class=\"ph-nav\" aria-label=\"Next photo\">\u203a</button>\n          <div id=\"ph-dots\"></div>\n        </div>\n        <div id=\"card-body\">\n          <p id=\"card-region\"></p>\n          <h2 id=\"card-name\"></h2>\n          <p id=\"card-tagline\"></p>\n          <div id=\"card-stats\">\n            <div class=\"stat\"><span class=\"stat-label\">Established</span><span id=\"stat-est\"></span></div>\n            <div class=\"stat\"><span class=\"stat-label\">Population <span class=\"stat-note\">(2021 census)</span></span><span id=\"stat-pop\"></span></div>\n          </div>\n          <p id=\"card-history\"></p>\n          <ul id=\"card-facts\"></ul>\n          <div id=\"card-actions\">\n            <button id=\"card-postcard\">\ud83d\udcee Send a postcard</button>\n            <a id=\"card-gmaps\" target=\"_blank\" rel=\"noopener\">View on Google Maps \u2197</a>\n            <button id=\"card-continue\">Keep exploring</button>\n          </div>\n          <button id=\"card-challenge\">\ud83d\udd75\ufe0f Challenge a friend to find this place</button>\n          <p id=\"card-credit\"></p>\n        </div>\n      </div>\n    </div>\n\n    <!-- full-size photo lightbox (tap a card photo) -->\n    <div id=\"photo-lightbox\" class=\"hidden\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Photo, full size\">\n      <button id=\"lightbox-close\" aria-label=\"Close full-size photo\">\u2715</button>\n      <img id=\"lightbox-img\" alt=\"\" />\n      <p id=\"lightbox-credit\"></p>\n    </div>\n\n    <!-- friend challenge -->\n    <div id=\"challenge-wrap\" class=\"hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"challenge-title\">\n      <div id=\"challenge\">\n        <p class=\"challenge-kicker\">A sealed envelope, slid under your tent flap</p>\n        <h2 id=\"challenge-title\">A Friend Challenges You</h2>\n        <p id=\"challenge-clue\"></p>\n        <p class=\"challenge-fine\">No pins on the map. No beacon hints. Just you and the clue.</p>\n        <div class=\"challenge-actions\">\n          <button id=\"challenge-accept\">Accept the challenge</button>\n          <button id=\"challenge-later\">Maybe later</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- active challenge chip -->\n    <button id=\"challenge-chip\" class=\"hidden\" aria-label=\"Reread the active challenge\">\ud83d\udd75\ufe0f <span id=\"challenge-chip-text\">Challenge active</span></button>\n\n    <!-- proximity visit actions: every nearby discovered place stays one tap away -->\n    <div id=\"visit-chips\" class=\"hidden\" role=\"group\" aria-label=\"Nearby places\"></div>\n\n    <!-- postcard modal -->\n    <div id=\"postcard-wrap\" class=\"hidden\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Your postcard\">\n      <div id=\"postcard\">\n        <button id=\"pc-close\" aria-label=\"Close postcard\">\u2715</button>\n        <img id=\"pc-img\" alt=\"A vintage postcard of your discovery, ready to share\" />\n        <div id=\"pc-actions\">\n          <button id=\"pc-download\">\u2b07 Download</button>\n          <button id=\"pc-share\">\ud83d\udce4 Share</button>\n          <button id=\"pc-copy\">\ud83d\udd17 Copy link</button>\n        </div>\n        <div id=\"pc-socials-row\">\n          <span id=\"pc-socials-label\">or post it via</span>\n          <div id=\"pc-socials\"><!-- chips from src/ui/postcard.js --></div>\n        </div>\n        <p id=\"pc-note\" role=\"status\"></p>\n      </div>\n    </div>\n\n    <!-- journal -->\n    <div id=\"journal\" class=\"hidden\">\n      <div id=\"journal-head\">\n        <h3>Explorer's Journal</h3>\n        <button id=\"journal-close\">\u2715</button>\n      </div>\n      <div id=\"journal-badge\" class=\"hidden\">\u2b50 You found the Spirit Bear of the Great Bear Rainforest</div>\n      <ul id=\"journal-list\"></ul>\n    </div>\n\n    <!-- help -->\n    <div id=\"help\" class=\"hidden\">\n      <h3>How to Bigfoot</h3>\n      <table class=\"desktop-help\">\n        <tr><td><kbd>W A S D</kbd> / arrows</td><td>roam the province</td></tr>\n        <tr><td><kbd>Shift</kbd></td><td>sprint (recommended \u2014 BC is big)</td></tr>\n        <tr><td><kbd>Space</kbd></td><td>leap</td></tr>\n        <tr><td>drag mouse</td><td>look around</td></tr>\n        <tr><td>scroll</td><td>zoom camera</td></tr>\n        <tr><td><kbd>R</kbd></td><td>ROAR (scatters the wildlife)</td></tr>\n        <tr><td><kbd>V</kbd></td><td>visit the place you're standing in</td></tr>\n        <tr><td><kbd>P</kbd></td><td>photo mode \u2014 frame the shot, <kbd>P</kbd> again snaps</td></tr>\n        <tr><td><kbd>M</kbd> <kbd>J</kbd> <kbd>H</kbd></td><td>full map \u00b7 journal \u00b7 help</td></tr>\n      </table>\n      <div class=\"mobile-help\">\n        <p><b>Left side</b><span>Drag to move \u00b7 push farther to sprint</span></p>\n        <p><b>Right side</b><span>Drag to look around</span></p>\n        <p><b>Two fingers</b><span>Pinch in the look zone to zoom</span></p>\n        <p><b>Leap + Roar</b><span>Use the circles at the right edge</span></p>\n      </div>\n      <p>Walk into a beacon of light to discover the town beneath it \u2014 tall gold for the 30 historic towns, slim teal for roadside waypoints, green once met. Standing near discovered places, press <b>V</b> (or tap a Visit button) to read a story. Open the map (M) and click anywhere to travel there; the Journal rereads any story. After dark, Bigfoot's headlamp switches on.</p>\n      <p>Wade out deep and Bigfoot boards his rowboat \u2014 Vancouver Island is a real crossing. Grizzlies charge: sprint away or roar (R). If your Vitality empties, the legend naps and wakes at the last town discovered.</p>\n      <p>Tourists prowl the pullouts. When a camera comes up, get out of frame before the flash fires \u2014 every shot that catches you stings. A good roar scatters them.</p>\n      <p><b>Hidden gems:</b> twenty real BC wonders twinkle gold somewhere out there, no beacons to give them away. The Journal keeps a page of cryptic hints; found gems appear on the map.</p>\n      <p id=\"help-credits\">Geography &amp; data: roads, water and park boundaries \u00a9 <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a> (ODbL) \u00b7 elevation from Mapzen/AWS Terrain Tiles (NASA SRTM, GEBCO, NRCan CDEM \u2014 Open Government Licence Canada) \u00b7 populations from the 2021 Census of Canada \u00b7 photos from Wikimedia Commons, credited on each card.</p>\n    </div>\n\n    <!-- about & credits -->\n    <div id=\"about\" class=\"hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"about-title\">\n      <button id=\"about-close\" aria-label=\"Close About\">\u2715</button>\n      <p class=\"about-kicker\">A province worth wandering</p>\n      <h3 id=\"about-title\">About Bigfoot's British Columbia</h3>\n      <div class=\"about-story\">\n        <p>Bigfoot's British Columbia is a playful way to learn about the province by exploring it.\n          Its terrain follows BC's real topography, while towns, roads, lakes, parks and coastlines\n          are placed using real geographic data.</p>\n        <p>Follow the beacons to discover how communities took shape, wander beyond the highways to\n          uncover hidden gems and natural wonders, and see how the landscape connects it all. It is\n          part game and part field guide \u2014 an invitation to get curious about British Columbia and\n          the stories tucked across it.</p>\n        <p>Created by <a href=\"https://overseed.ai\" target=\"_blank\" rel=\"noopener\">Overseed AI</a>,\n          with no accounts or tracking.</p>\n      </div>\n      <div id=\"about-links\"><!-- populated from src/links.js \u2014 the one source of truth --></div>\n      <p class=\"about-credits\">Roads, water &amp; park boundaries \u00a9 <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a> (ODbL)\n        \u00b7 elevation: Mapzen/AWS Terrain Tiles (NASA SRTM, GEBCO, NRCan CDEM \u2014 Open Government Licence Canada)\n        \u00b7 populations: 2021 Census of Canada\n        \u00b7 town &amp; gem photos: Wikimedia Commons photographers, credited on each card\n        \u00b7 built with <a href=\"https://threejs.org\" target=\"_blank\" rel=\"noopener\">three.js</a>.</p>\n    </div>\n  </div>\n\n</body>\n</html>\n", "erro": "", "ms": 645}