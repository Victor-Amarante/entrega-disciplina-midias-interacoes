{"status": 200, "url_final": "https://quantmlayer.com/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>QuantmLayer | kernel-enforced containment for AI coding agents</title>\n<link rel=\"icon\" href=\"/favicon.ico\" sizes=\"any\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16.png\">\n<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">\n<meta name=\"description\" content=\"AI coding agents run with your privileges. QuantmLayer contains them at the kernel \u2014 the agent doesn't have to be trusted, because the cell doesn't trust it.\">\n<meta property=\"og:title\" content=\"QuantmLayer\">\n<meta property=\"og:image\" content=\"https://quantmlayer.com/quantmlayer-social-preview.png\">\n<meta property=\"og:url\" content=\"https://quantmlayer.com\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"QuantmLayer | kernel-enforced containment for AI coding agents\">\n<meta name=\"twitter:description\" content=\"The agent doesn't have to be trusted. The cell doesn't trust it.\">\n<meta name=\"twitter:image\" content=\"https://quantmlayer.com/quantmlayer-social-preview.png\">\n<meta property=\"og:description\" content=\"Kernel-enforced containment for AI coding agents. The agent doesn't have to be trusted. The cell doesn't trust it.\">\n<meta property=\"og:type\" content=\"website\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    /* schematic palette \u2014 deep blueprint slate, not terminal-black */\n    --ink:        #0b1220;   /* deepest ground */\n    --panel:      #101a2e;   /* raised panel */\n    --panel-2:    #0e1526;   /* recessed */\n    --line:       #24344f;   /* structural hairline */\n    --line-soft:  #1a273d;\n    --fg:         #e8eef7;   /* primary text */\n    --fg-dim:     #9fb0c9;   /* secondary */\n    --fg-faint:   #5f708f;   /* tertiary / captions */\n    --allow:      #6fe3c4;   /* verified / allowed \u2014 cold cyan-green */\n    --deny:       #ff8f6b;   /* blocked \u2014 warm amber-red */\n    --accent:     #8fb3ff;   /* signal blue */\n    --radius: 3px;\n  }\n\n  *{ box-sizing:border-box; }\n  html{ -webkit-text-size-adjust:100%; scroll-behavior:smooth; }\n  body{\n    margin:0; background:var(--ink); color:var(--fg);\n    font-family:\"IBM Plex Sans\", system-ui, sans-serif;\n    font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased;\n    background-image:\n      linear-gradient(var(--line-soft) 1px, transparent 1px),\n      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);\n    background-size: 64px 64px, 64px 64px;\n    background-position:center top;\n  }\n  ::selection{ background:var(--allow); color:var(--ink); }\n  a{ color:var(--accent); text-decoration:none; }\n  a:hover{ text-decoration:underline; text-underline-offset:3px; }\n\n  .wrap{ max-width:1120px; margin:0 auto; padding:0 32px; }\n\n  /* ---- shared type ---- */\n  .mono{ font-family:\"IBM Plex Mono\", ui-monospace, monospace; }\n  .eyebrow{\n    font-family:\"IBM Plex Mono\", monospace; font-size:12px; letter-spacing:.18em;\n    text-transform:uppercase; color:var(--fg-faint); font-weight:500;\n    display:inline-flex; align-items:center; gap:10px;\n  }\n  .eyebrow::before{ content:\"\"; width:22px; height:1px; background:var(--line); }\n  h1,h2,h3{ font-family:\"Space Grotesk\", sans-serif; font-weight:600; letter-spacing:-.01em; line-height:1.08; margin:0; }\n\n  /* verdict tag \u2014 the page's signature device, echoing real ql output */\n  .verdict{\n    font-family:\"IBM Plex Mono\", monospace; font-size:12.5px; font-weight:600;\n    padding:2px 9px; border-radius:2px; letter-spacing:.02em; white-space:nowrap;\n    border:1px solid transparent;\n  }\n  .verdict.allow{ color:var(--allow); border-color:#1f4d43; background:rgba(111,227,196,.07); }\n  .verdict.deny{ color:var(--deny); border-color:#5a3325; background:rgba(255,143,107,.07); }\n\n  /* ---- top bar ---- */\n  header.bar{\n    position:sticky; top:0; z-index:20;\n    border-bottom:1px solid var(--line-soft);\n    background:rgba(11,18,32,.82); backdrop-filter:blur(10px);\n  }\n  .bar .wrap{ display:flex; align-items:center; justify-content:space-between; height:60px; }\n  .brand{ display:flex; align-items:center; gap:11px; font-family:\"Space Grotesk\"; font-weight:600; font-size:17px; letter-spacing:-.01em; color:var(--fg); }\n  .brand .glyph{ width:26px; height:26px; flex:none; display:block; }\n  .bar nav{ display:flex; align-items:center; gap:26px; }\n  .bar nav a{ color:var(--fg-dim); font-size:14px; }\n  .bar nav a:hover{ color:var(--fg); text-decoration:none; }\n  .bar .ghost{ border:1px solid var(--line); padding:7px 14px; border-radius:var(--radius); color:var(--fg); font-family:\"IBM Plex Mono\"; font-size:13px; }\n  .bar .ghost:hover{ border-color:var(--allow); text-decoration:none; }\n  @media(max-width:720px){ .bar nav a.navlink{ display:none; } }\n\n  /* ---- hero ---- */\n  .hero{ padding:76px 0 40px; position:relative; }\n  .hero h1{ font-size:clamp(34px, 6vw, 62px); max-width:15ch; margin-top:22px; }\n  .hero .sub{\n    font-family:\"IBM Plex Mono\", monospace; color:var(--fg-dim);\n    font-size:clamp(15px,2.4vw,19px); margin:22px 0 0; max-width:52ch; line-height:1.5;\n  }\n  .hero .sub b{ color:var(--allow); font-weight:500; }\n  .cta-row{ display:flex; flex-wrap:wrap; gap:14px; align-items:center; margin-top:34px; }\n  .btn{\n    font-family:\"IBM Plex Mono\", monospace; font-size:14px; font-weight:500;\n    padding:12px 20px; border-radius:var(--radius); border:1px solid var(--line);\n    color:var(--fg); display:inline-flex; align-items:center; gap:9px; transition:.15s;\n  }\n  .btn.primary{ background:var(--allow); color:#062018; border-color:var(--allow); font-weight:600; }\n  .btn.primary:hover{ background:#8af0d6; text-decoration:none; }\n  .btn.ghost:hover{ border-color:var(--fg-dim); text-decoration:none; }\n\n  /* install line */\n  .install{\n    margin-top:30px; border:1px solid var(--line); border-radius:var(--radius);\n    background:var(--panel-2); display:flex; align-items:stretch; max-width:640px; overflow:hidden;\n  }\n  .install .lbl{ font-family:\"IBM Plex Mono\"; font-size:12px; color:var(--fg-faint); padding:13px 14px; border-right:1px solid var(--line); background:rgba(255,255,255,.015); display:flex; align-items:center; }\n  .install code{ font-family:\"IBM Plex Mono\"; font-size:13.5px; color:var(--fg); padding:13px 16px; overflow-x:auto; white-space:nowrap; flex:1; }\n  .install code .tok{ color:var(--allow); }\n\n  /* demo frame */\n  .demo-frame{\n    margin:52px 0 0; border:1px solid var(--line); border-radius:6px; overflow:hidden;\n    background:var(--panel-2); box-shadow:0 24px 60px -30px rgba(0,0,0,.7); width:fit-content; max-width:100%;\n  }\n  .demo-frame .chrome{\n    display:flex; align-items:center; gap:8px; padding:11px 15px; border-bottom:1px solid var(--line-soft);\n    font-family:\"IBM Plex Mono\"; font-size:12px; color:var(--fg-faint); background:var(--panel);\n  }\n  .demo-frame .dot{ width:10px; height:10px; border-radius:50%; background:var(--line); }\n  .demo-frame .cap{ margin-left:8px; }\n  .demo-frame img{ display:block; max-width:100%; height:auto; max-height:560px; background:#05080f; }\n\n  /* ---- section scaffold ---- */\n  section{ padding:74px 0; border-top:1px solid var(--line-soft); position:relative; }\n  .sec-head{ max-width:60ch; }\n  .sec-head h2{ font-size:clamp(26px,4vw,40px); margin-top:16px; }\n  .sec-head p{ color:var(--fg-dim); font-size:17px; margin:16px 0 0; }\n\n  /* ---- threat section ---- */\n  .threat{ background:linear-gradient(180deg, rgba(255,143,107,.03), transparent 60%); }\n  .incidents{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:38px 0 8px; }\n  @media(max-width:680px){ .incidents{ grid-template-columns:1fr; } }\n  .incident{\n    border:1px solid var(--line); border-left:2px solid var(--deny); border-radius:var(--radius);\n    background:var(--panel-2); padding:20px 22px;\n  }\n  .incident .when{ font-family:\"IBM Plex Mono\"; font-size:12px; color:var(--deny); letter-spacing:.04em; }\n  .incident h3{ font-size:18px; margin:9px 0 8px; font-family:\"IBM Plex Sans\"; font-weight:500; line-height:1.35; letter-spacing:0; }\n  .incident p{ margin:0; color:var(--fg-dim); font-size:14.5px; }\n  .incident .src{ margin-top:12px; font-family:\"IBM Plex Mono\"; font-size:11.5px; color:var(--fg-faint); }\n  .pull{ font-family:\"Space Grotesk\"; font-weight:500; font-size:clamp(19px,2.6vw,24px); line-height:1.4; margin:30px 0 0; max-width:40ch; }\n  .pull .hl{ color:var(--deny); }\n\n  /* ---- walls / how it works ---- */\n  .walls{ display:grid; grid-template-columns:repeat(2,1fr); gap:0; margin-top:40px; border:1px solid var(--line); border-radius:6px; overflow:hidden; }\n  @media(max-width:680px){ .walls{ grid-template-columns:1fr; } }\n  .wall{ padding:26px 26px 28px; border-right:1px solid var(--line-soft); border-bottom:1px solid var(--line-soft); }\n  .wall:nth-child(2n){ border-right:none; }\n  .wall .n{ font-family:\"IBM Plex Mono\"; font-size:12px; color:var(--fg-faint); }\n  .wall h3{ font-size:19px; margin:10px 0 9px; }\n  .wall p{ margin:0; color:var(--fg-dim); font-size:14.5px; }\n  .wall .tags{ margin-top:14px; display:flex; gap:7px; flex-wrap:wrap; }\n\n  /* ---- MCP depth section ---- */\n  .mcp .demo-frame{ margin-top:38px; }\n\n  /* ---- enterprise line ---- */\n  .ent{ border-top:1px solid var(--line-soft); }\n  .ent .box{\n    border:1px solid var(--line); border-radius:6px; background:var(--panel-2);\n    padding:30px 32px; display:flex; align-items:center; justify-content:space-between; gap:26px; flex-wrap:wrap;\n  }\n  .ent .box .txt h3{ font-size:20px; }\n  .ent .box .txt p{ margin:8px 0 0; color:var(--fg-dim); font-size:14.5px; max-width:52ch; }\n  .ent .tag2{ font-family:\"IBM Plex Mono\"; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--accent); border:1px solid var(--line); padding:4px 9px; border-radius:2px; }\n\n  /* ---- final CTA ---- */\n  .final{ text-align:center; border-top:1px solid var(--line-soft); }\n  .final h2{ font-size:clamp(28px,5vw,46px); max-width:20ch; margin:16px auto 0; }\n  .final p{ color:var(--fg-dim); max-width:48ch; margin:18px auto 0; font-family:\"IBM Plex Mono\"; font-size:15px; }\n  .final .cta-row{ justify-content:center; }\n\n  footer{ border-top:1px solid var(--line-soft); padding:40px 0 60px; color:var(--fg-faint); }\n  footer .wrap{ display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; font-family:\"IBM Plex Mono\"; font-size:13px; }\n  footer a{ color:var(--fg-dim); }\n  footer .links{ display:flex; gap:22px; flex-wrap:wrap; }\n\n  /* motion, but disciplined */\n  .reveal{ opacity:0; transform:translateY(14px); transition:opacity .6s ease, transform .6s ease; }\n  .reveal.in{ opacity:1; transform:none; }\n  @media(prefers-reduced-motion:reduce){ .reveal{ opacity:1; transform:none; transition:none; } html{ scroll-behavior:auto; } }\n\n  :focus-visible{ outline:2px solid var(--allow); outline-offset:2px; border-radius:2px; }\n\n  /* ---- mobile ---- */\n  @media(max-width:720px){\n    body{ background-size:44px 44px, 44px 44px; }\n    .wrap{ padding:0 18px; }\n    .bar .wrap{ height:56px; }\n    .brand{ font-size:15px; gap:9px; }\n    .brand .glyph{ width:22px; height:22px; }\n    .bar nav{ gap:14px; }\n\n    .hero{ padding:44px 0 28px; }\n    .hero h1{ font-size:clamp(30px,9vw,44px); max-width:100%; margin-top:16px; }\n    .hero .sub{ font-size:15px; max-width:100%; }\n    .eyebrow{ font-size:11px; }\n\n    .cta-row{ gap:10px; margin-top:26px; }\n    .btn{ width:100%; justify-content:center; font-size:13.5px; padding:13px 16px; }\n\n    .install{ margin-top:24px; max-width:100%; }\n    .install .lbl{ padding:11px 11px; font-size:11px; }\n    .install code{ font-size:12px; padding:11px 12px; }\n\n    .demo-frame{ margin:34px 0 0; width:100%; }\n    .demo-frame .chrome{ padding:9px 12px; font-size:11px; }\n    .demo-frame img{ width:100%; max-height:none; }\n\n    section{ padding:52px 0; }\n    .sec-head h2{ font-size:clamp(23px,6.5vw,32px); }\n    .sec-head p{ font-size:15.5px; }\n\n    .incidents{ gap:12px; margin:28px 0 4px; }\n    .incident{ padding:17px 18px; }\n    .pull{ font-size:19px; }\n\n    .walls{ margin-top:30px; }\n    .wall{ padding:22px 20px; border-right:none; }\n\n    .ent .box{ padding:24px 22px; }\n    .ent .box .txt h3{ font-size:18px; }\n\n    .final h2{ font-size:clamp(25px,7vw,36px); }\n    .final .cta-row .btn{ width:100%; }\n\n    footer .wrap{ flex-direction:column; align-items:flex-start; gap:14px; }\n  }\n\n  @media(max-width:400px){\n    .install code{ font-size:11px; white-space:normal; word-break:break-all; }\n    .hero h1{ font-size:29px; }\n  }\n</style>\n</head>\n<body>\n\n<header class=\"bar\">\n  <div class=\"wrap\">\n    <a class=\"brand\" href=\"#top\"><svg class=\"glyph\" viewBox=\"0 0 32 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><circle cx=\"16\" cy=\"16\" r=\"13\" stroke=\"var(--allow)\" stroke-width=\"2\"/><circle cx=\"16\" cy=\"16\" r=\"6.5\" stroke=\"var(--line)\" stroke-width=\"1.5\"/><path d=\"M20.5 20.5 L26 26\" stroke=\"var(--allow)\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>QuantmLayer</a>\n    <nav>\n      <a class=\"navlink\" href=\"#threat\">The threat</a>\n      <a class=\"navlink\" href=\"#how\">How it works</a>\n      <a class=\"navlink\" href=\"#mcp\">MCP</a>\n      <a class=\"ghost mono\" href=\"https://github.com/quantmlayer/quantmlayer\">GitHub \u2197</a>\n    </nav>\n  </div>\n</header>\n\n<a id=\"top\"></a>\n\n<!-- HERO -->\n<div class=\"hero\">\n  <div class=\"wrap\">\n    <span class=\"eyebrow reveal\">Kernel-enforced \u00b7 open source \u00b7 one binary</span>\n    <h1 class=\"reveal\">Contain the coding agent. Not just trust it.</h1>\n    <p class=\"sub reveal\">An AI coding agent runs with <b>your</b> privileges \u2014 your keys, your network, your machine. QuantmLayer puts it in a kernel cell that enforces what it's <i>allowed to do</i>, learned from behavior and provable after the fact.</p>\n\n    <div class=\"cta-row reveal\">\n      <a class=\"btn primary\" href=\"#how\">See it contain a real attack \u2192</a>\n      <a class=\"btn ghost\" href=\"https://github.com/quantmlayer/quantmlayer\">Read the source</a>\n    </div>\n\n    <div class=\"install reveal\">\n      <span class=\"lbl\">install</span>\n      <code class=\"mono\"><span class=\"tok\">curl</span> -fsSL https://quantmlayer.com/install.sh | <span class=\"tok\">sh</span></code>\n    </div>\n\n    <div class=\"demo-frame reveal\">\n      <div class=\"chrome\"><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"cap\">ql \u2014 one command, six kernel walls</span></div>\n      <img src=\"demo/ql-hero.gif\" alt=\"QuantmLayer containing a coding agent: SSH key invisible, network blocked, tamper-evident audit, all in one command.\" loading=\"lazy\">\n    </div>\n  </div>\n</div>\n\n<!-- THREAT -->\n<section id=\"threat\" class=\"threat\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\">The threat is not hypothetical</span>\n      <h2>Agents are wired into dev machines faster than they're contained.</h2>\n      <p>These tools are handed real credentials and run privileged, in editors and CI. When one is compromised \u2014 or rug-pulled after you trusted it \u2014 its behavior <i>is</i> the attack.</p>\n    </div>\n\n    <div class=\"incidents\">\n      <div class=\"incident reveal\">\n        <div class=\"when\">FEB 2026 \u00b7 SUPPLY CHAIN</div>\n        <h3>A malicious coding-agent npm release shipped a payload to ~4,000 machines in 8 hours.</h3>\n        <p>It read SSH keys, ran arbitrary shell commands, phoned home, and installed a persistent daemon that survived reboots.</p>\n        <div class=\"src\">src: StepSecurity \u00b7 Snyk \u00b7 A. Khan</div>\n      </div>\n      <div class=\"incident reveal\">\n        <div class=\"when\">APR 2026 \u00b7 CVE-2026-12537</div>\n        <h3>A major agent CLI: a CVSS 10.0 remote code execution \u2014 the maximum score.</h3>\n        <p>Pre-sandbox command execution, reachable in CI pipelines. The trust model shipped behind the capability.</p>\n        <div class=\"src\">src: Google \u00b7 GHSA-wpqr-6v78-jr5g</div>\n      </div>\n    </div>\n\n    <p class=\"pull reveal\">The payload's <span class=\"hl\">behavior</span> is the threat \u2014 reading secrets, reaching the network, dropping a binary. Contain the behavior and it doesn't matter which agent carried it.</p>\n  </div>\n</section>\n\n<!-- HOW / SECURITY DEMO -->\n<section id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\">Same payload, inside the cell</span>\n      <h2>Three hostile actions. Three different walls. Nothing changed but the cage.</h2>\n      <p>QuantmLayer runs the agent inside a least-privilege cell built from Linux kernel primitives. Below, an exact stand-in for that supply-chain payload runs uncontained, then inside a cell \u2014 with no change to the payload itself.</p>\n    </div>\n\n    <div class=\"demo-frame reveal\">\n      <div class=\"chrome\"><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"cap\">ql \u2014 the supply-chain payload, contained</span></div>\n      <img src=\"demo/ql-security.gif\" alt=\"The same malicious payload run uncontained (succeeds) then inside a QuantmLayer cell: key invisible, egress blocked, dropped daemon denied at execve.\" loading=\"lazy\">\n    </div>\n\n    <div class=\"walls reveal\">\n      <div class=\"wall\">\n        <div class=\"n mono\">wall 01 \u2014 filesystem</div>\n        <h3>Secrets aren't hidden. They're absent.</h3>\n        <p>SSH, cloud, and token credentials don't exist inside the cell \u2014 a read returns \u201cno such file,\u201d not \u201cpermission denied.\u201d</p>\n        <div class=\"tags\"><span class=\"verdict deny\">cat ~/.ssh/id_rsa \u2192 no such file</span></div>\n      </div>\n      <div class=\"wall\">\n        <div class=\"n mono\">wall 02 \u2014 network</div>\n        <h3>Egress is default-deny.</h3>\n        <p>No route leaves the cell except what a profile allow-lists. Exfiltration and C2 can't even resolve a host.</p>\n        <div class=\"tags\"><span class=\"verdict deny\">curl unlisted-host \u2192 blocked</span></div>\n      </div>\n      <div class=\"wall\">\n        <div class=\"n mono\">wall 03 \u2014 exec</div>\n        <h3>Only approved binaries run.</h3>\n        <p>Content-verified by hash (BPF-LSM). A dropped payload binary is denied at <span class=\"mono\">execve</span> \u2014 its hash was never approved.</p>\n        <div class=\"tags\"><span class=\"verdict deny\">./dropped-daemon \u2192 denied</span></div>\n      </div>\n      <div class=\"wall\">\n        <div class=\"n mono\">wall 04 \u2014 audit</div>\n        <h3>Provable after the fact.</h3>\n        <p>Every run commits its governing policy to a hash chain. Edit one record and it breaks \u2014 third-party-verifiable evidence.</p>\n        <div class=\"tags\"><span class=\"verdict allow\">audit verify \u2192 intact</span></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- MCP -->\n<section id=\"mcp\" class=\"mcp\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\">Beyond the process \u2014 the protocol</span>\n      <h2>MCP servers are third-party code. The protocol trusts them. We don't.</h2>\n      <p>An MCP tool server runs with your privileges and the protocol enforces nothing at the call layer. The QuantmLayer gateway sits in the JSON-RPC stream and makes each <span class=\"mono\">tools/call</span> prove itself against the server's own schema \u2014 denied calls never reach it, and every decision is auditable.</p>\n    </div>\n\n    <div class=\"demo-frame reveal\">\n      <div class=\"chrome\"><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"cap\">ql mcp gateway \u2014 one forwarded, three denied</span></div>\n      <img src=\"demo/ql-mcp.gif\" alt=\"The QuantmLayer MCP gateway inspecting four tool calls: one valid call forwarded, three denied for schema violation, unknown tool, and gated state-change.\" loading=\"lazy\">\n    </div>\n  </div>\n</section>\n\n<!-- ENTERPRISE (minimal) -->\n<section class=\"ent\">\n  <div class=\"wrap\">\n    <div class=\"box reveal\">\n      <div class=\"txt\">\n        <span class=\"tag2\">Private preview</span>\n        <h3 style=\"margin-top:12px\">Enterprise identity &amp; credential controls</h3>\n        <p>Cell-scoped, short-lived credentials and fleet-wide, tamper-evident attribution \u2014 in private preview with design partners.</p>\n      </div>\n      <a class=\"btn ghost\" href=\"mailto:contact@quantmlayer.com?subject=QuantmLayer%20enterprise%20preview\">Talk to us \u2192</a>\n    </div>\n  </div>\n</section>\n\n<!-- FINAL CTA -->\n<section class=\"final\">\n  <div class=\"wrap\">\n    <span class=\"eyebrow\" style=\"justify-content:center\">Learned from behavior \u00b7 enforced by the kernel \u00b7 provable</span>\n    <h2>The agent doesn't have to be trusted. The cell doesn't trust it.</h2>\n    <p>One static binary. Seven agents out of the box. Open source.</p>\n    <div class=\"cta-row\">\n      <a class=\"btn primary\" href=\"https://github.com/quantmlayer/quantmlayer\">Get started on GitHub \u2192</a>\n      <a class=\"btn ghost\" href=\"mailto:contact@quantmlayer.com?subject=QuantmLayer\">contact@quantmlayer.com</a>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <span>\u00a9 2026 QuantmLayer</span>\n    <div class=\"links\">\n      <a href=\"https://github.com/quantmlayer/quantmlayer\">GitHub</a>\n      <a href=\"https://github.com/quantmlayer/quantmlayer#readme\">Docs</a>\n      <a href=\"mailto:contact@quantmlayer.com\">Contact</a>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // disciplined scroll reveal\n  const io = new IntersectionObserver((es)=>{\n    es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });\n  }, {threshold:.12, rootMargin:'0px 0px -8% 0px'});\n  document.querySelectorAll('.reveal').forEach((el,i)=>{\n    el.style.transitionDelay = Math.min(i%5*0.05, .2)+'s';\n    io.observe(el);\n  });\n</script>\n</body>\n</html>\n", "erro": "", "ms": 766}