{"status": 200, "url_final": "https://www.avaneya.com/", "html": "<!DOCTYPE html >\n<html>\n    <head>\n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\n        <meta http-equiv-\"X-UA-Compatible\" content=\"IE=edge\"/>\n        <meta name=\"fragment\" content=\"!\">\n        <title>Avaneya\u2122</title>\n\n        <link rel=\"shortcut icon\" href=\"/favicon.ico\" type=\"image/x-icon\" />\n\t\t<link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" />\n\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"css/preloader.css\" />\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"css/style.css\" />\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"js/jquery.mCustomScrollbar.css\" />\n    \t<link rel=\"stylesheet\" type=\"text/css\" href=\"css/typography.css\" />\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"css/jquery.fancybox.css?v=2.1.5\" media=\"screen\" />\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"css/jquery.fancybox-buttons.css?v=1.0.5\" media=\"screen\" />\n\n        <script src=\"js/jquery-1.10.1.min.js\"></script>\n        <script src=\"js/jquery.html5Loader.circular.js\"></script>\n        <script src=\"js/jquery.html5Loader.js\"></script>\n        <script src=\"js/modernizr.custom.js\"></script>\n        <script src=\"js/css_browser_selector.min.js\"></script>\n    </head>\n    <body>\n        <div id=\"searchEngineSynopsis\" style=\"display:none;\">\n            <p>\n            Avaneya\u2122 combines the perfect blend of the metropolis city builder\n            social simulation, real time strategy, and cooperative multiplayer.\n            </p>\n        </div>\n        <div id=\"html5Loader\"></div>\n        <div id=\"wrapper\"></div>\n            <!-- audio id=\"bgMusic\" name=\"bgMusic\" preload=\"auto\" src=\"audio/ogg.ogg\">\n                <source src=\"audio/opus.opus\" type=\"audio/ogg; codecs=&quot;opus&quot;\">\n                <source src=\"audio/weba.