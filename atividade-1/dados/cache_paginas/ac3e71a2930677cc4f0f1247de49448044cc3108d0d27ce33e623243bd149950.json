{"status": 200, "url_final": "https://dprovenance.dev/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>DProvenanceKit \u2014 On-device provenance &amp; signed attestation for Swift AI</title>\n<meta name=\"description\" content=\"Turn every AI run into a queryable, diffable, cryptographically signed trace. Catch the silent regressions on-device AI ships \u2014 a dropped tool call, a skipped step \u2014 and verify the evidence offline. Swift-native, Apache 2.0, built for Apple Foundation Models.\" />\n<meta name=\"theme-color\" content=\"#0a0c10\" />\n\n<!-- Open Graph / social -->\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"DProvenanceKit\" />\n<meta property=\"og:title\" content=\"DProvenanceKit \u2014 trace your AI's reasoning, catch its silent regressions\" />\n<meta property=\"og:description\" content=\"OpenTelemetry traces requests. DProvenanceKit traces reasoning. Swift-native, on-device, Apache 2.0.\" />\n<meta property=\"og:url\" content=\"https://dprovenance.dev/\" />\n<meta property=\"og:image\" content=\"https://dprovenance.dev/og-image.png\" />\n<meta property=\"og:image:type\" content=\"image/png\" />\n<meta property=\"og:image:width\" content=\"1200\" />\n<meta property=\"og:image:height\" content=\"630\" />\n<meta property=\"og:image:alt\" content=\"DProvenanceKit: trace your AI's reasoning, catch the silent regressions. A structural trace diff shows demandProseGenerated.ai replaced by demandProseGenerated.template.\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:title\" content=\"DProvenanceKit \u2014 trace your AI's reasoning, catch its silent regressions\" />\n<meta name=\"twitter:description\" content=\"OpenTelemetry traces requests. DProvenanceKit traces reasoning. Swift-native, on-device, Apache 2.0.\" />\n<meta name=\"twitter:image\" content=\"https://dprovenance.dev/og-image.png\" />\n<meta name=\"twitter:image:alt\" content=\"DProvenanceKit: trace your AI's reasoning, catch the silent regressions.\" />\n\n<!--\n  ANALYTICS (privacy-friendly, no cookies). Uncomment ONE after you set it up.\n  See docs/BILLING_SETUP.md \u2192 \"Analytics\" for the 5-minute setup.\n\n  Cloudflare Web Analytics (free, zero-config if the domain is on Cloudflare):\n  <script defer src=\"https://static.cloudflareinsights.com/beacon.min.js\"\n          data-cf-beacon='{\"token\":\"YOUR_TOKEN\"}'></script>\n\n  Plausible (self-host or plausible.io):\n  <script defer data-domain=\"dprovenance.dev\" src=\"https://plausible.io/js/script.js\"></script>\n-->\n\n<style>\n  :root {\n    color-scheme: dark light;\n    --bg:        #0a0c10;\n    --bg-soft:   #0f1218;\n    --surface:   #12151d;\n    --surface-2: #171b24;\n    --border:    #242a35;\n    --border-lit:#333b49;\n    --text:      #e7ebf3;\n    --text-mut:  #9aa4b4;\n    --text-dim:  #6b7484;\n    --accent:    #6d5efc;\n    --accent-2:  #8b7dff;\n    --accent-dim:#2a2550;\n    --green:     #3fb950;\n    --red:       #f85149;\n    --amber:     #d9a441;\n    --mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n    --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    --maxw: 1080px;\n    --radius: 14px;\n    --shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 12px 40px -12px rgba(0,0,0,.6);\n  }\n  :root[data-theme=\"light\"] {\n    color-scheme: light;\n    --bg:        #ffffff;\n    --bg-soft:   #f7f8fa;\n    --surface:   #ffffff;\n    --surface-2: #f4f6f9;\n    --border:    #e3e7ee;\n    --border-lit:#d3d9e3;\n    --text:      #10141b;\n    --text-mut:  #4c5566;\n    --text-dim:  #7b8494;\n    --accent:    #5a4be0;\n    --accent-2:  #6d5efc;\n    --accent-dim:#e9e6ff;\n    --green:     #1a7f37;\n    --red:       #cf222e;\n    --amber:     #9a6700;\n    --shadow: 0 1px 0 rgba(0,0,0,.02) inset, 0 12px 40px -18px rgba(20,30,60,.22);\n  }\n  @media (prefers-color-scheme: light) {\n    :root:not([data-theme=\"dark\"]) {\n      color-scheme: light;\n      --bg:#ffffff; --bg-soft:#f7f8fa; --surface:#ffffff; --surface-2:#f4f6f9;\n      --border:#e3e7ee; --border-lit:#d3d9e3; --text:#10141b; --text-mut:#4c5566;\n      --text-dim:#7b8494; --accent:#5a4be0; --accent-2:#6d5efc; --accent-dim:#e9e6ff;\n      --green:#1a7f37; --red:#cf222e; --amber:#9a6700;\n      --shadow: 0 1px 0 rgba(0,0,0,.02) inset, 0 12px 40px -18px rgba(20,30,60,.22);\n    }\n  }\n\n  * { box-sizing: border-box; }\n  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    font-family: var(--sans);\n    background: var(--bg);\n    color: var(--text);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n  a { color: var(--accent-2); text-decoration: none; }\n  a:hover { text-decoration: underline; }\n  h1,h2,h3 { line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 .5em; }\n  h2 { font-size: clamp(1.6rem, 3.5vw, 2.3rem); }\n  p { margin: 0 0 1rem; }\n  .wrap { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }\n  .mono { font-family: var(--mono); }\n  .muted { color: var(--text-mut); }\n  section { padding: 72px 0; border-top: 1px solid var(--border); }\n  section:first-of-type { border-top: none; }\n\n  /* ---- nav ---- */\n  header.nav {\n    position: sticky; top: 0; z-index: 50;\n    background: color-mix(in srgb, var(--bg) 82%, transparent);\n    backdrop-filter: saturate(160%) blur(12px);\n    border-bottom: 1px solid var(--border);\n  }\n  .nav-inner { display: flex; align-items: center; gap: 20px; height: 60px; }\n  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -0.02em; color: var(--text); }\n  .brand:hover { text-decoration: none; }\n  .logo { width: 26px; height: 26px; flex: none; }\n  .nav-links { margin-left: auto; display: flex; align-items: center; gap: 22px; }\n  .nav-links a { color: var(--text-mut); font-size: .93rem; font-weight: 500; }\n  .nav-links a:hover { color: var(--text); text-decoration: none; }\n  .icon-btn {\n    display: inline-grid; place-items: center; width: 34px; height: 34px;\n    border: 1px solid var(--border); border-radius: 9px; background: var(--surface);\n    color: var(--text-mut); cursor: pointer;\n  }\n  .icon-btn:hover { color: var(--text); border-color: var(--border-lit); }\n  @media (max-width: 720px) { .nav-links a.hide-sm { display: none; } }\n\n  /* ---- buttons ---- */\n  .btn {\n    display: inline-flex; align-items: center; gap: 9px;\n    padding: 11px 20px; border-radius: 11px; font-weight: 600; font-size: .95rem;\n    border: 1px solid transparent; cursor: pointer; transition: transform .06s ease, background .15s ease, border-color .15s ease;\n  }\n  .btn:hover { text-decoration: none; }\n  .btn:active { transform: translateY(1px); }\n  .btn-primary { background: linear-gradient(180deg, var(--accent-2), var(--accent)); color: #fff; box-shadow: 0 8px 24px -10px var(--accent); }\n  .btn-primary:hover { filter: brightness(1.06); }\n  .btn-ghost { background: var(--surface); color: var(--text); border-color: var(--border-lit); }\n  .btn-ghost:hover { border-color: var(--accent); color: var(--text); }\n\n  /* ---- hero ---- */\n  .hero { position: relative; padding-top: 84px; padding-bottom: 40px; overflow: hidden; }\n  .hero::before {\n    content: \"\"; position: absolute; inset: -40% 0 auto 0; height: 620px; z-index: 0;\n    background:\n      radial-gradient(60% 60% at 22% 8%, color-mix(in srgb, var(--accent) 26%, transparent), transparent 70%),\n      radial-gradient(46% 46% at 88% 0%, color-mix(in srgb, #3fb95022 60%, transparent), transparent 70%);\n    filter: blur(8px); pointer-events: none;\n  }\n  .hero .wrap { position: relative; z-index: 1; }\n  .eyebrow {\n    display: inline-flex; align-items: center; gap: 8px; font-size: .8rem; font-weight: 600;\n    color: var(--accent-2); background: var(--accent-dim); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);\n    padding: 5px 12px; border-radius: 999px; letter-spacing: .01em; margin-bottom: 22px;\n  }\n  .hero h1 { font-size: clamp(2.1rem, 5.6vw, 3.7rem); max-width: 15ch; }\n  .hero h1 .grad { background: linear-gradient(120deg, var(--accent-2), #6ad0ff); -webkit-background-clip: text; background-clip: text; color: transparent; }\n  .hero .lede { font-size: clamp(1.05rem, 2.3vw, 1.28rem); color: var(--text-mut); max-width: 60ch; margin-bottom: 28px; }\n  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }\n  .runline {\n    margin-top: 26px; display: inline-flex; align-items: center; gap: 12px;\n    font-family: var(--mono); font-size: .9rem; color: var(--text-mut);\n    background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 9px 14px;\n  }\n  .runline .p { color: var(--accent-2); }\n  .copy-btn { margin-left: 4px; border: none; background: transparent; color: var(--text-dim); cursor: pointer; font-family: var(--mono); font-size: .82rem; }\n  .copy-btn:hover { color: var(--text); }\n\n  /* ---- demo terminal + diff ---- */\n  .demo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px; }\n  @media (max-width: 860px) { .demo-grid { grid-template-columns: 1fr; } }\n  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }\n  .panel-head { display: flex; align-items: center; gap: 8px; padding: 11px 15px; border-bottom: 1px solid var(--border); background: var(--surface-2); font-family: var(--mono); font-size: .8rem; color: var(--text-dim); }\n  .dot { width: 11px; height: 11px; border-radius: 50%; }\n  .dot.r{background:#ff5f56}.dot.y{background:#ffbd2e}.dot.g{background:#27c93f}\n  .panel-head .title { margin-left: 8px; }\n  .term { font-family: var(--mono); font-size: .84rem; line-height: 1.65; padding: 16px; min-height: 330px; white-space: pre-wrap; color: var(--text); }\n  .term .c-dim { color: var(--text-dim); }\n  .term .c-mut { color: var(--text-mut); }\n  .term .c-green { color: var(--green); font-weight: 600; }\n  .term .c-red { color: var(--red); }\n  .term .c-amber { color: var(--amber); }\n  .term .c-accent { color: var(--accent-2); }\n  .cursor { display: inline-block; width: 8px; height: 1.05em; background: var(--accent-2); vertical-align: -2px; animation: blink 1s steps(1) infinite; }\n  @keyframes blink { 50% { opacity: 0; } }\n\n  .tree { padding: 16px; min-height: 330px; }\n  .tree .root { font-family: var(--mono); font-size: .82rem; color: var(--text-mut); margin-bottom: 10px; }\n  .node {\n    display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: .86rem;\n    padding: 8px 11px; border-radius: 9px; border: 1px solid transparent; margin: 5px 0 5px 14px;\n    opacity: 0; transform: translateY(4px); transition: opacity .32s ease, transform .32s ease, background .2s;\n  }\n  .node.show { opacity: 1; transform: none; }\n  .node .badge { font-size: .68rem; font-weight: 700; letter-spacing: .04em; padding: 2px 7px; border-radius: 6px; margin-left: auto; }\n  .node.unchanged { background: var(--surface-2); border-color: var(--border); color: var(--text-mut); }\n  .node.unchanged .badge { background: var(--border); color: var(--text-dim); }\n  .node.removed { background: color-mix(in srgb, var(--red) 12%, transparent); border-color: color-mix(in srgb, var(--red) 40%, transparent); color: var(--red); text-decoration: line-through; text-decoration-thickness: 1px; }\n  .node.removed .badge { background: color-mix(in srgb, var(--red) 22%, transparent); color: var(--red); text-decoration: none; }\n  .node.changed { background: color-mix(in srgb, var(--amber) 13%, transparent); border-color: color-mix(in srgb, var(--amber) 42%, transparent); color: var(--amber); }\n  .node.changed .badge { background: color-mix(in srgb, var(--amber) 22%, transparent); color: var(--amber); }\n  .node .marker { width: 15px; text-align: center; flex: none; }\n  .node .detail { display: block; margin: 6px 0 0 14px; font-family: var(--mono); font-size: .78rem; color: var(--text-dim); opacity: 0; transition: opacity .3s .1s; }\n  .node.changed.show .detail { opacity: 1; }\n  .detail .a { color: var(--text-mut); } .detail .b { color: var(--amber); }\n\n  .verdict { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; opacity: 0; transition: opacity .4s; }\n  .verdict.show { opacity: 1; }\n  .pill { display: inline-flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: .8rem; font-weight: 700; padding: 6px 13px; border-radius: 999px; }\n  .pill.high { background: color-mix(in srgb, var(--red) 16%, transparent); color: var(--red); border: 1px solid color-mix(in srgb, var(--red) 45%, transparent); }\n  .pill.gate { background: color-mix(in srgb, var(--red) 12%, transparent); color: var(--red); border: 1px solid color-mix(in srgb, var(--red) 35%, transparent); }\n  .pill.drift { background: var(--surface-2); color: var(--text-mut); border: 1px solid var(--border); }\n\n  .demo-controls { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }\n  .demo-note { font-size: .84rem; color: var(--text-dim); }\n\n  /* ---- generic cards ---- */\n  .grid { display: grid; gap: 16px; }\n  .grid.cols-2 { grid-template-columns: 1fr 1fr; }\n  .grid.cols-3 { grid-template-columns: repeat(3,1fr); }\n  @media (max-width: 820px) { .grid.cols-3 { grid-template-columns: 1fr; } .grid.cols-2 { grid-template-columns: 1fr; } }\n  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; }\n  .card h3 { font-size: 1.05rem; margin-bottom: .35em; }\n  .card p { color: var(--text-mut); font-size: .95rem; margin: 0; }\n  .card .k { font-family: var(--mono); font-size: .8rem; color: var(--accent-2); }\n\n  .lead { font-size: 1.1rem; color: var(--text-mut); max-width: 62ch; }\n  .center { text-align: center; }\n  .center .lead { margin-left: auto; margin-right: auto; }\n\n  pre.code { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 18px; overflow-x: auto; font-family: var(--mono); font-size: .84rem; line-height: 1.6; }\n  pre.code .kw { color: var(--accent-2); } pre.code .str { color: var(--green); } pre.code .cm { color: var(--text-dim); }\n\n  .vs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 18px; align-items: center; margin-top: 8px; }\n  @media (max-width: 720px) { .vs { grid-template-columns: 1fr; } .vs .arrow { display: none; } }\n  .vs .arrow { font-family: var(--mono); color: var(--text-dim); font-size: 1.4rem; }\n  .vs .side { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; }\n  .vs .side .h { font-family: var(--mono); font-size: .78rem; color: var(--text-dim); margin-bottom: 8px; }\n\n  /* ---- pricing / pilot ---- */\n  .plan { display: grid; gap: 18px; grid-template-columns: 1fr 1fr; }\n  @media (max-width: 820px) { .plan { grid-template-columns: 1fr; } }\n  .plan .tier { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 26px; display: flex; flex-direction: column; }\n  .plan .tier.featured { border-color: color-mix(in srgb, var(--accent) 55%, transparent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent), var(--shadow); position: relative; }\n  .plan .tier.featured::after { content: \"Available now\"; position: absolute; top: -11px; right: 20px; font-size: .7rem; font-weight: 700; letter-spacing: .03em; background: linear-gradient(180deg,var(--accent-2),var(--accent)); color:#fff; padding: 3px 10px; border-radius: 999px; }\n  .plan .tier h3 { font-size: 1.25rem; }\n  .plan .price { font-family: var(--mono); color: var(--text); font-size: 1.05rem; margin: 2px 0 14px; }\n  .plan .price .free { color: var(--green); }\n  ul.feats { list-style: none; padding: 0; margin: 0 0 22px; display: grid; gap: 9px; }\n  ul.feats li { position: relative; padding-left: 26px; color: var(--text-mut); font-size: .93rem; }\n  ul.feats li::before { content: \"\u2713\"; position: absolute; left: 4px; color: var(--green); font-weight: 700; }\n  .plan .tier .btn { margin-top: auto; justify-content: center; }\n\n  /* ---- footer ---- */\n  footer { border-top: 1px solid var(--border); padding: 42px 0 60px; color: var(--text-dim); }\n  .foot-grid { display: flex; flex-wrap: wrap; gap: 26px 48px; justify-content: space-between; }\n  .foot-links { display: flex; flex-wrap: wrap; gap: 10px 26px; }\n  .foot-links a { color: var(--text-mut); font-size: .9rem; }\n  .foot small { color: var(--text-dim); font-size: .82rem; }\n\n  .kicker { font-family: var(--mono); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 10px; }\n</style>\n</head>\n<body>\n\n<header class=\"nav\">\n  <div class=\"wrap nav-inner\">\n    <a class=\"brand\" href=\"#top\">\n      <svg class=\"logo\" viewBox=\"0 0 32 32\" fill=\"none\" aria-hidden=\"true\">\n        <rect x=\"1\" y=\"1\" width=\"30\" height=\"30\" rx=\"8\" fill=\"url(#lg)\"/>\n        <path d=\"M9 22V10h4.6c3.7 0 6 2.3 6 6s-2.3 6-6 6H9Z\" stroke=\"#fff\" stroke-width=\"2.1\" fill=\"none\"/>\n        <circle cx=\"22.5\" cy=\"10\" r=\"2.4\" fill=\"#fff\"/>\n        <path d=\"M22.5 12.2v7.2\" stroke=\"#fff\" stroke-width=\"1.8\"/>\n        <defs><linearGradient id=\"lg\" x1=\"0\" y1=\"0\" x2=\"32\" y2=\"32\"><stop stop-color=\"#8b7dff\"/><stop offset=\"1\" stop-color=\"#5a4be0\"/></linearGradient></defs>\n      </svg>\n      DProvenanceKit\n    </a>\n    <nav class=\"nav-links\">\n      <a href=\"#demo\" class=\"hide-sm\">Demo</a>\n      <a href=\"#start\" class=\"hide-sm\">Quickstart</a>\n      <a href=\"/explorer/\" class=\"hide-sm\">Explorer</a>\n      <a href=\"/docs/\">Docs</a>\n      <a href=\"#pilot\">Pilot</a>\n      <a href=\"https://github.com/Therealdk8890/DProvenanceKit\">GitHub</a>\n      <button class=\"icon-btn\" id=\"theme\" title=\"Toggle theme\" aria-label=\"Toggle theme\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36A5.5 5.5 0 0 1 12.4 3.1c-.13 0-.26-.1-.4-.1Z\"/></svg>\n      </button>\n    </nav>\n  </div>\n</header>\n\n<a id=\"top\"></a>\n\n<!-- ================= HERO ================= -->\n<section class=\"hero\">\n  <div class=\"wrap\">\n    <span class=\"eyebrow\">\u25c6 Swift-native \u00b7 on-device \u00b7 Apache 2.0</span>\n    <h1>Your AI agent <span class=\"grad\">changed its mind.</span> Now you know exactly why.</h1>\n    <p class=\"lede\">\n      DProvenanceKit turns every AI run into a queryable, diffable trace of its <em>reasoning</em> \u2014\n      then signs it with CryptoKit into a tamper-evident attestation you can verify offline.\n      When an OS or model update makes your on-device agent silently drop a tool call or skip a step,\n      it catches the regression and fails your build \u2014 before your users hit it.\n    </p>\n    <div class=\"cta-row\">\n      <a class=\"btn btn-primary\" href=\"#demo\">\u25b6 Watch it catch a regression</a>\n      <a class=\"btn btn-ghost\" href=\"https://github.com/Therealdk8890/DProvenanceKit\">\u2605 Star on GitHub</a>\n    </div>\n    <div class=\"runline\">\n      <span><span class=\"p\">$</span> swift run FoundationModelsRegressionDemo --gate</span>\n      <button class=\"copy-btn\" data-copy=\"swift run FoundationModelsRegressionDemo --gate\">copy</button>\n    </div>\n  </div>\n</section>\n\n<!-- ================= INTERACTIVE DEMO ================= -->\n<section id=\"demo\">\n  <div class=\"wrap\">\n    <div class=\"kicker\">The 30-second demo</div>\n    <h2>Watch it catch a regression</h2>\n    <p class=\"lead\">\n      A weather agent, traced through the Foundation Models adapter. Before an OS update it called\n      <span class=\"mono\">getWeather</span> for live conditions. After the update, the same prompt was\n      answered straight from the model's prior \u2014 fluent, plausible, and wrong. Every traditional test\n      stays green. Press run.\n    </p>\n\n    <div class=\"demo-controls\">\n      <button class=\"btn btn-primary\" id=\"run\">\u25b6 Run the reasoning check</button>\n      <button class=\"btn btn-ghost\" id=\"reset\" hidden>\u21bb Reset</button>\n      <span class=\"demo-note\">Real output from <span class=\"mono\">FoundationModelsRegressionDemo</span> \u2014 nothing here is faked.</span>\n    </div>\n\n    <div class=\"demo-grid\">\n      <div class=\"panel\">\n        <div class=\"panel-head\"><span class=\"dot r\"></span><span class=\"dot y\"></span><span class=\"dot g\"></span><span class=\"title\">terminal</span></div>\n        <div class=\"term\" id=\"term\"><span class=\"c-dim\">$ swift run FoundationModelsRegressionDemo --gate</span>\n<span class=\"cursor\" id=\"cur\"></span></div>\n      </div>\n      <div class=\"panel\">\n        <div class=\"panel-head\"><span class=\"dot r\"></span><span class=\"dot y\"></span><span class=\"dot g\"></span><span class=\"title\">reasoning diff \u2014 Weather agent</span></div>\n        <div class=\"tree\" id=\"tree\">\n          <div class=\"root\">Weather agent \u00b7 baseline \u2192 candidate</div>\n          <div id=\"nodes\"></div>\n          <div class=\"verdict\" id=\"verdict\">\n            <span class=\"pill high\">\u26a0 regression risk: HIGH</span>\n            <span class=\"pill drift\">drift 60 / 100</span>\n            <span class=\"pill gate\">\u2715 CI gate FAILED</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <p class=\"demo-note\" style=\"margin-top:22px;text-align:center;font-size:.95rem\">\n      This is a scripted recording of real output.\n      <a href=\"/explorer/\"><strong>Open the live Explorer \u2192</strong></a>\n      to poke at the bundled sample diff in your browser, or drop in your own\n      <span class=\"mono\">swift run DProvenanceKitCLI web-export</span> JSON.\n    </p>\n  </div>\n</section>\n\n<!-- ================= PROBLEM ================= -->\n<section>\n  <div class=\"wrap\">\n    <div class=\"kicker\">Why this matters</div>\n    <h2>AI systems don't fail like software</h2>\n    <p class=\"lead\">Traditional software crashes. AI usually doesn't \u2014 it fails <em>quietly</em>, and your logs show <em>what</em> happened, not <em>why</em>.</p>\n    <div class=\"grid cols-3\" style=\"margin-top:26px\">\n      <div class=\"card\"><h3>Steps vanish</h3><p>An agent silently stops calling a tool after a model update and answers from memory instead of live data.</p></div>\n      <div class=\"card\"><h3>Order drifts</h3><p>Reasoning steps reorder between runs; a validation that used to gate a decision now runs after it.</p></div>\n      <div class=\"card\"><h3>Same input, new path</h3><p>Two supposedly identical runs take different routes and produce different results \u2014 with no obvious cause.</p></div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= OTEL ================= -->\n<section>\n  <div class=\"wrap\">\n    <div class=\"kicker\">Isn't this just OpenTelemetry?</div>\n    <div class=\"vs\">\n      <div class=\"side\">\n        <div class=\"h\">OpenTelemetry</div>\n        <strong>Traces requests.</strong>\n        <p class=\"muted\" style=\"margin:.4em 0 0\">Latency, spans, service health, infrastructure. Answers <em>what happened</em>.</p>\n      </div>\n      <div class=\"arrow\">\u2260</div>\n      <div class=\"side\" style=\"border-color: color-mix(in srgb, var(--accent) 45%, transparent)\">\n        <div class=\"h\" style=\"color:var(--accent-2)\">DProvenanceKit</div>\n        <strong>Traces reasoning.</strong>\n        <p class=\"muted\" style=\"margin:.4em 0 0\">Decision lineage, logic diffs, regression detection. Answers <em>why the AI reached this conclusion</em>.</p>\n      </div>\n    </div>\n    <p class=\"muted\" style=\"margin-top:20px\">\n      And when you need both, <a href=\"https://github.com/Therealdk8890/DProvenanceKit/blob/main/docs/otel-bridge.md\"><span class=\"mono\">DProvenanceOTel</span></a>\n      exports finished runs as standard OTLP spans to Langfuse or any collector \u2014 DPK stays the on-device capture layer.\n      <strong>Export, not equivalence.</strong>\n    </p>\n  </div>\n</section>\n\n<!-- ================= QUICKSTART ================= -->\n<section id=\"start\">\n  <div class=\"wrap\">\n    <div class=\"kicker\">Get started</div>\n    <h2>Two lines to a diffable AI trace</h2>\n    <div class=\"grid cols-2\" style=\"margin-top:22px; align-items:start\">\n      <div>\n        <p class=\"muted\"><strong>1.</strong> Add the package (Swift Package Manager):</p>\n        <pre class=\"code\"><span class=\"cm\">// Package.swift</span>\n.package(url: <span class=\"str\">\"https://github.com/Therealdk8890/DProvenanceKit\"</span>, from: <span class=\"str\">\"0.8.1\"</span>)</pre>\n      </div>\n      <div>\n        <p class=\"muted\"><strong>2.</strong> Trace an Apple Foundation Models session \u2014 one line:</p>\n        <pre class=\"code\"><span class=\"kw\">import</span> FoundationModels\n<span class=\"kw\">import</span> DProvenanceFoundationModels\n\n<span class=\"kw\">try await</span> FMTrace.run(contextID: <span class=\"str\">\"chat\"</span>, store: store) {\n    <span class=\"kw\">let</span> s = LanguageModelSession.traced(instructions: <span class=\"str\">\"Be terse.\"</span>)\n    _ = <span class=\"kw\">try await</span> s.respond(to: <span class=\"str\">\"Plan my day.\"</span>)\n}</pre>\n      </div>\n    </div>\n    <p class=\"muted\" style=\"margin-top:18px\">\n      Already have working FoundationModels code? <span class=\"mono\">session.recordProvenance()</span> ingests the transcript after the fact \u2014 zero refactor.\n      Every prompt, response, tool call, and generation error becomes a queryable trace event you can diff, align, and gate in CI.\n    </p>\n    <div class=\"cta-row\" style=\"margin-top:22px\">\n      <a class=\"btn btn-primary\" href=\"/docs/\">Read the docs</a>\n      <a class=\"btn btn-ghost\" href=\"https://github.com/Therealdk8890/DProvenanceKit/blob/main/docs/foundation-models-regression-demo.md\">Full regression walkthrough</a>\n    </div>\n  </div>\n</section>\n\n<!-- ================= WHO ================= -->\n<section>\n  <div class=\"wrap\">\n    <div class=\"kicker\">Who it's for</div>\n    <h2>If your reasoning happens in Swift, this is built for you</h2>\n    <p class=\"lead\">\n      Agents, LLM workflows, tool-using models, and reasoning that runs on-device with Apple Foundation Models, MLX, or Core ML.\n      The observability ecosystem \u2014 LangSmith, Langfuse, Phoenix, OTel \u2014 is Python- and JS-first, built around requests crossing a network.\n      DProvenanceKit works at the reasoning layer, in your language, with nothing leaving the device.\n    </p>\n    <div class=\"grid cols-3\" style=\"margin-top:24px\">\n      <div class=\"card\"><span class=\"k\">on-device</span><h3>No service to stand up</h3><p>Pure Swift package. System SQLite + CryptoKit. Runs in your process; traces never leave the machine unless you export them.</p></div>\n      <div class=\"card\"><span class=\"k\">CI-native</span><h3>Fails the build on drift</h3><p>The regression gate exits non-zero when a critical reasoning step disappears \u2014 the same way a failing test breaks your PR.</p></div>\n      <div class=\"card\"><span class=\"k\">portable</span><h3>Python port + GitHub Action</h3><p>Not writing Swift? <a href=\"https://github.com/Therealdk8890/DProvenanceKitPython\">DProvenanceKitPython</a> mirrors the API, with a drop-in CI action.</p></div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= PILOT / PRICING ================= -->\n<section id=\"pilot\">\n  <div class=\"wrap\">\n    <div class=\"kicker\">Open source + services</div>\n    <h2>The library is free. The service is paid.</h2>\n    <p class=\"lead\">Everything in the public library \u2014 capture, query, diff, lineage, local signed attestation, offline proof packs, the FoundationModels adapter, and OTLP export \u2014 is Apache 2.0. The live paid offer is a defined 30-day assurance pilot, with other maintainer help scoped per engagement. There's no hosted service, recurring support tier, SLA, indemnity, or compliance-certification package.</p>\n\n    <div class=\"plan\" style=\"margin-top:28px\">\n      <div class=\"tier\">\n        <h3>Open Source</h3>\n        <div class=\"price\"><span class=\"free\">$0</span> \u00b7 Apache 2.0</div>\n        <ul class=\"feats\">\n          <li>Full recording, query DSL, diff &amp; alignment engine</li>\n          <li>Local signed trace attestation &amp; role-bound proof packs, verified offline</li>\n          <li>Provenance / lineage recording and export</li>\n          <li>FoundationModels adapter (live + post-hoc)</li>\n          <li>OTLP export to Langfuse or any collector</li>\n          <li>CI regression gate + <a href=\"/explorer/\">web Explorer</a> to share one diff</li>\n          <li>Community support on GitHub</li>\n        </ul>\n        <a class=\"btn btn-ghost\" href=\"https://github.com/Therealdk8890/DProvenanceKit\">Get it on GitHub</a>\n      </div>\n      <div class=\"tier featured\">\n        <h3>30-day assurance pilot</h3>\n        <div class=\"price\">$4,500 \u00b7 one time</div>\n        <ul class=\"feats\">\n          <li>One AI workflow with one agreed failure risk</li>\n          <li><strong>1.</strong> Instrumentation review</li>\n          <li><strong>2.</strong> Golden baseline committed to your repository</li>\n          <li><strong>3.</strong> Three to five governance policies</li>\n          <li><strong>4.</strong> CI gate that fails a pull request on regression</li>\n          <li><strong>5.</strong> Audit and provenance report</li>\n          <li><strong>6.</strong> Kickoff and handover calls, plus async support</li>\n          <li>You run the software; your engineer instruments the workflow (2\u20136 hours)</li>\n          <li>Local-first work using synthetic or redacted examples</li>\n        </ul>\n        <a class=\"btn btn-primary\" id=\"pilot-cta\" href=\"/pilot/\">See the $4,500 pilot \u2192</a>\n      </div>\n    </div>\n    <div class=\"card\" style=\"margin-top:28px; text-align:left\">\n      <span class=\"k\">native app</span>\n      <h3>Prefer a desktop workbench? The D.P.K Mac app</h3>\n      <p>The free <a href=\"/explorer/\">web Explorer</a> shares or previews <strong>one</strong> frozen before/after diff in the browser. <a href=\"https://apps.apple.com/us/app/d-p-k-reasoning-traces/id6784076039?mt=12\"><strong>D.P.K: Reasoning Traces</strong></a> is the native workbench over your <strong>live, local</strong> trace database \u2014 diff runs you choose, replay timelines, drill into payloads and span lineage, and surface anomalies across loaded runs. Basic is currently free. As of July 2026, an optional $99/year Pro Annual subscription is planned but not publicly purchasable; metadata, the D.P.K 1.3.0 submission, and Apple review still remain. Check the App Store for current availability.</p>\n      <a class=\"btn btn-ghost\" href=\"https://apps.apple.com/us/app/d-p-k-reasoning-traces/id6784076039?mt=12\" style=\"margin-top:12px\">Get the Mac app \u2192</a>\n    </div>\n\n    <p class=\"muted center\" style=\"margin-top:22px; font-size:.92rem\">\n      Need an invoice or a different scoped engagement? <a href=\"mailto:therealdk8890+lineage@gmail.com?subject=DProvenanceKit%20scoped%20engagement%20inquiry&amp;body=Company%3A%0AOne%20workflow%20to%20de-risk%3A%0ADesired%20deliverable%3A%0ALocal%20or%20privacy%20constraints%3A%0A\">therealdk8890+lineage@gmail.com</a>\n      \u00b7 Full offer details in <a href=\"https://github.com/Therealdk8890/DProvenanceKit/blob/main/COMMERCIAL.md\">COMMERCIAL.md</a>\n    </p>\n  </div>\n</section>\n\n<!-- ================= FINAL CTA ================= -->\n<section class=\"center\">\n  <div class=\"wrap\">\n    <h2>Ship AI you can actually debug.</h2>\n    <p class=\"lead\">Start free in five minutes \u2014 capture, diff, and gate PRs on reasoning drift in the open-source library. When one workflow needs hands-on integration and an assurance report, start the 30-day pilot.</p>\n    <div class=\"cta-row\" style=\"justify-content:center; margin-top:18px\">\n      <a class=\"btn btn-primary\" href=\"https://github.com/Therealdk8890/DProvenanceKit\">Get started free</a>\n      <a class=\"btn btn-ghost\" href=\"/pilot/\">See the $4,500 pilot</a>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap foot-grid\">\n    <div>\n      <a class=\"brand\" href=\"#top\" style=\"font-size:1rem\"><svg class=\"logo\" viewBox=\"0 0 32 32\" fill=\"none\" aria-hidden=\"true\"><rect x=\"1\" y=\"1\" width=\"30\" height=\"30\" rx=\"8\" fill=\"url(#lg2)\"/><path d=\"M9 22V10h4.6c3.7 0 6 2.3 6 6s-2.3 6-6 6H9Z\" stroke=\"#fff\" stroke-width=\"2.1\" fill=\"none\"/><circle cx=\"22.5\" cy=\"10\" r=\"2.4\" fill=\"#fff\"/><path d=\"M22.5 12.2v7.2\" stroke=\"#fff\" stroke-width=\"1.8\"/><defs><linearGradient id=\"lg2\" x1=\"0\" y1=\"0\" x2=\"32\" y2=\"32\"><stop stop-color=\"#8b7dff\"/><stop offset=\"1\" stop-color=\"#5a4be0\"/></linearGradient></defs></svg> DProvenanceKit</a>\n      <p style=\"margin-top:12px\"><small>Reasoning observability for Swift &amp; on-device AI.<br/>Apache 2.0. Built for Apple Foundation Models.</small></p>\n    </div>\n    <div class=\"foot-links\">\n      <a href=\"https://github.com/Therealdk8890/DProvenanceKit\">GitHub</a>\n      <a href=\"/docs/\">Docs</a>\n      <a href=\"/explorer/\">Explorer</a>\n      <a href=\"https://github.com/Therealdk8890/DProvenanceKit/blob/main/docs/foundation-models.md\">Foundation Models</a>\n      <a href=\"https://github.com/Therealdk8890/DProvenanceKit/blob/main/docs/otel-bridge.md\">OTel bridge</a>\n      <a href=\"https://github.com/Therealdk8890/DProvenanceKitPython\">Python port</a>\n      <a href=\"https://apps.apple.com/us/app/d-p-k-reasoning-traces/id6784076039?mt=12\">Mac app</a>\n      <a href=\"https://github.com/Therealdk8890/DProvenanceKit/blob/main/COMMERCIAL.md\">Commercial</a>\n      <a href=\"/pilot/\">Pilot</a>\n    </div>\n  </div>\n</footer>\n\n<script>\n(function () {\n  // ---- theme toggle ----\n  var root = document.documentElement;\n  var saved = null;\n  try { saved = localStorage.getItem(\"dpk-theme\"); } catch (e) {}\n  if (saved) root.setAttribute(\"data-theme\", saved);\n  document.getElementById(\"theme\").addEventListener(\"click\", function () {\n    var cur = root.getAttribute(\"data-theme\");\n    var isDark = cur ? cur === \"dark\" : matchMedia(\"(prefers-color-scheme: dark)\").matches;\n    var next = isDark ? \"light\" : \"dark\";\n    root.setAttribute(\"data-theme\", next);\n    try { localStorage.setItem(\"dpk-theme\", next); } catch (e) {}\n  });\n\n  // ---- copy buttons ----\n  document.querySelectorAll(\"[data-copy]\").forEach(function (b) {\n    b.addEventListener(\"click\", function () {\n      navigator.clipboard && navigator.clipboard.writeText(b.getAttribute(\"data-copy\"));\n      var t = b.textContent; b.textContent = \"copied \u2713\";\n      setTimeout(function () { b.textContent = t; }, 1400);\n    });\n  });\n\n  // ---- interactive regression demo (real FoundationModelsRegressionDemo output) ----\n  var termData = [\n    { t: 400,  cls: \"c-mut\",   text: \"\\nBASELINE  (macOS 26.0 \u00b7 model 2025-09):\" },\n    { t: 120,  cls: \"c-dim\",   text: \"\\n  \u2192 instructions\\n  \u2192 prompt\\n  \u2192 tool call \u00b7 getWeather\\n  \u2192 tool output \u00b7 getWeather\\n  \u2192 response\" },\n    { t: 700,  cls: \"c-mut\",   text: \"\\n\\nCANDIDATE (macOS 26.1 \u00b7 model 2025-11):\" },\n    { t: 120,  cls: \"c-dim\",   text: \"\\n  \u2192 instructions\\n  \u2192 prompt\\n  \u2192 response\" },\n    { t: 800,  cls: \"c-mut\",   text: \"\\n\\nStructural diff (baseline \u2192 candidate):\" },\n    { t: 260,  cls: \"c-red\",   text: \"\\n  removed: tool call \u00b7 getWeather\" },\n    { t: 260,  cls: \"c-red\",   text: \"\\n  removed: tool output \u00b7 getWeather\" },\n    { t: 700,  cls: \"c-mut\",   text: \"\\n\\nSemantic alignment:\" },\n    { t: 300,  cls: \"c-red\",   text: \"\\n  regression risk: HIGH \u2014 Critical reasoning steps removed: fm_tool_call\" },\n    { t: 800,  cls: \"c-red\",   text: \"\\n\\nCI gate: \u2715 FAILED \u2014 reasoning regression detected\" },\n    { t: 120,  cls: \"c-dim\",   text: \"\\n  A dropped critical step changed the agent's behavior with\" },\n    { t: 40,   cls: \"c-dim\",   text: \"\\n  no crash or error. `--gate` exits non-zero here.\" },\n    { t: 300,  cls: \"c-dim\",   text: \"\\n$ echo $?\" },\n    { t: 260,  cls: \"c-green\", text: \"\\n1\" }\n  ];\n  var nodesData = [\n    { label: \"fm_instructions\", type: \"unchanged\", tag: \"unchanged\" },\n    { label: \"fm_prompt\",       type: \"unchanged\", tag: \"unchanged\" },\n    { label: \"fm_tool_call \u00b7 getWeather\", type: \"removed\", tag: \"removed\", marker: \"\u2212\" },\n    { label: \"fm_tool_output \u00b7 getWeather\", type: \"removed\", tag: \"removed\", marker: \"\u2212\" },\n    { label: \"fm_response\", type: \"changed\", tag: \"changed\", marker: \"~\",\n      detail: '<span class=\"a\">\u201c14\u00b0C, light rain \u2014 bring a jacket.\u201d</span> \u2192 <span class=\"b\">\u201csunny and about 22\u00b0C \u2014 a lovely day!\u201d</span>' }\n  ];\n\n  var term = document.getElementById(\"term\");\n  var cur = document.getElementById(\"cur\");\n  var nodesEl = document.getElementById(\"nodes\");\n  var verdict = document.getElementById(\"verdict\");\n  var runBtn = document.getElementById(\"run\");\n  var resetBtn = document.getElementById(\"reset\");\n  var timers = [];\n  var running = false;\n\n  function clearTimers(){ timers.forEach(clearTimeout); timers = []; }\n\n  function reset() {\n    clearTimers(); running = false;\n    term.innerHTML = '<span class=\"c-dim\">$ swift run FoundationModelsRegressionDemo --gate</span>\\n<span class=\"cursor\" id=\"cur\"></span>';\n    cur = document.getElementById(\"cur\");\n    nodesEl.innerHTML = \"\";\n    verdict.classList.remove(\"show\");\n    resetBtn.hidden = true;\n    runBtn.hidden = false;\n    runBtn.disabled = false;\n  }\n\n  function run() {\n    if (running) return;\n    running = true;\n    runBtn.disabled = true;\n    runBtn.hidden = true;\n    resetBtn.hidden = false;\n    nodesEl.innerHTML = \"\";\n    verdict.classList.remove(\"show\");\n\n    // build (hidden) tree nodes\n    var nodeEls = nodesData.map(function (n) {\n      var el = document.createElement(\"div\");\n      el.className = \"node \" + n.type;\n      var marker = n.marker ? n.marker : \"\u2022\";\n      el.innerHTML = '<span class=\"marker\">' + marker + '</span><span>' + n.label + '</span>'\n                   + '<span class=\"badge\">' + n.tag + '</span>'\n                   + (n.detail ? '<span class=\"detail\">' + n.detail + '</span>' : '');\n      nodesEl.appendChild(el);\n      return el;\n    });\n\n    // stream the terminal\n    var delay = 250;\n    termData.forEach(function (line) {\n      delay += line.t;\n      timers.push(setTimeout(function () {\n        var span = document.createElement(\"span\");\n        span.className = line.cls;\n        span.textContent = line.text;\n        term.insertBefore(span, cur);\n        term.scrollTop = term.scrollHeight;\n      }, delay));\n    });\n\n    // reveal tree nodes in step\n    nodeEls.forEach(function (el, i) {\n      timers.push(setTimeout(function () { el.classList.add(\"show\"); }, 700 + i * 460));\n    });\n\n    // verdict last\n    timers.push(setTimeout(function () {\n      verdict.classList.add(\"show\");\n      cur.style.display = \"none\";\n      running = false;\n    }, delay + 500));\n  }\n\n  runBtn.addEventListener(\"click\", run);\n  resetBtn.addEventListener(\"click\", reset);\n})();\n</script>\n</body>\n</html>\n", "erro": "", "ms": 779}