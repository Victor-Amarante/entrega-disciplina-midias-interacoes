{"status": 200, "url_final": "https://scrollweaver.siruizou.com/", "html": "<!DOCTYPE html>\r\n<html lang=\"zh\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>ScrollWeaver - \u7ec7\u68a6\u7ed8\u5377</title>\r\n    <link rel=\"stylesheet\" href=\"/frontend/css/pages/home.css\">\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\">\r\n    <link\r\n        href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Inter:wght@400;600;700;800;900&display=swap\"\r\n        rel=\"stylesheet\">\r\n</head>\r\n<body>\r\n    <div class=\"home-container\">\r\n        <!-- \u9876\u90e8\u4e00\u53e5\u8bdd\u4ecb\u7ecd -->\r\n        <div class=\"hero-section\">\r\n            <h1 class=\"hero-title\">ScrollWeaver</h1>\r\n            <p class=\"hero-subtitle\">\u7531 AI \u9a71\u52a8\u7684\u6c89\u6d78\u5f0f\u865a\u62df\u4e16\u754c\u6784\u5efa\u4e0e\u591a\u667a\u80fd\u4f53\u535a\u5f08\u5e73\u53f0</p>\r\n        </div>\r\n\r\n        <!-- \u4e66\u5377\u533a\u57df -->\r\n        <div class=\"scroll-section\">\r\n            <div class=\"scroll-container\" id=\"scrollContainer\">\r\n                <div class=\"scroll-book\">\r\n                    <div class=\"scroll-cover\">\r\n                        <div class=\"scroll-title\">\u7f16\u7ec7\u4e66\u5377 \u535a\u5f08\u53e4\u4eca</div>\r\n                        <div class=\"scroll-decoration\"></div>\r\n                        <div class=\"scroll-subtitle-small\">\u4e00\u5377\u4e00\u4e16\u754c\uff0c\u4e00\u5ff5\u4e00\u6d6e\u751f</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"scroll-hint\">\r\n                <i class=\"fas fa-mouse\"></i>\r\n                <span>\u5411\u4e0b\u6eda\u52a8\u4e86\u89e3\u66f4\u591a</span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- \u4ecb\u7ecd\u5185\u5bb9\u533a\u57df -->\r\n        <div class=\"intro-section\" id=\"introSection\">\r\n            <div class=\"intro-content\">\r\n                <!-- \u73a9\u6cd5\u5c55\u793a -->\r\n                <section class=\"intro-block gameplay-section\">\r\n                    <h2>\u6838\u5fc3\u73a9\u6cd5</h2>\r\n                    <div class=\"gameplay-grid\">\r\n                        <div class=\"gameplay-card creation-card\">\r\n                            <div class=\"gameplay-visual creation-visual\">\r\n                                <div class=\"visual-content\">\r\n                                    <i class=\"fas fa-scroll\"></i>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"gameplay-content\">\r\n                                <div class=\"gameplay-number\">1</div>\r\n                                <h3>\u9020\u7269 (Creation)</h3>\r\n                                <p class=\"gameplay-slogan\">\u4e00\u5ff5\u751f\u4e07\u7269</p>\r\n                                <p class=\"gameplay-desc\">\u4e0a\u4f20\u4e00\u672c\u5c0f\u8bf4\uff0cAI \u77ac\u95f4\u4e3a\u4f60\u6784\u5efa\u4e16\u754c\u89c2\u3002\u4f60\u662f\u4f5c\u8005\uff0c\u4e5f\u662f\u9020\u7269\u4e3b\u3002</p>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"gameplay-card simulation-card\">\r\n                            <div class=\"gameplay-visual simulation-visual\">\r\n                                <div class=\"visual-content\">\r\n                                    <i class=\"fas fa-door-open\"></i>\r\n                                    <div class=\"crossing-line\"></div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"gameplay-content\">\r\n                                <div class=\"gameplay-number\">2</div>\r\n                                <h3>\u5386\u7ec3 (Simulation)</h3>\r\n                                <p class=\"gameplay-slogan\">\u7ea2\u5c18\u70bc\u672c\u5fc3</p>\r\n                                <p class=\"gameplay-desc\">\u7a7f\u8d8a\u81f3\u300a\u7ea2\u697c\u68a6\u300b\u6216\u300a\u4e09\u56fd\u300b\uff0c\u5316\u8eab\u5267\u4e2d\u4eba\uff0c\u6539\u5199\u65e2\u5b9a\u7684\u547d\u8fd0\u3002</p>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"gameplay-card gathering-card\">\r\n                            <div class=\"gameplay-visual gathering-visual\">\r\n                                <div class=\"visual-content\">\r\n                                    <i class=\"fas fa-users\"></i>\r\n                                    <div class=\"candle-light\"></div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"gameplay-content\">\r\n                                <div class=\"gameplay-number\">3</div>\r\n                                <h3>\u96c5\u96c6 (Gathering)</h3>\r\n                                <p class=\"gameplay-slogan\">\u535a\u5f08\u89c1\u771f\u7ae0</p>\r\n                                <p class=\"gameplay-desc\">\u4e0e\u6797\u9edb\u7389\u3001\u66f9\u64cd\u540c\u684c\u7ade\u6280\u3002\u5728'\u72fc\u4eba\u6740'\u535a\u5f08\u4e2d\uff0c\u4f53\u9a8c AI \u771f\u6b63\u7684\u8c0b\u7565\u3002</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </section>\r\n\r\n                <!-- \u6838\u5fc3\u6280\u672f -->\r\n                <section class=\"intro-block tech-section\">\r\n                    <h2>\u6838\u5fc3\u6280\u672f</h2>\r\n                    <p class=\"section-subtitle\">\u9aa8\u4e0e\u9b42\u7684\u89e3\u6784\uff0c\u7528\"\u7ecf\u7edc/\u8840\u8109\"\u8fde\u63a5\u4e07\u7269</p>\r\n                    <div class=\"tech-architecture\">\r\n                        <div class=\"tech-card p-arch\">\r\n                            <div class=\"tech-visual\">\r\n                                <div class=\"arch-visual p-visual\">\r\n                                    <i class=\"fas fa-comments\"></i>\r\n                                    <div class=\"connection-line\"></div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"tech-content\">\r\n                                <h3>P \u67b6\u6784 (\u79c1\u8bed)</h3>\r\n                                <p class=\"tech-arch-desc\">\u7528\u6237\u4e0e\u5355\u4e2aAI\u89d2\u8272\u8fdb\u884c1v1\u5bf9\u8bdd\uff0cAI\u57fa\u4e8e\u89d2\u8272\u8bbe\u5b9a\u548c\u8bb0\u5fc6\u8fdb\u884c\u56de\u5e94\u3002</p>\r\n                                <p class=\"tech-desc\">1v1 \u6c89\u6d78\u3002\u79c1\u5bc6\u7684\u5fc3\u7075\u5171\u632f\u3002</p>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"tech-card op-arch\">\r\n                            <div class=\"tech-visual\">\r\n                                <div class=\"arch-visual op-visual\">\r\n                                    <i class=\"fas fa-theater-masks\"></i>\r\n                                    <div class=\"orchestrator-shadow\"></div>\r\n                                    <div class=\"event-chain\"></div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"tech-content\">\r\n                                <h3>O-P \u67b6\u6784 (\u5165\u5377)</h3>\r\n                                <p class=\"tech-arch-desc\">Orchestrator\uff08\u6307\u6325\u5bb6\uff09\u8d1f\u8d23\u573a\u666f\u7f16\u6392\u548c\u4e8b\u4ef6\u751f\u6210\uff0cPerformer\uff08\u8868\u6f14\u8005\uff09\u4f5c\u4e3a\u89d2\u8272\u8fdb\u884c\u884c\u52a8\u3002\u901a\u8fc7\u4e8b\u4ef6\u94fe\u673a\u5236\uff0cAI\u7f16\u5bfc\u638c\u63a7\u5267\u672c\u5927\u7eb2\u3002</p>\r\n                                <div class=\"tech-explanation\">\r\n                                    <div>\r\n                                        <strong>\u6838\u5fc3\u7279\u6027\uff1a\u4e8b\u4ef6\u94fe (Event Chain)</strong>\r\n                                        <p>AI \u7f16\u5bfc\u638c\u63a7\u5267\u672c\u5927\u7eb2\uff0c\u62d2\u7edd\u6d41\u6c34\u8d26\uff0c\u8ba9\u6545\u4e8b\u6709\u59cb\u6709\u7ec8\u3002</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"tech-card aop-arch\">\r\n                            <div class=\"tech-visual\">\r\n                                <div class=\"arch-visual aop-visual\">\r\n                                    <i class=\"fas fa-brain\"></i>\r\n                                    <div class=\"belief-network\"></div>\r\n                                    <div class=\"brain-sparks\"></div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"tech-content\">\r\n                                <h3>A-O-P \u67b6\u6784 (\u96c5\u96c6)</h3>\r\n                                <p class=\"tech-arch-desc\">Administrator-Orchestrator-Performer\u67b6\u6784\u3002Administrator\uff08\u7ba1\u7406\u5458\uff09\u8d1f\u8d23\u901a\u8fc7\u4ee3\u7801\u786c\u63a7\u5236\uff0c\u5982\u72fc\u4eba\u6740\u7684\u8f6e\u6d41\u8c03\u5ea6\u673a\u5236\uff1bOrchestrator\u8d1f\u8d23\u573a\u666f\u7f16\u6392\uff1bPerformer\u4f5c\u4e3a\u89d2\u8272\u884c\u52a8\u3002\u901a\u8fc7\u4fe1\u5ff5\u673a\u5236\uff0cAI\u89d2\u8272\u5177\u6709\u7acb\u573a\u548c\u9635\u8425\u3002</p>\r\n                                <div class=\"tech-explanation\">\r\n                                    <div>\r\n                                        <strong>\u6838\u5fc3\u7279\u6027\uff1a\u4fe1\u5ff5\u673a\u5236 (Belief System)</strong>\r\n                                        <p>\u8d4b\u4e88 AI \u7acb\u573a\u3002\u4e3a\u4e86\u9635\u8425\uff0c\u5b83\u4f1a\u6492\u8c0e\u3001\u4f1a\u56fa\u6267\u3002\u8fd9\u662f\u4eba\u6027\u7684\u6570\u5b57\u955c\u50cf\u3002</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </section>\r\n\r\n                <!-- \u521b\u4f5c\u4e0e\u793e\u533a -->\r\n                <section class=\"intro-block ugc-section\">\r\n                    <h2>\u521b\u4f5c\u4e0e\u793e\u533a</h2>\r\n                    <div class=\"ugc-container\">\r\n                        <div class=\"ugc-left workshop\">\r\n                            <div class=\"ugc-header\">\r\n                                <i class=\"fas fa-tools\"></i>\r\n                                <h3>\u9020\u529e\u5904 (The Workshop)</h3>\r\n                            </div>\r\n                            <p class=\"ugc-subtitle\">\u4e09\u79cd\u65b9\u5f0f\uff0c\u7f16\u7ec7\u4f60\u7684\u4e16\u754c</p>\r\n                            <div class=\"workshop-visual\">\r\n                                <div class=\"workshop-desk\">\r\n                                    <i class=\"fas fa-pen-nib\"></i>\r\n                                    <i class=\"fas fa-scroll\"></i>\r\n                                    <i class=\"fas fa-book\"></i>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"function-list\">\r\n                                <div class=\"function-item\">\r\n                                    <div class=\"function-icon\">\u2728</div>\r\n                                    <div class=\"function-content\">\r\n                                        <h4>\u70b9\u77f3\u6210\u91d1 (RAG)</h4>\r\n                                        <p>\u4e0a\u4f20 PDF/TXT\uff08\u5982\u300a\u4e09\u4f53\u300b\uff09\uff0cAI \u81ea\u52a8\u63d0\u53d6\u4e16\u754c\u89c2\u3001\u5730\u7406\u5fd7\u4e0e\u4eba\u7269\u8c31\u7cfb\uff0c\u4e00\u952e\u751f\u6210\u4e66\u5377\u3002</p>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"function-item\">\r\n                                    <div class=\"function-icon\">\ud83c\udfa8</div>\r\n                                    <div class=\"function-content\">\r\n                                        <h4>\u51ed\u7a7a\u9020\u7269 (Prompt)</h4>\r\n                                        <p>\u8f93\u5165\u4e00\u53e5\u8bdd\uff08\u5982'\u6211\u8981\u4e00\u4e2a\u8d5b\u535a\u670b\u514b\u98ce\u683c\u7684\u7ea2\u697c\u68a6'\uff09\uff0cAI \u81ea\u52a8\u751f\u6210\u89c4\u5219\u914d\u7f6e\u3002</p>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"function-item\">\r\n                                    <div class=\"function-icon\">\u2699\ufe0f</div>\r\n                                    <div class=\"function-content\">\r\n                                        <h4>\u624b\u52a8\u7f16\u7ec7 (Manual)</h4>\r\n                                        <p>\u4e3a\u786c\u6838\u73a9\u5bb6\u51c6\u5907\u7684\u7f16\u8f91\u5668\u3002\u624b\u52a8\u8c03\u6574\u4e8b\u4ef6\u94fe\u8d70\u5411\uff0c\u7cbe\u4fee\u4eba\u7269\u4fe1\u5ff5\u53c2\u6570\u3002</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"ugc-right library\">\r\n                            <div class=\"ugc-header\">\r\n                                <i class=\"fas fa-book-open\"></i>\r\n                                <h3>\u85cf\u4e66\u9601 (The Library)</h3>\r\n                            </div>\r\n                            <p class=\"ugc-subtitle\">\u4e07\u5377\u6d41\u8f6c\uff0c\u5171\u4eab\u4e7e\u5764</p>\r\n                            <div class=\"library-visual\">\r\n                                <div class=\"books-shelf\">\r\n                                    <div class=\"book\"></div>\r\n                                    <div class=\"book\"></div>\r\n                                    <div class=\"book\"></div>\r\n                                    <div class=\"book\"></div>\r\n                                </div>\r\n                            </div>\r\n                            <p class=\"library-desc\">\u5728\u8fd9\u91cc\uff0c\u4f60\u53ef\u4ee5\u53d1\u5e03\u81ea\u5df1\u7684\u6770\u4f5c\uff0c\u6216\u4e0b\u8f7d\u4ed6\u4eba\u7684\u4e16\u754c\u3002\u6bcf\u4e00\u6b21\u4e0b\u8f7d\uff0c\u90fd\u662f\u4e00\u6b21\u65b0\u7684\u8f6e\u56de\u3002</p>\r\n                        </div>\r\n                    </div>\r\n                </section>\r\n\r\n                <!-- \u8054\u673a\u4e0e\u5171\u9e23 -->\r\n                <section class=\"intro-block connection-section\">\r\n                    <div class=\"connection-banner\">\r\n                        <div class=\"connection-visual\">\r\n                            <div class=\"ink-flow\"></div>\r\n                            <div class=\"user-silhouette left-user\">\r\n                                <i class=\"fas fa-user\"></i>\r\n                            </div>\r\n                            <div class=\"user-silhouette right-user\">\r\n                                <i class=\"fas fa-user-ninja\"></i>\r\n                            </div>\r\n                            <div class=\"connection-hands\"></div>\r\n                        </div>\r\n                        <div class=\"connection-content\">\r\n                            <h2>\u6253\u7834\u6b21\u5143\uff0c\u5165\u5377\u540c\u6e38</h2>\r\n                            <p class=\"connection-subtitle\">\u72ec\u4e50\u4e50\u4e0d\u5982\u4f17\u4e50\u4e50\u3002\u9080\u8bf7\u597d\u53cb\uff0c\u5171\u8d74\u8fd9\u573a\u8de8\u8d8a\u65f6\u7a7a\u7684\u96c5\u96c6\u3002</p>\r\n                            <div class=\"connection-features\">\r\n                                <div class=\"feature-item\">\r\n                                    <i class=\"fas fa-users\"></i>\r\n                                    <div>\r\n                                        <h4>\u5165\u5377\u540c\u6e38</h4>\r\n                                        <p>\u4e0e\u597d\u53cb\u5e76\u80a9\uff0c\u4e00\u540c\u63a8\u52a8\u6545\u4e8b\u53d1\u5c55\u3002</p>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"feature-item\">\r\n                                    <i class=\"fas fa-chess\"></i>\r\n                                    <div>\r\n                                        <h4>\u4eba\u673a\u535a\u5f08</h4>\r\n                                        <p>\u5728\u8fd9\u4e2a\u623f\u95f4\u91cc\uff0c\u6709 3 \u4e2a\u4eba\u7c7b\uff0c6 \u4e2a AI\u3002\u8c01\u662f\u5367\u5e95\uff1f\u5728\u8c0e\u8a00\u4e0e\u63a8\u7406\u4e2d\u5206\u8fa8\u771f\u5047\u3002</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <button class=\"find-party-button\" onclick=\"window.location.href='/frontend/pages/login.html'\">\r\n                                <span>\u5bfb\u627e\u540c\u4f34 (Find a Party)</span>\r\n                                <i class=\"fas fa-search\"></i>\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                </section>\r\n\r\n                <div class=\"cta-section\">\r\n                    <button class=\"cta-button\" onclick=\"window.location.href='/frontend/pages/login.html'\">\r\n                        <span>\u5165\u5377\u540c\u6e38</span>\r\n                        <i class=\"fas fa-arrow-right\"></i>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script src=\"/frontend/js/pages/home.js\"></script>\r\n</body>\r\n\r\n</html>\r\n", "erro": "", "ms": 716}