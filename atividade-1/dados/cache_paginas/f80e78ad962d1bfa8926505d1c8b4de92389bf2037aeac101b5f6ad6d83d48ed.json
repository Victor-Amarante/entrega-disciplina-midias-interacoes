{"status": 200, "url_final": "https://sabbour.me/agentweaver/", "html": "<!DOCTYPE html>\n<html lang=\"en-US\" dir=\"ltr\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n    <title>Agentweaver</title>\n    <meta name=\"description\" content=\"Put a team of AI agents on real work. You approve the plan and review the result.\">\n    <meta name=\"generator\" content=\"VitePress v1.6.4\">\n    <link rel=\"preload stylesheet\" href=\"/agentweaver/assets/style.zjSiS9Lb.css\" as=\"style\">\n    <link rel=\"preload stylesheet\" href=\"/agentweaver/vp-icons.css\" as=\"style\">\n    \n    <script type=\"module\" src=\"/agentweaver/assets/app.BPuqDS3-.js\"></script>\n    <link rel=\"preload\" href=\"/agentweaver/assets/inter-roman-latin.Di8DUHzh.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/framework.BJe9wsJO.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/theme.BcARSiMQ.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/katex.C5jXJg4s.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/sizeCapture-X5ZJPWSS.CR-vfmht.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/dagre-3AP2YEHR.DnMe9soE.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/swimlanes-XN3QIQJK.VDo6Gi9z.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/cose-bilkent-JH36ORCC.DuNRU7eD.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/c4Diagram-UCG6FXSJ.DojgbZNp.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/flowDiagram-A5DVABFB.DtHYxmya.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/swimlanesDiagram-VK2B7HYN.BRCRHoyc.js\">\n    <link rel=\"modulepreload\" href=\"/agentweaver/assets/chunks/erDiagram-SSCWMZ5O.Dw0jDOm4.js\">\n    <link rel=\"modulepreload\" href=\