{"status": 200, "url_final": "https://x0152.github.io/grand/", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" />\n  <meta name=\"color-scheme\" content=\"light\" />\n\n  <title>GRAND \u2014 One more AI-but-guarded system (Gonka inference, WinXP UI)</title>\n  <meta name=\"description\" content=\"AI-but-guarded multi-agent runtime. Agents run in isolated SSH sandboxes; every command passes a deterministic Guard. Supports Gonka decentralised inference. Optional Windows XP UI.\" />\n\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"./logo.svg\" />\n\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:title\" content=\"GRAND \u2014 One more AI-but-guarded system, supports Gonka inference\" />\n  <meta property=\"og:description\" content=\"Multi-agent runtime. Agents in SSH sandboxes, Guard on every command, Gonka decentralised inference, optional WinXP UI.\" />\n  <meta property=\"og:image\" content=\"https://x0152.github.io/grand/screenshot-winxp.jpg\" />\n  <meta property=\"og:url\" content=\"https://x0152.github.io/grand/\" />\n\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  <meta name=\"twitter:title\" content=\"GRAND \u2014 One more AI-but-guarded system, supports Gonka inference\" />\n  <meta name=\"twitter:description\" content=\"Multi-agent runtime. Agents in SSH sandboxes, Guard on every command, Gonka decentralised inference, optional WinXP UI.\" />\n  <meta name=\"twitter:image\" content=\"https://x0152.github.io/grand/screenshot-winxp.jpg\" />\n\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@400;500&display=swap\" rel=\"stylesheet\" />\n\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; }\n\n    :root {\n      --bg: #fafafa;\n      --fg: #0a0a0a;\n      --muted: #525866;\n      --line: #0a0a0a;\n      --rule-soft: rgba(10, 10, 10, 0.18);\n      --accent: #10b981;\n      --accent-soft: rgba(16, 185, 129, 0.10);\n      --warn: #b45309;\n      --danger: #b91c1c;\n    }\n\n    body {\n      background: var(--bg);\n      color: var(--fg);\n      font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;\n      font-feature-settings: 'ss01', 'cv11';\n      letter-spacing: -0.01em;\n      line-height: 1.55;\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n    }\n\n    a { color: inherit; text-decoration: none; }\n    .mono {\n      font-family: 'Geist Mono', ui-monospace, Menlo, Consolas, monospace;\n      letter-spacing: 0;\n    }\n\n    .masthead {\n      display: grid;\n      grid-template-columns: 1fr auto 1fr;\n      align-items: end;\n      gap: 24px;\n      padding: 24px 48px 14px;\n      border-bottom: 1px solid var(--line);\n    }\n    .masthead .left,\n    .masthead .right {\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: var(--muted);\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n    .masthead .right { justify-content: flex-end; }\n    .masthead .center {\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.28em;\n      text-transform: uppercase;\n    }\n    .pill {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 4px 11px;\n      border: 1px solid var(--line);\n      font-size: 11px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: var(--fg);\n    }\n    .pill .dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: var(--accent);\n    }\n    .double-rule {\n      border-bottom: 1px solid var(--line);\n      margin: 0 48px;\n      padding-bottom: 4px;\n    }\n\n    .display {\n      padding: 56px 48px 36px;\n      position: relative;\n    }\n    .display .axis {\n      position: absolute;\n      left: 48px;\n      right: 48px;\n      top: 16px;\n      display: flex;\n      justify-content: space-between;\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: var(--muted);\n    }\n    .display h1 {\n      margin: 0 0 48px;\n      font-weight: 800;\n      font-size: clamp(48px, 10vw, 120px);\n      line-height: 0.85;\n      letter-spacing: -0.06em;\n      text-align: center;\n    }\n    .display h1 .mark {\n      color: var(--accent);\n      font-weight: 800;\n    }\n\n    .lede-row {\n      display: grid;\n      grid-template-columns: 1fr auto 1fr;\n      align-items: end;\n      gap: 24px;\n      padding-top: 28px;\n      border-top: 1px solid var(--line);\n    }\n    .lede-row .l,\n    .lede-row .r {\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: var(--muted);\n    }\n    .lede-row .r { text-align: right; }\n    .lede {\n      max-width: 760px;\n      margin: 0 auto;\n      text-align: center;\n      font-size: clamp(20px, 2vw, 28px);\n      line-height: 1.45;\n      font-weight: 400;\n      letter-spacing: -0.015em;\n    }\n    .lede em {\n      font-style: italic;\n      color: var(--accent);\n      font-weight: 500;\n    }\n\n    .hero-cta {\n      margin-top: 40px;\n      padding-top: 28px;\n      border-top: 1px solid var(--line);\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      gap: 20px;\n      flex-wrap: wrap;\n    }\n    .btn-primary {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      padding: 14px 24px;\n      border: 1px solid var(--fg);\n      background: var(--fg);\n      color: var(--bg);\n      font-family: 'Geist Mono', monospace;\n      font-size: 12px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      font-weight: 600;\n      transition: background 0.12s, border-color 0.12s, color 0.12s;\n    }\n    .btn-primary:hover {\n      background: var(--accent);\n      border-color: var(--accent);\n      color: var(--fg);\n    }\n    .btn-primary svg { width: 16px; height: 16px; }\n    .btn-ghost {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      font-family: 'Geist Mono', monospace;\n      font-size: 12px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      border-bottom: 1px solid var(--fg);\n      padding-bottom: 3px;\n    }\n    .btn-ghost:hover {\n      color: var(--accent);\n      border-color: var(--accent);\n    }\n\n    .duo {\n      display: grid;\n      grid-template-columns: 1fr 1px 1fr;\n      padding: 0 48px;\n    }\n    .duo .col { padding: 44px 56px; }\n    .duo .col.left { padding-left: 0; }\n    .duo .col.right { padding-right: 0; }\n    .duo .rule { background: var(--line); }\n    .duo .label {\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.20em;\n      text-transform: uppercase;\n      color: var(--muted);\n      margin-bottom: 22px;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n    .duo .label .num { color: var(--fg); font-weight: 600; }\n    .duo h2 {\n      margin: 0 0 18px;\n      font-size: clamp(36px, 4.4vw, 60px);\n      line-height: 1.02;\n      letter-spacing: -0.04em;\n      font-weight: 700;\n    }\n    .duo h2 em {\n      font-style: italic;\n      font-weight: 600;\n      color: var(--accent);\n    }\n    .duo p {\n      margin: 0 0 14px;\n      font-size: 17px;\n      line-height: 1.65;\n      max-width: 46ch;\n    }\n    .duo .meta {\n      margin-top: 28px;\n      font-family: 'Geist Mono', monospace;\n      font-size: 12px;\n      line-height: 1.7;\n      letter-spacing: 0.04em;\n      color: var(--muted);\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n    .duo .meta .row {\n      display: grid;\n      grid-template-columns: 100px 1fr;\n      gap: 14px;\n    }\n    .duo .meta .k { color: var(--fg); }\n    .duo .link {\n      margin-top: 28px;\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      font-family: 'Geist Mono', monospace;\n      font-size: 12px;\n      letter-spacing: 0.06em;\n      text-transform: uppercase;\n      border-bottom: 1px solid var(--fg);\n      padding-bottom: 3px;\n    }\n    .duo .link:hover {\n      color: var(--accent);\n      border-color: var(--accent);\n    }\n\n    .stat {\n      margin: 22px 0 10px;\n      padding: 22px 22px 20px;\n      border: 1px solid var(--line);\n      display: flex;\n      align-items: baseline;\n      gap: 18px;\n    }\n    .stat .num {\n      font-weight: 800;\n      font-size: clamp(38px, 4.6vw, 64px);\n      line-height: 1.0;\n      letter-spacing: -0.04em;\n      color: var(--accent);\n    }\n    .stat .num .lt {\n      color: var(--fg);\n      font-weight: 500;\n    }\n    .stat .unit {\n      font-family: 'Geist Mono', monospace;\n      font-size: 12px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: var(--muted);\n      max-width: 14ch;\n      line-height: 1.5;\n    }\n    .stat .unit b {\n      display: block;\n      color: var(--fg);\n      font-weight: 600;\n      margin-bottom: 4px;\n    }\n\n    .bounty {\n      margin-top: 28px;\n      padding: 22px 22px 24px;\n      border: 1px solid var(--line);\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .bounty .meta {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: var(--muted);\n    }\n    .bounty .meta .dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: var(--warn);\n    }\n    .bounty h3 {\n      margin: 6px 0 2px;\n      font-size: 22px;\n      font-weight: 700;\n      letter-spacing: -0.02em;\n      line-height: 1.2;\n    }\n    .bounty h3 em {\n      font-style: italic;\n      font-weight: 600;\n      color: var(--accent);\n    }\n    .bounty p {\n      margin: 0;\n      font-size: 15px;\n      line-height: 1.6;\n      max-width: 100%;\n    }\n    .bounty .cta {\n      margin-top: 12px;\n      align-self: flex-start;\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      padding: 11px 18px;\n      background: var(--fg);\n      color: var(--bg);\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      font-weight: 600;\n      border: 1px solid var(--fg);\n      transition: background 0.12s, border-color 0.12s;\n    }\n    .bounty .cta:hover {\n      background: var(--accent);\n      border-color: var(--accent);\n      color: var(--fg);\n    }\n\n    .runrow {\n      margin: 0 48px;\n      padding: 44px 0 0;\n      border-top: 1px solid var(--line);\n    }\n    .runrow-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: baseline;\n      margin-bottom: 28px;\n      gap: 24px;\n      flex-wrap: wrap;\n    }\n    .runrow-head .label {\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.20em;\n      text-transform: uppercase;\n      color: var(--muted);\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n    .runrow-head .label .num { color: var(--fg); font-weight: 600; }\n    .runrow-head h2 {\n      margin: 0;\n      font-size: clamp(28px, 3.4vw, 44px);\n      line-height: 1.1;\n      letter-spacing: -0.03em;\n      font-weight: 700;\n    }\n    .runrow-head h2 em {\n      font-style: italic;\n      font-weight: 600;\n      color: var(--accent);\n    }\n\n    .runrow .grid {\n      display: grid;\n      grid-template-columns: 1.7fr 1px 1fr;\n      border-top: 1px solid var(--line);\n      padding: 36px 0 44px;\n    }\n    .runrow .diag-col {\n      padding: 0 48px 0 0;\n      min-width: 0;\n    }\n    .runrow .diag-col .head,\n    .runrow .qs-col .head {\n      display: flex;\n      justify-content: space-between;\n      align-items: baseline;\n      margin-bottom: 18px;\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--muted);\n    }\n    .runrow .diag-col .head b,\n    .runrow .qs-col .head b { color: var(--fg); font-weight: 600; }\n    .runrow .qs-col .head .arrow {\n      color: var(--accent);\n      font-weight: 700;\n      letter-spacing: 0;\n      margin-right: 6px;\n    }\n    .runrow .rule { background: var(--line); align-self: stretch; }\n    .runrow .qs-col {\n      padding: 0 0 0 48px;\n      display: flex;\n      flex-direction: column;\n      min-width: 0;\n    }\n\n    .qs-step {\n      padding: 18px 0;\n      border-bottom: 1px dashed var(--rule-soft);\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .qs-step:first-of-type { padding-top: 0; }\n    .qs-step:last-of-type { padding-bottom: 0; border-bottom: 0; }\n    .qs-step .meta {\n      display: flex;\n      align-items: baseline;\n      gap: 12px;\n      font-family: 'Geist Mono', monospace;\n      font-size: 11px;\n      letter-spacing: 0.20em;\n      text-transform: uppercase;\n      color: var(--muted);\n    }\n    .qs-step .meta .n {\n      color: var(--accent);\n      font-weight: 700;\n    }\n    .qs-step pre {\n      margin: 0;\n      padding: 14px 16px;\n      background: var(--fg);\n      color: var(--bg);\n      font-family: 'Geist Mono', monospace;\n      font-size: 13px;\n      line-height: 1.65;\n      white-space: pre;\n      overflow-x: auto;\n    }\n    .qs-step pre .prompt { color: #9ca3af; }\n    .qs-step pre .accent { color: var(--accent); }\n    .qs-step pre .comment { color: #9ca3af; font-style: italic; }\n\n    svg.diagram {\n      width: 100%;\n      height: auto;\n      display: block;\n    }\n    .diagram .node      { fill: var(--bg); stroke: var(--line); stroke-width: 1; }\n    .diagram .node-acc  { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1; }\n    .diagram .node-guard{ fill: rgba(180, 83, 9, 0.06); stroke: var(--warn); stroke-width: 1; }\n    .diagram .node-deny { fill: var(--bg); stroke: var(--danger); stroke-width: 1; stroke-dasharray: 3 3; }\n    .diagram .node-ext  { fill: var(--bg); stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 3; }\n    .diagram .container { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 4 3; }\n    .diagram .sb-wrap   { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1; }\n    .diagram .sb-item   { fill: var(--bg); stroke: var(--accent); stroke-width: 1; }\n    .diagram .sb-ctrl   { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.4; }\n    .diagram .lbl       { font: 600 13px 'Geist', sans-serif; fill: var(--fg); }\n    .diagram .sub       { font: 400 10px 'Geist Mono', monospace; fill: var(--muted); letter-spacing: 0.04em; }\n    .diagram .ctitle    { font: 600 10px 'Geist Mono', monospace; fill: var(--muted); letter-spacing: 0.18em; text-transform: uppercase; }\n    .diagram .glabel    { font: 700 12px 'Geist', sans-serif; fill: var(--warn); letter-spacing: 0.04em; }\n    .diagram .gtag      { font: 500 9px 'Geist Mono', monospace; fill: var(--warn); letter-spacing: 0.16em; text-transform: uppercase; }\n    .diagram .flow      { stroke: var(--fg); stroke-width: 1; fill: none; }\n    .diagram .flow-deny { stroke: var(--danger); stroke-width: 1.2; fill: none; stroke-dasharray: 3 3; }\n    .diagram .flow-ok   { stroke: var(--accent); stroke-width: 1.2; fill: none; }\n    .diagram .flow-ssh  { stroke: var(--accent); stroke-width: 1; fill: none; }\n    .diagram .edge      { font: 600 9px 'Geist Mono', monospace; letter-spacing: 0.18em; text-transform: uppercase; fill: var(--muted); }\n    .diagram .edge-ok   { fill: var(--accent); }\n    .diagram .edge-deny { fill: var(--danger); }\n    .diagram .edge-ssh  { fill: var(--accent); }\n    .diagram .caption   { font: 500 10px 'Geist Mono', monospace; fill: var(--muted); letter-spacing: 0.12em; text-transform: uppercase; }\n\n    .colophon {\n      padding: 22px 48px;\n      border-top: 1px solid var(--line);\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 28px;\n      font-family: 'Geist Mono', monospace;\n      font-size: 12px;\n      line-height: 1.5;\n      letter-spacing: 0.10em;\n      text-transform: uppercase;\n      color: var(--muted);\n    }\n    .colophon .k { color: var(--fg); margin-right: 10px; font-weight: 600; }\n\n    @media (max-width: 980px) {\n      .runrow .grid {\n        grid-template-columns: 1fr;\n        gap: 28px;\n        padding-top: 24px;\n      }\n      .runrow .diag-col { padding-right: 0; }\n      .runrow .rule { display: none; }\n      .runrow .qs-col {\n        padding: 24px 0 0;\n        border-top: 1px solid var(--line);\n      }\n      .display h1 {\n        font-size: clamp(96px, 18vw, 200px);\n        margin-bottom: 28px;\n      }\n    }\n\n    @media (max-width: 880px) {\n      .masthead,\n      .double-rule,\n      .display,\n      .colophon {\n        padding-left: 24px;\n        padding-right: 24px;\n      }\n      .double-rule { margin: 0 24px; }\n      .runrow { margin: 0 24px; }\n      .display .axis { left: 24px; right: 24px; }\n      .duo {\n        grid-template-columns: 1fr;\n        padding: 0 24px;\n      }\n      .duo .col { padding: 28px 0 24px; }\n      .duo .col.right { border-top: 1px solid var(--line); }\n      .duo .rule { display: none; }\n      .display { padding-top: 48px; }\n      .colophon { grid-template-columns: 1fr 1fr; }\n    }\n\n    @media (max-width: 560px) {\n      .masthead { grid-template-columns: 1fr; }\n      .masthead .center,\n      .masthead .right { display: none; }\n    }\n  </style>\n</head>\n<body>\n\n  <header class=\"masthead\">\n    <div class=\"left\">\n      <span class=\"pill\"><span class=\"dot\"></span>v0 \u00b7 in development</span>\n    </div>\n    <div class=\"center\">a runtime specimen</div>\n    <div class=\"right\">mit license \u00b7 2026</div>\n  </header>\n  <div class=\"double-rule\"></div>\n\n  <section class=\"display\">\n    <div class=\"axis\">\n      <span>display \u00b7 geist 800</span>\n      <span>open source</span>\n    </div>\n\n    <h1><span class=\"mark\">\u258d</span>GRAND</h1>\n\n    <div class=\"lede-row\">\n      <span class=\"l\">\u00a7 a runtime</span>\n      <p class=\"lede\">\n        Run powerful AI agents <em>without trusting them</em> with your machine.\n      </p>\n      <span class=\"r\">\u00a7 for your infra</span>\n    </div>\n\n    <div class=\"hero-cta\">\n      <a class=\"btn-primary\" href=\"https://github.com/x0152/grand\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path d=\"M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.1.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.7-3.88-1.54-3.88-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.9-.39s1.98.13 2.9.39c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.55 4.56-1.53 7.85-5.84 7.85-10.92C23.5 5.65 18.35.5 12 .5z\"/>\n        </svg>\n        view on github \u2192\n      </a>\n      <a class=\"btn-ghost\" href=\"#run\">how to run \u2193</a>\n    </div>\n  </section>\n\n  <section class=\"duo\">\n    <div class=\"col left\">\n      <div class=\"label\"><span class=\"num\">01</span> <span>the runtime \u00b7 grand</span></div>\n      <h2>A boundary, not a chatbot.</h2>\n      <p>\n        An LLM orchestrator routes tasks. Per-task agents run inside isolated sandboxes \u2014\n        <span class=\"mono\">base \u00b7 browser \u00b7 ffmpeg \u00b7 netsec \u00b7 runtimectl</span>. The Guard\n        authorises every command, every domain, every IP \u2014 before it touches a server.\n      </p>\n\n      <div class=\"meta\">\n        <div class=\"row\"><span class=\"k\">interface</span><span>web \u00b7 telegram \u00b7 plans</span></div>\n        <div class=\"row\"><span class=\"k\">guard</span><span>commands \u00b7 domains \u00b7 ips</span></div>\n        <div class=\"row\"><span class=\"k\">engine</span><span>gonka or any openai-compatible</span></div>\n        <div class=\"row\"><span class=\"k\">ui</span><span>web \u00b7 optional windows xp theme</span></div>\n      </div>\n\n      <a class=\"link\" href=\"https://github.com/x0152/grand\">view on github \u2192</a>\n    </div>\n\n    <div class=\"rule\" aria-hidden=\"true\"></div>\n\n    <div class=\"col right\">\n      <div class=\"label\"><span class=\"num\">02</span> <span>the engine \u00b7 gonka</span></div>\n      <h2>Cheap inference. <em>Decentralised.</em></h2>\n\n      <div class=\"stat\">\n        <span class=\"num\"><span class=\"lt\">&lt;</span>$0.01</span>\n        <span class=\"unit\"><b>per 1M tokens</b>open peer marketplace</span>\n      </div>\n\n      <p>\n        Gonka is a decentralised inference network \u2014 independent GPU hosts serve open-weight\n        models behind an OpenAI-compatible API. No central provider, no subscription; every\n        request is settled on-chain from a <span class=\"mono\">GNK</span> wallet.\n      </p>\n\n      <div class=\"bounty\">\n        <div class=\"meta\">\n          <span class=\"dot\"></span>\n          <span>protocol \u00b7 in development &amp; testing</span>\n        </div>\n        <h3>Contribute to Gonka. <em>Open-source.</em></h3>\n        <p>\n          Gonka is an open-source protocol \u2014 contributions welcome across the network:\n          issues, models, GPU compute, integrations.\n        </p>\n        <a class=\"cta\" href=\"https://gonka.ai\">contribute \u2192</a>\n      </div>\n\n      <a class=\"link\" href=\"https://gonka.ai\">about gonka \u2192</a>\n    </div>\n  </section>\n\n  <section class=\"runrow\" id=\"run\">\n    <div class=\"runrow-head\">\n      <span class=\"label\"><span class=\"num\">03</span> <span>how it works \u00b7 how to run</span></span>\n      <h2>The architecture. <em>Three commands.</em></h2>\n    </div>\n\n    <div class=\"grid\">\n      <div class=\"diag-col\">\n        <div class=\"head\">\n          <span><b>fig. 01</b> \u00b7 architecture</span>\n          <span>scale \u00b7 n.t.s.</span>\n        </div>\n        <svg class=\"diagram\" viewBox=\"0 0 1100 660\" role=\"img\" aria-label=\"GRAND architecture diagram\">\n          <defs>\n            <marker id=\"m-allow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"9\" markerHeight=\"9\" orient=\"auto\">\n              <path d=\"M0,0 L10,5 L0,10 z\" fill=\"#10b981\"/>\n            </marker>\n            <marker id=\"m-deny\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"9\" markerHeight=\"9\" orient=\"auto\">\n              <path d=\"M0,0 L10,5 L0,10 z\" fill=\"#b91c1c\"/>\n            </marker>\n            <marker id=\"m-flow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"9\" markerHeight=\"9\" orient=\"auto\">\n              <path d=\"M0,0 L10,5 L0,10 z\" fill=\"#0a0a0a\"/>\n            </marker>\n            <marker id=\"m-flow-bi\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"9\" markerHeight=\"9\" orient=\"auto-start-reverse\">\n              <path d=\"M0,0 L10,5 L0,10 z\" fill=\"#0a0a0a\"/>\n            </marker>\n            <marker id=\"m-ssh\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"9\" markerHeight=\"9\" orient=\"auto\">\n              <path d=\"M0,0 L10,5 L0,10 z\" fill=\"#10b981\"/>\n            </marker>\n          </defs>\n\n          <rect class=\"node\" x=\"60\" y=\"22\" width=\"120\" height=\"38\"/>\n          <text x=\"120\" y=\"40\" text-anchor=\"middle\" class=\"lbl\">telegram</text>\n          <text x=\"120\" y=\"54\" text-anchor=\"middle\" class=\"sub\">bot</text>\n\n          <rect class=\"node\" x=\"200\" y=\"22\" width=\"120\" height=\"38\"/>\n          <text x=\"260\" y=\"40\" text-anchor=\"middle\" class=\"lbl\">web chat</text>\n          <text x=\"260\" y=\"54\" text-anchor=\"middle\" class=\"sub\">react ui</text>\n\n          <rect class=\"node-ext\" x=\"900\" y=\"18\" width=\"180\" height=\"46\"/>\n          <text x=\"990\" y=\"38\" text-anchor=\"middle\" class=\"lbl\">llm provider</text>\n          <text x=\"990\" y=\"54\" text-anchor=\"middle\" class=\"sub\">openai \u00b7 ollama \u00b7 gonka</text>\n\n          <rect class=\"container\" x=\"40\" y=\"92\" width=\"1020\" height=\"384\" rx=\"6\"/>\n          <text x=\"58\" y=\"112\" class=\"ctitle\">grand \u00b7 docker compose / k8s</text>\n\n          <rect class=\"node\" x=\"66\" y=\"130\" width=\"170\" height=\"58\"/>\n          <text x=\"151\" y=\"155\" text-anchor=\"middle\" class=\"lbl\">web panel</text>\n          <text x=\"151\" y=\"172\" text-anchor=\"middle\" class=\"sub\">react</text>\n\n          <rect class=\"node-acc\" x=\"290\" y=\"130\" width=\"240\" height=\"58\"/>\n          <text x=\"410\" y=\"155\" text-anchor=\"middle\" class=\"lbl\">agent loop</text>\n          <text x=\"410\" y=\"172\" text-anchor=\"middle\" class=\"sub\">control plane \u00b7 llm reasoning</text>\n\n          <rect class=\"node\" x=\"900\" y=\"130\" width=\"140\" height=\"58\"/>\n          <text x=\"970\" y=\"155\" text-anchor=\"middle\" class=\"lbl\">llm client</text>\n          <text x=\"970\" y=\"172\" text-anchor=\"middle\" class=\"sub\">openai-compatible</text>\n\n          <rect class=\"node\" x=\"66\" y=\"232\" width=\"170\" height=\"58\"/>\n          <text x=\"151\" y=\"257\" text-anchor=\"middle\" class=\"lbl\">postgresql</text>\n          <text x=\"151\" y=\"274\" text-anchor=\"middle\" class=\"sub\">session log \u00b7 audit</text>\n\n          <rect class=\"node-guard\" x=\"340\" y=\"222\" width=\"160\" height=\"78\" rx=\"4\"/>\n          <text x=\"420\" y=\"252\" text-anchor=\"middle\" class=\"glabel\">GUARD</text>\n          <text x=\"420\" y=\"270\" text-anchor=\"middle\" class=\"sub\">profiles \u00b7 whitelist</text>\n          <text x=\"420\" y=\"286\" text-anchor=\"middle\" class=\"gtag\">authorize</text>\n\n          <rect class=\"node-deny\" x=\"560\" y=\"232\" width=\"150\" height=\"58\"/>\n          <text x=\"635\" y=\"257\" text-anchor=\"middle\" class=\"lbl\">blocked</text>\n          <text x=\"635\" y=\"274\" text-anchor=\"middle\" class=\"sub\">denied before exec</text>\n\n          <rect class=\"node-acc\" x=\"90\" y=\"356\" width=\"110\" height=\"50\"/>\n          <text x=\"145\" y=\"378\" text-anchor=\"middle\" class=\"lbl\">agent</text>\n          <text x=\"145\" y=\"392\" text-anchor=\"middle\" class=\"sub\">per-task</text>\n\n          <rect class=\"node-acc\" x=\"220\" y=\"356\" width=\"110\" height=\"50\"/>\n          <text x=\"275\" y=\"378\" text-anchor=\"middle\" class=\"lbl\">agent</text>\n          <text x=\"275\" y=\"392\" text-anchor=\"middle\" class=\"sub\">per-task</text>\n\n          <rect class=\"node-acc\" x=\"350\" y=\"356\" width=\"110\" height=\"50\"/>\n          <text x=\"405\" y=\"378\" text-anchor=\"middle\" class=\"lbl\">agent</text>\n          <text x=\"405\" y=\"392\" text-anchor=\"middle\" class=\"sub\">per-task</text>\n\n          <rect class=\"node-acc\" x=\"480\" y=\"356\" width=\"110\" height=\"50\"/>\n          <text x=\"535\" y=\"378\" text-anchor=\"middle\" class=\"lbl\">agent</text>\n          <text x=\"535\" y=\"392\" text-anchor=\"middle\" class=\"sub\">per-task</text>\n\n          <rect class=\"sb-wrap\" x=\"70\" y=\"494\" width=\"660\" height=\"110\" rx=\"4\"/>\n\n          <rect class=\"sb-item\" x=\"90\" y=\"510\" width=\"110\" height=\"56\"/>\n          <text x=\"145\" y=\"532\" text-anchor=\"middle\" class=\"lbl\">base</text>\n          <text x=\"145\" y=\"549\" text-anchor=\"middle\" class=\"sub\">python \u00b7 cli</text>\n\n          <rect class=\"sb-item\" x=\"220\" y=\"510\" width=\"110\" height=\"56\"/>\n          <text x=\"275\" y=\"532\" text-anchor=\"middle\" class=\"lbl\">browser</text>\n          <text x=\"275\" y=\"549\" text-anchor=\"middle\" class=\"sub\">playwright</text>\n\n          <rect class=\"sb-item\" x=\"350\" y=\"510\" width=\"110\" height=\"56\"/>\n          <text x=\"405\" y=\"532\" text-anchor=\"middle\" class=\"lbl\">ffmpeg</text>\n          <text x=\"405\" y=\"549\" text-anchor=\"middle\" class=\"sub\">media</text>\n\n          <rect class=\"sb-item\" x=\"480\" y=\"510\" width=\"110\" height=\"56\"/>\n          <text x=\"535\" y=\"532\" text-anchor=\"middle\" class=\"lbl\">netsec</text>\n          <text x=\"535\" y=\"549\" text-anchor=\"middle\" class=\"sub\">nmap \u00b7 dig</text>\n\n          <rect class=\"sb-ctrl\" x=\"610\" y=\"510\" width=\"110\" height=\"56\"/>\n          <text x=\"665\" y=\"532\" text-anchor=\"middle\" class=\"lbl\">runtimectl</text>\n          <text x=\"665\" y=\"549\" text-anchor=\"middle\" class=\"sub\">controller</text>\n\n          <text x=\"400\" y=\"590\" text-anchor=\"middle\" class=\"ctitle\">sandboxes \u00b7 ssh :22 \u00b7 sibling containers</text>\n\n          <rect class=\"node-ext\" x=\"780\" y=\"494\" width=\"290\" height=\"110\"/>\n          <text x=\"925\" y=\"528\" text-anchor=\"middle\" class=\"lbl\">your infra</text>\n          <text x=\"925\" y=\"546\" text-anchor=\"middle\" class=\"sub\">linux \u00b7 vm \u00b7 bare metal \u00b7 apis</text>\n          <text x=\"925\" y=\"562\" text-anchor=\"middle\" class=\"sub\">scoped ssh \u00b7 per-host credentials</text>\n          <text x=\"925\" y=\"590\" text-anchor=\"middle\" class=\"ctitle\">your servers \u00b7 external</text>\n\n          <text x=\"555\" y=\"638\" text-anchor=\"middle\" class=\"caption\">runtimectl can build new sandboxes on demand \u00b7 scoped ssh reaches your external servers</text>\n\n          <path class=\"flow\" d=\"M120 60 V92\" marker-end=\"url(#m-flow)\"/>\n          <path class=\"flow\" d=\"M260 60 V92\" marker-end=\"url(#m-flow)\"/>\n\n          <path class=\"flow\" d=\"M970 64 V130\" marker-start=\"url(#m-flow-bi)\" marker-end=\"url(#m-flow-bi)\"/>\n          <text x=\"980\" y=\"110\" class=\"edge\">api</text>\n\n          <path class=\"flow\" d=\"M530 159 H900\" marker-start=\"url(#m-flow-bi)\" marker-end=\"url(#m-flow-bi)\"/>\n\n          <path class=\"flow\" d=\"M410 188 V222\" marker-end=\"url(#m-flow)\"/>\n          <text x=\"418\" y=\"208\" class=\"edge\">tool calls</text>\n\n          <path class=\"flow-deny\" d=\"M500 261 H560\" marker-end=\"url(#m-deny)\"/>\n          <text x=\"528\" y=\"252\" text-anchor=\"middle\" class=\"edge edge-deny\">deny</text>\n\n          <path class=\"flow-ok\" d=\"M420 300 V330\"/>\n          <path class=\"flow-ok\" d=\"M145 330 H535\"/>\n          <path class=\"flow-ok\" d=\"M145 330 V356\" marker-end=\"url(#m-allow)\"/>\n          <path class=\"flow-ok\" d=\"M275 330 V356\" marker-end=\"url(#m-allow)\"/>\n          <path class=\"flow-ok\" d=\"M405 330 V356\" marker-end=\"url(#m-allow)\"/>\n          <path class=\"flow-ok\" d=\"M535 330 V356\" marker-end=\"url(#m-allow)\"/>\n          <text x=\"436\" y=\"320\" class=\"edge edge-ok\">allow</text>\n\n          <path class=\"flow-ssh\" d=\"M145 406 V510\" marker-end=\"url(#m-ssh)\"/>\n          <path class=\"flow-ssh\" d=\"M275 406 V510\" marker-end=\"url(#m-ssh)\"/>\n          <path class=\"flow-ssh\" d=\"M405 406 V510\" marker-end=\"url(#m-ssh)\"/>\n          <path class=\"flow-ssh\" d=\"M535 406 V510\" marker-end=\"url(#m-ssh)\"/>\n          <text x=\"152\" y=\"448\" class=\"edge edge-ssh\">ssh</text>\n          <text x=\"282\" y=\"448\" class=\"edge edge-ssh\">ssh</text>\n          <text x=\"412\" y=\"448\" class=\"edge edge-ssh\">ssh</text>\n          <text x=\"542\" y=\"448\" class=\"edge edge-ssh\">ssh</text>\n\n          <path class=\"flow-ssh\" d=\"M590 381 H750 V549 H780\" marker-end=\"url(#m-ssh)\"/>\n          <text x=\"600\" y=\"372\" class=\"edge edge-ssh\">ssh \u00b7 external</text>\n        </svg>\n      </div>\n\n      <div class=\"rule\" aria-hidden=\"true\"></div>\n\n      <div class=\"qs-col\">\n        <div class=\"head\">\n          <span><span class=\"arrow\">\u25b6</span> <b>quick start</b> \u00b7 3 commands</span>\n          <span>docker required</span>\n        </div>\n\n        <div class=\"qs-step\">\n          <div class=\"meta\"><span class=\"n\">01</span> <span>clone</span></div>\n<pre><span class=\"prompt\">$</span> git clone <span class=\"accent\">github.com/x0152/grand</span></pre>\n        </div>\n\n        <div class=\"qs-step\">\n          <div class=\"meta\"><span class=\"n\">02</span> <span>enter</span></div>\n<pre><span class=\"prompt\">$</span> cd grand</pre>\n        </div>\n\n        <div class=\"qs-step\">\n          <div class=\"meta\"><span class=\"n\">03</span> <span>run</span></div>\n<pre><span class=\"prompt\">$</span> ./quickstart.sh\n<span class=\"comment\"># prints URL + AUTH_TOKEN, then follow the in-app wizard</span></pre>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <footer class=\"colophon\">\n    <div><span class=\"k\">install</span>./quickstart.sh</div>\n    <div><span class=\"k\">port</span>localhost:27173</div>\n    <div><span class=\"k\">repo</span>github.com/x0152/grand</div>\n    <div><span class=\"k\">network</span>gonka.ai</div>\n  </footer>\n\n</body>\n</html>\n", "erro": "", "ms": 368}