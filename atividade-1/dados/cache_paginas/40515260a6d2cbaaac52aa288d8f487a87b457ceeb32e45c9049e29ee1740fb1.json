{"status": 200, "url_final": "https://nonaveragejoe.itch.io/gekokujo-jidai", "html": "<!DOCTYPE HTML><html lang=\"en\"><head><meta charset=\"UTF-8\"/><meta content=\"#1A0F0D\" name=\"theme-color\"/><meta content=\"https://img.itch.zone/aW1nLzI3NzM4MDg2LnBuZw==/original/HAPUEP.png\" property=\"og:image\"/><link href=\"https://img.itch.zone/aW1nLzI3NzM4MDg2LnBuZw==/32x32%23/m5cYmI.png\" type=\"image/png\" rel=\"icon\"/><meta content=\"itch.io\" property=\"og:site_name\"/><meta content=\"4503599627724030\" property=\"twitter:account_id\"/><meta content=\"width=device-width, initial-scale=1\" name=\"viewport\"/><meta content=\"games/4654847\" name=\"itch:path\"/><meta content=\"@itchio\" name=\"twitter:site\"/><meta content=\"Gekokujo Jidai by NonAverageJoe\" name=\"twitter:title\"/><meta content=\"\" name=\"twitter:description\"/><meta content=\"summary_large_image\" name=\"twitter:card\"/><meta content=\"https://img.itch.zone/aW1nLzI3NzM4MDg2LnBuZw==/508x254%23mb/Mn7YXt.png\" property=\"twitter:image\"/><meta content=\"https://nonaveragejoe.itch.io/gekokujo-jidai\" name=\"twitter:url\"/><script type=\"application/ld+json\">{\"itemListElement\":[{\"position\":1,\"@type\":\"ListItem\",\"item\":{\"name\":\"Games\",\"@id\":\"https:\\/\\/itch.io\\/games\"}},{\"position\":2,\"@type\":\"ListItem\",\"item\":{\"name\":\"Role Playing\",\"@id\":\"https:\\/\\/itch.io\\/games\\/genre-rpg\"}},{\"position\":3,\"@type\":\"ListItem\",\"item\":{\"name\":\"Free\",\"@id\":\"https:\\/\\/itch.io\\/games\\/free\"}}],\"@context\":\"http:\\/\\/schema.org\",\"@type\":\"BreadcrumbList\"}</script><script type=\"application/ld+json\">{\"name\":\"Gekokujo Jidai\",\"@context\":\"http:\\/\\/schema.org\\/\",\"@type\":\"Product\"}</script><title>Gekokujo Jidai by NonAverageJoe</title><meta name=\"csrf_token\" value=\"WyJuZnVQIiwxNzg4NDA3MTY2LCJqdUVpV1dCYzQ3bmh1eVUiXQ==.Bl4yuPuqZYGUn40w93phu1WXySI=\" /><link href=\"https://static.itch.io/game.css?1788406861\" rel=\"stylesheet\"/><script type=\"text/javascript\">window.itchio_translations_url = 'https://static.itch.io/translations';</script><script src=\"https://static.itch.io/lib.min.js?1788406861\" type=\"text/javascript\"></script><script src=\"https://static.itch.io/bundle.min.js?1788406861\" type=\"text/javascript\"></script><script src=\"https://static.itch.io/lib/jquery.maskMoney.js\" type=\"text/javascript\"></script><script id=\"lib_react_src\" data-src=\"https://static.itch.io/react.min.js?1788406861\"></script><script src=\"https://static.itch.io/game.min.js?1788406861\" type=\"text/javascript\"></script><script type=\"text/javascript\">I.current_user = null;I.subdomain = true;</script><script type=\"text/javascript\">if (!window.location.hostname.match(/localhost/)) {      window.dataLayer = window.dataLayer || [];\n      function gtag(){dataLayer.push(arguments);}\n      gtag('js', new Date());\n      gtag('config', \"G-36R7NPBMLS\", {});\n      (function(d, t, s, m) {\n        s = d.createElement(t);\n        s.src = \"https:\\/\\/www.googletagmanager.com\\/gtag\\/js?id=G-36R7NPBMLS\";\n        s.async = 1;\n        m = d.getElementsByTagName(t)[0];\n        m.parentNode.insertBefore(s, m);\n      })(document, \"script\");\n      }</script><style type=\"text/css\" id=\"game_theme\">:root{--itchio_ui_bg: #2e2b2b;--itchio_ui_bg_dark: #272525}.wrapper{--itchio_font_family: Lato;--itchio_bg_color: #1A0F0D;--itchio_bg2_color: rgba(202, 189, 141, 1);--itchio_bg2_sub: #b7aa7a;--itchio_text_color: #0c0c0c;--itchio_link_color: #fa5c5c;--itchio_border_color: #a89961;--itchio_button_color: #fa5c5c;--itchio_button_fg_color: #ffffff;--itchio_button_shadow_color: #e54747;background-color:#1A0F0D;/*! */  /* */}.inner_column{color:#0c0c0c;font-family:Lato,Lato,LatoExtended,sans-serif;background-color:rgba(202, 189, 141, 1)}.inner_column ::selection{color:#ffffff;background:#fa5c5c}.inner_column ::-moz-selection{color:#ffffff;background:#fa5c5c}.inner_column h1,.inner_column h2,.inner_column h3,.inner_column h4,.inne