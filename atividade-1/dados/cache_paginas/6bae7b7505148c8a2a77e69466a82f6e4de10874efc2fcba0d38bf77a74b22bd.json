{"status": 200, "url_final": "https://sumitaich1998.github.io/ai-game-engine/", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>VICE \u2014 Talk to Your Game | AI Game Engine</title>\n\n    <!-- Primary meta -->\n    <meta\n      name=\"description\"\n      content=\"Talk to your game and it rewrites itself live. An AI Game Master engine in the browser: type plain English, watch the open world obey. Three.js, no build step.\"\n    />\n    <meta name=\"theme-color\" content=\"#ff3ea5\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"./assets/favicon.svg\" />\n\n    <!-- Open Graph -->\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://sumitaich1998.github.io/ai-game-engine/\" />\n    <meta property=\"og:title\" content=\"AI Game Engine \u2014 talk to your game, it rewrites itself live\" />\n    <meta\n      property=\"og:description\"\n      content=\"Type plain English while you play and the world obeys: spawn a T-Rex, repaint the city, drop a Taj Mahal, give a lion a mind of its own. Ships with VICE, a neon open-world playground.\"\n    />\n    <meta\n      property=\"og:image\"\n      content=\"https://sumitaich1998.github.io/ai-game-engine/assets/banner.svg\"\n    />\n    <meta\n      property=\"og:image:alt\"\n      content=\"AI Game Engine - talk to your game and it rewrites itself live\"\n    />\n\n    <!-- Twitter -->\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"AI Game Engine \u2014 talk to your game, it rewrites itself live\" />\n    <meta\n      name=\"twitter:description\"\n      content=\"Type plain English while you play and the world obeys: spawn a T-Rex, repaint the city, drop a Taj Mahal, give a lion a mind of its own. Ships with VICE, a neon open-world playground.\"\n    />\n    <meta\n      name=\"twitter:image\"\n      content=\"https://sumitaich1998.github.io/ai-game-engine/assets/banner.svg\"\n    />\n    <meta\n      name=\"twitter:image:alt\"\n      content=\"AI Game Engine - talk to your game and it rewrites itself live\"\n    />\n\n    <link rel=\"stylesheet\" href=\"./style.css\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Monoton&family=Orbitron:wght@400;700;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n\n    <script type=\"importmap\">\n      {\n        \"imports\": {\n          \"three\": \"https://unpkg.com/three@0.160.0/build/three.module.js\",\n          \"three/addons/\": \"https://unpkg.com/three@0.160.0/examples/jsm/\"\n        }\n      }\n    </script>\n  </head>\n  <body>\n    <!-- Loading screen -->\n    <div id=\"loader\">\n      <div class=\"loader-inner\">\n        <h1 class=\"logo\">VICE</h1>\n        <p class=\"tagline\">A Sunset City, In Your Browser</p>\n        <div class=\"bar\"><div class=\"bar-fill\" id=\"bar-fill\"></div></div>\n        <p class=\"hint\" id=\"loader-hint\">Booting engine...</p>\n      </div>\n    </div>\n\n    <!-- Start screen -->\n    <div id=\"start\" class=\"hidden\">\n      <div class=\"start-inner\">\n        <h1 class=\"logo big\">VICE</h1>\n        <p class=\"tagline\">Open world. Sunset forever.</p>\n        <div class=\"controls-card\">\n          <h3>Controls</h3>\n          <ul>\n            <li><b>W A S D</b> \u2014 Move / Drive</li>\n            <li><b>Mouse</b> \u2014 Look around</li>\n            <li><b>Shift</b> \u2014 Sprint / Boost</li>\n            <li><b>Space</b> \u2014 Jump / Handbrake</li>\n            <li><b>F</b> \u2014 Enter / Exit vehicle</li>\n            <li><b>C</b> \u2014 Toggle camera (1st/3rd person)</li>\n            <li><b>R</b> \u2014 Respawn / Flip car</li>\n            <li><b>ESC</b> \u2014 Release mouse</li>\n          </ul>\n        </div>\n        <div class=\"quality\">\n          <span class=\"qlbl\">Graphics</span>\n          <div class=\"qrow\" id=\"quality-row\">\n            <button class=\"q-btn selected\" data-quality=\"low\">LOW</button>\n            <button class=\"q-btn\" data-quality=\"med\">MEDIUM</button>\n            <button class=\"q-btn\" data-quality=\"high\">HIGH</button>\n          </div>\n          <p class=\"qhint\">Stay on LOW if your laptop slows down.</p>\n        </div>\n        <button id=\"play-btn\">DRIVE INTO THE SUNSET</button>\n      </div>\n    </div>\n\n    <!-- In-game HUD -->\n    <div id=\"hud\" class=\"hidden\">\n      <div id=\"hud-top-left\">\n        <div class=\"brand\">VICE</div>\n        <div id=\"status-line\">On foot</div>\n      </div>\n\n      <div id=\"hud-top-right\">\n        <div class=\"clock\"><span id=\"clock-time\">19:42</span></div>\n        <div class=\"stat\"><span class=\"lbl\">Cash</span> $<span id=\"cash\">0</span></div>\n        <div class=\"stat\"><span class=\"lbl\">Wanted</span> <span id=\"stars\">\u2014</span></div>\n      </div>\n\n      <div id=\"hud-bottom-left\">\n        <div class=\"bar-wrap\">\n          <span class=\"bar-lbl\">HEALTH</span>\n          <div class=\"bar small\"><div class=\"bar-fill health\" id=\"health-fill\"></div></div>\n        </div>\n        <div class=\"bar-wrap\">\n          <span class=\"bar-lbl\">ARMOR</span>\n          <div class=\"bar small\"><div class=\"bar-fill armor\" id=\"armor-fill\"></div></div>\n        </div>\n      </div>\n\n      <div id=\"hud-bottom-right\">\n        <div id=\"speedo\" class=\"hidden\">\n          <div class=\"speedo-num\"><span id=\"speed-num\">0</span><span class=\"unit\">MPH</span></div>\n          <div class=\"gear\">Gear <span id=\"gear\">D</span></div>\n        </div>\n        <canvas id=\"minimap\" width=\"180\" height=\"180\"></canvas>\n      </div>\n\n      <div id=\"prompt\" class=\"prompt hidden\">\n        Press <b>F</b> to enter vehicle\n      </div>\n\n      <div id=\"toast\" class=\"toast hidden\"></div>\n    </div>\n\n    <!-- AI Game Master console (populated by src/agent_console.js) -->\n    <div id=\"agent-console\" class=\"agent-console hidden\"></div>\n\n    <div id=\"errlog\" class=\"errlog hidden\"></div>\n\n    <canvas id=\"game\"></canvas>\n\n    <script type=\"module\" src=\"./src/main.js\"></script>\n  </body>\n</html>\n", "erro": "", "ms": 615}