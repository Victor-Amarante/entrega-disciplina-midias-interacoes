reenshot\":\"https://ship-it.ai/og-default.png\",\"isAccessibleForFree\":true,\"featureList\":[\"Chat-driven development with Claude Code or Codex\",\"Isolated per-session containers with a live app to test against\",\"Run many coding agents in parallel, each on its own branch\",\"Inline PR, CI, and deploy lifecycle without leaving the chat\",\"Linear and GitHub Issues in one inline tracker\",\"Docker Compose live previews with hot reload, driven by the agent\",\"Android build, test, and emulator preview alongside web projects\",\"Agent-rendered diagrams, mockups, and prototypes in a Present tab\",\"Mobile-first installable app with voice input and spoken summaries\",\"Self-hosted on a VPS you own or local Docker\"],\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\"},\"license\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"softwareVersion\":\"latest\",\"sameAs\":[\"https://github.com/nikzlabs/shipit\",\"https://www.linkedin.com/in/nikolayz/\",\"https://x.com/evs0\"],\"author\":{\"@id\":\"https://ship-it.ai/#organization\"},\"publisher\":{\"@id\":\"https://ship-it.ai/#organization\"}}</script><link rel=\"stylesheet\" href=\"/_astro/BaseLayout.16s1DSpe.css\"><link rel=\"stylesheet\" href=\"/_astro/index.nLKwKnHr.css\"></head><body class=\"flex flex-col min-h-screen\"><a href=\"#main\" class=\"sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-3 focus:py-2 focus:bg-[var(--color-surface-2)] focus:text-[var(--color-text-primary)] focus:rounded-lg focus:border focus:border-[var(--color-border-strong)]\">Skip to content</a><header class=\"nav\" data-astro-cid-wpvy4v7s><div class=\"nav-inner container-page\" data-astro-cid-wpvy4v7s><a class=\"brand\" href=\"/\" aria-label=\"ShipIt home\" data-astro-cid-wpvy4v7s><img src=\"/favicon.svg\" alt=\"\" width=\"30\" height=\"30\" data-astro-cid-wpvy4v7s><span class=\"wm\" data-astro-cid-wpvy4v7s>Ship<b data-astro-cid-wpvy4v7s>It</b></span></a><nav class=\"links\" aria-l