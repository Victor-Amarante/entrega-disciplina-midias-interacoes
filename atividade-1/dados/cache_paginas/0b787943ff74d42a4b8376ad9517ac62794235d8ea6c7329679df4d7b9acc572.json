{"status": 200, "url_final": "https://insight-ai-ai-business-intelligence.vercel.app/", "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>AI Business Intelligence Agent</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n    tailwind.config = {\n    theme: {\n        extend: {\n        colors: {\n            bg: '#050816',\n            card: '#0B1220',\n            accent: '#00E5FF',\n            'accent-dim': '#00E5FF33',\n            border: '#1E293B',\n            muted: '#64748B',\n            'muted-light': '#94A3B8',\n        },\n        fontFamily: {\n            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],\n            mono: ['JetBrains Mono', 'Fira Code', 'monospace'],\n        },\n        animation: {\n            'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',\n            'shimmer': 'shimmer 2s linear infinite',\n            'fade-in': 'fadeIn 0.5s ease-out forwards',\n            'slide-up': 'slideUp 0.5s ease-out forwards',\n            'glow': 'glow 2s ease-in-out infinite alternate',\n        },\n        keyframes: {\n            shimmer: {\n            '0%': { backgroundPosition: '-200% 0' },\n            '100%': { backgroundPosition: '200% 0' },\n            },\n            fadeIn: {\n            '0%': { opacity: '0' },\n            '100%': { opacity: '1' },\n            },\n            slideUp: {\n            '0%': { opacity: '0', transform: 'translateY(16px)' },\n            '100%': { opacity: '1', transform: 'translateY(0)' },\n            },\n            glow: {\n            '0%': { boxShadow: '0 0 20px rgba(0, 229, 255, 0.15)' },\n            '100%': { boxShadow: '0 0 40px rgba(0, 229, 255, 0.35)' },\n            },\n        },\n        },\n    },\n    };\n</script>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\" />\n<link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body class=\"min-h-screen overflow-x-hidden\">\n\n<!-- Ambient orbs -->\n<div class=\"orb w-96 h-96 bg-accent/5 top-0 left-1/4 -translate-x-1/2 fixed\"></div>\n<div class=\"orb w-80 h-80 bg-blue-500/5 top-1/3 right-0 fixed\"></div>\n<div class=\"orb w-64 h-64 bg-accent/3 bottom-0 left-1/3 fixed\"></div>\n\n<!-- Navigation -->\n<nav class=\"glass-nav fixed top-0 left-0 right-0 z-50\">\n    <div class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\">\n    <div class=\"flex items-center gap-3\">\n        <div class=\"w-8 h-8 rounded-lg bg-accent/10 border border-accent/30 flex items-center justify-center logo-icon\">\n        <svg class=\"w-4 h-4 text-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 10V3L4 14h7v7l9-11h-7z\"/>\n        </svg>\n        </div>\n        <span class=\"font-semibold text-white tracking-tight\">IntelliAgent</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-8 text-sm text-muted-light\">\n        <a href=\"#hero\" class=\"hover:text-accent transition-colors\">Home</a>\n        <a href=\"#search\" class=\"hover:text-accent transition-colors\">Analyze</a>\n        <a href=\"#\" onclick=\"alert('Beta features coming soon!')\" class=\"px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-medium border border-accent/20 hover:bg-accent/20 transition-colors cursor-pointer\">Beta</a>\n    </div>\n    </div>\n</nav>\n\n<!-- ===================== HERO SECTION ===================== -->\n<section id=\"hero\" class=\"relative pt-32 pb-20 px-6 grid-bg\">\n    <div class=\"max-w-4xl mx-auto text-center\">\n    <div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-pill text-xs text-muted-light mb-8 animate-fade-in\">\n        <span class=\"accent-dot\"></span>\n        Powered by Multi-Agent AI Research\n    </div>\n\n    <h1 class=\"text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-tight mb-6 animate-slide-up\">\n        <span class=\"gradient-text\">AI Business Intelligence</span><br />\n        <span class=\"text-white\">Agent</span>\n    </h1>\n\n    <p class=\"text-lg sm:text-xl text-muted-light max-w-2xl mx-auto leading-relaxed mb-10 animate-slide-up\" style=\"animation-delay: 0.1s\">\n        Transform company research into actionable AI opportunities\n    </p>\n\n    <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up\" style=\"animation-delay: 0.2s\">\n        <a href=\"#search\" class=\"btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl text-bg font-semibold text-sm\">\n        Get Started\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n        </svg>\n        </a>\n\n    </div>\n\n    <!-- Feature pills -->\n    <div class=\"mt-16 flex flex-wrap justify-center gap-3 animate-fade-in\" style=\"animation-delay: 0.4s\">\n        <span class=\"feature-pill\">6 Specialized Agents</span>\n        <span class=\"feature-pill\">Real-time Research</span>\n        <span class=\"feature-pill\">CEO-Ready Pitch</span>\n        <span class=\"feature-pill\">AI Roadmap</span>\n    </div>\n    </div>\n</section>\n\n<!-- ===================== SEARCH SECTION ===================== -->\n<section id=\"search\" class=\"relative py-16 px-6\">\n    <div class=\"max-w-2xl mx-auto\">\n    <div class=\"gradient-border p-8 sm:p-10\">\n        <div class=\"relative z-10\">\n        <div class=\"flex items-center gap-3 mb-6\">\n            <div class=\"w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center\">\n            <svg class=\"w-5 h-5 text-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"/>\n            </svg>\n            </div>\n            <div>\n            <h2 class=\"text-lg font-semibold text-white\">Company Analysis</h2>\n            <p class=\"text-sm text-muted\">Enter a company name to generate a full AI intelligence report</p>\n            </div>\n        </div>\n\n        <form id=\"searchForm\" class=\"space-y-4\">\n            <div>\n            <label for=\"companyInput\" class=\"block text-sm font-medium text-muted-light mb-2\">Company Name</label>\n            <input\n                type=\"text\"\n                id=\"companyInput\"\n                name=\"company\"\n                placeholder=\"e.g. Stripe, Shopify, Tesla...\"\n                autocomplete=\"organization\"\n                required\n                class=\"search-input w-full px-4 py-3.5 rounded-xl bg-bg border border-border text-white placeholder-muted focus:outline-none focus:border-accent/50 transition-all text-sm\"\n            />\n            </div>\n            <button\n            type=\"submit\"\n            id=\"generateBtn\"\n            class=\"btn-primary w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-bg font-semibold text-sm\"\n            >\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z\"/>\n            </svg>\n            Generate Report\n            </button>\n        </form>\n        </div>\n    </div>\n    </div>\n</section>\n\n<!-- ===================== LOADING SCREEN ===================== -->\n<section id=\"loadingScreen\" class=\"section-hidden relative py-16 px-6\">\n    <div class=\"max-w-xl mx-auto\">\n    <div class=\"gradient-border p-8 sm:p-10 animate-glow\">\n        <div class=\"relative z-10\">\n        <div class=\"text-center mb-8\">\n            <div class=\"inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-accent/10 border border-accent/30 mb-4\">\n            <svg class=\"w-7 h-7 text-accent animate-spin\" style=\"animation-duration: 3s\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/>\n            </svg>\n            </div>\n            <h2 class=\"text-xl font-semibold text-white mb-1\">Analyzing Company</h2>\n            <p id=\"loadingCompanyName\" class=\"text-accent font-medium text-sm\"></p>\n        </div>\n\n        <!-- Progress bar -->\n        <div class=\"mb-8\">\n            <div class=\"flex justify-between text-xs text-muted mb-2\">\n            <span>Progress</span>\n            <span id=\"progressPercent\" class=\"text-accent font-mono\">0%</span>\n            </div>\n            <div class=\"h-1.5 rounded-full bg-bg overflow-hidden\">\n            <div id=\"progressBar\" class=\"progress-bar-fill h-full rounded-full bg-gradient-to-r from-accent/60 to-accent\" style=\"width: 0%\"></div>\n            </div>\n        </div>\n\n        <!-- Agent steps -->\n        <div id=\"agentSteps\" class=\"space-y-3\">\n            <div class=\"agent-step flex items-center gap-4 p-3 rounded-xl border border-transparent transition-all\" data-agent=\"research\">\n            <div class=\"step-icon w-10 h-10 rounded-xl border border-border flex items-center justify-center shrink-0 transition-all\">\n                <div class=\"step-spinner items-center justify-center\">\n                <svg class=\"w-4 h-4 animate-spin text-accent\" fill=\"none\" viewBox=\"0 0 24 24\">\n                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                    <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path>\n                </svg>\n                </div>\n                <div class=\"step-check hidden items-center justify-center\">\n                <svg class=\"w-4 h-4 text-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M5 13l4 4L19 7\"/>\n                </svg>\n                </div>\n            </div>\n            <div class=\"flex-1 min-w-0\">\n                <p class=\"text-sm font-medium text-white\">Research Agent</p>\n                <p class=\"text-xs text-muted truncate\">Gathering company data & market intelligence</p>\n            </div>\n            </div>\n\n            <div class=\"agent-step flex items-center gap-4 p-3 rounded-xl border border-transparent transition-all\" data-agent=\"business\">\n            <div class=\"step-icon w-10 h-10 rounded-xl border border-border flex items-center justify-center shrink-0 transition-all\">\n                <div class=\"step-spinner items-center justify-center\">\n                <svg class=\"w-4 h-4 animate-spin text-accent\" fill=\"none\" viewBox=\"0 0 24 24\">\n                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                    <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path>\n                </svg>\n                </div>\n                <div class=\"step-check hidden items-center justify-center\">\n                <svg class=\"w-4 h-4 text-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M5 13l4 4L19 7\"/>\n                </svg>\n                </div>\n            </div>\n            <div class=\"flex-1 min-w-0\">\n                <p class=\"text-sm font-medium text-white\">Business Agent</p>\n                <p class=\"text-xs text-muted truncate\">Analyzing business model & revenue streams</p>\n            </div>\n            </div>\n\n            <div class=\"agent-step flex items-center gap-4 p-3 rounded-xl border border-transparent transition-all\" data-agent=\"challenge\">\n            <div class=\"step-icon w-10 h-10 rounded-xl border border-border flex items-center justify-center shrink-0 transition-all\">\n                <div class=\"step-spinner items-center justify-center\">\n                <svg class=\"w-4 h-4 animate-spin text-accent\" fill=\"none\" viewBox=\"0 0 24 24\">\n                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                    <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path>\n                </svg>\n                </div>\n                <div class=\"step-check hidden items-center justify-center\">\n                <svg class=\"w-4 h-4 text-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M5 13l4 4L19 7\"/>\n                </svg>\n                </div>\n            </div>\n            <div class=\"flex-1 min-w-0\">\n                <p class=\"text-sm font-medium text-white\">Challenge Agent</p>\n                <p class=\"text-xs text-muted truncate\">Identifying operational & strategic challenges</p>\n            </div>\n            </div>\n\n            <div class=\"agent-step flex items-center gap-4 p-3 rounded-xl border border-transparent transition-all\" data-agent=\"opportunity\">\n            <div class=\"step-icon w-10 h-10 rounded-xl border border-border flex items-center justify-center shrink-0 transition-all\">\n                <div class=\"step-spinner items-center justify-center\">\n                <svg class=\"w-4 h-4 animate-spin text-accent\" fill=\"none\" viewBox=\"0 0 24 24\">\n                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                    <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path>\n                </svg>\n                </div>\n                <div class=\"step-check hidden items-center justify-center\">\n                <svg class=\"w-4 h-4 text-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M5 13l4 4L19 7\"/>\n                </svg>\n                </div>\n            </div>\n            <div class=\"flex-1 min-w-0\">\n                <p class=\"text-sm font-medium text-white\">AI Opportunity Agent</p>\n                <p class=\"text-xs text-muted truncate\">Mapping AI use cases & impact potential</p>\n            </div>\n            </div>\n\n            <div class=\"agent-step flex items-center gap-4 p-3 rounded-xl border border-transparent transition-all\" data-agent=\"roadmap\">\n            <div class=\"step-icon w-10 h-10 rounded-xl border border-border flex items-center justify-center shrink-0 transition-all\">\n                <div class=\"step-spinner items-center justify-center\">\n                <svg class=\"w-4 h-4 animate-spin text-accent\" fill=\"none\" viewBox=\"0 0 24 24\">\n                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                    <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path>\n                </svg>\n                </div>\n                <div class=\"step-check hidden items-center justify-center\">\n                <svg class=\"w-4 h-4 text-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M5 13l4 4L19 7\"/>\n                </svg>\n                </div>\n            </div>\n            <div class=\"flex-1 min-w-0\">\n                <p class=\"text-sm font-medium text-white\">Roadmap Agent</p>\n                <p class=\"text-xs text-muted truncate\">Building phased implementation timeline</p>\n            </div>\n            </div>\n\n            <div class=\"agent-step flex items-center gap-4 p-3 rounded-xl border border-transparent transition-all\" data-agent=\"pitch\">\n            <div class=\"step-icon w-10 h-10 rounded-xl border border-border flex items-center justify-center shrink-0 transition-all\">\n                <div class=\"step-spinner items-center justify-center\">\n                <svg class=\"w-4 h-4 animate-spin text-accent\" fill=\"none\" viewBox=\"0 0 24 24\">\n                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                    <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z\"></path>\n                </svg>\n                </div>\n                <div class=\"step-check hidden items-center justify-center\">\n                <svg class=\"w-4 h-4 text-accent\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M5 13l4 4L19 7\"/>\n                </svg>\n                </div>\n            </div>\n            <div class=\"flex-1 min-w-0\">\n                <p class=\"text-sm font-medium text-white\">CEO Pitch Agent</p>\n                <p class=\"text-xs text-muted truncate\">Crafting executive summary & pitch deck</p>\n            </div>\n            </div>\n        </div>\n        </div>\n    </div>\n    </div>\n</section>\n\n<!-- ===================== RESULTS DASHBOARD ===================== -->\n<section id=\"resultsDashboard\" class=\"section-hidden relative py-16 px-6 pb-24\">\n    <div class=\"max-w-6xl mx-auto\">\n\n    <!-- Dashboard header -->\n    <div class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8\">\n        <div>\n        <p class=\"text-xs text-accent font-medium uppercase tracking-wider mb-1\">Intelligence Report</p>\n        <h2 id=\"reportCompanyName\" class=\"text-2xl sm:text-3xl font-bold text-white\"></h2>\n        <p id=\"reportTimestamp\" class=\"text-sm text-muted mt-1\"></p>\n        </div>\n        <button\n        id=\"newReportBtn\"\n        type=\"button\"\n        class=\"btn-ghost\"\n        >\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 4v16m8-8H4\"/>\n        </svg>\n        New Report\n        </button>\n    </div>\n\n    <!-- Tabs -->\n    <div class=\"mb-6 tab-nav-scroll\">\n        <div id=\"tabNav\" class=\"flex gap-2 min-w-max pb-1\">\n        <button class=\"tab-btn active px-4 py-2 rounded-lg text-sm font-medium border border-transparent text-muted-light transition-all\" data-tab=\"overview\">Overview</button>\n        <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-medium border border-transparent text-muted-light transition-all\" data-tab=\"business\">Business Information</button>\n        <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-medium border border-transparent text-muted-light transition-all\" data-tab=\"challenges\">Challenges</button>\n        <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-medium border border-transparent text-muted-light transition-all\" data-tab=\"opportunities\">AI Opportunities</button>\n        <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-medium border border-transparent text-muted-light transition-all\" data-tab=\"roadmap\">Roadmap</button>\n        <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-medium border border-transparent text-muted-light transition-all\" data-tab=\"pitch\">CEO Pitch</button>\n        </div>\n    </div>\n\n    <!-- Tab panels -->\n    <div id=\"tabPanels\">\n\n        <!-- Overview -->\n        <div class=\"tab-panel active\" data-panel=\"overview\">\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6\">\n            <div class=\"stat-card gradient-border p-5 flex flex-col justify-between h-full\">\n            <div class=\"relative z-10 flex flex-col flex-1\">\n                <p class=\"text-xs text-muted uppercase tracking-wider mb-2\">AI Readiness</p>\n                <div class=\"flex-1 flex items-center\">\n                  <p id=\"statReadiness\" class=\"text-3xl font-bold text-accent\">\u2014</p>\n                </div>\n                <p class=\"text-xs text-muted-light mt-2\">Score out of 100</p>\n            </div>\n            </div>\n            <div class=\"stat-card gradient-border p-5 flex flex-col justify-between h-full\">\n            <div class=\"relative z-10 flex flex-col flex-1\">\n                <p class=\"text-xs text-muted uppercase tracking-wider mb-2\">Opportunities</p>\n                <div class=\"flex-1 flex items-center\">\n                  <p id=\"statOpportunities\" class=\"text-3xl font-bold text-white\">\u2014</p>\n                </div>\n                <p class=\"text-xs text-muted-light mt-2\">Identified use cases</p>\n            </div>\n            </div>\n            <div class=\"stat-card gradient-border p-5 flex flex-col justify-between h-full\">\n            <div class=\"relative z-10 flex flex-col flex-1\">\n                <p class=\"text-xs text-muted uppercase tracking-wider mb-2\">Challenges</p>\n                <div class=\"flex-1 flex items-center\">\n                  <p id=\"statChallenges\" class=\"text-3xl font-bold text-white\">\u2014</p>\n                </div>\n                <p class=\"text-xs text-muted-light mt-2\">Key pain points</p>\n            </div>\n            </div>\n            <div class=\"stat-card gradient-border p-5 flex flex-col justify-between h-full\">\n            <div class=\"relative z-10 flex flex-col flex-1\">\n                <p class=\"text-xs text-muted uppercase tracking-wider mb-2\">ROI Potential</p>\n                <div class=\"flex-1 flex items-center\">\n                  <p id=\"statROI\" class=\"text-2xl sm:text-3xl font-bold text-accent line-clamp-2 overflow-hidden break-words leading-tight\">\u2014</p>\n                </div>\n                <p class=\"text-xs text-muted-light mt-2\">Estimated annual savings</p>\n            </div>\n            </div>\n        </div>\n\n        <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n            <div class=\"gradient-border p-6\">\n            <div class=\"relative z-10\">\n                <h3 class=\"text-sm font-semibold text-white mb-4 flex items-center gap-2\">\n                <span class=\"w-2 h-2 rounded-full bg-accent\"></span>\n                Executive Summary\n                </h3>\n                <p id=\"overviewSummary\" class=\"text-sm text-muted-light leading-relaxed\"></p>\n            </div>\n            </div>\n            <div class=\"gradient-border p-6\">\n            <div class=\"relative z-10\">\n                <h3 class=\"text-sm font-semibold text-white mb-4 flex items-center gap-2\">\n                <span class=\"w-2 h-2 rounded-full bg-accent\"></span>\n                Top AI Recommendations\n                </h3>\n                <ul id=\"overviewRecommendations\" class=\"space-y-3\"></ul>\n            </div>\n            </div>\n        </div>\n        </div>\n\n        <!-- Business Information -->\n        <div class=\"tab-panel\" data-panel=\"business\">\n        <div class=\"gradient-border p-6 sm:p-8\">\n            <div class=\"relative z-10\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-8\">\n                <div>\n                <h3 class=\"text-xs text-muted uppercase tracking-wider mb-4\">Company Profile</h3>\n                <dl id=\"businessProfile\" class=\"space-y-4\"></dl>\n                </div>\n                <div>\n                <h3 class=\"text-xs text-muted uppercase tracking-wider mb-4\">Market Position</h3>\n                <dl id=\"businessMarket\" class=\"space-y-4\"></dl>\n                </div>\n            </div>\n            <div>\n                <h3 class=\"text-xs text-muted uppercase tracking-wider mb-4\">Business Description</h3>\n                <p id=\"businessDescription\" class=\"text-sm text-muted-light leading-relaxed\"></p>\n            </div>\n            </div>\n        </div>\n        </div>\n\n        <!-- Challenges -->\n        <div class=\"tab-panel\" data-panel=\"challenges\">\n        <div id=\"challengesList\" class=\"space-y-4\"></div>\n        </div>\n\n        <!-- AI Opportunities -->\n        <div class=\"tab-panel\" data-panel=\"opportunities\">\n        <div id=\"opportunitiesList\" class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"></div>\n        </div>\n\n        <!-- Roadmap -->\n        <div class=\"tab-panel\" data-panel=\"roadmap\">\n        <div class=\"gradient-border p-6 sm:p-8\">\n            <div class=\"relative z-10\">\n            <h3 class=\"text-sm font-semibold text-white mb-8\">Implementation Roadmap</h3>\n            <div id=\"roadmapTimeline\" class=\"relative pl-8 space-y-8\"></div>\n            </div>\n        </div>\n        </div>\n\n        <!-- CEO Pitch -->\n        <div class=\"tab-pa